  "locked": false,
  "title": "feat: use the bundled nanoda, and deprecate the `nanoda` input",
  "user": {
    "login": "kim-em",
    "id": 477956,
    "node_id": "MDQ6VXNlcjQ3Nzk1Ng==",
    "avatar_url": "https://avatars.githubusercontent.com/u/477956?v=4",
