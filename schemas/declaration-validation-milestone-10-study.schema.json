{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanassurancelab.invalid/schemas/declaration-validation-milestone-10-study.schema.json",
  "title": "Declaration Validation Milestone 10 Study Design",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "recorded_at",
    "status",
    "immutable_m9_input",
    "evidence_index",
    "eligibility_algorithm",
    "readiness",
    "future_isolated_negative_coverage_contract",
    "checker_attribution_contract",
    "synthesis_hierarchy",
    "execution_gates",
    "successor_rebinding_rule",
    "prohibitions",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "study_id": {"const": "ordinary-declaration-validation.milestone-10-study-design.v1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"const": "FROZEN_FUTURE_EXPERIMENT_PROTOCOL"},
    "immutable_m9_input": {
      "type": "object",
      "required": [
        "attestation_path",
        "attestation_sha256",
        "historical_commit",
        "reviewed_catalog_binding",
        "identity_registry_binding",
        "approved_authority_sources_binding"
      ],
      "properties": {
        "attestation_path": {"const": "results/research/declaration-validation-milestone-9-historical.json"},
        "attestation_sha256": {"$ref": "#/$defs/sha256"},
        "historical_commit": {"$ref": "#/$defs/gitObjectId"},
        "reviewed_catalog_binding": {"$ref": "#/$defs/gitBlobBinding"},
        "identity_registry_binding": {"$ref": "#/$defs/gitBlobBinding"},
        "approved_authority_sources_binding": {"$ref": "#/$defs/gitBlobBinding"}
      },
      "additionalProperties": false
    },
    "evidence_index": {
      "type": "array",
      "minItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "artifact", "json_pointer", "claim", "limitation"],
        "properties": {
          "id": {"type": "string", "pattern": "^M9\\.(CATALOG|IDENTITY)\\.[0-9]+$"},
          "artifact": {"enum": ["immutable_m9_reviewed_catalog", "immutable_m9_identity_registry"]},
          "json_pointer": {"type": "string", "pattern": "^/"},
          "claim": {"type": "string", "minLength": 20},
          "limitation": {"type": "string", "minLength": 20}
        },
        "additionalProperties": false
      }
    },
    "eligibility_algorithm": {
      "type": "object",
      "required": [
        "algorithm_id",
        "primary_conjunction",
        "controlled_exclusion_reasons",
        "empty_denominator_policy",
        "percentage_policy",
        "exploratory_candidate_algorithm",
        "empirical_context_policy"
      ],
      "properties": {
        "algorithm_id": {"const": "M10.PRIMARY.NORMATIVE.NEGATIVE.COVERAGE.ELIGIBILITY.V1"},
        "primary_conjunction": {
          "const": [
            "kind=NORMATIVE_CANDIDATE_OBLIGATION",
            "authority.status=ESTABLISHED",
            "layers contains KERNEL_DECLARATION_VALIDITY",
            "study_scope.status=YES",
            "semantic_negative_testability.status=YES",
            "arena_representability.status=YES",
            "isolation_feasibility.status=YES",
            "lifecycle.status=ACTIVE"
          ]
        },
        "controlled_exclusion_reasons": {
          "type": "object",
          "minProperties": 10,
          "additionalProperties": {"type": "string", "minLength": 10}
        },
        "empty_denominator_policy": {"type": "string", "minLength": 30},
        "percentage_policy": {"type": "string", "minLength": 30},
        "exploratory_candidate_algorithm": {"type": "string", "minLength": 30},
        "empirical_context_policy": {"type": "string", "minLength": 30}
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/readinessRecord"}
    },
    "future_isolated_negative_coverage_contract": {
      "type": "object",
      "required": [
        "semantic_obligation",
        "required_evidence",
        "positive_control",
        "competing_obligations",
        "authority_scoped_expected_outcome",
        "counting_rule"
      ],
      "properties": {
        "semantic_obligation": {"const": "Reach(x) AND NOT P(x)"},
        "required_evidence": {
          "const": [
            "content-bound negative artifact",
            "evidence-backed Reach(x) applicability and prerequisites",
            "evidence that NOT P(x) holds",
            "matched positive control",
            "complete competing-obligation analysis",
            "authority-scoped expected normative rejection",
            "per-checker rejection attribution where obtainable"
          ]
        },
        "positive_control": {
          "type": "object",
          "required": ["same_construction_family", "repairs_target_violation", "minimizes_unrelated_differences", "documents_unavoidable_differences"],
          "properties": {
            "same_construction_family": {"const": true},
            "repairs_target_violation": {"const": true},
            "minimizes_unrelated_differences": {"const": true},
            "documents_unavoidable_differences": {"const": true}
          },
          "additionalProperties": false
        },
        "competing_obligations": {
          "type": "object",
          "required": ["statuses", "unresolved_blocks_isolated_coverage", "derived_consequence_rule"],
          "properties": {
            "statuses": {"const": ["SATISFIED", "NOT_APPLICABLE", "UNRESOLVED"]},
            "unresolved_blocks_isolated_coverage": {"const": true},
            "derived_consequence_rule": {"type": "string", "minLength": 30}
          },
          "additionalProperties": false
        },
        "authority_scoped_expected_outcome": {
          "type": "object",
          "required": ["established_may_support_normative_rejection", "provisional_may_support_normative_rejection", "profile_behavior_is_normative_outcome"],
          "properties": {
            "established_may_support_normative_rejection": {"const": true},
            "provisional_may_support_normative_rejection": {"const": false},
            "profile_behavior_is_normative_outcome": {"const": false}
          },
          "additionalProperties": false
        },
        "counting_rule": {"type": "string", "minLength": 40}
      },
      "additionalProperties": false
    },
    "checker_attribution_contract": {
      "type": "object",
      "required": ["required_bindings", "pipeline_stages", "normalized_outcomes", "agreement_is_authority", "rejection_alone_proves_isolation"],
      "properties": {
        "required_bindings": {"const": ["artifact_sha256", "observer_profile", "configuration", "pipeline_stage", "normalized_outcome", "raw_result_sha256"]},
        "pipeline_stages": {"const": ["EXPORT", "TRANSPORT", "PARSE", "RECONSTRUCTION", "VALIDATION", "POLICY"]},
        "normalized_outcomes": {"const": ["ACCEPT", "REJECT", "DECLINE", "CRASH", "TIMEOUT", "PARSE_ERROR", "UNKNOWN"]},
        "agreement_is_authority": {"const": false},
        "rejection_alone_proves_isolation": {"const": false}
      },
      "additionalProperties": false
    },
    "synthesis_hierarchy": {
      "const": [
        {"tier": 1, "name": "DETERMINISTIC_PREMISE_SPECIFIC_TEMPLATES"},
        {"tier": 2, "name": "STRUCTURE_PRESERVING_TRANSFORMATIONS_OF_KNOWN_VALID_ARTIFACTS"},
        {"tier": 3, "name": "CONSTRAINT_DRIVEN_REACH_AND_NOT_P_CONSTRUCTORS"}
      ]
    },
    "execution_gates": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "requirement", "failure_effect"],
        "properties": {
          "id": {"type": "string", "pattern": "^GATE\\.M10\\.[0-9]{2}$"},
          "requirement": {"type": "string", "minLength": 20},
          "failure_effect": {"const": "BLOCK_SUBSTANTIVE_STUDY_EXECUTION"}
        },
        "additionalProperties": false
      }
    },
    "successor_rebinding_rule": {
      "type": "object",
      "required": ["protocol_immutable", "new_input_snapshot_required", "reapply_algorithm", "freeze_denominator_before_execution"],
      "properties": {
        "protocol_immutable": {"const": true},
        "new_input_snapshot_required": {"const": true},
        "reapply_algorithm": {"const": true},
        "freeze_denominator_before_execution": {"const": true}
      },
      "additionalProperties": false
    },
    "prohibitions": {
      "const": [
        "NEW_ARENA_TEST_CAMPAIGN",
        "NEW_CHECKER_COMPARISON_CAMPAIGN",
        "MUTATION_CAMPAIGN",
        "GENERATED_LEAN_WITNESS_CAMPAIGN",
        "BROAD_WITNESS_SYNTHESIS",
        "NEW_SEMANTIC_CROSS_VALIDATION",
        "AUTHORITY_SOURCE_APPROVAL",
        "AUTHORITY_PROMOTION",
        "DENOMINATOR_CRITERION_WEAKENING"
      ]
    },
    "nonclaims": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 20}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gitBlobBinding": {
      "type": "object",
      "required": ["path", "sha256", "git_commit", "git_blob"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "git_commit": {"$ref": "#/$defs/gitObjectId"},
        "git_blob": {"$ref": "#/$defs/gitObjectId"}
      },
      "additionalProperties": false
    },
    "determination": {
      "type": "object",
      "required": ["status", "basis", "evidence", "blocking_reason_if_any"],
      "properties": {
        "status": {"enum": ["YES", "NO", "UNRESOLVED"]},
        "basis": {"type": "string", "minLength": 20},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^M9\\.(CATALOG|IDENTITY)\\.[0-9]+$"}
        },
        "blocking_reason_if_any": {"type": ["string", "null"], "minLength": 10}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "YES"}}},
          "then": {"properties": {"blocking_reason_if_any": {"const": null}}},
          "else": {"properties": {"blocking_reason_if_any": {"type": "string", "minLength": 10}}}
        }
      ],
      "additionalProperties": false
    },
    "frozenClassification": {
      "type": "object",
      "required": ["kind", "layers", "authority_status", "lifecycle_status", "identity_status"],
      "properties": {
        "kind": {"type": ["string", "null"], "enum": ["NORMATIVE_CANDIDATE_OBLIGATION", "EMPIRICAL_CONTRACT_SCENARIO", null]},
        "layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["KERNEL_DECLARATION_VALIDITY", "EXPORT_FORMAT", "RECONSTRUCTION", "TRUST_POLICY", "IMPLEMENTATION_POLICY"]}
        },
        "authority_status": {"type": ["string", "null"], "enum": ["ESTABLISHED", "PROVISIONAL", "UNRESOLVED", null]},
        "lifecycle_status": {"type": ["string", "null"], "enum": ["ACTIVE", "SUPERSEDED", "REDUNDANT", "OUT_OF_SCOPE", null]},
        "identity_status": {"enum": ["ACTIVE_PROVISIONAL", "DEFERRED_KIND", "RESERVED_OUT_OF_SCOPE"]}
      },
      "additionalProperties": false
    },
    "witnessStrategy": {
      "type": ["object", "null"],
      "required": ["tier", "construction", "positive_control", "competing_obligation_focus", "blocking_prerequisites"],
      "properties": {
        "tier": {"type": "integer", "minimum": 1, "maximum": 3},
        "construction": {"type": "string", "minLength": 20},
        "positive_control": {"type": "string", "minLength": 20},
        "competing_obligation_focus": {"type": "string", "minLength": 20},
        "blocking_prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 10}}
      },
      "additionalProperties": false
    },
    "readinessRecord": {
      "type": "object",
      "required": [
        "entry_id",
        "input_disposition",
        "frozen_classification",
        "kind_eligible",
        "authority_eligible",
        "kernel_layer_eligible",
        "study_scope",
        "semantic_negative_testability",
        "arena_representability",
        "isolation_feasibility",
        "lifecycle_eligible",
        "future_witness_strategy"
      ],
      "properties": {
        "entry_id": {"type": "string", "minLength": 3},
        "input_disposition": {"enum": ["CATALOG_ENTRY", "DEFERRED_UNRESOLVED_KIND", "OUT_OF_SCOPE"]},
        "frozen_classification": {"$ref": "#/$defs/frozenClassification"},
        "kind_eligible": {"$ref": "#/$defs/determination"},
        "authority_eligible": {"$ref": "#/$defs/determination"},
        "kernel_layer_eligible": {"$ref": "#/$defs/determination"},
        "study_scope": {"$ref": "#/$defs/determination"},
        "semantic_negative_testability": {"$ref": "#/$defs/determination"},
        "arena_representability": {"$ref": "#/$defs/determination"},
        "isolation_feasibility": {"$ref": "#/$defs/determination"},
        "lifecycle_eligible": {"$ref": "#/$defs/determination"},
        "future_witness_strategy": {"$ref": "#/$defs/witnessStrategy"}
      },
      "additionalProperties": false
    }
  }
}
