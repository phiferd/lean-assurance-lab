{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanassurancelab.invalid/schemas/declaration-validation-historical-attestation.schema.json",
  "title": "Declaration Validation Historical Attestation",
  "description": "Binds a completed declaration-validation milestone to exact repository Git blobs so its validation never follows mutable current paths.",
  "type": "object",
  "required": [
    "schema_version",
    "attestation_id",
    "recorded_at",
    "status",
    "historical_commit",
    "artifacts",
    "recovery",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "attestation_id": {"type": "string", "pattern": "^ordinary-declaration-validation\\.milestone-[0-9]+\\.historical\\.v[0-9]+$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"const": "FROZEN_HISTORICAL_MILESTONE_ATTESTATION"},
    "historical_commit": {"$ref": "#/$defs/gitObjectId"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/gitBlobBinding"}
    },
    "recovery": {
      "type": "object",
      "required": ["recovered_from_commit", "later_mutable_rewrite_commit", "reason"],
      "properties": {
        "recovered_from_commit": {"$ref": "#/$defs/gitObjectId"},
        "later_mutable_rewrite_commit": {"$ref": "#/$defs/gitObjectId"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gitBlobBinding": {
      "type": "object",
      "required": ["path", "sha256", "git_commit", "git_blob"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "git_commit": {"$ref": "#/$defs/gitObjectId"},
        "git_blob": {"$ref": "#/$defs/gitObjectId"}
      },
      "additionalProperties": false
    }
  }
}
