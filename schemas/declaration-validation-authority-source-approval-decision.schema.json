{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanassurancelab.invalid/schemas/declaration-validation-authority-source-approval-decision.schema.json",
  "title": "Declaration Validation Authority-Source Approval Decision",
  "description": "A separately recorded approval decision that must precede a successor authority-source registry. This schema is an evolution mechanism; it does not approve a source by itself.",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "recorded_at",
    "status",
    "predecessor_registry",
    "approved_source_ids",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^DEC\\.AUTHORITY_SOURCE\\.[A-Z0-9_.]+$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"const": "APPROVED_AUTHORITY_SOURCE_DECISION"},
    "predecessor_registry": {"$ref": "#/$defs/registryBinding"},
    "approved_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^APPROVED\\.(NORMDOC|MECH)(\\.[A-Z0-9_]+)+$"}
    },
    "nonclaims": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registryBinding": {
      "type": "object",
      "required": ["path", "sha256", "registry_id", "sequence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "registry_id": {"type": "string", "pattern": "^ordinary-declaration-validation\\.approved-authority-sources\\.[a-z0-9.-]+\\.v[0-9]+$"},
        "sequence": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
