{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanassurancelab.invalid/schemas/declaration-validation-milestone-8-pilot.v2.schema.json",
  "title": "Declaration Validation Milestone 8 Five-Entry Historical Pilot",
  "description": "A separately reviewable five-entry pilot whose predecessor and bound inputs are immutable Git blobs or content-addressed historical attestations.",
  "type": "object",
  "required": [
    "schema_version",
    "pilot_id",
    "recorded_at",
    "status",
    "predecessor_catalog",
    "predecessor_pilot",
    "artifact_bindings",
    "evidence_lock_predecessors",
    "selection",
    "candidate_ids",
    "entries",
    "site_dispositions",
    "review_requirements",
    "stop_condition",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "pilot_id": {"const": "ordinary-declaration-validation.milestone-8-pilot.v1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"const": "MILESTONE_8_FIVE_ENTRY_PILOT_REVIEWED"},
    "predecessor_catalog": {"$ref": "#/$defs/historicalCatalogBinding"},
    "predecessor_pilot": {"$ref": "#/$defs/gitBlobBinding"},
    "artifact_bindings": {
      "type": "object",
      "required": [
        "authority_rules",
        "approved_authority_sources",
        "approved_authority_sources_schema",
        "catalog_schema",
        "characterization_model",
        "discovery_closure",
        "entry_schema",
        "evidence_lock",
        "evidence_lock_schema",
        "identity_registry",
        "prior_identity_decisions",
        "semantic_target",
        "source_lock"
      ],
      "properties": {
        "authority_rules": {"$ref": "#/$defs/gitBlobBinding"},
        "approved_authority_sources": {"$ref": "#/$defs/authorityRegistryGitBlobBinding"},
        "approved_authority_sources_schema": {"$ref": "#/$defs/gitBlobBinding"},
        "catalog_schema": {"$ref": "#/$defs/gitBlobBinding"},
        "characterization_model": {"$ref": "#/$defs/gitBlobBinding"},
        "discovery_closure": {"$ref": "#/$defs/gitBlobBinding"},
        "entry_schema": {"$ref": "#/$defs/gitBlobBinding"},
        "evidence_lock": {"$ref": "#/$defs/gitBlobBinding"},
        "evidence_lock_schema": {"$ref": "#/$defs/gitBlobBinding"},
        "identity_registry": {"$ref": "#/$defs/gitBlobBinding"},
        "prior_identity_decisions": {"$ref": "#/$defs/gitBlobBinding"},
        "semantic_target": {"$ref": "#/$defs/gitBlobBinding"},
        "source_lock": {"$ref": "#/$defs/gitBlobBinding"}
      },
      "additionalProperties": false
    },
    "evidence_lock_predecessors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/gitBlobBinding"}
    },
    "selection": {
      "type": "object",
      "required": ["method", "coverage", "exclusions"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "coverage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "candidate_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/semanticId"}},
    "entries": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}},
    "site_dispositions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "review_requirements": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stop_condition": {"type": "string", "minLength": 1},
    "nonclaims": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "semanticId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(\\.[A-Z][A-Z0-9_]*)+$"},
    "gitBlobBinding": {
      "type": "object",
      "required": ["path", "sha256", "git_commit", "git_blob"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "git_commit": {"$ref": "#/$defs/gitObjectId"},
        "git_blob": {"$ref": "#/$defs/gitObjectId"},
        "registry_id": {"type": "string", "pattern": "^ordinary-declaration-validation\\.approved-authority-sources\\.[a-z0-9.-]+\\.v[0-9]+$"}
      },
      "additionalProperties": false
    },
    "authorityRegistryGitBlobBinding": {
      "allOf": [
        {"$ref": "#/$defs/gitBlobBinding"},
        {
          "type": "object",
          "required": ["registry_id"],
          "properties": {
            "registry_id": {"type": "string", "pattern": "^ordinary-declaration-validation\\.approved-authority-sources\\.[a-z0-9.-]+\\.v[0-9]+$"}
          }
        }
      ]
    },
    "historicalCatalogBinding": {
      "type": "object",
      "required": ["attestation_path", "attestation_sha256", "artifact"],
      "properties": {
        "attestation_path": {"const": "results/research/declaration-validation-milestone-7-historical.json"},
        "attestation_sha256": {"$ref": "#/$defs/sha256"},
        "artifact": {"const": "catalog"}
      },
      "additionalProperties": false
    }
  }
}
