{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanassurancelab.invalid/schemas/declaration-validation-catalog.schema.json",
  "title": "Ordinary Declaration Validation Characterization Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "recorded_at",
    "status",
    "artifact_bindings",
    "id_evolution_rules",
    "identity_denotation_profile",
    "observer_order",
    "entries",
    "site_dispositions",
    "existing_evidence_dispositions",
    "identity_dispositions",
    "completion_boundary",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"const": "ordinary-declaration-validation.catalog.v1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": [
        "MILESTONE_7_INFRASTRUCTURE_ONLY",
        "MILESTONE_8_CHARACTERIZATION_INVENTORY",
        "MILESTONE_9_PRE_REVIEW_FREEZE",
        "MILESTONE_9_REVIEWED_FREEZE",
        "PUBLICATION_STUDY_SENTINEL_VALIDATED",
        "PUBLICATION_STUDY_COMPLETE_ADJUDICATION"
      ]
    },
    "artifact_bindings": {
      "type": "object",
      "required": [
        "approved_authority_sources",
        "approved_authority_sources_schema",
        "semantic_target",
        "characterization_model",
        "discovery_closure",
        "identity_registry",
        "source_lock",
        "evidence_lock",
        "evidence_lock_schema",
        "entry_schema",
        "authority_rules"
      ],
      "properties": {
        "approved_authority_sources": {"$ref": "#/$defs/fileBinding"},
        "approved_authority_sources_schema": {"$ref": "#/$defs/fileBinding"},
        "semantic_target": {"$ref": "#/$defs/fileBinding"},
        "characterization_model": {"$ref": "#/$defs/fileBinding"},
        "discovery_closure": {"$ref": "#/$defs/fileBinding"},
        "identity_registry": {"$ref": "#/$defs/fileBinding"},
        "source_lock": {"$ref": "#/$defs/fileBinding"},
        "evidence_lock": {"$ref": "#/$defs/fileBinding"},
        "evidence_lock_schema": {"$ref": "#/$defs/fileBinding"},
        "entry_schema": {"$ref": "#/$defs/fileBinding"},
        "authority_rules": {"$ref": "#/$defs/fileBinding"}
      },
      "additionalProperties": false
    },
    "id_evolution_rules": {"$ref": "#/$defs/idEvolutionRules"},
    "identity_denotation_profile": {"$ref": "#/$defs/identityDenotationProfile"},
    "observer_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/observerPointer"}
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/catalogEntry"}
    },
    "site_dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/siteDisposition"}
    },
    "existing_evidence_dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/existingEvidenceDisposition"}
    },
    "identity_dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/identityDisposition"}
    },
    "completion_boundary": {
      "type": "object",
      "required": [
        "canonical_data_authoritative",
        "generated_report_required",
        "inventory_populated",
        "authority_assignments_created",
        "next_milestone"
      ],
      "properties": {
        "canonical_data_authoritative": {"const": true},
        "generated_report_required": {"const": true},
        "inventory_populated": {"type": "boolean"},
        "authority_assignments_created": {"type": "boolean"},
        "next_milestone": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semanticId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(\\.[A-Z][A-Z0-9_]*)+$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EVID(\\.[A-Z][A-Z0-9_]*)+$"
    },
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "idEvolutionRules": {
      "type": "object",
      "required": [
        "retain_id_when",
        "new_id_when",
        "supersession",
        "merge_tombstone",
        "deletion",
        "reuse"
      ],
      "properties": {
        "retain_id_when": {"type": "string", "minLength": 1},
        "new_id_when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "supersession": {"type": "string", "minLength": 1},
        "merge_tombstone": {"type": "string", "minLength": 1},
        "deletion": {"const": "FORBIDDEN"},
        "reuse": {"const": "FORBIDDEN"}
      },
      "additionalProperties": false
    },
    "identityDenotationProfile": {
      "type": "object",
      "required": [
        "profile_id",
        "normative",
        "empirical",
        "non_identity_fields",
        "semantic_change_requires_new_id"
      ],
      "properties": {
        "profile_id": {"const": "ordinary-declaration-validation.semantic-denotation-projection.v1"},
        "normative": {
          "type": "object",
          "required": [
            "applicability",
            "modeled_judgment_target_profile_pointer",
            "premises",
            "target_premise",
            "violation_expectation"
          ],
          "properties": {
            "applicability": {"const": "EXACT_SINGLE_FROZEN_APPLICABILITY"},
            "modeled_judgment_target_profile_pointer": {"const": "/logical_target/modeled_judgment"},
            "premises": {"const": "EMPTY_NO_ADDITIONAL_REACH_RESTRICTIONS"},
            "target_premise": {"const": "EXACT_FROZEN_SEMANTIC_STATEMENT"},
            "violation_expectation": {"const": "REJECT"}
          },
          "additionalProperties": false
        },
        "empirical": {
          "type": "object",
          "required": [
            "subject_scope",
            "precondition",
            "stimulus",
            "observation_point",
            "profile_specific_effects"
          ],
          "properties": {
            "subject_scope": {"const": "EXACT_FROZEN_APPLICABILITY"},
            "precondition": {"const": "EXACT_SINGLE_FROZEN_APPLICABILITY"},
            "stimulus": {"const": "EXACT_FROZEN_SEMANTIC_STATEMENT"},
            "observation_point": {"const": "EXACT_SINGLE_DERIVED_PINNED_OBSERVER_OUTCOME"},
            "profile_specific_effects": {"const": "NON_IDENTITY_OBSERVATIONS"}
          },
          "additionalProperties": false
        },
        "non_identity_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "semantic_change_requires_new_id": {"const": true}
      },
      "additionalProperties": false
    },
    "observerPointer": {
      "enum": [
        "/observer_profiles/official_importer",
        "/observer_profiles/nanoda",
        "/observer_profiles/lean4lean",
        "/observer_profiles/kiota"
      ]
    },
    "observerOutcome": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "ERROR",
        "TIMEOUT",
        "NOT_INSPECTED",
        "NOT_APPLICABLE",
        "UNRESOLVED"
      ]
    },
    "catalogEntry": {
      "type": "object",
      "required": [
        "characterization",
        "identity_denotation",
        "identity_statement_sha256",
        "semantic_denotation_sha256",
        "decision_ids",
        "observer_vector",
        "source_mappings",
        "arena_disposition"
      ],
      "properties": {
        "characterization": {
          "$ref": "https://leanassurancelab.invalid/schemas/declaration-validation-characterization-entry.schema.json"
        },
        "identity_denotation": {
          "type": "object",
          "required": [
            "semantic_statement",
            "applicability",
            "intended_kind",
            "canonical_semantics"
          ],
          "properties": {
            "semantic_statement": {"type": "string", "minLength": 1},
            "applicability": {"type": "string", "minLength": 1},
            "intended_kind": {
              "enum": [
                "NORMATIVE_CANDIDATE_OBLIGATION",
                "EMPIRICAL_CONTRACT_SCENARIO"
              ]
            },
            "canonical_semantics": {
              "oneOf": [
                {"$ref": "#/$defs/normativeCanonicalSemantics"},
                {"$ref": "#/$defs/empiricalCanonicalSemantics"}
              ]
            }
          },
          "additionalProperties": false
        },
        "identity_statement_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_denotation_sha256": {"$ref": "#/$defs/sha256"},
        "decision_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^DEC\\.[A-Z0-9_.]+$"}
        },
        "observer_vector": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/observerObservation"}
        },
        "source_mappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceMapping"}
        },
        "arena_disposition": {"$ref": "#/$defs/arenaDisposition"}
      },
      "additionalProperties": false
    },
    "arenaDisposition": {
      "type": "object",
      "required": ["disposition", "evidence_refs"],
      "properties": {
        "disposition": {
          "enum": [
            "LINKED",
            "NO_EXISTING_CASE_FOUND",
            "NOT_INSPECTED",
            "NOT_APPLICABLE",
            "DEFERRED"
          ]
        },
        "arena_revision": {"$ref": "#/$defs/revision"},
        "case_id": {"type": "string", "minLength": 1},
        "case_path": {"type": "string", "minLength": 1},
        "expected_outcome": {"enum": ["ACCEPT", "REJECT", "ERROR", "TIMEOUT"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        },
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "LINKED"}}, "required": ["disposition"]},
          "then": {
            "required": ["arena_revision", "case_id", "case_path", "expected_outcome"],
            "properties": {"evidence_refs": {"minItems": 1}}
          },
          "else": {"properties": {"evidence_refs": {"maxItems": 0}}}
        }
      ]
    },
    "siteDisposition": {
      "type": "object",
      "required": [
        "stable_identity_id",
        "site_id",
        "source_file_id",
        "implementation",
        "symbol_or_range",
        "disposition",
        "evidence_refs",
        "notes"
      ],
      "properties": {
        "stable_identity_id": {"$ref": "#/$defs/semanticId"},
        "site_id": {"type": "string", "pattern": "^SITE(\\.[A-Z0-9_]+)+$"},
        "source_file_id": {"type": "string", "pattern": "^SRC\\.[A-Z0-9_.]+$"},
        "implementation": {
          "enum": [
            "LOGICAL_TARGET",
            "EXPORTER",
            "OFFICIAL_IMPORTER",
            "NANODA",
            "LEAN4LEAN",
            "KIOTA",
            "OTHER"
          ]
        },
        "symbol_or_range": {"type": "string", "minLength": 1},
        "disposition": {
          "enum": [
            "MAPPED_ENFORCEMENT",
            "MAPPED_RECONSTRUCTION",
            "MAPPED_POLICY",
            "MAPPED_IMPLEMENTATION_BEHAVIOR",
            "OBSERVED_ABSENCE",
            "IMPORTED_PREREQUISITE",
            "NOT_APPLICABLE_AFTER_SPLIT",
            "REDUNDANT_WITH_OTHER_SITE",
            "OUT_OF_SCOPE"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        },
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "existingEvidenceDisposition": {
      "type": "object",
      "required": [
        "stable_identity_id",
        "source_lock_id",
        "source_record_kind",
        "disposition",
        "linked_catalog_evidence_ids",
        "claim_relevance",
        "layer_relevance",
        "rationale"
      ],
      "properties": {
        "stable_identity_id": {"$ref": "#/$defs/semanticId"},
        "source_lock_id": {
          "type": "string",
          "pattern": "^(LOCAL|WITNESS)(\\.[A-Z0-9_]+)+$"
        },
        "source_record_kind": {
          "enum": [
            "TRACKED_EVIDENCE",
            "GENERATED_WITNESS",
            "ARENA_EVIDENCE"
          ]
        },
        "disposition": {
          "enum": [
            "LINKED",
            "NOT_APPLICABLE",
            "SUPERSEDED_BY_STRONGER_EVIDENCE",
            "DUPLICATE",
            "OUTSIDE_THIS_ENTRY_LAYER",
            "INSUFFICIENT_FOR_CLAIM",
            "DEFERRED_TO_LATER_STUDY"
          ]
        },
        "linked_catalog_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        },
        "claim_relevance": {
          "enum": [
            "DISCOVERY",
            "CONTROL",
            "IMPLEMENTATION_OBSERVATION",
            "ARENA_LINKAGE",
            "PROVENANCE_ONLY",
            "NONE"
          ]
        },
        "layer_relevance": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "KERNEL_DECLARATION_VALIDITY",
              "EXPORT_FORMAT",
              "RECONSTRUCTION",
              "TRUST_POLICY",
              "IMPLEMENTATION_POLICY"
            ]
          }
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"disposition": {"const": "LINKED"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {"linked_catalog_evidence_ids": {"minItems": 1}}
          },
          "else": {
            "properties": {"linked_catalog_evidence_ids": {"maxItems": 0}}
          }
        }
      ]
    },
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "normativeCanonicalSemantics": {
      "type": "object",
      "required": [
        "kind",
        "modeled_judgment_target_profile_pointer",
        "applicability",
        "premises",
        "target_premise",
        "violation_expectation"
      ],
      "properties": {
        "kind": {"const": "NORMATIVE_CANDIDATE_OBLIGATION"},
        "modeled_judgment_target_profile_pointer": {"const": "/logical_target/modeled_judgment"},
        "applicability": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "premises": {"type": "array", "maxItems": 0},
        "target_premise": {"type": "string", "minLength": 1},
        "violation_expectation": {"const": "REJECT"}
      },
      "additionalProperties": false
    },
    "empiricalCanonicalSemantics": {
      "type": "object",
      "required": [
        "kind",
        "subject_scope",
        "precondition",
        "stimulus",
        "observation_points",
        "observer_population",
        "profile_specific_effects_identity_relevance"
      ],
      "properties": {
        "kind": {"const": "EMPIRICAL_CONTRACT_SCENARIO"},
        "subject_scope": {"type": "string", "minLength": 1},
        "precondition": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "stimulus": {"type": "string", "minLength": 1},
        "observation_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "observer_population": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/observerPointer"}
        },
        "profile_specific_effects_identity_relevance": {"const": "NON_IDENTITY_OBSERVATIONS"}
      },
      "additionalProperties": false
    },
    "identityDisposition": {
      "type": "object",
      "required": [
        "id",
        "identity_statement_sha256",
        "disposition",
        "reason",
        "decision_ids"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/semanticId"},
        "identity_statement_sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {
          "enum": [
            "CATALOG_ENTRY",
            "DEFERRED_UNRESOLVED_KIND",
            "OUT_OF_SCOPE"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "decision_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^DEC\\.[A-Z0-9_.]+$"}
        }
      },
      "additionalProperties": false
    },
    "observerObservation": {
      "type": "object",
      "required": ["profile_pointer", "outcome", "attribution", "evidence_refs"],
      "properties": {
        "profile_pointer": {"$ref": "#/$defs/observerPointer"},
        "outcome": {"$ref": "#/$defs/observerOutcome"},
        "attribution": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        }
      },
      "additionalProperties": false
    },
    "sourceMapping": {
      "type": "object",
      "required": [
        "implementation",
        "source_file_id",
        "symbol_or_range",
        "role",
        "evidence_refs"
      ],
      "properties": {
        "implementation": {
          "enum": [
            "LOGICAL_TARGET",
            "EXPORTER",
            "OFFICIAL_IMPORTER",
            "NANODA",
            "LEAN4LEAN",
            "KIOTA",
            "OTHER"
          ]
        },
        "source_file_id": {"type": "string", "pattern": "^SRC\\.[A-Z0-9_.]+$"},
        "symbol_or_range": {"type": "string", "minLength": 1},
        "role": {"enum": ["ENFORCEMENT", "RECONSTRUCTION", "POLICY", "OTHER"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidenceId"}
        }
      },
      "additionalProperties": false
    }
  }
}
