{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication-study Gate-9 bounded synthesis plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "status",
    "recorded_at",
    "predecessor_commit",
    "bindings",
    "claim_tier",
    "targets",
    "permitted_prior_input_ids",
    "budget",
    "execution_protocol",
    "reporting",
    "scope_closure"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "const": "ordinary-declaration-validation.publication-study.gate-9-synthesis.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "FROZEN_PROTOCOL_BEFORE_CANDIDATE_GENERATION"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "predecessor_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 1
    },
    "bindings": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "$ref": "#/$defs/gitBinding"
      }
    },
    "claim_tier": {
      "const": "BOUNDED_PILOT"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      },
      "maxItems": 1
    },
    "permitted_prior_input_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "execution_protocol": {
      "$ref": "#/$defs/protocol"
    },
    "reporting": {
      "type": "object",
      "required": [
        "primary_counts",
        "incremental_value",
        "recommendation",
        "nonclaims"
      ],
      "additionalProperties": false,
      "properties": {
        "primary_counts": {
          "type": "string",
          "minLength": 1
        },
        "incremental_value": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "nonclaims": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scope_closure": {
      "type": "object",
      "required": [
        "candidate_generation_started",
        "checker_feedback_obtained",
        "catalog_changed",
        "denominator_changed",
        "baseline_changed",
        "external_action_authorized",
        "next_gate"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_generation_started": {
          "const": false
        },
        "checker_feedback_obtained": {
          "const": false
        },
        "catalog_changed": {
          "const": false
        },
        "denominator_changed": {
          "const": false
        },
        "baseline_changed": {
          "const": false
        },
        "external_action_authorized": {
          "const": false
        },
        "next_gate": {
          "const": "PUBLICATION_STUDY_GATE_10_RESULT_AND_RECOMMENDATION_CLOSURE"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "gitBinding": {
      "type": "object",
      "required": [
        "path",
        "git_commit",
        "git_blob",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[^:]+$",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "minLength": 1
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "entry_id",
        "identity_statement_sha256",
        "semantic_denotation_sha256",
        "predicate",
        "baseline_status",
        "negative_input_id",
        "auxiliary_input_id",
        "negative_policy",
        "construction_family",
        "strategy",
        "matched_control",
        "competing_obligation_ids",
        "competing_analysis_policy",
        "authority_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string",
          "minLength": 1
        },
        "identity_statement_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 1
        },
        "semantic_denotation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 1
        },
        "predicate": {
          "type": "object",
          "required": [
            "applicability",
            "kind",
            "modeled_judgment_target_profile_pointer",
            "premises",
            "target_premise",
            "violation_expectation"
          ],
          "additionalProperties": false,
          "properties": {
            "applicability": {
              "type": "array"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "modeled_judgment_target_profile_pointer": {
              "type": "string",
              "minLength": 1
            },
            "premises": {
              "type": "array"
            },
            "target_premise": {
              "type": "string",
              "minLength": 1
            },
            "violation_expectation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "baseline_status": {
          "type": "string",
          "minLength": 1
        },
        "negative_input_id": {
          "type": "string",
          "minLength": 1
        },
        "auxiliary_input_id": {
          "type": "string",
          "minLength": 1
        },
        "negative_policy": {
          "type": "string",
          "minLength": 1
        },
        "construction_family": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "object",
          "required": [
            "tier_order",
            "tier_1",
            "tier_2",
            "tier_3",
            "randomness",
            "adaptive_repair",
            "construction_note"
          ],
          "additionalProperties": false,
          "properties": {
            "tier_order": {
              "const": [
                1
              ]
            },
            "tier_1": {
              "type": "string",
              "minLength": 1
            },
            "tier_2": {
              "const": "DISABLED_FOR_THIS_RUN"
            },
            "tier_3": {
              "const": "FORBIDDEN_IN_BOUNDED_PILOT"
            },
            "randomness": {
              "const": "NONE"
            },
            "adaptive_repair": {
              "const": "FORBIDDEN_WITHIN_THIS_RUN"
            },
            "construction_note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "matched_control": {
          "type": "object",
          "required": [
            "declaration_kind",
            "type_expression",
            "proof_expression",
            "must_remain_theorem",
            "must_be_prop_valued",
            "must_have_matching_valid_proof",
            "definition_form_role",
            "matching_contract",
            "minimizes_unrelated_differences",
            "documents_unavoidable_differences",
            "unavoidable_differences"
          ],
          "additionalProperties": false,
          "properties": {
            "declaration_kind": {
              "type": "string",
              "minLength": 1
            },
            "type_expression": {
              "type": "string",
              "minLength": 1
            },
            "proof_expression": {
              "type": "string",
              "minLength": 1
            },
            "must_remain_theorem": {
              "const": true
            },
            "must_be_prop_valued": {
              "const": true
            },
            "must_have_matching_valid_proof": {
              "const": true
            },
            "definition_form_role": {
              "type": "string",
              "minLength": 1
            },
            "matching_contract": {
              "type": "string",
              "minLength": 1
            },
            "minimizes_unrelated_differences": {
              "const": true
            },
            "documents_unavoidable_differences": {
              "const": true
            },
            "unavoidable_differences": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "competing_obligation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "competing_analysis_policy": {
          "type": "string",
          "minLength": 1
        },
        "authority_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "tier_1_candidates",
        "tier_2_candidates",
        "tier_3_candidates",
        "total_candidates",
        "checker_executions",
        "minimization_checks",
        "wall_seconds",
        "candidate_unit",
        "checker_timeout_seconds",
        "checker_accounting",
        "wall_accounting",
        "new_mutants",
        "new_coverage_runs"
      ],
      "additionalProperties": false,
      "properties": {
        "tier_1_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "tier_2_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "tier_3_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "total_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "checker_executions": {
          "type": "integer",
          "minimum": 0
        },
        "minimization_checks": {
          "type": "integer",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_unit": {
          "type": "string",
          "minLength": 1
        },
        "checker_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "checker_accounting": {
          "type": "string",
          "minLength": 1
        },
        "wall_accounting": {
          "type": "string",
          "minLength": 1
        },
        "new_mutants": {
          "const": 0
        },
        "new_coverage_runs": {
          "const": 0
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "observer_ids",
        "observer_policy",
        "order",
        "artifact_freeze_before_feedback",
        "freeze_requirements",
        "expected_observations",
        "outcome_vocabulary",
        "attribution",
        "resume",
        "success_contract",
        "terminal_states",
        "failure_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "observer_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observer_policy": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "string",
          "minLength": 1
        },
        "artifact_freeze_before_feedback": {
          "const": true
        },
        "freeze_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_observations": {
          "type": "object",
          "required": [
            "negative",
            "control"
          ],
          "additionalProperties": false,
          "properties": {
            "negative": {
              "const": "REJECT"
            },
            "control": {
              "const": "ACCEPT"
            }
          }
        },
        "outcome_vocabulary": {
          "const": [
            "ACCEPT",
            "REJECT",
            "DECLINE",
            "CRASH",
            "TIMEOUT",
            "PARSE_ERROR",
            "UNKNOWN"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "resume": {
          "type": "string",
          "minLength": 1
        },
        "success_contract": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terminal_states": {
          "const": [
            "ISOLATED_SUCCESS",
            "BOUNDED_FAILURE_ATTEMPT_OR_TIME_BUDGET_EXHAUSTED",
            "PIPELINE_NOT_REPRESENTABLE_AT_EXECUTION",
            "EXECUTION_UNRESOLVED",
            "ISOLATION_UNRESOLVED"
          ]
        },
        "failure_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
