{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "majority_vote_used", "candidates", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["READY", "EMPTY"]},
    "majority_vote_used": {"const": false},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id", "artifact", "expected_outcome", "expected_evidence",
          "cross_validation", "status"
        ],
        "properties": {
          "expected_outcome": {"enum": ["ACCEPT", "REJECT"]},
          "status": {
            "enum": ["EXPECTED_OUTCOME_ESTABLISHED", "EXPECTED_OUTCOME_ESTABLISHED_WITH_UNRESOLVED_DISAGREEMENT"]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
