{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanassurancelab.invalid/schemas/declaration-validation-decision-log.schema.json",
  "title": "Declaration Validation Milestone 5 Decision Log",
  "type": "object",
  "required": [
    "schema_version", "log_id", "generated_at", "status", "hash_domain",
    "predecessor", "registry", "records", "completion"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "log_id": {"const": "ordinary-declaration-validation.milestone-5-decisions.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "FROZEN_GENERATED_DECISION_LOG"},
    "hash_domain": {"const": "M4_DISCOVERY_CLOSURE_TO_M5_IDENTITY_REGISTRY"},
    "predecessor": {"$ref": "#/$defs/artifactBinding"},
    "registry": {"$ref": "#/$defs/artifactBinding"},
    "records": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "completion": {
      "type": "object",
      "required": ["all_seed_resolutions_recorded", "history_rewritten", "catalog_entries_created"],
      "properties": {
        "all_seed_resolutions_recorded": {"const": true},
        "history_rewritten": {"const": false},
        "catalog_entries_created": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifactBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["seed_keys", "site_ids", "prior_kind_hint", "prior_merge_split"],
      "properties": {
        "seed_keys": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SEED\\.[A-Z0-9_.]+$"}
        },
        "site_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SITE\\.[A-Z0-9_.]+$"}
        },
        "prior_kind_hint": {"enum": ["NORMATIVE_CANDIDATE_OBLIGATION", "EMPIRICAL_CONTRACT_SCENARIO", "UNRESOLVED"]},
        "prior_merge_split": {"enum": ["KEEP", "PROVISIONAL_MERGE", "PROVISIONAL_SPLIT", "DEFER"]}
      },
      "additionalProperties": false
    },
    "resultIdentity": {
      "type": "object",
      "required": ["stable_id", "intended_kind", "identity_status"],
      "properties": {
        "stable_id": {"type": "string", "pattern": "^(DECL|EXPR|SCENARIO)\\.[A-Z0-9_]+(\\.[A-Z0-9_]+)+$"},
        "intended_kind": {"enum": ["NORMATIVE_CANDIDATE_OBLIGATION", "EMPIRICAL_CONTRACT_SCENARIO", null]},
        "identity_status": {"enum": ["ACTIVE_PROVISIONAL", "DEFERRED_KIND", "RESERVED_OUT_OF_SCOPE"]}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["action", "identities"],
      "properties": {
        "action": {"enum": ["KEEP", "MERGE_IMPLEMENTATION_SITES", "SPLIT", "SPLIT_AND_REUSE", "DEFER_AS_DISTINCT", "DEFER_OUT_OF_SCOPE"]},
        "identities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/resultIdentity"}
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id", "role", "source_type", "source_lock", "exact_locator",
        "claim_supported", "assumptions"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^EVID\\.M5\\.DECISION_[0-9]{3}$"},
        "role": {"const": "DISCOVERY"},
        "source_type": {"const": "LAB_EXPERIMENT"},
        "source_lock": {
          "type": "object",
          "required": ["registry", "lock_id"],
          "properties": {
            "registry": {"const": "LOCAL_ARTIFACT_LOCK"},
            "lock_id": {"type": "string", "pattern": "^milestone-4-discovery-closure@sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "exact_locator": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "JSON_POINTER"},
            "value": {"type": "string", "pattern": "^config/declaration-validation-discovery-closure\\.json#/seed_groups/[0-9]+$"}
          },
          "additionalProperties": false
        },
        "claim_supported": {
          "type": "object",
          "required": ["entry_json_pointer", "predicate_id", "proposition"],
          "properties": {
            "entry_json_pointer": {"type": "string", "pattern": "^/records/[0-9]+$"},
            "predicate_id": {"const": "CLAIM.M5.SEED_DISPOSITION"},
            "proposition": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "statement", "status"],
            "properties": {
              "id": {"const": "ASSUMPTION.M4.DISCOVERY_ONLY"},
              "statement": {"type": "string", "minLength": 1},
              "status": {"const": "ACTIVE"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "id", "decision", "inputs", "result", "reason", "evidence",
        "catalog_hash_before", "catalog_hash_after"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^DEC\\.M5\\.[0-9]{3}$"},
        "decision": {"enum": ["KEEP", "MERGE_IMPLEMENTATION_SITES", "SPLIT", "SPLIT_AND_REUSE", "DEFER_AS_DISTINCT", "DEFER_OUT_OF_SCOPE"]},
        "inputs": {"$ref": "#/$defs/input"},
        "result": {"$ref": "#/$defs/result"},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "catalog_hash_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "catalog_hash_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
