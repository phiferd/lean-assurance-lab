{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanassurancelab.invalid/schemas/declaration-validation-evidence-lock.schema.json",
  "title": "Declaration Validation Versioned Evidence-Lock Successor",
  "description": "A versioned, content-addressed successor chain for evidence selected after the frozen Milestone 6 source lock. Each milestone writes a new file rather than mutating a predecessor.",
  "type": "object",
  "required": [
    "schema_version",
    "lock_id",
    "sequence",
    "recorded_at",
    "status",
    "predecessor",
    "normative_documentation",
    "mechanized_results",
    "tracked_evidence",
    "generated_witnesses",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "lock_id": {"type": "string", "pattern": "^ordinary-declaration-validation\\.evidence-lock\\.[a-z0-9.-]+\\.v[0-9]+$"},
    "sequence": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": [
        "MILESTONE_7_EMPTY_EVIDENCE_LOCK",
        "MILESTONE_8_EVIDENCE_SELECTION",
        "MILESTONE_9_PRE_REVIEW_EVIDENCE_FREEZE",
        "MILESTONE_9_REVIEWED_EVIDENCE_FREEZE"
      ]
    },
    "predecessor": {"$ref": "#/$defs/predecessor"},
    "normative_documentation": {
      "type": "array",
      "items": {"$ref": "#/$defs/normativeDocument"}
    },
    "mechanized_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/mechanizedResult"}
    },
    "tracked_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/trackedEvidence"}
    },
    "generated_witnesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/generatedWitness"}
    },
    "nonclaims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "predecessor": {
      "type": "object",
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"enum": ["MILESTONE_6_SOURCE_LOCK", "EVIDENCE_LOCK"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "normativeDocument": {
      "type": "object",
      "required": [
        "id",
        "approved_source_id",
        "document_kind",
        "version_or_edition",
        "stable_url_or_doi",
        "retrieved_path",
        "retrieved_content_sha256",
        "section_anchor_or_page",
        "claim_supported"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^NORMDOC(\\.[A-Z0-9_]+)+$"},
        "approved_source_id": {"type": "string", "pattern": "^APPROVED\\.NORMDOC(\\.[A-Z0-9_]+)+$"},
        "document_kind": {"enum": ["SPECIFICATION", "AUTHORITATIVE_DOCUMENTATION"]},
        "version_or_edition": {"type": "string", "minLength": 1},
        "stable_url_or_doi": {"type": "string", "minLength": 1},
        "retrieved_path": {"type": "string", "minLength": 1},
        "retrieved_content_sha256": {"$ref": "#/$defs/sha256"},
        "section_anchor_or_page": {"type": "string", "minLength": 1},
        "claim_supported": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "mechanizedResult": {
      "type": "object",
      "required": [
        "id",
        "approved_source_id",
        "repository_url",
        "revision",
        "module",
        "theorem_or_definition",
        "path",
        "blob_sha256",
        "retrieved_path",
        "retrieved_content_sha256",
        "assumptions_or_axioms",
        "verification_command",
        "target_judgment_mapping"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^MECH(\\.[A-Z0-9_]+)+$"},
        "approved_source_id": {"type": "string", "pattern": "^APPROVED\\.MECH(\\.[A-Z0-9_]+)+$"},
        "repository_url": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/revision"},
        "module": {"type": "string", "minLength": 1},
        "theorem_or_definition": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "blob_sha256": {"$ref": "#/$defs/sha256"},
        "retrieved_path": {"type": "string", "minLength": 1},
        "retrieved_content_sha256": {"$ref": "#/$defs/sha256"},
        "assumptions_or_axioms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verification_command": {"type": "string", "minLength": 1},
        "target_judgment_mapping": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "trackedEvidence": {
      "type": "object",
      "required": ["id", "path", "file_sha256", "json_pointer_or_case_id", "source_role"],
      "properties": {
        "id": {"type": "string", "pattern": "^LOCAL(\\.[A-Z0-9_]+)+$"},
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "json_pointer_or_case_id": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "generatedWitness": {
      "type": "object",
      "required": ["id", "path", "artifact_sha256", "generator_or_origin", "relevant_case_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^WITNESS(\\.[A-Z0-9_]+)+$"},
        "path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "generator_or_origin": {"type": "string", "minLength": 1},
        "relevant_case_id": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(\\.[A-Z][A-Z0-9_]*)+$"}
        }
      },
      "additionalProperties": false
    }
  }
}
