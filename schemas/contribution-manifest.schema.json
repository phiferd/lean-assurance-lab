{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contribution_type", "title", "summary", "scope", "artifacts", "evidence", "unresolved_states", "type_metadata"],
  "properties": {
    "schema_version": {"const": 1},
    "contribution_type": {"enum": ["validator", "corpus-test", "mutation-operator", "witness-generator", "report", "bug-investigation", "documentation"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_revisions", "configurations", "assumptions", "non_claims"],
      "properties": {
        "exact_revisions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "configurations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/bound_file"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "mechanical_condition"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"$ref": "#/$defs/bound_file"},
          "mechanical_condition": {"type": "string", "minLength": 1}
        }
      }
    },
    "unresolved_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "type_metadata": {"type": "object", "minProperties": 1}
  },
  "$defs": {
    "bound_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 1}
      }
    }
  }
}
