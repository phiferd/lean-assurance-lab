{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanassurancelab.invalid/schemas/declaration-validation-milestone-8-pilot.schema.json",
  "title": "Declaration Validation Milestone 8 Five-Entry Pilot",
  "description": "A separately reviewable candidate batch. It is not the complete Milestone 8 characterization inventory.",
  "type": "object",
  "required": [
    "schema_version",
    "pilot_id",
    "recorded_at",
    "status",
    "predecessor_catalog",
    "artifact_bindings",
    "selection",
    "candidate_ids",
    "entries",
    "review_requirements",
    "stop_condition",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pilot_id": {"const": "ordinary-declaration-validation.milestone-8-pilot.v1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "status": {"const": "MILESTONE_8_FIVE_ENTRY_PILOT_AWAITING_REVIEW"},
    "predecessor_catalog": {"$ref": "#/$defs/fileBinding"},
    "artifact_bindings": {
      "type": "object",
      "required": [
        "authority_rules",
        "catalog_schema",
        "characterization_model",
        "entry_schema",
        "evidence_lock",
        "evidence_lock_schema",
        "identity_registry",
        "semantic_target",
        "source_lock"
      ],
      "properties": {
        "authority_rules": {"$ref": "#/$defs/fileBinding"},
        "catalog_schema": {"$ref": "#/$defs/fileBinding"},
        "characterization_model": {"$ref": "#/$defs/fileBinding"},
        "entry_schema": {"$ref": "#/$defs/fileBinding"},
        "evidence_lock": {"$ref": "#/$defs/fileBinding"},
        "evidence_lock_schema": {"$ref": "#/$defs/fileBinding"},
        "identity_registry": {"$ref": "#/$defs/fileBinding"},
        "semantic_target": {"$ref": "#/$defs/fileBinding"},
        "source_lock": {"$ref": "#/$defs/fileBinding"}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["method", "coverage", "exclusions"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "coverage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "candidate_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/semanticId"}
    },
    "entries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"type": "object"}
    },
    "review_requirements": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_condition": {"type": "string", "minLength": 1},
    "nonclaims": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semanticId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(\\.[A-Z][A-Z0-9_]*)+$"},
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
