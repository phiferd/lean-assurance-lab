{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "experiment_id", "fold_id", "status", "classification", "original_corpus_evaluation", "augmented_corpus_evaluation", "score", "candidate_evaluation", "control_evaluation", "feedback_boundary", "source_restored", "costs"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "COMPLETE"},
    "classification": {"enum": ["POSITIVE", "NEUTRAL", "NEGATIVE", "INCONCLUSIVE", "INCOMPATIBLE", "UNRESOLVED"]},
    "score": {
      "type": "object",
      "required": ["mutant_count", "original_killed", "augmented_killed", "original_score", "augmented_score", "score_change"]
    },
    "source_restored": {"const": true}
  }
}
