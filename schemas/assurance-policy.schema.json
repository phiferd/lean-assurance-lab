{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "description", "hard_gates", "trend_thresholds"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "hard_gates": {
      "type": "object",
      "required": ["baseline_identity", "complete_result_inventories", "semantic_checker_disagreements", "regression_expected_outcomes", "artifact_freshness"],
      "additionalProperties": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"const": true}}}
    },
    "trend_thresholds": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled_as_gate", "minimum", "context"],
        "properties": {
          "enabled_as_gate": {"const": false},
          "minimum": {"type": ["number", "null"]},
          "context": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
