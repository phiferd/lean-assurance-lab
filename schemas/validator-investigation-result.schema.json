{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "created_at", "status", "classification",
    "artifact", "positive_control", "validators", "mechanical_predicate",
    "expected_semantics", "scope", "producer"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["CONFIRMED", "NOT_REPRODUCED", "UNRESOLVED"]},
    "classification": {"enum": ["CURRENT_UPSTREAM_DISAGREEMENT", "NO_CURRENT_DISAGREEMENT", "UNRESOLVED"]},
    "artifact": {"$ref": "#/$defs/bound_file"},
    "positive_control": {"$ref": "#/$defs/bound_file"},
    "validators": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "revision", "binary_sha256", "artifact_result", "control_result"]
      }
    },
    "mechanical_predicate": {
      "type": "object",
      "required": ["expression", "satisfied"],
      "properties": {"satisfied": {"type": "boolean"}}
    },
    "expected_semantics": {"type": "object", "minProperties": 1},
    "scope": {"type": "object", "minProperties": 1},
    "producer": {"$ref": "#/$defs/bound_file"}
  },
  "$defs": {
    "bound_file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
