#!/usr/bin/env python3
"""Validate the complete source-bound Kiota recursor-type design package."""
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import kiota_recursor_type_design as design  # noqa: E402


try:
    print(json.dumps(design.validate(ROOT), sort_keys=True))
except (OSError, ValueError) as error:
    print("Kiota recursor-type design validation failed: " + str(error), file=sys.stderr)
    raise SystemExit(2)
