#!/usr/bin/env python3
"""Freeze or validate the committed Stage-2 construction tooling."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import acceptance_impact_stage2 as stage2  # noqa: E402

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("action", choices=("freeze", "validate"))
args = parser.parse_args()
try:
    result = (stage2.freeze_tooling_manifest(ROOT) if args.action == "freeze"
              else stage2.validate_tooling_manifest(ROOT, require_commit=True))
    print(json.dumps(result, sort_keys=True))
except (OSError, ValueError) as error:
    print("Stage-2 preparation refused: " + str(error), file=sys.stderr)
    raise SystemExit(2)
