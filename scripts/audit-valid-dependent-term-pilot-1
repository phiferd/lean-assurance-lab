#!/usr/bin/env python3
"""Audit development cases or an exact dependent-term pilot corpus offline."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib.valid_dependent_term_audit import AuditError, audit_case_file, audit_corpus


def load_design(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("paths", nargs="+", type=Path)
    parser.add_argument("--design", type=Path,
                        default=ROOT / "results/research/valid-dependent-term-pilot-1/design.json")
    parser.add_argument("--corpus", action="store_true",
                        help="require exact complete corpus count, order, and uniqueness")
    args = parser.parse_args()
    try:
        design = load_design(args.design)
        result = audit_corpus(args.paths, design) if args.corpus else {
            "status": "PASS", "cases": [audit_case_file(path, design) for path in args.paths]}
    except (AuditError, OSError, UnicodeError, json.JSONDecodeError) as error:
        code = error.code if isinstance(error, AuditError) else "E_INPUT"
        print(json.dumps({"status": "FAIL", "code": code, "message": str(error)},
                         sort_keys=True, separators=(",", ":")))
        return 1
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
