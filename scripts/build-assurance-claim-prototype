#!/usr/bin/env python3
"""Build the falsification-first two-kind assurance-claim prototype."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
OUTPUT = ROOT / "results" / "research" / "assurance-claim-prototype.json"

EQ_CANDIDATE = Path(
    "corpus/generated/nanoda-gen-d39c873fbcb7-quot-eq-type-candidate.ndjson"
)
EQ_CONTROL = Path(
    "corpus/generated/nanoda-gen-d39c873fbcb7-quot-eq-type-control.ndjson"
)
UNSAFE_ONLY_CANDIDATE = Path("corpus/generated/axiom-unsafe-only-candidate.ndjson")
UNSAFE_ONLY_CONTROL = Path("corpus/generated/axiom-unsafe-only-control.ndjson")
UNSAFE_DEPENDENT_CANDIDATE = Path("corpus/generated/axiom-unsafe-candidate.ndjson")
UNSAFE_DEPENDENT_CONTROL = Path("corpus/generated/axiom-unsafe-control.ndjson")

EXPECTED_HASHES = {
    EQ_CANDIDATE: "777475027a53b84836a95eb4758f49fc0aa90923f72e511a48c88fff4a1e32a2",
    EQ_CONTROL: "fdb1b6085c32d29a27ef9aa531bb10dabe8560f6f58efbe1ccfb817b5e329d21",
    UNSAFE_ONLY_CANDIDATE: "347d348ebe8da9b95d17fbd4b8c1120bbcfe8f0b87d24ccf9fd17081706c28ae",
    UNSAFE_ONLY_CONTROL: "0e168c8e62593327c2a1634c9c966c8dff60c6bcf0a80a5d2e3c902334f2520f",
    UNSAFE_DEPENDENT_CANDIDATE: "203e7e41eb4e9e9d8b34bb1f4daa2bfc4032496979779a82e7c624375b66c4c4",
    UNSAFE_DEPENDENT_CONTROL: "b3d5e6f1f6e45721973e4e7167fbe0a92abbdcd69f039112eac70ab25c028acc",
}

EQ_CROSS = Path(
    "results/cross-validation/nanoda-gen-d39c873fbcb7-quot-eq-type/results.json"
)
EQ_EXPECTED = Path(
    "results/expected-outcomes/nanoda-gen-d39c873fbcb7-quot-eq-type.json"
)
EQ_NANODA = Path("results/investigations/nanoda-quot-eq-type/max1-reproduction.json")
EQ_NANODA_CONTROL = Path(
    "results/investigations/nanoda-quot-eq-type/control-reproduction.json"
)
EQ_REMAP = Path(
    "results/investigations/nanoda-quot-eq-type/remap-audit-2026-08-28.json"
)
EQ_MUTATION = Path("mutations/nanoda-gen-d39c873fbcb7.json")

UNSAFE_ONLY_CROSS = Path("results/cross-validation/axiom-unsafe-only/results.json")
UNSAFE_ONLY_EXPECTED = Path("results/expected-outcomes/axiom-unsafe-only.json")
UNSAFE_ONLY_NANODA = Path(
    "results/investigations/nanoda-axiom-unsafe/axiom-only-nanoda-pair.json"
)
UNSAFE_DEPENDENT_CROSS = Path("results/cross-validation/axiom-unsafe-flag/results.json")
UNSAFE_DEPENDENT_EXPECTED = Path("results/expected-outcomes/axiom-unsafe-flag.json")
UNSAFE_DEPENDENT_NANODA = Path(
    "results/investigations/nanoda-axiom-unsafe/nanoda-pair.json"
)
UNSAFE_MATERIALIZATION = Path(
    "results/investigations/nanoda-axiom-unsafe/materialization.json"
)
UNSAFE_CURRENT_KIOTA = Path(
    "results/investigations/nanoda-axiom-unsafe/kiota-upstream-main.json"
)


def load_json(path: Path) -> dict:
    return json.loads((ROOT / path).read_text(encoding="utf-8"))


def sha256(path: Path) -> str:
    return hashlib.sha256((ROOT / path).read_bytes()).hexdigest()


def evidence_ref(path: Path) -> dict[str, str]:
    return {"path": str(path), "sha256": sha256(path)}


def load_ndjson(path: Path) -> list[dict]:
    return [
        json.loads(line)
        for line in (ROOT / path).read_text(encoding="utf-8").splitlines()
        if line
    ]


def identity_projection(identity: dict) -> dict:
    return {
        "arena_revision": identity.get("arena_revision", "UNKNOWN"),
        "binary_sha256": identity.get("binary_sha256", "UNKNOWN"),
        "implementation_family": identity.get("implementation_family", "UNKNOWN"),
        "source_revision": identity.get("source_revision", "NOT_RECORDED"),
        "version": identity.get("version", "UNKNOWN"),
    }


def cross_vector(path: Path, attribution: dict[str, str]) -> dict[str, dict]:
    data = load_json(path)
    vector = {}
    for row in data["validators"]:
        checker = row["checker"]
        vector[checker] = {
            "attribution": attribution[checker],
            "candidate": row["result"]["normalized_outcome"],
            "classification": row["classification"],
            "control": row["positive_control"]["result"]["normalized_outcome"],
            "identity": identity_projection(row["compatibility"]["checker_identity"]),
            "stage": row["result"]["parse_behavior"],
        }
    return vector


def nanoda_pair_observation(path: Path, attribution: str, stage: str) -> dict:
    data = load_json(path)
    checker = data["checker"]
    return {
        "attribution": attribution,
        "candidate": data["candidate"]["result"]["normalized_outcome"],
        "classification": "SUBJECT_CHARACTERIZATION",
        "control": data["control"]["result"]["normalized_outcome"],
        "identity": {
            "binary_sha256": checker["binary_sha256"],
            "config_sha256": checker["config_sha256"],
            "implementation_family": "nanoda-rust",
            "source_revision": checker.get("source_revision", "NOT_RECORDED"),
            "version": "arena-pinned-binary",
        },
        "stage": stage,
    }


def unsafe_change_is_isolated(candidate: Path, control: Path) -> bool:
    candidate_rows = load_ndjson(candidate)
    control_rows = load_ndjson(control)
    if len(candidate_rows) != len(control_rows):
        return False
    differences = []
    for index, (candidate_row, control_row) in enumerate(
        zip(candidate_rows, control_rows, strict=True)
    ):
        if candidate_row != control_row:
            differences.append((index, candidate_row, control_row))
    if len(differences) != 1:
        return False
    _, candidate_row, control_row = differences[0]
    return (
        candidate_row == {"axiom": {**control_row["axiom"], "isUnsafe": True}}
        and control_row["axiom"]["isUnsafe"] is False
    )


def all_controls_accept(claims: list[dict]) -> bool:
    return all(
        observation["control"] == "ACCEPT"
        for claim in claims
        for observation in claim["observations"].values()
    )


def has_forbidden_aggregate_key(value: object) -> bool:
    if isinstance(value, dict):
        forbidden = {"aggregate", "count", "majority", "score", "vote"}
        return any(
            key.lower() in forbidden or has_forbidden_aggregate_key(child)
            for key, child in value.items()
        )
    if isinstance(value, list):
        return any(has_forbidden_aggregate_key(child) for child in value)
    return False


def main() -> int:
    artifact_hashes_match = all(
        sha256(path) == digest for path, digest in EXPECTED_HASHES.items()
    )

    eq_cross = load_json(EQ_CROSS)
    eq_expected = load_json(EQ_EXPECTED)
    eq_nanoda = load_json(EQ_NANODA)
    eq_nanoda_control = load_json(EQ_NANODA_CONTROL)
    eq_mutation = load_json(EQ_MUTATION)
    eq_vector = cross_vector(
        EQ_CROSS,
        {
            "official": "DIAGNOSTIC_SUPPORT",
            "kiota": "NOT_APPLICABLE_ACCEPTED",
            "lean4lean": "DIAGNOSTIC_SUPPORT",
        },
    )
    eq_vector["nanoda"] = {
        "attribution": "ISOLATED_BY_OMISSION_DIFFERENTIAL",
        "candidate": eq_nanoda["baseline"]["normalized_outcome"],
        "classification": "SUBJECT_CHARACTERIZATION",
        "control": eq_nanoda_control["baseline"]["normalized_outcome"],
        "identity": {
            "binary_sha256": "UNKNOWN",
            "config_sha256": "UNKNOWN",
            "implementation_family": "nanoda-rust",
            "source_revision": "NOT_RECORDED",
            "version": "NOT_RECORDED",
        },
        "stage": "TARGET_ASSERTION_REACHED",
    }

    eq_claim = {
        "authority": {
            "basis": "DESIGNATED_REFERENCE_PLUS_MULTI_IMPLEMENTATION_CHARACTERIZATION",
            "criterion": (
                "Pinned official reference rejects an exact candidate whose control it "
                "accepts; Nanoda and Lean4Lean corroborate while compatible Kiota disagrees."
            ),
            "status": eq_cross["semantic_status"],
        },
        "evidence": [
            evidence_ref(EQ_CANDIDATE),
            evidence_ref(EQ_CONTROL),
            evidence_ref(EQ_EXPECTED),
            evidence_ref(EQ_CROSS),
            evidence_ref(EQ_NANODA),
            evidence_ref(EQ_NANODA_CONTROL),
            evidence_ref(EQ_REMAP),
            evidence_ref(EQ_MUTATION),
        ],
        "id": "quotient.eq.result-universe-prerequisite",
        "isolation": {
            "competing_violations": "NONE_KNOWN_IN_BOUNDED_REMAP_AUDIT",
            "per_observer": {
                checker: observation["attribution"]
                for checker, observation in eq_vector.items()
            },
            "target_violation": "ESTABLISHED_FOR_TESTED_RESULT_UNIVERSE_DEVIATION",
        },
        "kind": "NORMATIVE_CANDIDATE_OBLIGATION",
        "layers": ["KERNEL_EXTENSION_INITIALIZATION"],
        "observations": eq_vector,
        "recommendation": {
            "action": "Factor the remaining adjacent Eq prerequisite before any external report.",
            "evidence": str(EQ_CROSS),
            "prerequisites": [
                "Preserve compatible Kiota disagreement.",
                "Do not promote to formal-spec authority without a formal or documented source.",
            ],
            "priority": "RESEARCH_FRONTIER_AFTER_MODEL_GATE",
            "target": "Lean Assurance Lab quotient contract investigation",
        },
        "statement": {
            "applicability": [
                "Quotient support is initialized from the tested built-in declaration graph.",
                "Canonical Quot and Quot.mk prerequisites have already passed in Nanoda.",
            ],
            "expected_effect": {
                "outcome": eq_expected["expected_outcome"],
                "scope": "DESIGNATED_OFFICIAL_REFERENCE",
            },
            "judgment": "Initialize quotient support from built-in Eq and quotient declarations.",
            "premises": [
                "Eq preserves the canonical parameter domain and constructor telescope.",
                "The canonical quotient suffix is remapped to the candidate Eq graph.",
            ],
            "target_premise": "The tested built-in Eq result is proposition-valued.",
        },
        "unknowns": [
            "Formal or documented semantic authority for the complete built-in Eq contract.",
            "Exact Nanoda revision, binary, and configuration for the preserved differential run.",
            "Whether compatible Kiota reaches or reconstructs the same prerequisite.",
        ],
    }

    unsafe_only_vector = cross_vector(
        UNSAFE_ONLY_CROSS,
        {
            "official": "PROCESS_ACCEPTED_ADMISSION_UNKNOWN",
            "kiota": "PROCESS_ACCEPTED_ADMISSION_UNKNOWN",
            "lean4lean": "PROCESS_ACCEPTED_ADMISSION_UNKNOWN",
        },
    )
    unsafe_only_vector["nanoda"] = nanoda_pair_observation(
        UNSAFE_ONLY_NANODA,
        "ISOLATED_SERIALIZED_FLAG_REJECTION",
        "PARSER_ASSERTION",
    )

    ingestion_claim = {
        "authority": {
            "basis": "REVISION_SCOPED_MULTI_IMPLEMENTATION_CHARACTERIZATION",
            "criterion": (
                "Exact one-field candidate/control pair with pinned external vectors and a "
                "revision/configuration-bound Nanoda parser result."
            ),
            "status": "EMPIRICALLY_CHARACTERIZED",
        },
        "evidence": [
            evidence_ref(UNSAFE_ONLY_CANDIDATE),
            evidence_ref(UNSAFE_ONLY_CONTROL),
            evidence_ref(UNSAFE_MATERIALIZATION),
            evidence_ref(UNSAFE_ONLY_EXPECTED),
            evidence_ref(UNSAFE_ONLY_CROSS),
            evidence_ref(UNSAFE_ONLY_NANODA),
        ],
        "id": "serialized-unsafe-axiom.ingestion",
        "isolation": {
            "competing_violations": "NONE_IN_ONE_FIELD_ARTIFACT_DIFF",
            "per_observer": {
                checker: observation["attribution"]
                for checker, observation in unsafe_only_vector.items()
            },
            "target_violation": "SERIALIZED_FLAG_CHANGE_ESTABLISHED",
        },
        "kind": "EMPIRICAL_CONTRACT_SCENARIO",
        "layers": ["SERIALIZATION", "PARSER", "RECONSTRUCTION"],
        "observations": unsafe_only_vector,
        "recommendation": {
            "action": "Measure post-ingestion environment visibility before assigning admit or skip semantics.",
            "evidence": str(UNSAFE_ONLY_CROSS),
            "prerequisites": ["Use dependent probes and exact checker revisions."],
            "priority": "ACTIVE_FRONTIER",
            "target": "F-AXIOM-UNSAFE-DECLARATIONS",
        },
        "statement": {
            "observation_points": [
                "process outcome",
                "parser rejection stage",
                "post-import environment visibility (not observed by this standalone probe)",
            ],
            "precondition": "The matched isUnsafe=false axiom artifact is accepted.",
            "profile_specific_effects": "See the complete observations vector; no common expected effect is asserted.",
            "stimulus": "Change only the serialized axiom isUnsafe field from false to true.",
            "subject_scope": "Pinned official, Nanoda, Lean4Lean, and Kiota importer profiles.",
        },
        "unknowns": [
            "Whether process-level acceptance admits, skips, or otherwise hides the axiom.",
            "Authoritative implementation-independent export contract for serialized isUnsafe.",
        ],
    }

    unsafe_dependent_vector = cross_vector(
        UNSAFE_DEPENDENT_CROSS,
        {
            "official": "ENVIRONMENT_NON_VISIBILITY_ESTABLISHED_MECHANISM_UNKNOWN",
            "kiota": "DEPENDENT_USE_ACCEPTED",
            "lean4lean": "ENVIRONMENT_NON_VISIBILITY_ESTABLISHED_MECHANISM_UNKNOWN",
        },
    )
    unsafe_dependent_vector["nanoda"] = nanoda_pair_observation(
        UNSAFE_DEPENDENT_NANODA,
        "EARLY_SERIALIZED_FLAG_REJECTION",
        "PARSER_ASSERTION",
    )
    current_kiota = load_json(UNSAFE_CURRENT_KIOTA)
    current_kiota_row = next(
        row for row in current_kiota["validators"] if row["id"] == "kiota-upstream-main"
    )
    unsafe_dependent_vector["kiota_current"] = {
        "attribution": "DIRECT_UNSAFE_AXIOM_REJECTION",
        "candidate": current_kiota_row["candidate_result"]["normalized_outcome"],
        "classification": current_kiota["classification"],
        "control": current_kiota_row["control_result"]["normalized_outcome"],
        "identity": {
            "binary_sha256": current_kiota_row["binary_sha256"],
            "implementation_family": "kiota-rust",
            "source_revision": current_kiota_row["revision"],
            "version": "upstream-main-reproduction",
        },
        "stage": "UNSAFE_AXIOM_POLICY",
    }

    dependent_claim = {
        "authority": {
            "basis": "REVISION_SCOPED_STATEFUL_CHARACTERIZATION",
            "criterion": (
                "The same one-field change is followed by a safe dependent declaration; "
                "diagnostics and revision-bound runs expose visibility and rejection stages."
            ),
            "status": "EMPIRICALLY_CHARACTERIZED_REVISION_SENSITIVE",
        },
        "evidence": [
            evidence_ref(UNSAFE_DEPENDENT_CANDIDATE),
            evidence_ref(UNSAFE_DEPENDENT_CONTROL),
            evidence_ref(UNSAFE_MATERIALIZATION),
            evidence_ref(UNSAFE_DEPENDENT_EXPECTED),
            evidence_ref(UNSAFE_DEPENDENT_CROSS),
            evidence_ref(UNSAFE_DEPENDENT_NANODA),
            evidence_ref(UNSAFE_CURRENT_KIOTA),
        ],
        "id": "serialized-unsafe-axiom.dependent-visibility",
        "isolation": {
            "competing_violations": (
                "TARGET_FIELD_ISOLATED_BUT_REJECTION_STAGE_DIFFERS_BY_PROFILE"
            ),
            "per_observer": {
                checker: observation["attribution"]
                for checker, observation in unsafe_dependent_vector.items()
            },
            "target_violation": "SERIALIZED_FLAG_CHANGE_ESTABLISHED",
        },
        "kind": "EMPIRICAL_CONTRACT_SCENARIO",
        "layers": [
            "SERIALIZATION",
            "TRUST_POLICY",
            "ENVIRONMENT_RECONSTRUCTION",
            "DEPENDENT_USE",
        ],
        "observations": unsafe_dependent_vector,
        "recommendation": {
            "action": "Complete the configuration cross-product with probes that distinguish reject, non-visible, and visible states.",
            "evidence": str(UNSAFE_DEPENDENT_CROSS),
            "prerequisites": [
                "Bind every checker revision and configuration.",
                "Keep parser, policy, environment visibility, and dependent use separate.",
            ],
            "priority": "ACTIVE_FRONTIER",
            "target": "F-AXIOM-UNSAFE-DECLARATIONS",
        },
        "statement": {
            "observation_points": [
                "unsafe axiom ingestion",
                "environment visibility",
                "safe dependent declaration checking",
                "final process outcome",
            ],
            "precondition": "The matched isUnsafe=false axiom and dependent definition are accepted.",
            "profile_specific_effects": "See the revision-scoped observations vector; no common expected effect is asserted.",
            "stimulus": "Change only the axiom isUnsafe field, then import a safe declaration that depends on it.",
            "subject_scope": "Pinned cohort plus a separately recorded current Kiota revision.",
        },
        "unknowns": [
            "Exact admit/skip/reject transition for accepting standalone profiles.",
            "Nanoda behavior under permit-all, whitelist, hard-error, and skip configurations.",
            "Implementation-independent authority for the serialized safety flag.",
        ],
    }

    claims = [eq_claim, ingestion_claim, dependent_claim]
    expected_eq_vector = {
        "official": "REJECT",
        "nanoda": "REJECT",
        "lean4lean": "REJECT",
        "kiota": "ACCEPT",
    }
    expected_unsafe_only_vector = {
        "official": "ACCEPT",
        "nanoda": "REJECT",
        "lean4lean": "ACCEPT",
        "kiota": "ACCEPT",
    }
    expected_unsafe_dependent_vector = {
        "official": "REJECT",
        "nanoda": "REJECT",
        "lean4lean": "REJECT",
        "kiota": "ACCEPT",
        "kiota_current": "REJECT",
    }

    statement_shapes = {
        "EMPIRICAL_CONTRACT_SCENARIO": [
            "subject_scope",
            "precondition",
            "stimulus",
            "observation_points",
            "profile_specific_effects",
        ],
        "NORMATIVE_CANDIDATE_OBLIGATION": [
            "judgment",
            "applicability",
            "premises",
            "target_premise",
            "expected_effect",
        ],
    }
    common_dimensions = [
        "id",
        "kind",
        "layers",
        "authority",
        "statement",
        "evidence",
        "observations",
        "isolation",
        "unknowns",
        "recommendation",
    ]

    checks = {
        "artifact_hashes_match": artifact_hashes_match,
        "both_claim_kinds_exercised": {claim["kind"] for claim in claims}
        == {"NORMATIVE_CANDIDATE_OBLIGATION", "EMPIRICAL_CONTRACT_SCENARIO"},
        "claim_shapes_match_kind": all(
            all(dimension in claim for dimension in common_dimensions)
            and set(claim["statement"]) == set(statement_shapes[claim["kind"]])
            for claim in claims
        ),
        "complete_vectors_preserved": (
            {key: row["candidate"] for key, row in eq_vector.items()}
            == expected_eq_vector
            and {key: row["candidate"] for key, row in unsafe_only_vector.items()}
            == expected_unsafe_only_vector
            and {key: row["candidate"] for key, row in unsafe_dependent_vector.items()}
            == expected_unsafe_dependent_vector
        ),
        "controls_accept_for_every_observation": all_controls_accept(claims),
        "eq_expected_outcome_is_reference_reject": (
            eq_expected["expected_outcome"] == "REJECT"
            and eq_cross["semantic_status"] == "UNRESOLVED"
        ),
        "eq_nanoda_target_isolated": (
            eq_nanoda["baseline"]["normalized_outcome"] == "REJECT"
            and eq_nanoda["mutant"]["normalized_outcome"] == "ACCEPT"
            and eq_nanoda_control["baseline"]["normalized_outcome"] == "ACCEPT"
            and eq_nanoda_control["mutant"]["normalized_outcome"] == "ACCEPT"
            and eq_mutation["source_file"] == "src/quot.rs"
            and eq_mutation["source_span"] == "89"
        ),
        "evidence_payloads_linked_not_copied": all(
            set(ref) == {"path", "sha256"}
            for claim in claims
            for ref in claim["evidence"]
        ),
        "isunsafe_decomposed_into_stateful_scenarios": (
            ingestion_claim["id"] != dependent_claim["id"]
            and ingestion_claim["statement"]["observation_points"]
            != dependent_claim["statement"]["observation_points"]
        ),
        "isunsafe_field_change_isolated_in_both_pairs": (
            unsafe_change_is_isolated(UNSAFE_ONLY_CANDIDATE, UNSAFE_ONLY_CONTROL)
            and unsafe_change_is_isolated(
                UNSAFE_DEPENDENT_CANDIDATE, UNSAFE_DEPENDENT_CONTROL
            )
        ),
        "no_aggregate_semantic_oracle": not any(
            has_forbidden_aggregate_key(claim) for claim in claims
        ),
        "recommendations_are_actionable": all(
            set(claim["recommendation"])
            == {"action", "evidence", "prerequisites", "priority", "target"}
            and claim["recommendation"]["prerequisites"]
            for claim in claims
        ),
        "unknowns_preserved_for_every_claim": all(
            claim["unknowns"] for claim in claims
        ),
    }
    status = "PASS" if all(checks.values()) else "FAIL"
    report = {
        "checks": checks,
        "claims": claims,
        "gate_decision": {
            "next_step": (
                "FACTOR_REMAINING_THREE_CASES"
                if status == "PASS"
                else "REFINE_OR_REJECT_TWO_KIND_MODEL"
            ),
            "rationale": (
                "The quotient Eq calibration fits a bounded normative-candidate obligation, "
                "while isUnsafe is representable only after decomposition into empirical "
                "ingestion and dependent-visibility scenarios."
            ),
            "status": status,
        },
        "model": {
            "claim_kinds": {
                "EMPIRICAL_CONTRACT_SCENARIO": {
                    "statement_shape": statement_shapes["EMPIRICAL_CONTRACT_SCENARIO"]
                },
                "NORMATIVE_CANDIDATE_OBLIGATION": {
                    "statement_shape": statement_shapes[
                        "NORMATIVE_CANDIDATE_OBLIGATION"
                    ]
                },
            },
            "common_dimensions": common_dimensions,
            "evidence_policy": {
                "aggregate_counts_are_semantic_evidence": False,
                "authority_is_separate_from_layer": True,
                "evidence_payloads_are_content_addressed_references": True,
                "isolation_is_per_observer": True,
                "unknown_is_representable": True,
            },
            "status": "RESEARCH_ONLY_NOT_A_PRODUCTION_SCHEMA",
        },
        "prototype_id": "two-kind-assurance-claim-falsification-gate",
        "schema_version": 1,
        "scope": (
            "Falsification-first Phase 2 gate over quotient Eq and decomposed isUnsafe only; "
            "not a semantic denominator, conformance claim, or production schema."
        ),
        "status": status,
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    print(
        json.dumps(
            {
                "checks": checks,
                "output": str(OUTPUT.relative_to(ROOT)),
                "status": status,
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0 if status == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
