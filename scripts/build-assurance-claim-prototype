            "The exact Nanoda source revision is not recorded by the pair file.",
        ],
    }

    universe_cross = load_json(UNIVERSE_CROSS)
    universe_expected = load_json(UNIVERSE_EXPECTED)
    universe_witness = load_json(UNIVERSE_WITNESS)
    universe_vector = cross_vector(
        UNIVERSE_CROSS,
        {
            "official": "DIAGNOSTIC_SUPPORT",
            "kiota": "UNRESOLVED_ACCEPTANCE_DISAGREEMENT",
            "lean4lean": "COMPATIBLE_REJECTION_NOT_INSTRUMENTED",
        },
    )
    universe_predicate = next(
        row
        for row in universe_witness["final_predicate_checks"]
        if row["artifact_sha256"] == EXPECTED_HASHES[UNIVERSE_CANDIDATE]
    )
    universe_vector["nanoda"] = {
        "attribution": "TARGET_ASSERTION_OMISSION_DIFFERENTIAL",
        "candidate": universe_predicate["baseline"]["normalized_outcome"],
        "classification": "SUBJECT_CHARACTERIZATION_WITH_PROVENANCE_GAP",
        "control": "NOT_DURABLY_LINKED",
        "identity": {
            "binary_sha256": "UNKNOWN",
            "config_sha256": "UNKNOWN",
            "implementation_family": "nanoda-rust",
            "source_revision": "NOT_RECORDED",
            "version": "NOT_RECORDED",
        },
        "stage": "UNIVERSE_OWNERSHIP_ASSERTION",
    }
    universe_claim = {
        "authority": {
            "basis": "DESIGNATED_REFERENCE_PLUS_MULTI_IMPLEMENTATION_CHARACTERIZATION",
            "criterion": (
                "The designated official reference rejects the exact candidate and accepts "
                "its declared-universe control; Nanoda and Lean4Lean corroborate candidate "
                "rejection while compatible Kiota accepts both."
            ),
            "status": universe_cross["semantic_status"],
        },
        "evidence": [
            evidence_ref(UNIVERSE_CANDIDATE),
            evidence_ref(UNIVERSE_CONTROL),
            evidence_ref(UNIVERSE_EXPECTED),
            evidence_ref(UNIVERSE_CROSS),
            evidence_ref(UNIVERSE_MUTATION),
            evidence_ref(UNIVERSE_WITNESS),
            evidence_ref(UNIVERSE_CONFIRMATION),
            evidence_ref(UNIVERSE_INVESTIGATION),
        ],
        "id": "declaration.constant-reference-universe-ownership",
        "isolation": {
            "competing_violations": (
                "NONE_KNOWN; PAIR_ALSO_USES_A_BENIGN_DECLARATION_RENAME"
            ),
            "per_observer": {
                checker: observation["attribution"]
                for checker, observation in universe_vector.items()
            },
            "target_violation": "ESTABLISHED_FOR_TESTED_UNDECLARED_UNIVERSE_REFERENCE",
        },
        "kind": "NORMATIVE_CANDIDATE_OBLIGATION",
        "layers": ["DECLARATION_ENVIRONMENT_WELL_FORMEDNESS"],
        "observations": universe_vector,
        "recommendation": {
            "action": "Await the existing Kiota adjudication and preserve the checker disagreement without a semantic vote.",
            "evidence": str(UNIVERSE_INVESTIGATION),
            "prerequisites": [
                "Kiota issue #3 maintainer guidance.",
                "Do not infer missing Nanoda revision/configuration from the present checkout.",
            ],
            "priority": "WAITING_UPSTREAM",
            "target": "W-KIOTA-UNIVERSES",
        },
        "statement": {
            "applicability": [
                "A declaration value contains a reference to a previously declared constant.",
                "That constant reference is instantiated with universe parameters.",
            ],
            "expected_effect": {
                "outcome": universe_expected["expected_outcome"],
                "scope": "DESIGNATED_OFFICIAL_REFERENCE",
            },
            "judgment": "Check a declaration against the universe parameters it owns.",
            "premises": [
                "The referenced constant exists and accepts the supplied universe arity.",
                "The containing declaration declares its permitted universe parameters.",
            ],
            "target_premise": (
                "Every universe parameter supplied to the constant reference belongs to "
                "the containing declaration's declared universe parameters."
            ),
        },
        "unknowns": [
            "Semantic authority remains unresolved across compatible implementations.",
            "The old Nanoda differential does not bind revision, binary, or configuration.",
            "A Nanoda run of the matched control is asserted in prior analysis but is not durably linked by the selected machine records.",
        ],
    }

    quot_type_cross = load_json(QUOT_TYPE_CROSS)
    quot_type_vector = cross_vector(
        QUOT_TYPE_CROSS,
        {
            "official": "EXACT_ACCEPTANCE_FIELD_TREATMENT_UNKNOWN",
            "kiota": "EXACT_ACCEPTANCE_FIELD_TREATMENT_UNKNOWN",
            "lean4lean": "EXACT_ACCEPTANCE_FIELD_TREATMENT_UNKNOWN",
        },
    )
    quot_type_vector["nanoda"] = unbound_nanoda_differential_observation(
        QUOT_TYPE_NANODA,
        QUOT_TYPE_NANODA_CONTROL,
        "EXACT_TYPE_ASSERTION_OMISSION_DIFFERENTIAL",
        "SERIALIZED_QUOT_TYPE_ASSERTION",
    )
    quot_type_claim = {
        "authority": {
            "basis": "REVISION_SCOPED_MULTI_IMPLEMENTATION_CHARACTERIZATION",
            "criterion": (
                "The designated official reference, Kiota, and Lean4Lean accept the exact "
                "one-field deviation and control, while Nanoda's baseline rejection is "
                "isolated by omission of its exact-type assertion."
            ),
            "status": "EMPIRICALLY_CHARACTERIZED_REFERENCE_ALIGNED",
        },
        "evidence": [
            evidence_ref(QUOT_TYPE_CANDIDATE),
            evidence_ref(QUOT_TYPE_CONTROL),
            evidence_ref(QUOT_TYPE_EXPECTED),
            evidence_ref(QUOT_TYPE_CROSS),
            evidence_ref(QUOT_TYPE_NANODA),
            evidence_ref(QUOT_TYPE_NANODA_CONTROL),
            evidence_ref(QUOT_TYPE_MUTATION),
            evidence_ref(QUOT_TYPE_INVESTIGATION),
        ],
        "id": "serialized-quotient.base-type-treatment",
        "isolation": {
            "competing_violations": "EARLIER_EXPORT_SHAPE_CONFOUND_REMOVED_IN_FINAL_73_RECORD_PAIR",
            "per_observer": {
                checker: observation["attribution"]
                for checker, observation in quot_type_vector.items()
            },
            "target_violation": "ONE_SERIALIZED_TYPE_REFERENCE_DEVIATION_ESTABLISHED",
        },
        "kind": "EMPIRICAL_CONTRACT_SCENARIO",
        "layers": ["SERIALIZATION", "RECONSTRUCTION", "IMPLEMENTATION_VALIDATION"],
        "observations": quot_type_vector,
        "recommendation": {
            "action": "Preserve with the four quotient primitive signature cases and defer any implementation report pending family-level contract analysis.",
            "evidence": str(QUOT_TYPE_INVESTIGATION),
            "prerequisites": [
                "Analyze parser, reconstruction, validation, and semantic-use behavior separately.",
                "Do not infer that accepting checkers ignore the serialized type field.",
            ],
            "priority": "FUTURE_DIRECTION_NOT_ACTIVE",
            "target": "D-IMPLEMENTATION-SPECS",
        },
        "statement": {
            "observation_points": [
                "serialized declaration ingestion",
                "primitive reconstruction or lookup",
                "exact-type validation",
                "final process outcome",
            ],
            "precondition": "The canonical 73-record quotient export and matched control are accepted.",
            "profile_specific_effects": "See the complete observations vector; no validator-independent rejection rule is asserted.",
            "stimulus": (
                "Change only the serialized base Quot type reference from the canonical "
                "relation-indexed telescope to independently well-formed Sort u."
            ),
            "subject_scope": "Pinned official, Nanoda differential, Lean4Lean, and Kiota profiles.",
        },
        "unknowns": [
            "Whether each accepting checker ignores, reconstructs, normalizes, or validates the field differently.",
            "The exact Nanoda source revision, binary, and configuration for the preserved differential run.",
            "The implementation-independent serialized primitive contract.",
        ],
    }

    claims = [
        eq_claim,
        ingestion_claim,
        dependent_claim,
        theorem_claim,
        universe_claim,
        quot_type_claim,
    ]
    expected_eq_vector = {
        "official": "REJECT",
        "nanoda": "REJECT",
        "lean4lean": "REJECT",
        "kiota": "ACCEPT",
    }
    expected_unsafe_only_vector = {
        "official": "ACCEPT",
        "nanoda": "REJECT",
        "lean4lean": "ACCEPT",
        "kiota": "ACCEPT",
    }
    expected_unsafe_dependent_vector = {
        "official": "REJECT",
        "nanoda": "REJECT",
        "lean4lean": "REJECT",
        "kiota": "ACCEPT",
        "kiota_current": "REJECT",
    }
    expected_theorem_vector = {
        "official": "REJECT",
        "nanoda": "REJECT",
        "lean4lean": "REJECT",
        "kiota": "REJECT",
    }
    expected_universe_vector = {
        "official": "REJECT",
        "nanoda": "REJECT",
        "lean4lean": "REJECT",
        "kiota": "ACCEPT",
    }
    expected_quot_type_vector = {
        "official": "ACCEPT",
        "nanoda": "REJECT",
        "lean4lean": "ACCEPT",
        "kiota": "ACCEPT",
    }

    statement_shapes = {
        "EMPIRICAL_CONTRACT_SCENARIO": [
            "subject_scope",
            "precondition",
            "stimulus",
            "observation_points",
            "profile_specific_effects",
        ],
        "NORMATIVE_CANDIDATE_OBLIGATION": [
            "judgment",
            "applicability",
            "premises",
            "target_premise",
            "expected_effect",
        ],
    }
    common_dimensions = [
        "id",
        "kind",
        "layers",
        "authority",
        "statement",
        "evidence",
        "observations",
        "isolation",
        "unknowns",
        "recommendation",
    ]

    checks = {
        "artifact_hashes_match": artifact_hashes_match,
        "both_claim_kinds_exercised": {claim["kind"] for claim in claims}
        == {"NORMATIVE_CANDIDATE_OBLIGATION", "EMPIRICAL_CONTRACT_SCENARIO"},
        "claim_shapes_match_kind": all(
            all(dimension in claim for dimension in common_dimensions)
            and set(claim["statement"]) == set(statement_shapes[claim["kind"]])
            for claim in claims
        ),
        "complete_vectors_preserved": (
            {key: row["candidate"] for key, row in eq_vector.items()}
            == expected_eq_vector
            and {key: row["candidate"] for key, row in unsafe_only_vector.items()}
            == expected_unsafe_only_vector
            and {key: row["candidate"] for key, row in unsafe_dependent_vector.items()}
            == expected_unsafe_dependent_vector
            and {key: row["candidate"] for key, row in theorem_vector.items()}
            == expected_theorem_vector
            and {key: row["candidate"] for key, row in universe_vector.items()}
            == expected_universe_vector
            and {key: row["candidate"] for key, row in quot_type_vector.items()}
            == expected_quot_type_vector
        ),
        "recorded_controls_accept_for_every_observation": all_recorded_controls_accept(
            claims
        ),
        "eq_expected_outcome_is_reference_reject": (
            eq_expected["expected_outcome"] == "REJECT"
            and eq_cross["semantic_status"] == "UNRESOLVED"
        ),
        "eq_nanoda_target_isolated": (
            eq_nanoda["baseline"]["normalized_outcome"] == "REJECT"
            and eq_nanoda["mutant"]["normalized_outcome"] == "ACCEPT"
            and eq_nanoda_control["baseline"]["normalized_outcome"] == "ACCEPT"
            and eq_nanoda_control["mutant"]["normalized_outcome"] == "ACCEPT"
            and eq_mutation["source_file"] == "src/quot.rs"
            and eq_mutation["source_span"] == "89"
        ),
        "evidence_payloads_linked_not_copied": all(
            set(ref) == {"path", "sha256"}
            for claim in claims
            for ref in claim["evidence"]
        ),
        "isunsafe_decomposed_into_stateful_scenarios": (
            ingestion_claim["id"] != dependent_claim["id"]
            and ingestion_claim["statement"]["observation_points"]
            != dependent_claim["statement"]["observation_points"]
        ),
        "isunsafe_field_change_isolated_in_both_pairs": (
            unsafe_change_is_isolated(UNSAFE_ONLY_CANDIDATE, UNSAFE_ONLY_CONTROL)
            and unsafe_change_is_isolated(
                UNSAFE_DEPENDENT_CANDIDATE, UNSAFE_DEPENDENT_CONTROL
            )
        ),
        "representative_set_factors_without_new_kind": (
            len(claims) == 6
            and theorem_claim["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION"
            and universe_claim["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION"
            and quot_type_claim["kind"] == "EMPIRICAL_CONTRACT_SCENARIO"
        ),
        "authority_states_remain_distinct": (
            theorem_claim["authority"]["status"] == "ESTABLISHED"
            and universe_claim["authority"]["status"] == "UNRESOLVED"
            and quot_type_claim["authority"]["status"]
            == "EMPIRICALLY_CHARACTERIZED_REFERENCE_ALIGNED"
        ),
        "universe_nanoda_provenance_gap_is_explicit": (
            universe_vector["nanoda"]["control"] == "NOT_DURABLY_LINKED"
            and universe_vector["nanoda"]["identity"]["source_revision"]
            == "NOT_RECORDED"
            and universe_vector["nanoda"]["identity"]["binary_sha256"] == "UNKNOWN"
        ),
        "quot_type_normative_rejection_is_not_asserted": (
            quot_type_claim["kind"] == "EMPIRICAL_CONTRACT_SCENARIO"
            and "expected_effect" not in quot_type_claim["statement"]
            and quot_type_cross["expected_outcome"] == "ACCEPT"
        ),
        "no_aggregate_semantic_oracle": not any(
            has_forbidden_aggregate_key(claim) for claim in claims
        ),
        "recommendations_are_actionable": all(
            set(claim["recommendation"])
            == {"action", "evidence", "prerequisites", "priority", "target"}
            and claim["recommendation"]["prerequisites"]
            for claim in claims
        ),
        "unknowns_preserved_for_every_claim": all(
            claim["unknowns"] for claim in claims
        ),
    }
    status = "PASS" if all(checks.values()) else "FAIL"
    report = {
        "checks": checks,
        "claims": claims,
        "gate_decision": {
            "next_step": (
                "DERIVE_RESEARCH_ONLY_KNOWN_RULE_CHARACTERIZATION_VIEW"
                if status == "PASS"
                else "REFINE_OR_REJECT_TWO_KIND_MODEL"
            ),
            "rationale": (
                "All five representative Phase 1 boundaries fit the unchanged two-kind "
                "model after isUnsafe is decomposed into two stateful scenarios. Authority "
                "states, per-observer isolation, disagreements, and provenance gaps remain "
                "explicit; serialized Quot is not recast as a normative rejection rule."
            ),
            "status": status,
        },
        "model": {
            "claim_kinds": {
                "EMPIRICAL_CONTRACT_SCENARIO": {
                    "statement_shape": statement_shapes["EMPIRICAL_CONTRACT_SCENARIO"]
                },
                "NORMATIVE_CANDIDATE_OBLIGATION": {
                    "statement_shape": statement_shapes[
                        "NORMATIVE_CANDIDATE_OBLIGATION"
                    ]
                },
            },
            "common_dimensions": common_dimensions,
            "evidence_policy": {
                "aggregate_counts_are_semantic_evidence": False,
                "authority_is_separate_from_layer": True,
                "evidence_payloads_are_content_addressed_references": True,
                "isolation_is_per_observer": True,
                "unknown_is_representable": True,
            },
            "status": "RESEARCH_ONLY_NOT_A_PRODUCTION_SCHEMA",
        },
        "prototype_id": "two-kind-assurance-claim-falsification-gate",
        "schema_version": 1,
        "scope": (
            "Falsification-first Phase 2 gate over all five representative Phase 1 "
            "boundaries, yielding six claims after decomposing isUnsafe; not a semantic "
            "denominator, conformance claim, or production schema."
        ),
        "status": status,
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    print(
        json.dumps(
            {
                "checks": checks,
                "output": str(OUTPUT.relative_to(ROOT)),
                "status": status,
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0 if status == "PASS" else 1


