    """A schema-only cross-layer fixture using the pinned Lean4Lean lineage."""
    pointer = "/observer_profiles/lean4lean"
    binding = lineage_by_pointer(model)[pointer]
    return {
        "schema_version": 1,
        "id": "FIXTURE.EMPIRICAL.RECONSTRUCTION",
        "name": "Schema fixture for a cross-layer empirical scenario",
        "kind": "EMPIRICAL_CONTRACT_SCENARIO",
        "layers": ["EXPORT_FORMAT", "RECONSTRUCTION", "IMPLEMENTATION_POLICY"],
        "authority": {
            "status": "ESTABLISHED",
            "scope": "EMPIRICAL_BOUNDARY_FOR_PINNED_PROFILES",
            "basis": {
                "qualification_rule": "FIXTURE.OBSERVATION_AND_CONTROL_PRESENT",
                "summary": "Schema-only fixture with an implementation observation and control.",
                "evidence_refs": ["EVID.FIXTURE.OBSERVATION", "EVID.FIXTURE.CONTROL"],
                "unmet_requirements": [],
            },
        },
        "lifecycle": {
            "status": "ACTIVE",
            "reason": "Schema-only conformance fixture.",
            "target_ids": [],
        },
        "soundness_relevance": {
            "status": "NOT_ASSESSED",
            "basis_evidence_refs": [],
            "statement": "The fixture makes no soundness claim.",
        },
        "statement": {
            "subject_scope": "A fictional serialized field under a pinned observer profile.",
            "precondition": [
