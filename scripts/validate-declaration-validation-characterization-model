            ],
        },
        "evidence": [
            {
                "id": "EVID.FIXTURE.OBSERVATION",
                "role": "IMPLEMENTATION_OBSERVATION",
                "source_type": "CHECKER_RESULT",
                "source_lock": {
                    "registry": "SEMANTIC_TARGET_PROFILE",
