#!/usr/bin/env python3
"""Validate the Milestones 2–3 declaration characterization ontology."""

from __future__ import annotations

import argparse
import copy
import hashlib
import json
from pathlib import Path
from typing import Any

import jsonschema


ROOT = Path(__file__).resolve().parents[1]
MODEL_PATH = ROOT / "config" / "declaration-validation-characterization-model.json"
MODEL_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-characterization-model.schema.json"
ENTRY_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-characterization-entry.schema.json"
TARGET_PATH = ROOT / "config" / "declaration-validation-target.json"
TEST_PATH = ROOT / "tests" / "test_declaration_validation_characterization_model.py"
COMPLETION_RECORDS = (
    ROOT / "results" / "research" / "declaration-validation-milestone-2.json",
    ROOT / "results" / "research" / "declaration-validation-milestone-3.json",
)


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def resolve_pointer(document: Any, pointer: str) -> Any:
    if pointer == "":
        return document
    if not pointer.startswith("/"):
        raise ValueError("pointer does not start with '/'")
    current = document
    for raw_token in pointer[1:].split("/"):
        token = raw_token.replace("~1", "/").replace("~0", "~")
        if isinstance(current, list):
            try:
                current = current[int(token)]
            except (ValueError, IndexError) as error:
                raise ValueError(f"invalid list index {token!r}") from error
        elif isinstance(current, dict):
            if token not in current:
                raise ValueError(f"missing object key {token!r}")
            current = current[token]
        else:
            raise ValueError(f"cannot descend through {type(current).__name__}")
    return current


def schema_errors(document: dict[str, Any], schema: dict[str, Any]) -> list[str]:
    validator = jsonschema.Draft202012Validator(
        schema, format_checker=jsonschema.FormatChecker()
    )
    return [
        f"schema /{'/'.join(str(part) for part in error.absolute_path)}: {error.message}"
        for error in sorted(
            validator.iter_errors(document), key=lambda item: list(item.absolute_path)
        )
    ]


def lineage_by_pointer(model: dict[str, Any]) -> dict[str, dict[str, Any]]:
    return {
        row["profile_pointer"]: row
        for row in model["lineage_registry"]["observers"]
    }


def validate_entry(
    entry: dict[str, Any],
    model: dict[str, Any],
    entry_schema: dict[str, Any],
    target: dict[str, Any],
) -> list[str]:
    """Apply schema checks plus cross-reference and epistemic invariants."""
    errors = schema_errors(entry, entry_schema)
    if errors:
        return errors

    evidence_by_id: dict[str, dict[str, Any]] = {}
    for evidence in entry["evidence"]:
        evidence_id = evidence["id"]
        if evidence_id in evidence_by_id:
            errors.append(f"duplicate evidence id: {evidence_id}")
        evidence_by_id[evidence_id] = evidence

        allowed_types = model["evidence_qualification"]["role_source_type_matrix"][
            evidence["role"]
        ]
        if evidence["source_type"] not in allowed_types:
            errors.append(
                f"evidence {evidence_id}: source type {evidence['source_type']} "
                f"is not qualified for role {evidence['role']}"
            )

        pointer = evidence["claim_supported"]["entry_json_pointer"]
        try:
            resolve_pointer(entry, pointer)
        except ValueError as error:
            errors.append(f"evidence {evidence_id}: invalid claim pointer {pointer}: {error}")

        source_lock = evidence["source_lock"]
        if source_lock["registry"] == "SEMANTIC_TARGET_PROFILE":
            lock_id = source_lock["lock_id"]
            try:
                resolve_pointer(target, lock_id)
            except ValueError as error:
                errors.append(
                    f"evidence {evidence_id}: invalid target-profile lock {lock_id}: {error}"
                )
                continue
            if lock_id.startswith("/observer_profiles/"):
                expected = lineage_by_pointer(model).get(lock_id)
                if expected is None:
                    errors.append(
                        f"evidence {evidence_id}: observer source lock lacks a lineage binding"
                    )
                else:
                    lineage = evidence.get("lineage")
                    if lineage is None:
                        errors.append(
                            f"evidence {evidence_id}: observer source lock lacks lineage"
                        )
                    else:
                        for field in (
                            "group",
                            "relationship_to_target",
                            "independence_scope",
                        ):
                            expected_field = (
                                "lineage_group" if field == "group" else field
                            )
                            if lineage[field] != expected[expected_field]:
                                errors.append(
                                    f"evidence {evidence_id}: lineage {field} does not "
                                    f"match {lock_id}"
                                )

    authority_refs = entry["authority"]["basis"]["evidence_refs"]
    soundness_refs = entry["soundness_relevance"]["basis_evidence_refs"]
    for field, refs in (
        ("authority", authority_refs),
        ("soundness_relevance", soundness_refs),
    ):
        for evidence_id in refs:
            if evidence_id not in evidence_by_id:
                errors.append(f"unknown {field} evidence ref: {evidence_id}")

    if (
        entry["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION"
        and entry["authority"]["status"] == "ESTABLISHED"
    ):
        roles = {
            evidence_by_id[evidence_id]["role"]
            for evidence_id in authority_refs
            if evidence_id in evidence_by_id
        }
        if "NORMATIVE_SUPPORT" not in roles:
            errors.append(
                "ESTABLISHED normative authority requires role-qualified NORMATIVE_SUPPORT"
            )

    if entry["lifecycle"]["status"] in {"SUPERSEDED", "REDUNDANT"}:
        if entry["id"] in entry["lifecycle"]["target_ids"]:
            errors.append("lifecycle target cannot be the entry itself")

    if entry["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION":
        judgment_pointer = entry["statement"]["judgment"]["target_profile_pointer"]
        try:
            resolve_pointer(target, judgment_pointer)
        except ValueError as error:
            errors.append(f"invalid modeled-judgment pointer {judgment_pointer}: {error}")
    else:
        seen_profiles: set[str] = set()
        for effect in entry["statement"]["profile_specific_effects"]:
            pointer = effect["observer_profile_pointer"]
            if pointer in seen_profiles:
                errors.append(f"duplicate empirical observer profile: {pointer}")
            seen_profiles.add(pointer)
            try:
                resolve_pointer(target, pointer)
            except ValueError as error:
                errors.append(f"invalid empirical observer pointer {pointer}: {error}")

    return errors


def normative_fixture() -> dict[str, Any]:
    """A schema-only normative fixture, never a research catalog entry."""
    return {
        "schema_version": 1,
        "id": "FIXTURE.NORMATIVE.THEOREM_TYPE",
        "name": "Schema fixture for a normative candidate",
        "kind": "NORMATIVE_CANDIDATE_OBLIGATION",
        "layers": ["KERNEL_DECLARATION_VALIDITY"],
        "authority": {
            "status": "ESTABLISHED",
            "scope": "NORMATIVE_REQUIREMENT_FOR_MODELED_JUDGMENT",
            "basis": {
                "qualification_rule": "FIXTURE.NORMATIVE_SUPPORT_PRESENT",
                "summary": "Schema-only fixture with one qualified normative source.",
                "evidence_refs": ["EVID.FIXTURE.NORMATIVE"],
                "unmet_requirements": [],
            },
        },
        "lifecycle": {
            "status": "ACTIVE",
            "reason": "Schema-only conformance fixture.",
            "target_ids": [],
        },
        "soundness_relevance": {
            "status": "NOT_ASSESSED",
            "basis_evidence_refs": [],
            "statement": "The fixture makes no soundness claim.",
        },
        "statement": {
            "judgment": {
                "target_profile_pointer": "/logical_target/modeled_judgment",
                "statement": "Schema-only instance of the pinned modeled judgment.",
            },
            "applicability": [
                {
                    "id": "PRED.FIXTURE.DECL_KIND",
                    "statement": "The declaration has the fixture declaration kind.",
                }
            ],
            "premises": [],
            "target_premise": {
                "id": "PRED.FIXTURE.REQUIRED",
                "statement": "The fixture predicate holds.",
            },
            "expected_effect": {
                "violation_expectation": "REJECT",
                "authority_scope": "Schema fixture only; not a Lean semantic claim.",
            },
        },
        "evidence": [
            {
                "id": "EVID.FIXTURE.NORMATIVE",
                "role": "NORMATIVE_SUPPORT",
                "source_type": "NORMATIVE_SPECIFICATION",
                "source_lock": {
                    "registry": "LOCAL_ARTIFACT_LOCK",
                    "lock_id": "FIXTURE.NORMATIVE.SOURCE",
                },
                "exact_locator": {
                    "kind": "DOCUMENT_SECTION",
                    "value": "fixture-section",
                },
                "claim_supported": {
                    "entry_json_pointer": "/statement/target_premise",
                    "predicate_id": "CLAIM.FIXTURE.NORMATIVE",
                    "proposition": "Supports only the schema fixture predicate.",
                },
                "assumptions": [],
                "limitations": ["Not a research finding or source citation."],
            }
        ],
        "unknowns": [],
        "notes": ["Constructed in memory and never admitted to the catalog."],
    }


