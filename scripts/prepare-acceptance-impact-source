#!/usr/bin/env python3
"""Inspect or materialize the frozen ACCEPTANCE-IMPACT-PILOT-1 Kiota source."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib.acceptance_impact_source import inspect_environment, prepare_source


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("inspect", "prepare"))
    args = parser.parse_args()
    result = inspect_environment(ROOT) if args.action == "inspect" else prepare_source(ROOT)
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
