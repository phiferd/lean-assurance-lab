#!/usr/bin/env python3
"""Validate the immutable acceptance-impact boundary closure."""
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import acceptance_impact_closure as closure  # noqa: E402


try:
    result = closure.validate(ROOT, require_committed=True)
    print(json.dumps(result, sort_keys=True))
except (OSError, ValueError) as error:
    print("acceptance-impact closure validation failed: " + str(error), file=sys.stderr)
    raise SystemExit(2)
