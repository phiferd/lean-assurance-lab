#!/usr/bin/env python3
"""Generate/check the repaired A7 baseline without a Lean launch."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.cvc_a7_repair_audit import baseline_source

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--check', action='store_true')
a = p.parse_args()
expected = ROOT / 'results/research/conditional-validation-contracts/cvc-conditional-1/baseline-expectations.json'
target = ROOT / 'research/conditional-validation-contracts/cvc-a7-repair/Baseline.lean'
payload = baseline_source(json.loads(expected.read_text()))
if a.check:
    if target.read_bytes() != payload:
        raise SystemExit('FAIL: generated repaired baseline drift')
else:
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(payload)
print('PASS: repaired baseline matches reviewed declarations; no Lean launch')
