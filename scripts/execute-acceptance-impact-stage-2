#!/usr/bin/env python3
"""Freeze, validate, or execute the fixed Stage-2 observation matrix."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import acceptance_impact_stage2 as stage2  # noqa: E402

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("action", choices=("freeze", "validate", "run"))
args = parser.parse_args()
try:
    if args.action == "freeze":
        result = stage2.freeze_execution_manifest(ROOT)
    elif args.action == "validate":
        result = stage2.validate_execution_manifest(ROOT, require_commit=True)
    else:
        result = stage2.execute(ROOT)
    print(json.dumps(result, sort_keys=True))
except (OSError, ValueError) as error:
    print("Stage-2 execution refused: " + str(error), file=sys.stderr)
    raise SystemExit(2)
