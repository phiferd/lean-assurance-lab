#!/usr/bin/env python3
import argparse
from pathlib import Path
import sys
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
from lib.trust_assumption_pilot import *
p=argparse.ArgumentParser();p.add_argument('action',choices=['local','import','result','validate']);p.add_argument('--producer');p.add_argument('--protocol',default='protocol-r1.json');p.add_argument('observations',nargs='*');a=p.parse_args()
if a.action in ('local','import'):execute(PATHS[0 if a.action=='local' else 1],a.protocol,a.producer)
elif a.action=='result':write(ROOT/BASE/'result.json',rebuild_result([bind(x) for x in a.observations]))
else: print(validate_result()['status'])
