#!/usr/bin/env python3
"""Validate investigation action recommendations and bound evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

import jsonschema


ROOT = Path(__file__).resolve().parents[1]


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "path",
        nargs="?",
        type=Path,
        default=ROOT / "results" / "action-recommendations" / "current.json",
    )
    args = parser.parse_args()
    schema = json.loads(
        (ROOT / "schemas" / "investigation-action-recommendations.schema.json").read_text(encoding="utf-8")
    )
    report = json.loads(args.path.read_text(encoding="utf-8"))
    errors = [
        error.message
        for error in jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker()).iter_errors(report)
    ]
    for finding in report.get("findings", []):
        for evidence in finding.get("evidence", []):
            path = (ROOT / evidence["path"]).resolve()
            try:
                path.relative_to(ROOT.resolve())
            except ValueError:
                errors.append(f"evidence outside repository: {evidence['path']}")
                continue
            if not path.is_file():
                errors.append(f"missing evidence: {evidence['path']}")
            elif sha256_file(path) != evidence["sha256"]:
                errors.append(f"evidence hash mismatch: {evidence['path']}")
    if errors:
        for error in sorted(errors):
            print(error)
        return 1
    print(json.dumps({
        "external_actions_requiring_review": sum(
            recommendation["external_action"] and recommendation["human_gate"]["status"] == "REVIEW_REQUIRED"
            for finding in report["findings"]
            for recommendation in finding["recommendations"]
        ),
        "findings": len(report["findings"]),
        "status": "PASS",
    }, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
