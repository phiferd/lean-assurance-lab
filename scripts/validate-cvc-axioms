#!/usr/bin/env python3
"""Validate CVC-AXIOMS-1 evidence without running a proof runtime."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.cvc_axioms import validate  # noqa: E402

parser = argparse.ArgumentParser()
parser.add_argument('--root', type=Path, default=ROOT)
parser.add_argument('--require-full-source', action='store_true')
args = parser.parse_args()
try:
    print(json.dumps(validate(args.root, args.require_full_source), indent=2, sort_keys=True))
except ValueError as error:
    print('FAIL: ' + str(error), file=sys.stderr)
    raise SystemExit(1)
