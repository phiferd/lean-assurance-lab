#!/usr/bin/env python3
"""Classify an inverted Quot.ind reduction guard under proof irrelevance."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from nanoda_differential import DifferentialSession  # noqa: E402


DEFAULT_MUTANT_ID = "nanoda-gen-cb4949d04bbf"
CHECKER = ROOT / "external" / "lean-kernel-arena" / "_build" / "checkers" / "nanoda" / "src"
ARTIFACT = (
    ROOT / "external" / "lean-kernel-arena" / "_build" / "tests" /
    "tutorial" / "good" / "133_quotIndReduction.ndjson"
)
REGISTRY = ROOT / "results" / "mutants" / "registry.jsonl"


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def classify(spec: dict, comparison: dict, quot_source: str, tc_source: str, probe: dict) -> dict:
    checks = {
        "mutation_inverts_quot_ind_discrimination": (
            spec.get("function") == "reduce_quot"
            and spec.get("mutation_operator") in {"REL_EQ_TO_NE", "BOOL_NEGATE"}
            and "quot_ind" in spec.get("original", "")
        ),
        "quot_ind_motive_is_restricted_to_prop": (
            "Quot.ind :" in quot_source and "@Quot A r → Prop" in quot_source
        ),
        "definitional_equality_applies_proof_irrelevance": (
            "if self.proof_irrel_eq(x_n, y_n)" in tc_source
            and "fn proof_irrel_eq" in tc_source
        ),
        "serialized_applications_receive_structural_check_inference": (
            "let inferred_type = tc.infer(*val, crate::tc::InferFlag::Check);" in tc_source
            and "let arg_type = self.infer(arg, flag);" in tc_source
            and "self.assert_def_eq(binder_type, arg_type);" in tc_source
        ),
        "non_ind_quotient_primitives_have_bounded_checked_arities": (
            "Quot : Π {A : Sort u}" in quot_source
            and "Quot.mk : Π {A : Sort u}" in quot_source
            and "Quot.lift : Π {A : Sort u}" in quot_source
        ),
        "covering_schedule_exhausted_without_difference": (
            comparison.get("status") == "SURVIVED"
            and comparison.get("all_covering_tests_exhausted") is True
        ),
        "explicit_reduction_probe_accepts_in_both_states": (
            probe.get("different") is False
            and probe.get("baseline", {}).get("normalized_outcome") == "ACCEPT"
            and probe.get("mutant", {}).get("normalized_outcome") == "ACCEPT"
        ),
    }
    passed = all(checks.values())
    return {
        "status": "PASS" if passed else "FAIL",
        "classification": "EQUIVALENT_UNDER_PROOF_IRRELEVANCE" if passed else "UNRESOLVED",
        "registry_classification": "EQUIVALENT" if passed else "SURVIVED_WITHOUT_WITNESS",
        "checks": checks,
        "reason": (
            "Quot.ind can produce only proofs, so suppressing its iota reduction cannot change "
            "observable definitional equality. Inverting the guard also admits other quotient "
            "primitive names, but checked Quot and Quot.mk applications cannot reach argument "
            "index 4; Quot.lift is handled by the preceding arm; and any well-typed Quot.sound "
            "case remains proof-valued. Mandatory structural Check inference rejects malformed "
            "applications before final declaration equality can validate them."
        ),
        "claim_scope": (
            "Pinned Nanoda checker semantics and Lean's proof-irrelevant Quot.ind primitive; "
            "this does not classify analogous reduction suppression for Quot.lift."
        ),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mutant-id", default=DEFAULT_MUTANT_ID)
    parser.add_argument("--write-status", action="store_true")
    parser.add_argument("--timeout", type=float, default=60.0)
    args = parser.parse_args()
    mutant_id = args.mutant_id
    spec_path = ROOT / "mutations" / f"{mutant_id}.json"
    comparison_path = ROOT / "results" / "mutants" / mutant_id / "scheduled-comparison.json"
    quot_path = CHECKER / "src" / "quot.rs"
    tc_path = CHECKER / "src" / "tc.rs"
    with DifferentialSession(mutant_id, args.timeout) as session:
        probe = session.evaluate(ARTIFACT)
        preparation = session.preparation
    report = classify(
        json.loads(spec_path.read_text(encoding="utf-8")),
        json.loads(comparison_path.read_text(encoding="utf-8")),
        quot_path.read_text(encoding="utf-8"),
        tc_path.read_text(encoding="utf-8"),
        probe,
    )
    report.update(
        {
            "schema_version": 1,
            "checker": "nanoda",
            "mutant_id": mutant_id,
            "probe": probe,
            "preparation": preparation,
            "inputs": {
                "mutation_spec": str(spec_path.relative_to(ROOT)),
                "mutation_spec_sha256": sha256_file(spec_path),
                "scheduled_comparison": str(comparison_path.relative_to(ROOT)),
                "scheduled_comparison_sha256": sha256_file(comparison_path),
                "explicit_reduction_artifact": str(ARTIFACT.relative_to(ROOT)),
                "explicit_reduction_artifact_sha256": sha256_file(ARTIFACT),
                "quot_source_sha256": sha256_file(quot_path),
                "typechecker_source_sha256": sha256_file(tc_path),
            },
        }
    )
    output = (
        ROOT / "results" / "investigations" / "nanoda-quot-ind-proof-irrelevance.json"
        if mutant_id == DEFAULT_MUTANT_ID
        else ROOT / "results" / "investigations" / "nanoda-quot-ind-guard" / "equivalence-analysis.json"
    )
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if args.write_status:
        if report["status"] != "PASS":
            raise SystemExit("refusing to classify mutant because an equivalence check failed")
        with REGISTRY.open("a", encoding="utf-8") as handle:
            handle.write(
                json.dumps(
                    {
                        "id": mutant_id,
                        "status": "SURVIVED",
                        "classification": "EQUIVALENT",
                        "notes": (
                            "Inverted Quot.ind guard equivalence established by "
                            f"{output.relative_to(ROOT)}"
                        ),
                        "updated_at": datetime.now(timezone.utc).isoformat(),
                    },
                    sort_keys=True,
                )
                + "\n"
            )
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
