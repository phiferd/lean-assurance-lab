 queue_sha256=queue_digest(q),decision='Complete the fixed lazy pilot after required final validation/refresh. Retain its demand-qualified local regression asset; no defect or external action follows. Select STATEFUL READY and unstarted, because public request histories provide a distinct feasible next conformance question. Do not execute the successor in this one-item request.',
 categories=[dict(category=k,assessment=v,candidate_ids=ids) for k,v,ids in categories],candidates=candidates,
 evidence_bindings=[dict(path=x,sha256=hashlib.sha256((ROOT/x).read_bytes()).hexdigest()) for x in paths])
