#!/usr/bin/env python3
"""Validate the external-contribution ledger and render its Markdown view.

This generator is offline by design. Upstream states remain dated observations
until an agent performs an authorized read-only refresh and edits the ledger.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path

import jsonschema


ROOT = Path(__file__).resolve().parents[1]
LEDGER = ROOT / "results" / "research" / "external-contributions.json"
SCHEMA = ROOT / "schemas" / "external-contributions.schema.json"
VIEW = ROOT / "docs" / "EXTERNAL_CONTRIBUTIONS.md"


def load_and_validate() -> dict:
    schema = json.loads(SCHEMA.read_text(encoding="utf-8"))
    ledger = json.loads(LEDGER.read_text(encoding="utf-8"))
    validator = jsonschema.Draft202012Validator(
        schema, format_checker=jsonschema.FormatChecker()
    )
    errors = [error.message for error in validator.iter_errors(ledger)]

    ids: set[str] = set()
    external_keys: set[tuple[str, int]] = set()
    tracked_submission_material: set[str] = set()
    for row in ledger.get("contributions", []):
        row_id = row.get("id")
        if row_id in ids:
            errors.append(f"duplicate contribution id: {row_id}")
        ids.add(row_id)

        paths = [*row.get("evidence_refs", [])]
        if row.get("submission_material"):
            paths.append(row["submission_material"])
            tracked_submission_material.add(row["submission_material"])
        for relative in paths:
            path = (ROOT / relative).resolve()
            try:
                path.relative_to(ROOT.resolve())
            except ValueError:
                errors.append(f"contribution path outside repository: {relative}")
                continue
            if not path.is_file():
                errors.append(f"missing contribution path: {relative}")

        upstream = row.get("upstream")
        if upstream is None:
            continue
        key = (row["target_repository"], upstream["number"])
        if key in external_keys:
            errors.append(f"duplicate external contribution: {key[0]}#{key[1]}")
        external_keys.add(key)
        expected_url = (
            f"https://github.com/{row['target_repository']}/pull/{upstream['number']}"
            if row["channel"] == "PULL_REQUEST"
            else None
        )
        if expected_url and upstream["url"] != expected_url:
            errors.append(f"unexpected pull request URL for {row_id}")
        if upstream["state"] == "MERGED" and upstream["merged_at"] is None:
            errors.append(f"merged contribution lacks merged_at: {row_id}")
        if upstream["state"] != "MERGED" and upstream["merged_at"] is not None:
            errors.append(f"unmerged contribution has merged_at: {row_id}")

    for path in sorted((ROOT / "results" / "action-recommendations" / "drafts").glob("*-pr.md")):
        relative = str(path.relative_to(ROOT))
        if relative not in tracked_submission_material:
            errors.append(f"untracked pull request draft: {relative}")

    if errors:
        raise ValueError("\n".join(sorted(errors)))
    return ledger


def local_link(path: str, label: str) -> str:
    return f"[{label}](../{path})"


def external_label(row: dict) -> str:
    upstream = row["upstream"]
    return f"[{row['title']}]({upstream['url']})"


def render(ledger: dict) -> str:
    rows = ledger["contributions"]
    open_rows = [row for row in rows if row["upstream"] and row["upstream"]["state"] == "OPEN"]
    draft_rows = [row for row in rows if row["lifecycle"] == "LOCAL_DRAFT"]
    merged_rows = [row for row in rows if row["upstream"] and row["upstream"]["state"] == "MERGED"]
    other_rows = [
        row
        for row in rows
        if row not in open_rows and row not in draft_rows and row not in merged_rows
    ]

    lines = [
        "# External contributions",
        "",
        "> Generated by `scripts/build-external-contributions --write` from "
        "`results/research/external-contributions.json`; do not edit this view.",
        "",
        ledger["scope"],
        "",
        f"Ledger updated: **{ledger['updated_on']}**. Upstream states are dated observations, "
        "not a live-status guarantee. The generator performs no network requests and no external writes.",
        "",
        "## At a glance",
        "",
        f"- Awaiting upstream: **{len(open_rows)}**",
        f"- Local drafts: **{len(draft_rows)}**",
        f"- Merged: **{len(merged_rows)}**",
        "",
    ]

    if open_rows:
        lines += [
            "## Awaiting upstream",
            "",
            "| Contribution | Repository | Observed | Review/checks | Next step |",
            "|---|---|---|---|---|",
        ]
        for row in open_rows:
            upstream = row["upstream"]
            activity = upstream["review_state"].replace("_", " ").lower()
            checks = upstream["checks_state"].replace("_", " ").lower()
            lines.append(
                f"| {external_label(row)} | `{row['target_repository']}` | "
                f"{upstream['observed_on']} | {activity}; {checks} | "
                f"{row['next_step']['summary']} |"
            )
        lines.append("")

    if draft_rows:
        lines += [
            "## Local drafts",
            "",
            "| Candidate | Repository | Evidence item | Reassess no earlier than | Next step |",
            "|---|---|---|---|---|",
        ]
        for row in draft_rows:
            draft = local_link(row["submission_material"], row["title"])
            research = ", ".join(f"`{item}`" for item in row["research_items"])
            reassess = row["next_step"]["reassess_not_before"] or "—"
            lines.append(
                f"| {draft} | `{row['target_repository']}` | {research} | "
                f"{reassess} | {row['next_step']['summary']} |"
            )
        lines.append("")

    if merged_rows:
        lines += [
            "## Merged",
            "",
            "| Contribution | Repository | Merged | Evidence |",
            "|---|---|---|---|",
        ]
        for row in merged_rows:
            evidence = local_link(row["evidence_refs"][0], "record")
            lines.append(
                f"| {external_label(row)} | `{row['target_repository']}` | "
                f"{row['upstream']['merged_at']} | {evidence} |"
            )
        lines.append("")

    if other_rows:
        lines += ["## Other dispositions", ""]
        for row in other_rows:
            lines.append(f"- `{row['id']}`: {row['next_step']['summary']}")
        lines.append("")

    lines += [
        "## Maintenance contract",
        "",
        "The JSON ledger is the canonical current index. Item-specific submission, "
        "evidence, and successor records remain authoritative for their detailed and historical claims.",
        "",
        "- `scripts/build-external-contributions --write` validates the ledger and regenerates this view.",
        "- `scripts/build-external-contributions --check` fails when the ledger is invalid or this view is stale.",
        "- `scripts/refresh-current-state` regenerates this view as part of the ordinary offline state build.",
        "- A GitHub observation must update the affected dated fields in the ledger; the build does not poll GitHub.",
        "- New pull-request drafts use the `*-pr.md` filename suffix; validation rejects any such draft omitted from the ledger.",
        "- Preparing, submitting, modifying, or following up on an external action still requires the repository's applicable human gate.",
        "",
    ]
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--write", action="store_true")
    group.add_argument("--check", action="store_true")
    args = parser.parse_args()

    try:
        ledger = load_and_validate()
    except (ValueError, json.JSONDecodeError) as error:
        print(error)
        return 1
    rendered = render(ledger)
    if args.write:
        VIEW.write_text(rendered, encoding="utf-8")
    elif args.check:
        if not VIEW.is_file() or VIEW.read_text(encoding="utf-8") != rendered:
            print("external contribution view is stale; run scripts/build-external-contributions --write")
            return 1
        print("PASS: external contribution ledger is valid and its view is current")
    else:
        print(rendered, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
