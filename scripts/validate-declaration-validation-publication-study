#!/usr/bin/env python3
"""Validate publication-study artifacts through complete authority adjudication.

This validator checks identity, provenance, closure, frozen human approvals,
and authored catalog dispositions.  It enforces procedure and evidence
bindings; it does not select favorable authority outcomes.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
from pathlib import Path
from typing import Any

import jsonschema


ROOT = Path(__file__).resolve().parents[1]
SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-publication-study.schema.json"
PREREGISTRATION_PATH = ROOT / "config" / "declaration-validation-publication-study-preregistration.json"
DISCOVERY_PATH = ROOT / "results" / "research" / "declaration-validation-publication-study-source-discovery.json"
REVIEW_PACKET_PATH = ROOT / "docs" / "research" / "DECLARATION_VALIDATION_PUBLICATION_STUDY_SOURCE_APPROVAL_REVIEW.md"
APPROVAL_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-publication-study-authority-source-approval.schema.json"
APPROVAL_PATH = ROOT / "results" / "research" / "declaration-validation-publication-study-authority-source-approval.json"
APPROVED_SUCCESSOR_PATH = ROOT / "config" / "declaration-validation-approved-authority-sources" / "publication-study-v2.json"
COMPATIBILITY_DECISION_PATH = ROOT / "results" / "research" / "declaration-validation-authority-source-approvals" / "publication-study-v2.json"
APPROVED_SUCCESSOR_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-approved-authority-sources-successor.schema.json"
COMPATIBILITY_DECISION_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-authority-source-approval-decision.schema.json"
SENTINEL_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-publication-study-sentinel.schema.json"
SENTINEL_PATH = ROOT / "results" / "research" / "declaration-validation-publication-study-sentinel.json"
SENTINEL_EVIDENCE_LOCK_PATH = ROOT / "config" / "declaration-validation-evidence-locks" / "publication-study-sentinel.json"
ADJUDICATION_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-publication-study-authority-adjudication.schema.json"
ADJUDICATION_PATH = ROOT / "results" / "research" / "declaration-validation-publication-study-authority-adjudication.json"
ADJUDICATION_EVIDENCE_LOCK_PATH = ROOT / "config" / "declaration-validation-evidence-locks" / "publication-study-complete-adjudication.json"
CATALOG_PATH = ROOT / "config" / "declaration-validation-catalog.json"
M9_REVIEWED_CATALOG_PATH = ROOT / "results" / "research" / "declaration-validation-milestone-9-reviewed-catalog.json"
AUTHORITY_RULES_PATH = ROOT / "config" / "declaration-validation-authority-rules.json"
DERIVER_PATH = ROOT / "scripts" / "derive-declaration-validation-publication-study-preregistration"
HISTORICAL_VALIDATOR_PATH = ROOT / "scripts" / "validate-declaration-validation-historical"
ERRATUM_VALIDATOR_PATH = ROOT / "scripts" / "validate-declaration-validation-milestone-10-protocol-erratum"
APPROVED_SOURCES_PATH = ROOT / "config" / "declaration-validation-approved-authority-sources.json"
RESEARCH_STATUS_PATH = ROOT / "docs" / "RESEARCH_STATUS.md"

EXPECTED_SOURCE_FAMILIES = {
    "OFFICIAL_VERSIONED_REFERENCE",
    "OFFICIAL_VERSIONED_DESIGN_AND_API_DOCUMENTATION",
    "MECHANIZED_SEMANTICS",
    "PRIMARY_SCHOLARLY",
    "IMPLEMENTATION_DISCOVERY_ONLY",
}
EXPECTED_QUERY_SCOPES = {
    "OFFICIAL_VERSIONED_REFERENCE",
    "MECHANIZED_SEMANTICS",
    "PRIMARY_SCHOLARLY",
    "IMPLEMENTATION_DISCOVERY_ONLY",
}
EXPECTED_SENTINELS = ["DECL.THEOREM.TYPE_PROP", "EXPR.LET.VALUE_TYPE_MATCH"]
GATE4_COMMIT = "4b7ed4d6b2b1e65f9b71e64bbb03cf333ef4ccb9"
GATE5_COMMIT = "f1161457c9b1eb817f020021d8d39e8d95a6497d"
THEOREM_APPROVED_SOURCE_ID = "APPROVED.NORMDOC.LEAN_REFERENCE_MANUAL.V4_33_THEOREM_PROP"
THEOREM_SOURCE_CANDIDATE_ID = "SOURCE.CANDIDATE.OFFICIAL.MANUAL.DEFINITIONS"
THEOREM_CLAIM_ID = "CLAIM.SOURCE.MANUAL.DEFS.THEOREM_PROP"
THEOREM_LOCK_ID = "NORMDOC.PUBLICATION_STUDY.THEOREM_PROP"
THEOREM_EVIDENCE_ID = "EVID.PUBLICATION_STUDY.THEOREM_PROP.NORMATIVE"
EXPECTED_PREDECESSORS = {
    "results/research/declaration-validation-milestone-8-historical.json": (
        "ordinary-declaration-validation.milestone-8.historical.v2",
        "714d0466a9f3e0ed1c8a8c6d20508324a48b3a1d",
    ),
    "results/research/declaration-validation-milestone-9-historical.json": (
        "ordinary-declaration-validation.milestone-9.historical.v1",
        "69dad9d13e4802e5ef29c958c60d2ee387293847",
    ),
    "results/research/declaration-validation-milestone-10-historical.json": (
        "ordinary-declaration-validation.milestone-10.historical.v1",
        "2811fdbbe146009775ebdb1bd3b153f59ae503eb",
    ),
    "results/research/declaration-validation-milestone-10-protocol-erratum-1-historical.json": (
        "ordinary-declaration-validation.milestone-10.protocol-erratum.1.historical.v1",
        "3f8d88ad4df80d746dbb3415156a1d31a01053e5",
    ),
}


def load_module(name: str, path: Path) -> Any:
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"could not load {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_bytes(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def git_blob_id(content: bytes) -> str:
    header = f"blob {len(content)}\0".encode("ascii")
    return hashlib.sha1(header + content).hexdigest()


def safe_relative_path(value: str) -> bool:
    path = Path(value)
    return not path.is_absolute() and ".." not in path.parts and ":" not in value


def schema_errors(instance: Any, label: str, schema_path: Path = SCHEMA_PATH) -> list[str]:
    schema = load_json(schema_path)
    validator = jsonschema.Draft202012Validator(
        schema, format_checker=jsonschema.FormatChecker()
    )
    return [
        f"{label} schema error at /{'/'.join(str(item) for item in error.absolute_path)}: {error.message}"
        for error in sorted(validator.iter_errors(instance), key=lambda item: list(item.absolute_path))
    ]


def git_output(args: list[str]) -> tuple[bytes | None, str | None]:
    result = subprocess.run(
        ["git", *args], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False
    )
    if result.returncode:
        return None, result.stderr.decode("utf-8", errors="replace").strip()
    return result.stdout, None


def binding_bytes(
    binding: dict[str, Any], *, label: str, require_live_match: bool = True
) -> tuple[bytes | None, list[str]]:
    errors: list[str] = []
    path = binding.get("path")
    commit = binding.get("git_commit")
    blob = binding.get("git_blob")
    if not isinstance(path, str) or not safe_relative_path(path):
        return None, [f"{label}: path is not safe and relative"]
    if not isinstance(commit, str) or not isinstance(blob, str):
        return None, [f"{label}: Git binding is incomplete"]
    resolved_commit, error = git_output(["rev-parse", "--verify", f"{commit}^{{commit}}"])
    if error or resolved_commit is None or resolved_commit.decode().strip() != commit:
        return None, [f"{label}: Git commit is unavailable or inexact"]
    resolved_blob, error = git_output(["rev-parse", "--verify", f"{commit}:{path}"])
    if error or resolved_blob is None or resolved_blob.decode().strip() != blob:
        return None, [f"{label}: Git blob identity is unavailable or stale"]
    content, error = git_output(["cat-file", "blob", blob])
    if error or content is None:
        return None, [f"{label}: Git blob content is unavailable"]
    if sha256_bytes(content) != binding.get("sha256"):
        errors.append(f"{label}: SHA-256 differs from bound Git bytes")
    live_path = ROOT / path
    if require_live_match:
        if not live_path.is_file():
            errors.append(f"{label}: bound live path is missing")
        elif live_path.read_bytes() != content:
            errors.append(f"{label}: bound live path differs from immutable Git bytes")
    return content, errors


def validate_preregistration(
    document: dict[str, Any] | None = None, *, check_predecessors: bool = True
) -> list[str]:
    document = load_json(PREREGISTRATION_PATH) if document is None else document
    errors = schema_errors(document, "publication-study preregistration")
    if errors:
        return errors

    if check_predecessors:
        history = load_module("publication_study_history", HISTORICAL_VALIDATOR_PATH)
        erratum = load_module("publication_study_erratum", ERRATUM_VALIDATOR_PATH)
        predecessor_errors = (
            history.validate_m8_attestation()
            + history.validate_m8_attestation_predecessor_commit()
            + history.validate_m9_attestation()
            + history.validate_m10_attestation()
            + erratum.validate_historical_attestation()
        )
        errors.extend(f"immutable predecessor: {item}" for item in predecessor_errors)

    _, plan_errors = binding_bytes(document["governing_plan"], label="governing plan")
    errors.extend(plan_errors)
    predecessor_paths: set[str] = set()
    for index, binding in enumerate(document["immutable_predecessors"]):
        path = binding["path"]
        predecessor_paths.add(path)
        content, item_errors = binding_bytes(binding, label=f"predecessor {index}")
        errors.extend(item_errors)
        expected = EXPECTED_PREDECESSORS.get(path)
        if expected is None:
            errors.append(f"predecessor {index}: unexpected historical path")
        elif (binding["attestation_id"], binding["historical_content_commit"]) != expected:
            errors.append(f"predecessor {index}: historical identity or content commit differs")
        if content is not None:
            attestation = json.loads(content)
            if attestation.get("attestation_id") != binding["attestation_id"]:
                errors.append(f"predecessor {index}: attestation ID differs from bound bytes")
            if attestation.get("historical_commit") != binding["historical_content_commit"]:
                errors.append(f"predecessor {index}: historical content commit differs from bound bytes")
    if predecessor_paths != set(EXPECTED_PREDECESSORS):
        errors.append("immutable predecessor set is not exactly M8, M9, M10, and M10 erratum 1")

    for name, binding in document["m10_inputs"].items():
        _, item_errors = binding_bytes(binding, label=f"M10 input {name}")
        errors.extend(item_errors)

    deriver = load_module("publication_study_deriver", DERIVER_PATH)
    try:
        expected_candidates, expected_holdouts = deriver.derive(document)
    except (KeyError, ValueError, subprocess.CalledProcessError) as error:
        return errors + [f"cohort derivation failed: {error}"]
    cohort = document["cohort_derivation"]
    if cohort["candidates"] != expected_candidates:
        errors.append("candidate cohort differs from immutable M10 derivation")
    if cohort["technical_readiness_holdouts"] != expected_holdouts:
        errors.append("technical-readiness holdouts differ from immutable M10 derivation")
    candidate_ids = [row["id"] for row in expected_candidates]
    candidate_set = set(candidate_ids)
    if len(candidate_set) != 15:
        errors.append("derived candidate identities are not 15 unique entries")

    family_ids = {row["id"] for row in document["semantic_families"]}
    family_members = [item for row in document["semantic_families"] for item in row["candidate_ids"]]
    if len(family_ids) != 5 or len(family_members) != len(set(family_members)) or set(family_members) != candidate_set:
        errors.append("semantic families do not partition the exact candidate cohort")

    protocol = document["source_discovery_protocol"]
    source_families = {row["id"] for row in protocol["source_families"]}
    if source_families != EXPECTED_SOURCE_FAMILIES:
        errors.append("source-family search surface is not the preregistered five-family surface")
    queries = protocol["required_queries"]
    query_ids = [row["id"] for row in queries]
    if len(queries) != 30 or len(query_ids) != len(set(query_ids)):
        errors.append("required query inventory is not exactly 30 unique queries")
    if protocol["resource_bounds"].get("required_query_count") != len(queries):
        errors.append("required-query resource count differs from query inventory")
    for query in queries:
        if query["scope"] not in EXPECTED_QUERY_SCOPES:
            errors.append(f"{query['id']}: query scope is outside the frozen surface")
        if not set(query["candidate_ids"]) <= candidate_set:
            errors.append(f"{query['id']}: query maps outside the cohort")
    for candidate_id in candidate_ids:
        scopes = {
            query["scope"] for query in queries if candidate_id in query["candidate_ids"]
        }
        if scopes != EXPECTED_QUERY_SCOPES:
            errors.append(f"{candidate_id}: required queries do not cover all four query scopes")

    authority = document["authority_protocol"]
    if authority["source_approval_decisions"] != ["APPROVE", "REJECT", "DEFER"]:
        errors.append("source-approval vocabulary changed")
    if authority["catalog_authority_statuses"] != ["ESTABLISHED", "PROVISIONAL", "UNRESOLVED"]:
        errors.append("catalog-authority vocabulary changed")
    if authority["roles"]["source_approver"] != "SEPARATE_HUMAN_REVIEW_REQUIRED":
        errors.append("source approval is not reserved to separate human review")
    if [row["id"] for row in document["claim_tiers"]] != [
        "EMPTY_DENOMINATOR", "BOUNDED_PILOT", "NONTRIVIAL_BOUNDED_STUDY"
    ]:
        errors.append("claim-tier identities changed")
    comparator = document["comparator_budget_rules"]
    if any(comparator[name] != 0 for name in (
        "new_checker_campaigns", "new_coverage_collection_runs", "new_mutants", "new_mutation_campaigns"
    )):
        errors.append("comparator preregistration permits new campaigns")
    synthesis = document["synthesis_budget_rules"]
    if synthesis["bounded_pilot_per_target_ceiling"]["tier_3_candidates"] != 0:
        errors.append("bounded-pilot synthesis permits Tier 3")
    if not synthesis["target_specific_plan_required_after_baseline_freeze"]:
        errors.append("target-specific synthesis plan is not deferred until baseline freeze")
    outcomes = document["outcome_criteria"]
    if outcomes.get("post_hoc_redefinition") != "FORBIDDEN" or set(outcomes["publish_bounded_stop"]) != {
        "PUBLISH_FULL", "PUBLISH_BOUNDED", "STOP"
    }:
        errors.append("publication outcome routing or post-hoc prohibition changed")
    if document["review_sentinels"] != EXPECTED_SENTINELS:
        errors.append("authority sentinels differ from the frozen identities")
    required_prohibitions = {
        "NO_IMPLEMENTATION_SOURCE_AS_NORMATIVE_AUTHORITY",
        "NO_LLM_CONCLUSION_AS_NORMATIVE_AUTHORITY",
        "NO_ADAPTIVE_COHORT_SUBSTITUTION",
        "NO_POST_HOC_OUTCOME_REDEFINITION",
        "NO_AUTHORITY_APPROVAL_BY_DISCOVERY_AGENT",
        "NO_BASELINE_SYNTHESIS_MUTATION_OR_CHECKER_CAMPAIGN_BEFORE_DENOMINATOR_FREEZE",
    }
    if not required_prohibitions <= set(document["prohibitions"]):
        errors.append("required scientific prohibitions are incomplete")

    approved = load_json(APPROVED_SOURCES_PATH)
    if approved.get("normative_documentation") or approved.get("mechanized_results"):
        errors.append("pre-approval authority-source registry is no longer empty")
    status_text = RESEARCH_STATUS_PATH.read_text(encoding="utf-8")
    if "### Active\n\n1. `F-DECLARATION-VALIDATION-OBLIGATION-COVERAGE-STUDY`" not in status_text:
        errors.append("publication study is not the active durable research frontier")
    return errors


def validate_approval(
    document: dict[str, Any] | None = None,
    discovery: dict[str, Any] | None = None,
) -> list[str]:
    """Validate the human review outcome without adjudicating any catalog entry."""

    document = load_json(APPROVAL_PATH) if document is None else document
    discovery = load_json(DISCOVERY_PATH) if discovery is None else discovery
    errors = schema_errors(
        document, "publication-study authority-source approval", APPROVAL_SCHEMA_PATH
    )
    if errors:
        return errors

    _, binding_errors = binding_bytes(
        document["frozen_discovery_binding"], label="frozen source discovery"
    )
    errors.extend(binding_errors)
    if document["frozen_discovery_binding"]["path"] != str(DISCOVERY_PATH.relative_to(ROOT)):
        errors.append("authority-source approval discovery path is not canonical")
    if document["frozen_discovery_binding"]["sha256"] != sha256_bytes(DISCOVERY_PATH.read_bytes()):
        errors.append("authority-source approval does not bind the exact live frozen discovery")

    predecessor = document["predecessor_authority_source_registry"]
    expected_predecessor = {
        "path": "config/declaration-validation-approved-authority-sources.json",
        "sha256": sha256_bytes(APPROVED_SOURCES_PATH.read_bytes()),
        "registry_id": "ordinary-declaration-validation.approved-authority-sources.m7.v1",
        "sequence": 1,
    }
    if predecessor != expected_predecessor:
        errors.append("authority-source approval does not bind the immutable empty M7 registry")

    source_decisions = document["source_decisions"]
    sources = discovery["sources"]
    if len(source_decisions) != len(sources):
        errors.append("authority-source approval does not decide every frozen discovered source")
    for index, source in enumerate(sources):
        if index >= len(source_decisions):
            break
        decision = source_decisions[index]
        source_id = source["source_candidate_id"]
        if decision["source_candidate_id"] != source_id:
            errors.append(f"source decision {index}: source identity differs from frozen discovery")
        if decision["frozen_source_index"] != index:
            errors.append(f"{source_id}: source decision does not preserve frozen discovery order")
        if decision["source_content_sha256"] != source["retrieved_content_sha256"]:
            errors.append(f"{source_id}: approval source content binding differs from frozen discovery")
        if decision["disposition"] != source["recommended_disposition"]:
            errors.append(f"{source_id}: human source disposition differs from the approved recommendation")
        claims = source["claims_extracted"]
        claim_decisions = decision["claim_decisions"]
        if len(claim_decisions) != len(claims):
            errors.append(f"{source_id}: claim-decision inventory differs from frozen discovery")
            continue
        for claim, claim_decision in zip(claims, claim_decisions):
            claim_id = claim["claim_id"]
            if claim_decision["claim_id"] != claim_id:
                errors.append(f"{source_id}: claim decision identity differs from frozen discovery")
            if claim_decision["applicable_candidate_ids"] != claim["applicable_candidate_ids"]:
                errors.append(f"{claim_id}: claim decision changes frozen candidate mapping")
            expected_disposition = source["recommended_disposition"]
            if source_id == "SOURCE.CANDIDATE.OFFICIAL.MANUAL.DEFINITIONS":
                expected_disposition = {
                    "CLAIM.SOURCE.MANUAL.DEFS.THEOREM_PROP": "APPROVE",
                    "CLAIM.SOURCE.MANUAL.DEFS.HEADER_BEFORE_BODY": "REJECT",
                }.get(claim_id, "REJECT")
            if claim_decision["disposition"] != expected_disposition:
                errors.append(f"{claim_id}: human claim disposition differs from the approved recommendation")

    approved_claims = [
        claim
        for decision in source_decisions
        for claim in decision["claim_decisions"]
        if claim["disposition"] == "APPROVE"
    ]
    if approved_claims != [{
        "claim_id": "CLAIM.SOURCE.MANUAL.DEFS.THEOREM_PROP",
        "applicable_candidate_ids": ["DECL.THEOREM.TYPE_PROP"],
        "disposition": "APPROVE",
    }]:
        errors.append("authority-source approval scope is not exactly the theorem-Prop claim")

    compatibility_binding = document["compatibility_approval_decision_binding"]
    if compatibility_binding["path"] != str(COMPATIBILITY_DECISION_PATH.relative_to(ROOT)):
        errors.append("compatibility approval decision path is not canonical")
    elif not COMPATIBILITY_DECISION_PATH.is_file() or compatibility_binding["sha256"] != sha256_bytes(COMPATIBILITY_DECISION_PATH.read_bytes()):
        errors.append("compatibility approval decision binding is missing or stale")
    else:
        compatibility = load_json(COMPATIBILITY_DECISION_PATH)
        errors.extend(schema_errors(
            compatibility,
            "compatibility authority-source approval decision",
            COMPATIBILITY_DECISION_SCHEMA_PATH,
        ))
        if compatibility.get("decision_id") != compatibility_binding["decision_id"]:
            errors.append("compatibility approval decision identity disagrees with binding")
        if compatibility.get("predecessor_registry") != expected_predecessor:
            errors.append("compatibility approval decision does not bind the immutable empty M7 registry")
        if compatibility.get("approved_source_ids") != [
            "APPROVED.NORMDOC.LEAN_REFERENCE_MANUAL.V4_33_THEOREM_PROP"
        ]:
            errors.append("compatibility approval decision approves an unexpected source identity")

    registry_binding = document["approved_registry_successor_binding"]
    if (
        registry_binding["registry_id"]
        != "ordinary-declaration-validation.approved-authority-sources.publication-study.v2"
        or registry_binding["sequence"] != 2
    ):
        errors.append("approved authority-source successor identity is not the frozen publication-study v2 registry")
    if registry_binding["path"] != str(APPROVED_SUCCESSOR_PATH.relative_to(ROOT)):
        errors.append("approved authority-source successor path is not canonical")
    elif not APPROVED_SUCCESSOR_PATH.is_file() or registry_binding["sha256"] != sha256_bytes(APPROVED_SUCCESSOR_PATH.read_bytes()):
        errors.append("approved authority-source successor binding is missing or stale")
    else:
        catalog = load_module("publication_study_catalog", ROOT / "scripts" / "validate-declaration-validation-catalog")
        registry = load_json(APPROVED_SUCCESSOR_PATH)
        errors.extend(
            "approved authority-source successor: " + error
            for error in catalog.validate_approved_authority_source_registry(
                registry,
                load_json(APPROVED_SUCCESSOR_SCHEMA_PATH),
                APPROVED_SUCCESSOR_PATH,
                check_generated=True,
            )
        )
        expected_source = {
            "id": "APPROVED.NORMDOC.LEAN_REFERENCE_MANUAL.V4_33_THEOREM_PROP",
            "document_kind": "AUTHORITATIVE_DOCUMENTATION",
            "version_or_edition": "Lean Language Reference Manual source snapshot at 02d0d61af6d344da5215eb2eb1efba0ca30ede68, bound by leanprover/lean4:v4.33.0",
            "stable_url_or_doi": "https://github.com/leanprover/reference-manual/blob/02d0d61af6d344da5215eb2eb1efba0ca30ede68/Manual/Defs.lean",
            "authenticated_content_sha256": "46c08588bd4b9c62fc53dba65dcd39cd9a09a0ad2a37d9731f1aaeb24cb0e024",
            "approval_decision": "DEC.AUTHORITY_SOURCE.PUBLICATION_STUDY.V2",
        }
        if registry.get("normative_documentation") != [expected_source] or registry.get("mechanized_results"):
            errors.append("approved authority-source successor scope is not exactly the theorem-Prop manual source")
    status_text = RESEARCH_STATUS_PATH.read_text(encoding="utf-8")
    if "### Human Authority-Source Approval — 2026-09-04" not in status_text:
        errors.append("durable research status does not record the human authority-source approval")
    if "The next separately bounded activity is the fixed two-entry authority-process" not in status_text:
        errors.append("durable research status does not preserve the sentinel stop boundary")
    return errors


def validate_discovery(
    document: dict[str, Any] | None = None,
    preregistration: dict[str, Any] | None = None,
) -> list[str]:
    document = load_json(DISCOVERY_PATH) if document is None else document
    preregistration = load_json(PREREGISTRATION_PATH) if preregistration is None else preregistration
    errors = schema_errors(document, "authority-source discovery")
    if errors:
        return errors
    _, binding_errors = binding_bytes(
        document["preregistration_binding"], label="frozen preregistration"
    )
    errors.extend(binding_errors)
    if sha256_bytes(PREREGISTRATION_PATH.read_bytes()) != document["preregistration_binding"]["sha256"]:
        errors.append("discovery does not bind the exact live frozen preregistration")

    candidate_ids = [row["id"] for row in preregistration["cohort_derivation"]["candidates"]]
    candidate_set = set(candidate_ids)
    queries = preregistration["source_discovery_protocol"]["required_queries"]
    expected_query_by_id = {row["id"]: row for row in queries}
    query_log = document["query_log"]
    query_ids = [row["query_id"] for row in query_log]
    if len(query_ids) != len(set(query_ids)) or set(query_ids) != set(expected_query_by_id):
        errors.append("discovery query log does not close the exact required query inventory")
    for row in query_log:
        expected = expected_query_by_id.get(row["query_id"])
        if expected is not None and row["scope"] != expected["scope"]:
            errors.append(f"{row['query_id']}: execution scope differs from preregistration")
        if row["execution_status"] == "ACCESS_FAILURE" and row["results_inspected"] != 0:
            errors.append(f"{row['query_id']}: access failure reports inspected results")

    summary = document["execution_summary"]
    bounds = preregistration["source_discovery_protocol"]["resource_bounds"]
    if summary["closure_status"] == "OPEN":
        errors.append("source discovery is frozen with OPEN closure")
    if summary["required_queries_total"] != len(queries):
        errors.append("discovery required-query total differs from preregistration")
    executed = sum(row["execution_status"] == "EXECUTED" for row in query_log)
    failures = sum(row["execution_status"] == "ACCESS_FAILURE" for row in query_log)
    if summary["required_queries_executed"] != executed:
        errors.append("discovery executed-query summary is not derived from the query log")
    if summary["required_query_access_failures"] != failures:
        errors.append("discovery access-failure summary is not derived from the query log")
    bound_checks = {
        "external_search_queries_executed": "maximum_external_search_queries",
        "primary_source_retrievals": "maximum_primary_source_retrievals",
        "citation_chase_retrievals": "maximum_citation_chase_retrievals",
        "retained_source_candidates": "maximum_retained_source_candidates",
        "retrieved_bytes": "maximum_retrieved_bytes",
        "researcher_hours": "maximum_researcher_hours",
    }
    for actual_name, bound_name in bound_checks.items():
        if summary[actual_name] > bounds[bound_name]:
            errors.append(f"discovery exceeds {bound_name}")

    sources = document["sources"]
    source_by_id = {row["source_candidate_id"]: row for row in sources}
    if len(source_by_id) != len(sources):
        errors.append("source-candidate identities are not unique")
    if summary["retained_source_candidates"] != len(sources):
        errors.append("retained-source count is not derived from sources")
    retrieved_total = 0
    claim_ids: set[str] = set()
    for source in sources:
        source_id = source["source_candidate_id"]
        if source["discovery_source_family"] not in EXPECTED_SOURCE_FAMILIES:
            errors.append(f"{source_id}: source family is outside the frozen surface")
        if not set(source["applicable_candidate_ids"]) <= candidate_set:
            errors.append(f"{source_id}: source maps outside the frozen cohort")
        if source["recommended_disposition"] == "APPROVE" and source["discovery_disposition"] != "CANDIDATE_FOR_APPROVAL":
            errors.append(f"{source_id}: APPROVE recommendation is incompatible with discovery disposition")
        if source["discovery_disposition"] == "IMPLEMENTATION_ONLY" and "IMPLEMENTATION_ONLY" not in source["evidence_character"]:
            errors.append(f"{source_id}: implementation-only source lacks matching evidence character")
        if source["discovery_disposition"] == "VERSION_MISMATCH" and "VERSION_MISMATCH" not in source["evidence_character"]:
            errors.append(f"{source_id}: version mismatch lacks matching evidence character")
        git_values = [source.get(name) for name in ("git_repository", "git_revision", "git_path", "git_blob")]
        if any(value is not None for value in git_values) and not all(value is not None for value in git_values):
            errors.append(f"{source_id}: Git source identity is only partially bound")
        path_value = source.get("retrieved_path")
        if path_value is not None:
            if not safe_relative_path(path_value):
                errors.append(f"{source_id}: retrieved path is not safe and relative")
            else:
                path = ROOT / path_value
                if not path.is_file():
                    errors.append(f"{source_id}: retrieved evidence file is missing")
                else:
                    content = path.read_bytes()
                    if sha256_bytes(content) != source["retrieved_content_sha256"]:
                        errors.append(f"{source_id}: retrieved evidence SHA-256 is stale")
                    if len(content) != source["retrieved_bytes"]:
                        errors.append(f"{source_id}: retrieved byte count is stale")
                    if source.get("git_blob") is not None and git_blob_id(content) != source["git_blob"]:
                        errors.append(f"{source_id}: retrieved content differs from bound Git blob")
        retrieved_total += source["retrieved_bytes"]
        for claim in source["claims_extracted"]:
            if claim["claim_id"] in claim_ids:
                errors.append(f"{claim['claim_id']}: source claim identity is not unique")
            claim_ids.add(claim["claim_id"])
            if not set(claim["applicable_candidate_ids"]) <= set(source["applicable_candidate_ids"]):
                errors.append(f"{claim['claim_id']}: claim maps beyond its source-candidate scope")
    if summary["retrieved_bytes"] != retrieved_total:
        errors.append("retrieved-byte summary is not derived from retained evidence")

    coverage = document["candidate_coverage"]
    if [row["candidate_id"] for row in coverage] != candidate_ids:
        errors.append("candidate coverage does not preserve exact cohort order and closure")
    for row in coverage:
        referenced = [source_by_id.get(source_id) for source_id in row["source_candidate_ids"]]
        if any(source is None for source in referenced):
            errors.append(f"{row['candidate_id']}: coverage references an unknown source")
            continue
        if any(row["candidate_id"] not in source["applicable_candidate_ids"] for source in referenced):
            errors.append(f"{row['candidate_id']}: coverage references a source not mapped to the candidate")
        has_candidate = any(source["discovery_disposition"] == "CANDIDATE_FOR_APPROVAL" for source in referenced)
        expected_status = (
            "HAS_APPROVAL_CANDIDATE" if has_candidate else
            "ONLY_DISQUALIFIED_SOURCES" if referenced else
            "NO_RETAINED_SOURCE"
        )
        if row["coverage_status"] not in {expected_status, "UNRESOLVED_ACCESS_FAILURE"}:
            errors.append(f"{row['candidate_id']}: coverage status is not supported by referenced sources")
    if document["review_sentinels"] != preregistration["review_sentinels"]:
        errors.append("discovery changes the frozen sentinel identities")
    approved = load_json(APPROVED_SOURCES_PATH)
    if approved.get("normative_documentation") or approved.get("mechanized_results"):
        errors.append("source discovery crossed the separate human approval boundary")
    if not REVIEW_PACKET_PATH.is_file():
        errors.append("human source-approval review packet is missing")
    else:
        review = REVIEW_PACKET_PATH.read_text(encoding="utf-8")
        if "FROZEN BEFORE AUTHORITY-SOURCE APPROVAL" not in review:
            errors.append("review packet does not preserve the authority-approval stop boundary")
        for source in sources:
            source_id = source["source_candidate_id"]
            heading = f"### `{source_id}`"
            start = review.find(heading)
            if start < 0:
                errors.append(f"{source_id}: review packet omits source identity")
                continue
            end = review.find("\n### ", start + len(heading))
            section = review[start:] if end < 0 else review[start:end]
            if source["retrieved_content_sha256"] not in section:
                errors.append(f"{source_id}: review packet omits exact content binding")
            recommendation = f"**{source['recommended_disposition']}"
            if recommendation not in section:
                errors.append(f"{source_id}: review packet omits recommended disposition vocabulary")
        for sentinel in document["review_sentinels"]:
            if sentinel not in review:
                errors.append(f"review packet omits fixed sentinel {sentinel}")
    return errors


def file_binding_errors(
    binding: dict[str, Any], expected_path: Path, label: str
) -> list[str]:
    relative = binding.get("path")
    if not isinstance(relative, str) or not safe_relative_path(relative):
        return [f"{label}: path is not safe and relative"]
    if ROOT / relative != expected_path:
        return [f"{label}: path is not canonical"]
    if not expected_path.is_file():
        return [f"{label}: file is missing"]
    if binding.get("sha256") != sha256_bytes(expected_path.read_bytes()):
        return [f"{label}: SHA-256 is stale"]
    return []


def claim_scope_errors(
    catalog: dict[str, Any],
    evidence_lock: dict[str, Any],
    approval: dict[str, Any],
    registry: dict[str, Any],
    sentinel: dict[str, Any],
    *,
    predecessor_locks: list[dict[str, Any]] | None = None,
) -> list[str]:
    """Enforce the human-approved source/claim/candidate relation.

    The Gate-4 compatibility registry authenticates source identities but does
    not encode claim scope.  Gate 5 therefore binds the full approval result
    and makes that missing relation mechanically mandatory.
    """

    errors: list[str] = []
    guard = sentinel["claim_scope_guard"]
    source_decision = next(
        (
            row
            for row in approval["source_decisions"]
            if row["source_candidate_id"] == guard["source_candidate_id"]
        ),
        None,
    )
    claim_decision = None
    if source_decision is not None:
        claim_decision = next(
            (
                row
                for row in source_decision["claim_decisions"]
                if row["claim_id"] == guard["claim_id"]
            ),
            None,
        )
    if source_decision is None or claim_decision is None:
        errors.append("sentinel claim-scope guard does not resolve in the full Gate-4 approval")
    elif (
        source_decision["disposition"] != "APPROVE"
        or claim_decision["disposition"] != "APPROVE"
        or claim_decision["applicable_candidate_ids"] != guard["candidate_ids"]
    ):
        errors.append("sentinel claim-scope guard broadens or changes the human approval")

    approved_source = next(
        (
            row
            for row in registry["normative_documentation"]
            if row["id"] == guard["approved_source_id"]
        ),
        None,
    )
    locked_source = next(
        (
            row
            for lock in [evidence_lock, *(predecessor_locks or [])]
            for row in lock["normative_documentation"]
            if row["id"] == guard["evidence_lock_id"]
        ),
        None,
    )
    if approved_source is None or locked_source is None:
        errors.append("sentinel claim-scope guard does not resolve through registry and evidence lock")
    elif locked_source["approved_source_id"] != approved_source["id"]:
        errors.append("sentinel evidence lock does not use the guarded approved source")

    allowed = {
        (
            guard["candidate_ids"][0],
            guard["evidence_lock_id"],
            guard["catalog_evidence_id"],
        )
    }
    observed: set[tuple[str, str, str]] = set()
    for wrapper in catalog["entries"]:
        entry = wrapper["characterization"]
        for evidence in entry["evidence"]:
            if evidence["role"] != "NORMATIVE_SUPPORT":
                continue
            row = (
                entry["id"],
                evidence["source_lock"]["lock_id"],
                evidence["id"],
            )
            observed.add(row)
            if row not in allowed:
                errors.append(
                    f"{entry['id']}/{evidence['id']}: normative support is outside the exact human-approved claim scope"
                )
    if observed != allowed:
        errors.append("sentinel normative-support set does not exactly reproduce the approved claim scope")
    return errors


def validate_sentinel(
    document: dict[str, Any] | None = None,
    *,
    check_generated: bool = True,
    catalog_bytes: bytes | None = None,
    evidence_lock_bytes: bytes | None = None,
    evidence_lock_schema_document: dict[str, Any] | None = None,
    evidence_lock_schema_sha256_override: str | None = None,
) -> list[str]:
    document = load_json(SENTINEL_PATH) if document is None else document
    errors = schema_errors(
        document, "publication-study Gate-5 sentinel", SENTINEL_SCHEMA_PATH
    )
    if errors:
        return errors

    expected_git_bindings = {
        "preregistration": (PREREGISTRATION_PATH, "c420e451b50fbbb56bb5ba89fb7faa4b65ac9a9a"),
        "source_discovery": (DISCOVERY_PATH, "07ae08eff053959b28e7b0beb1ac7f5505ef9aac"),
        "authority_source_approval": (APPROVAL_PATH, GATE4_COMMIT),
        "approved_authority_source_registry": (APPROVED_SUCCESSOR_PATH, GATE4_COMMIT),
        "immutable_m9_catalog": (M9_REVIEWED_CATALOG_PATH, "69dad9d13e4802e5ef29c958c60d2ee387293847"),
        "m10_protocol_erratum_historical": (
            ROOT / "results" / "research" / "declaration-validation-milestone-10-protocol-erratum-1-historical.json",
            "296bcff8969996c48a0a06d29c254bbaef441bcf",
        ),
    }
    immutable_documents: dict[str, dict[str, Any]] = {}
    for name, (path, commit) in expected_git_bindings.items():
        binding = document["bindings"][name]
        content, binding_errors = binding_bytes(binding, label=f"sentinel {name}")
        errors.extend(binding_errors)
        if ROOT / binding["path"] != path:
            errors.append(f"sentinel {name}: path is not canonical")
        if binding["git_commit"] != commit:
            errors.append(f"sentinel {name}: Git commit differs from frozen stage identity")
        if content is not None:
            immutable_documents[name] = json.loads(content)

    if evidence_lock_bytes is None:
        errors.extend(
            file_binding_errors(
                document["bindings"]["sentinel_evidence_lock"],
                SENTINEL_EVIDENCE_LOCK_PATH,
                "sentinel evidence lock",
            )
        )
        evidence_lock_bytes = SENTINEL_EVIDENCE_LOCK_PATH.read_bytes()
    else:
        binding = document["bindings"]["sentinel_evidence_lock"]
        if ROOT / binding["path"] != SENTINEL_EVIDENCE_LOCK_PATH:
            errors.append("sentinel evidence lock: path is not canonical")
        if binding["sha256"] != sha256_bytes(evidence_lock_bytes):
            errors.append("sentinel evidence lock: SHA-256 differs from historical bytes")
    if catalog_bytes is None:
        errors.extend(
            file_binding_errors(
                document["bindings"]["sentinel_catalog"],
                CATALOG_PATH,
                "sentinel catalog",
            )
        )
        catalog_bytes = CATALOG_PATH.read_bytes()
    else:
        binding = document["bindings"]["sentinel_catalog"]
        if ROOT / binding["path"] != CATALOG_PATH:
            errors.append("sentinel catalog: path is not canonical")
        if binding["sha256"] != sha256_bytes(catalog_bytes):
            errors.append("sentinel catalog: SHA-256 differs from historical bytes")
    errors.extend(
        file_binding_errors(
            document["bindings"]["authority_rules"],
            AUTHORITY_RULES_PATH,
            "sentinel authority rules",
        )
    )

    approval = immutable_documents.get("authority_source_approval", load_json(APPROVAL_PATH))
    registry = immutable_documents.get(
        "approved_authority_source_registry", load_json(APPROVED_SUCCESSOR_PATH)
    )
    catalog = json.loads(catalog_bytes)
    evidence_lock = json.loads(evidence_lock_bytes)
    previous = immutable_documents.get("immutable_m9_catalog")
    if previous is None:
        return errors + ["immutable M9 catalog is unavailable"]

    catalog_validator = load_module(
        "publication_study_sentinel_catalog",
        ROOT / "scripts" / "validate-declaration-validation-catalog",
    )
    errors.extend(
        "sentinel catalog: " + error
        for error in catalog_validator.validate_artifacts(
            catalog,
            load_json(catalog_validator.CATALOG_SCHEMA_PATH),
            load_json(catalog_validator.ENTRY_SCHEMA_PATH),
            load_json(catalog_validator.AUTHORITY_PATH),
            load_json(catalog_validator.AUTHORITY_SCHEMA_PATH),
            load_json(catalog_validator.DECISIONS_PATH),
            load_json(catalog_validator.DECISIONS_SCHEMA_PATH),
            load_json(catalog_validator.TARGET_PATH),
            load_json(catalog_validator.MODEL_PATH),
            load_json(catalog_validator.IDENTITY_PATH),
            load_json(catalog_validator.SOURCE_LOCK_PATH),
            evidence_lock,
            evidence_lock_schema_document
            if evidence_lock_schema_document is not None
            else load_json(catalog_validator.EVIDENCE_LOCK_SCHEMA_PATH),
            registry,
            load_json(catalog_validator.registry_schema_path(APPROVED_SUCCESSOR_PATH)),
            load_json(catalog_validator.PRIOR_DECISIONS_PATH),
            check_generated=check_generated,
            enforce_milestone_boundary=True,
            evidence_lock_schema_sha256_override=evidence_lock_schema_sha256_override,
        )
    )

    current_by_id = {
        row["characterization"]["id"]: row for row in catalog["entries"]
    }
    previous_by_id = {
        row["characterization"]["id"]: row for row in previous["entries"]
    }
    if set(current_by_id) != set(previous_by_id):
        errors.append("sentinel catalog changes the immutable M9 entry inventory")
    for entry_id in set(previous_by_id) - set(EXPECTED_SENTINELS):
        if current_by_id.get(entry_id) != previous_by_id[entry_id]:
            errors.append(f"{entry_id}: non-sentinel entry changed during Gate 5")
    preserved_fields = (
        "identity_denotation",
        "identity_statement_sha256",
        "semantic_denotation_sha256",
        "observer_vector",
        "source_mappings",
        "arena_disposition",
    )
    preserved_characterization_fields = (
        "id",
        "kind",
        "layers",
        "lifecycle",
        "name",
        "schema_version",
        "soundness_relevance",
        "statement",
    )
    for entry_id in EXPECTED_SENTINELS:
        current = current_by_id.get(entry_id)
        prior = previous_by_id.get(entry_id)
        if current is None or prior is None:
            errors.append(f"{entry_id}: sentinel entry is missing")
            continue
        for field in preserved_fields:
            if current[field] != prior[field]:
                errors.append(f"{entry_id}: Gate 5 changes frozen {field}")
        for field in preserved_characterization_fields:
            if current["characterization"][field] != prior["characterization"][field]:
                errors.append(f"{entry_id}: Gate 5 changes frozen characterization {field}")

    decisions = document["sentinel_decisions"]
    if [row["entry_id"] for row in decisions] != EXPECTED_SENTINELS:
        errors.append("Gate-5 decisions differ from the fixed sentinel order")
    for decision in decisions:
        entry_id = decision["entry_id"]
        try:
            current = catalog_validator.resolve_pointer(
                catalog, decision["sentinel_catalog_json_pointer"]
            )
            prior = catalog_validator.resolve_pointer(
                previous, decision["m9_catalog_json_pointer"]
            )
        except (KeyError, IndexError, ValueError):
            errors.append(f"{entry_id}: sentinel decision pointer does not resolve")
            continue
        if current["characterization"]["id"] != entry_id or prior["characterization"]["id"] != entry_id:
            errors.append(f"{entry_id}: sentinel decision pointer resolves to another identity")
        entry = current["characterization"]
        authority = entry["authority"]
        if authority["status"] != decision["authority_status"]:
            errors.append(f"{entry_id}: decision authority status differs from catalog")
        if authority["basis"]["qualification_rule"] != decision["qualification_rule"]:
            errors.append(f"{entry_id}: decision qualification rule differs from catalog")
        if authority["basis"]["evidence_refs"] != decision["authority_evidence_ids"]:
            errors.append(f"{entry_id}: decision authority evidence differs from catalog")
        if authority["basis"]["unmet_requirements"] != decision["unmet_requirements"]:
            errors.append(f"{entry_id}: decision unmet requirements differ from catalog")
        if current["identity_statement_sha256"] != decision["identity_statement_sha256"]:
            errors.append(f"{entry_id}: decision identity hash differs from catalog")
        if current["semantic_denotation_sha256"] != decision["semantic_denotation_sha256"]:
            errors.append(f"{entry_id}: decision semantic hash differs from catalog")

    theorem, let_value = decisions
    if (
        theorem["authority_status"] != "ESTABLISHED"
        or theorem["approved_claim_ids"] != [THEOREM_CLAIM_ID]
        or theorem["authority_evidence_ids"] != [THEOREM_EVIDENCE_ID]
        or theorem["unmet_requirements"]
    ):
        errors.append("theorem sentinel does not record the exact established disposition")
    if (
        let_value["authority_status"] != "PROVISIONAL"
        or let_value["approved_claim_ids"]
        or not let_value["unmet_requirements"]
    ):
        errors.append("let-value sentinel does not preserve the unsupported provisional disposition")

    errors.extend(claim_scope_errors(catalog, evidence_lock, approval, registry, document))
    if len(evidence_lock["normative_documentation"]) != 1:
        errors.append("sentinel evidence lock does not contain exactly one normative document")
    if evidence_lock["mechanized_results"] or evidence_lock["tracked_evidence"] or evidence_lock["generated_witnesses"]:
        errors.append("sentinel evidence lock adds out-of-scope evidence")

    erratum_attestation = immutable_documents.get("m10_protocol_erratum_historical")
    if erratum_attestation is not None:
        binding = erratum_attestation["artifacts"]["protocol_erratum"]
        content, item_errors = binding_bytes(
            binding, label="sentinel immutable M10 protocol erratum", require_live_match=False
        )
        errors.extend(item_errors)
        if content is not None:
            erratum = json.loads(content)
            expected_rule = erratum["operative_protocol_correction"]["corrected_value"]
            expected_role = erratum["auxiliary_control_classification"]["allowed_role"]
            applied = document["m10_erratum_application"]
            if applied["matched_positive_control_rule"] != expected_rule:
                errors.append("sentinel does not apply the immutable M10 theorem-control correction")
            if applied["definition_form_role"] != expected_role:
                errors.append("sentinel changes the immutable definition-form auxiliary role")

    if document["architecture"]["verdict"] != "PASS_AFTER_REPAIR":
        errors.append("sentinel architecture did not pass after the explicit scope repair")
    return errors


def validate_complete_adjudication(
    document: dict[str, Any] | None = None, *, check_generated: bool = True
) -> list[str]:
    document = load_json(ADJUDICATION_PATH) if document is None else document
    errors = schema_errors(
        document,
        "publication-study Gate-6 complete adjudication",
        ADJUDICATION_SCHEMA_PATH,
    )
    if errors:
        return errors

    expected_git_bindings = {
        "preregistration": (
            PREREGISTRATION_PATH,
            "c420e451b50fbbb56bb5ba89fb7faa4b65ac9a9a",
        ),
        "authority_source_approval": (APPROVAL_PATH, GATE4_COMMIT),
        "approved_authority_source_registry": (APPROVED_SUCCESSOR_PATH, GATE4_COMMIT),
        "gate5_sentinel": (SENTINEL_PATH, GATE5_COMMIT),
        "gate5_catalog": (CATALOG_PATH, GATE5_COMMIT),
        "gate5_evidence_lock": (SENTINEL_EVIDENCE_LOCK_PATH, GATE5_COMMIT),
    }
    immutable_bytes: dict[str, bytes] = {}
    immutable_documents: dict[str, dict[str, Any]] = {}
    for name, (path, commit) in expected_git_bindings.items():
        binding = document["bindings"][name]
        content, binding_errors = binding_bytes(
            binding, label=f"complete adjudication {name}", require_live_match=False
        )
        errors.extend(binding_errors)
        if ROOT / binding["path"] != path:
            errors.append(f"complete adjudication {name}: path is not canonical")
        if binding["git_commit"] != commit:
            errors.append(
                f"complete adjudication {name}: Git commit differs from frozen stage identity"
            )
        if content is not None:
            immutable_bytes[name] = content
            immutable_documents[name] = json.loads(content)

    errors.extend(
        file_binding_errors(
            document["bindings"]["current_catalog"],
            CATALOG_PATH,
            "complete adjudication current catalog",
        )
    )
    errors.extend(
        file_binding_errors(
            document["bindings"]["current_evidence_lock"],
            ADJUDICATION_EVIDENCE_LOCK_PATH,
            "complete adjudication current evidence lock",
        )
    )
    errors.extend(
        file_binding_errors(
            document["bindings"]["authority_rules"],
            AUTHORITY_RULES_PATH,
            "complete adjudication authority rules",
        )
    )
    required_historical = set(expected_git_bindings)
    if not required_historical.issubset(immutable_documents):
        return errors + ["Gate-5 predecessor bytes are unavailable"]

    gate5_evidence_schema_bytes, gate5_evidence_schema_error = git_output(
        ["show", f"{GATE5_COMMIT}:schemas/declaration-validation-evidence-lock.schema.json"]
    )
    if gate5_evidence_schema_error or gate5_evidence_schema_bytes is None:
        errors.append("Gate-5 evidence-lock schema bytes are unavailable")
        gate5_evidence_schema = None
        gate5_evidence_schema_sha256 = None
    else:
        gate5_evidence_schema = json.loads(gate5_evidence_schema_bytes)
        gate5_evidence_schema_sha256 = sha256_bytes(gate5_evidence_schema_bytes)

    errors.extend(
        "historical Gate-5 sentinel: " + error
        for error in validate_sentinel(
            immutable_documents["gate5_sentinel"],
            check_generated=False,
            catalog_bytes=immutable_bytes["gate5_catalog"],
            evidence_lock_bytes=immutable_bytes["gate5_evidence_lock"],
            evidence_lock_schema_document=gate5_evidence_schema,
            evidence_lock_schema_sha256_override=gate5_evidence_schema_sha256,
        )
    )

    preregistration = immutable_documents["preregistration"]
    approval = immutable_documents["authority_source_approval"]
    registry = immutable_documents["approved_authority_source_registry"]
    gate5_sentinel = immutable_documents["gate5_sentinel"]
    gate5_catalog = immutable_documents["gate5_catalog"]
    gate5_lock = immutable_documents["gate5_evidence_lock"]
    current_catalog = load_json(CATALOG_PATH)
    current_lock = load_json(ADJUDICATION_EVIDENCE_LOCK_PATH)

    catalog_validator = load_module(
        "publication_study_complete_adjudication_catalog",
        ROOT / "scripts" / "validate-declaration-validation-catalog",
    )
    errors.extend(
        "complete adjudication catalog: " + error
        for error in catalog_validator.validate_artifacts(
            current_catalog,
            load_json(catalog_validator.CATALOG_SCHEMA_PATH),
            load_json(catalog_validator.ENTRY_SCHEMA_PATH),
            load_json(catalog_validator.AUTHORITY_PATH),
            load_json(catalog_validator.AUTHORITY_SCHEMA_PATH),
            load_json(catalog_validator.DECISIONS_PATH),
            load_json(catalog_validator.DECISIONS_SCHEMA_PATH),
            load_json(catalog_validator.TARGET_PATH),
            load_json(catalog_validator.MODEL_PATH),
            load_json(catalog_validator.IDENTITY_PATH),
            load_json(catalog_validator.SOURCE_LOCK_PATH),
            current_lock,
            load_json(catalog_validator.EVIDENCE_LOCK_SCHEMA_PATH),
            registry,
            load_json(catalog_validator.registry_schema_path(APPROVED_SUCCESSOR_PATH)),
            load_json(catalog_validator.PRIOR_DECISIONS_PATH),
            check_generated=check_generated,
            enforce_milestone_boundary=True,
        )
    )

    candidates = preregistration["cohort_derivation"]["candidates"]
    candidate_ids = [row["id"] for row in candidates]
    remaining_ids = [item for item in candidate_ids if item not in EXPECTED_SENTINELS]
    decisions = document["decisions"]
    if [row["entry_id"] for row in decisions] != candidate_ids:
        errors.append("Gate-6 decisions differ from the exact preregistered cohort order")
    if len(set(candidate_ids)) != 15 or len(remaining_ids) != 13:
        errors.append("Gate-6 candidate partition is not exactly two sentinels plus thirteen remaining")

    gate5_by_id = {
        row["characterization"]["id"]: row for row in gate5_catalog["entries"]
    }
    current_by_id = {
        row["characterization"]["id"]: row for row in current_catalog["entries"]
    }
    if set(gate5_by_id) != set(current_by_id):
        errors.append("Gate 6 changes the Gate-5 catalog entry inventory")
    for entry_id in set(gate5_by_id):
        before = gate5_by_id[entry_id]
        after = current_by_id.get(entry_id)
        if after is None:
            continue
        if entry_id in remaining_ids:
            projected = json.loads(json.dumps(after))
            projected["characterization"]["authority"] = before["characterization"]["authority"]
            if projected != before:
                errors.append(f"{entry_id}: Gate 6 changes a field outside authority adjudication")
        elif after != before:
            errors.append(f"{entry_id}: Gate 6 changes a sentinel or non-cohort entry")

    candidate_by_id = {row["id"]: row for row in candidates}
    decision_by_id = {row["entry_id"]: row for row in decisions}
    for entry_id in candidate_ids:
        decision = decision_by_id.get(entry_id)
        entry_wrapper = current_by_id.get(entry_id)
        if decision is None or entry_wrapper is None:
            errors.append(f"{entry_id}: complete adjudication decision or catalog entry is missing")
            continue
        expected_stage = (
            "GATE_5_SENTINEL_PRESERVED"
            if entry_id in EXPECTED_SENTINELS
            else "GATE_6_REMAINING_COHORT"
        )
        if decision["stage"] != expected_stage:
            errors.append(f"{entry_id}: adjudication stage is incorrect")
        preregistered = candidate_by_id[entry_id]
        if decision["identity_statement_sha256"] != preregistered["identity_statement_sha256"]:
            errors.append(f"{entry_id}: decision changes the frozen identity statement hash")
        if decision["semantic_denotation_sha256"] != preregistered["semantic_denotation_sha256"]:
            errors.append(f"{entry_id}: decision changes the frozen semantic denotation hash")

        applicable_claims: list[dict[str, str]] = []
        for source in approval["source_decisions"]:
            for claim in source["claim_decisions"]:
                if entry_id in claim["applicable_candidate_ids"]:
                    applicable_claims.append(
                        {
                            "source_candidate_id": source["source_candidate_id"],
                            "claim_id": claim["claim_id"],
                            "disposition": claim["disposition"],
                        }
                    )
        expected_counts = {
            disposition.lower(): sum(
                row["disposition"] == disposition for row in applicable_claims
            )
            for disposition in ("APPROVE", "DEFER", "REJECT")
        }
        approved_claims = [
            row["claim_id"] for row in applicable_claims if row["disposition"] == "APPROVE"
        ]
        if decision["gate4_claim_decision_counts"] != expected_counts:
            errors.append(f"{entry_id}: Gate-4 claim-decision counts are not reproduced exactly")
        if decision["approved_claim_ids"] != approved_claims:
            errors.append(f"{entry_id}: approved claims differ from the frozen Gate-4 decisions")

        characterization = entry_wrapper["characterization"]
        authority = characterization["authority"]
        if decision["authority_status"] != authority["status"]:
            errors.append(f"{entry_id}: decision authority status differs from the catalog")
        if decision["qualification_rule"] != authority["basis"]["qualification_rule"]:
            errors.append(f"{entry_id}: decision qualification rule differs from the catalog")
        if decision["authority_evidence_ids"] != authority["basis"]["evidence_refs"]:
            errors.append(f"{entry_id}: decision authority evidence differs from the catalog")
        if entry_wrapper["identity_statement_sha256"] != decision["identity_statement_sha256"]:
            errors.append(f"{entry_id}: catalog identity hash differs from the decision")
        if entry_wrapper["semantic_denotation_sha256"] != decision["semantic_denotation_sha256"]:
            errors.append(f"{entry_id}: catalog semantic hash differs from the decision")

        normative_support = [
            row for row in characterization["evidence"] if row["role"] == "NORMATIVE_SUPPORT"
        ]
        if approved_claims:
            if (
                entry_id != "DECL.THEOREM.TYPE_PROP"
                or approved_claims != [THEOREM_CLAIM_ID]
                or authority["status"] != "ESTABLISHED"
                or authority["basis"]["qualification_rule"] != "AUTH.NORMATIVE.ESTABLISHED.V1"
                or [row["id"] for row in normative_support] != [THEOREM_EVIDENCE_ID]
            ):
                errors.append(f"{entry_id}: approved authority is not qualified exactly")
        elif (
            authority["status"] != "PROVISIONAL"
            or authority["basis"]["qualification_rule"] != "AUTH.NORMATIVE.PROVISIONAL.V1"
            or not authority["basis"]["unmet_requirements"]
            or normative_support
        ):
            errors.append(f"{entry_id}: unsupported candidate is not preserved as provisional")
        if characterization["soundness_relevance"]["status"] != "NOT_ASSESSED":
            errors.append(f"{entry_id}: Gate 6 changes soundness relevance")

    actual_counts = {
        "total_candidates": len(decisions),
        "newly_adjudicated_at_gate6": sum(
            row["stage"] == "GATE_6_REMAINING_COHORT" for row in decisions
        ),
        "established": sum(row["authority_status"] == "ESTABLISHED" for row in decisions),
        "provisional": sum(row["authority_status"] == "PROVISIONAL" for row in decisions),
        "unresolved": sum(row["authority_status"] == "UNRESOLVED" for row in decisions),
    }
    if document["counts"] != actual_counts:
        errors.append("Gate-6 disposition counts do not derive from the exact decisions")

    errors.extend(
        claim_scope_errors(
            current_catalog,
            current_lock,
            approval,
            registry,
            gate5_sentinel,
            predecessor_locks=[gate5_lock],
        )
    )
    if current_lock["sequence"] != 8:
        errors.append("complete adjudication evidence lock is not sequence 8")
    if current_lock["status"] != "PUBLICATION_STUDY_COMPLETE_ADJUDICATION_EVIDENCE_FREEZE":
        errors.append("complete adjudication evidence lock status is incorrect")
    if current_lock["predecessor"] != {
        "kind": "EVIDENCE_LOCK",
        "path": "config/declaration-validation-evidence-locks/publication-study-sentinel.json",
        "sha256": sha256_bytes(immutable_bytes["gate5_evidence_lock"]),
    }:
        errors.append("complete adjudication evidence lock predecessor is not exact Gate 5")
    for field in ("normative_documentation", "mechanized_results", "tracked_evidence", "generated_witnesses"):
        if current_lock[field]:
            errors.append(f"complete adjudication evidence lock adds out-of-scope {field}")
    if current_catalog["status"] != "PUBLICATION_STUDY_COMPLETE_ADJUDICATION":
        errors.append("catalog does not record Gate-6 complete adjudication status")
    if current_catalog["completion_boundary"]["next_milestone"] != "PUBLICATION_STUDY_GATE_7_DENOMINATOR_FREEZE":
        errors.append("Gate 6 does not stop before denominator freeze")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--require-discovery", action="store_true")
    parser.add_argument("--require-approval", action="store_true")
    parser.add_argument("--require-sentinel", action="store_true")
    parser.add_argument("--require-adjudication", action="store_true")
    args = parser.parse_args()
    errors = validate_preregistration()
    if DISCOVERY_PATH.exists():
        errors.extend(validate_discovery())
    elif args.require_discovery:
        errors.append("frozen source-discovery result is missing")
    if APPROVAL_PATH.exists():
        errors.extend(validate_approval())
    elif args.require_approval:
        errors.append("human authority-source approval result is missing")
    if ADJUDICATION_PATH.exists():
        errors.extend(validate_complete_adjudication())
    elif SENTINEL_PATH.exists():
        errors.extend(validate_sentinel())
    elif args.require_sentinel:
        errors.append("Gate-5 sentinel result is missing")
    if args.require_adjudication and not ADJUDICATION_PATH.exists():
        errors.append("Gate-6 complete adjudication result is missing")
    if errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        return 1
    preregistration = load_json(PREREGISTRATION_PATH)
    candidates = preregistration["cohort_derivation"]["candidates"]
    holdouts = preregistration["cohort_derivation"]["technical_readiness_holdouts"]
    print(
        "Declaration-validation publication-study validation passed: "
        f"{len(candidates)} preregistered candidates, {len(holdouts)} readiness holdouts, "
        f"source discovery {'frozen' if DISCOVERY_PATH.exists() else 'not yet executed'}; "
        f"authority-source approval {'frozen' if APPROVAL_PATH.exists() else 'not yet recorded'}; "
        f"Gate-5 sentinel {'validated' if SENTINEL_PATH.exists() else 'not yet executed'}; "
        f"Gate-6 complete adjudication {'validated' if ADJUDICATION_PATH.exists() else 'not yet executed'}."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
