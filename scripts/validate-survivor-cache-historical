#!/usr/bin/env python3
"""Validate SURVIVOR-CACHE-1 against its closure snapshot after queue advance."""
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.survivor_cache_historical import validate  # noqa: E402

try:
    print(json.dumps(validate(ROOT), indent=2))
except (ValueError, OSError, KeyError, json.JSONDecodeError) as error:
    print("historical survivor-cache validation refused: " + str(error), file=sys.stderr)
    raise SystemExit(2)
