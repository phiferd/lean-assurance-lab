def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def document_bytes(document: dict[str, Any]) -> bytes:
    return (json.dumps(document, indent=2, sort_keys=True) + "\n").encode("utf-8")


def document_sha256(document: dict[str, Any]) -> str:
    return hashlib.sha256(document_bytes(document)).hexdigest()


def load_module(name: str, path: Path) -> Any:
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"could not load {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def resolve_pointer(document: Any, pointer: str) -> Any:
    if pointer == "":
        return document
    if not pointer.startswith("/"):
        raise KeyError("not a JSON Pointer")
    current = document
    for raw in pointer[1:].split("/"):
        if re.search(r"~(?:[^01]|$)", raw):
            raise KeyError("invalid JSON Pointer escape")
        part = raw.replace("~1", "/").replace("~0", "~")
        if isinstance(current, list):
            if not re.fullmatch(r"0|[1-9][0-9]*", part):
                raise KeyError("invalid JSON Pointer array index")
            index = int(part)
            if index >= len(current):
                raise IndexError(index)
            current = current[index]
        elif isinstance(current, dict):
            current = current[part]
        else:
            raise KeyError(part)
    return current


def schema_errors(
    instance: dict[str, Any],
    schema: dict[str, Any],
    label: str,
) -> list[str]:
    validator = jsonschema.Draft202012Validator(
        schema,
        format_checker=jsonschema.FormatChecker(),
    )
    errors: list[str] = []
    for error in sorted(validator.iter_errors(instance), key=lambda item: list(item.absolute_path)):
        where = "/" + "/".join(str(part) for part in error.absolute_path)
        errors.append(f"{label} schema {where}: {error.message}")
    return errors


def unique_index(rows: list[dict[str, Any]], field: str, label: str) -> tuple[dict[str, dict[str, Any]], list[str]]:
    index: dict[str, dict[str, Any]] = {}
    errors: list[str] = []
    for row in rows:
        value = row[field]
        if value in index:
            errors.append(f"duplicate {label}: {value}")
        index[value] = row
    return index, errors


def binding_errors(bindings: dict[str, Any], expected: dict[str, Path], label: str) -> list[str]:
    errors: list[str] = []
    if set(bindings) != set(expected):
        errors.append(f"{label} binding names are not exact")
        return errors
    for name, path in expected.items():
        binding = bindings[name]
        if ROOT / binding["path"] != path:
            errors.append(f"{label} {name} path is not canonical")
        elif binding["sha256"] != sha256_file(path):
            errors.append(f"{label} {name} hash is stale")
    return errors


def source_lock_indices(
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]] | None = None,
) -> dict[str, tuple[str, dict[str, Any]]]:
    result: dict[str, tuple[str, dict[str, Any]]] = {}
    for section, kind in [
        ("repositories", "repository"),
        ("source_files", "source_file"),
        ("tracked_evidence", "tracked_evidence"),
        ("generated_witnesses", "generated_witness"),
        ("optional_local_observations", "optional_local_observation"),
    ]:
        for row in source_lock[section]:
            result[row["id"]] = (kind, row)
    for row in source_lock["observer_configurations"]:
        result[f"OBSERVER.{row['observer']}"] = ("observer_configuration", row)
    for section in ("normative_documentation", "mechanized_results"):
        for row in source_lock[section]["records"]:
            result[row["id"]] = (section, row)
    for evidence_lock in evidence_locks or []:
        for section, kind in (
            ("normative_documentation", "normative_documentation"),
            ("mechanized_results", "mechanized_results"),
            ("tracked_evidence", "tracked_evidence"),
            ("generated_witnesses", "generated_witness"),
        ):
            for row in evidence_lock[section]:
                result[row["id"]] = (kind, row)
    return result


def pointer_is_within(pointer: str, allowed: set[str]) -> bool:
    return any(
        pointer == root or pointer.startswith(root.rstrip("/") + "/")
        for root in allowed
    )


def document_contains_case_id(value: Any, case_id: str) -> bool:
    if isinstance(value, dict):
        if any(value.get(key) == case_id for key in ("id", "case_id", "name")):
            return True
        return any(document_contains_case_id(item, case_id) for item in value.values())
    if isinstance(value, list):
        return any(document_contains_case_id(item, case_id) for item in value)
    return False


def safe_relative_path(value: str) -> bool:
    path = Path(value)
    return not path.is_absolute() and ".." not in path.parts and value not in {"", "."}


def is_tracked(relative: str) -> bool:
    return subprocess.run(
        ["git", "ls-files", "--error-unmatch", relative],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def validate_evidence_lock_chain(
    current: dict[str, Any],
    schema: dict[str, Any],
    source_lock: dict[str, Any],
    *,
    check_git_tracking: bool = True,
) -> tuple[list[str], list[dict[str, Any]]]:
    """Validate a successor chain without mutating the frozen Milestone 6 lock."""
    errors: list[str] = []
    chain_reversed: list[dict[str, Any]] = []
    seen_hashes: set[str] = set()
    cursor = current
    while True:
        current_schema_errors = schema_errors(
            cursor, schema, f"evidence lock {cursor.get('lock_id', 'UNKNOWN')}"
        )
        errors.extend(current_schema_errors)
        if current_schema_errors:
            return errors, list(reversed(chain_reversed))
        digest = document_sha256(cursor)
        if digest in seen_hashes:
            errors.append("evidence-lock predecessor chain contains a cycle")
            break
        seen_hashes.add(digest)
        chain_reversed.append(cursor)
        predecessor = cursor.get("predecessor", {})
        if predecessor.get("kind") == "MILESTONE_6_SOURCE_LOCK":
            if ROOT / predecessor.get("path", "") != SOURCE_LOCK_PATH:
                errors.append("evidence-lock root does not name the canonical Milestone 6 source lock")
            elif predecessor.get("sha256") != sha256_file(SOURCE_LOCK_PATH):
                errors.append("evidence-lock root source-lock hash is stale")
            break
        if predecessor.get("kind") != "EVIDENCE_LOCK":
            errors.append("evidence-lock predecessor kind is invalid")
            break
        relative = predecessor.get("path", "")
        if not safe_relative_path(relative) or not relative.startswith(
            "config/declaration-validation-evidence-locks/"
        ):
            errors.append("evidence-lock predecessor path is not canonical and safe")
            break
        path = ROOT / relative
        if not path.is_file():
            errors.append(f"evidence-lock predecessor is missing: {relative}")
            break
        if sha256_file(path) != predecessor.get("sha256"):
            errors.append(f"evidence-lock predecessor hash is stale: {relative}")
            break
        try:
            cursor = load_json(path)
        except (OSError, json.JSONDecodeError):
            errors.append(f"evidence-lock predecessor is unreadable JSON: {relative}")
            break

    chain = list(reversed(chain_reversed))
    for index, lock in enumerate(chain, start=1):
        if lock.get("sequence") != index:
            errors.append(f"{lock.get('lock_id', 'UNKNOWN')}: evidence-lock sequence is not contiguous")
    if chain:
        root = chain[0]
        if root.get("status") != "MILESTONE_7_EMPTY_EVIDENCE_LOCK" or root.get("sequence") != 1:
            errors.append("evidence-lock chain does not start at the Milestone 7 empty root")
        if any(root.get(section) for section in (
            "normative_documentation",
            "mechanized_results",
            "tracked_evidence",
            "generated_witnesses",
        )):
            errors.append("Milestone 7 evidence-lock root is not empty")

    base_ids = set(source_lock_indices(source_lock))
    seen_ids = set(base_ids)
    tracked_paths = {row["path"] for row in source_lock["tracked_evidence"]}
    identity_ids = {row["id"] for row in load_json(IDENTITY_PATH)["identities"]}
    for lock in chain:
        for section in (
            "normative_documentation",
            "mechanized_results",
            "tracked_evidence",
            "generated_witnesses",
        ):
            for row in lock[section]:
                if row["id"] in seen_ids:
                    errors.append(f"duplicate source/evidence lock ID across successor chain: {row['id']}")
                seen_ids.add(row["id"])
        for row in lock["normative_documentation"]:
            relative = row["retrieved_path"]
            path = ROOT / relative
            if not safe_relative_path(relative) or not path.is_file():
                errors.append(f"{row['id']}: normative-document snapshot is missing or unsafe")
            elif sha256_file(path) != row["retrieved_content_sha256"]:
                errors.append(f"{row['id']}: normative-document snapshot hash is stale")
            elif check_git_tracking and not is_tracked(relative):
                errors.append(f"{row['id']}: normative-document snapshot is not tracked by Git")
        for row in lock["mechanized_results"]:
            relative = row["retrieved_path"]
            path = ROOT / relative
            if not safe_relative_path(relative) or not path.is_file():
                errors.append(f"{row['id']}: mechanized source snapshot is missing or unsafe")
            elif sha256_file(path) != row["retrieved_content_sha256"]:
                errors.append(f"{row['id']}: mechanized source snapshot hash is stale")
            elif check_git_tracking and not is_tracked(relative):
                errors.append(f"{row['id']}: mechanized source snapshot is not tracked by Git")
        for row in lock["tracked_evidence"]:
            relative = row["path"]
            path = ROOT / relative
            if not safe_relative_path(relative) or not path.is_file():
                errors.append(f"{row['id']}: successor tracked evidence is missing or unsafe")
                continue
            if sha256_file(path) != row["file_sha256"]:
                errors.append(f"{row['id']}: successor tracked-evidence hash is stale")
            if check_git_tracking and not is_tracked(relative):
                errors.append(f"{row['id']}: successor tracked evidence is not tracked by Git")
            tracked_paths.add(relative)
            try:
                document = load_json(path)
            except (OSError, json.JSONDecodeError, UnicodeDecodeError):
                errors.append(f"{row['id']}: successor tracked evidence is not JSON")
                continue
            for pointer in row["json_pointer_or_case_id"]:
                if pointer.startswith("/"):
                    try:
                        resolve_pointer(document, pointer)
                    except (KeyError, IndexError, ValueError):
                        errors.append(f"{row['id']}: successor JSON pointer does not resolve: {pointer}")
        for row in lock["generated_witnesses"]:
            relative = row["path"]
            path = ROOT / relative
            if not safe_relative_path(relative) or not path.is_file():
                errors.append(f"{row['id']}: successor witness is missing or unsafe")
            elif sha256_file(path) != row["artifact_sha256"]:
                errors.append(f"{row['id']}: successor witness hash is stale")
            elif check_git_tracking and not is_tracked(relative):
                errors.append(f"{row['id']}: successor witness is not tracked by Git")
            if row["generator_or_origin"] not in tracked_paths:
                errors.append(f"{row['id']}: successor witness origin is not content-bound tracked evidence")
            unknown = set(row["relevant_case_id"]) - identity_ids
            if unknown:
                errors.append(f"{row['id']}: successor witness names unknown identities {sorted(unknown)}")
    return errors, chain


def evidence_source_errors(
    evidence: dict[str, Any],
    target: dict[str, Any],
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]],
) -> list[str]:
    errors: list[str] = []
    registry_name = evidence["source_lock"]["registry"]
    lock_id = evidence["source_lock"]["lock_id"]
    indices = source_lock_indices(source_lock, evidence_locks)
    locked: tuple[str, dict[str, Any]] | None = None
    if registry_name == "SEMANTIC_TARGET_PROFILE":
        allowed = {
            target["profile_id"],
            target["logical_target"]["target_id"],
            "/logical_target/modeled_judgment",
            *OBSERVER_POINTERS,
        }
        if lock_id not in allowed:
            errors.append(f"{evidence['id']}: unknown semantic-target lock id {lock_id}")
        if evidence["role"] != "DISCOVERY" or evidence["source_type"] != "OTHER":
            errors.append(
                f"{evidence['id']}: semantic-target profile is identity/applicability discovery only"
            )
    elif registry_name == "DECLARATION_VALIDATION_SOURCE_LOCK":
        locked = indices.get(lock_id)
        if locked is None:
            errors.append(f"{evidence['id']}: unknown source-lock id {lock_id}")
    else:
        locked = indices.get(lock_id)
        if locked is None or locked[0] not in {"tracked_evidence", "generated_witness"}:
            errors.append(f"{evidence['id']}: local-artifact lock id is not content-bound by the source lock")

    if locked is None:
        return errors
    kind, row = locked
    allowed_kinds = SOURCE_TYPE_LOCK_KINDS[evidence["source_type"]]
    if kind not in allowed_kinds:
        errors.append(
            f"{evidence['id']}: source type {evidence['source_type']} is incompatible "
            f"with locked record kind {kind}"
        )
    if kind == "normative_documentation":
        expected_type = (
            "NORMATIVE_SPECIFICATION"
            if row["document_kind"] == "SPECIFICATION"
            else "AUTHORITATIVE_DOCUMENTATION"
        )
        if evidence["source_type"] != expected_type:
            errors.append(f"{evidence['id']}: normative document kind disagrees with source type")
    locator = evidence["exact_locator"]
    value = locator["value"]
    locator_kind = locator["kind"]
    if kind == "tracked_evidence":
        allowed_locators = set(row["json_pointer_or_case_id"])
        if locator_kind == "JSON_POINTER":
            pointer = value
            if "#" in value:
                path, pointer = value.split("#", 1)
                if path != row["path"]:
                    errors.append(f"{evidence['id']}: JSON locator path disagrees with tracked evidence {lock_id}")
            if not pointer_is_within(pointer, allowed_locators):
                errors.append(f"{evidence['id']}: JSON locator is not bound by tracked evidence {lock_id}")
            else:
                try:
                    resolve_pointer(load_json(ROOT / row["path"]), pointer)
                except (OSError, json.JSONDecodeError, KeyError, IndexError, ValueError):
                    errors.append(f"{evidence['id']}: JSON locator does not resolve in tracked evidence {lock_id}")
        elif locator_kind == "CASE_ID":
            try:
                document = load_json(ROOT / row["path"])
            except (OSError, json.JSONDecodeError):
                errors.append(f"{evidence['id']}: case artifact is not readable JSON")
            else:
                if not document_contains_case_id(document, value):
                    errors.append(f"{evidence['id']}: case ID does not resolve in tracked evidence {lock_id}")
        elif locator_kind == "COMMAND" and value not in allowed_locators:
            errors.append(f"{evidence['id']}: command locator is not bound by tracked evidence {lock_id}")
    elif kind == "generated_witness":
        if locator_kind == "ARTIFACT_SHA256" and value != row["artifact_sha256"]:
            errors.append(f"{evidence['id']}: artifact digest locator disagrees with witness {lock_id}")
        elif locator_kind not in {"ARTIFACT_SHA256", "CASE_ID"}:
            errors.append(f"{evidence['id']}: incompatible witness locator kind {locator_kind}")
    elif kind == "source_file":
        if locator_kind not in {"SOURCE_SYMBOL", "SOURCE_RANGE"}:
            errors.append(f"{evidence['id']}: source file requires a source symbol or range locator")
        else:
            tokens = row["locator_verification"]["tokens"]
            mechanically_bound = value == row["symbol_or_range"] or any(
                value == token or value == token.split()[-1] for token in tokens
            )
            if not mechanically_bound:
                errors.append(
                    f"{evidence['id']}: source symbol/range is not bound by the source-lock locator"
                )
    elif kind == "normative_documentation":
        if locator_kind != "DOCUMENT_SECTION" or value != row["section_anchor_or_page"]:
            errors.append(f"{evidence['id']}: normative-document locator is not exact")
    elif kind == "mechanized_results":
        if locator_kind != "THEOREM_OR_DEFINITION" or value != row["theorem_or_definition"]:
            errors.append(f"{evidence['id']}: mechanized-result locator is not exact")
    return errors


def evidence_matches_observation(
    evidence: dict[str, Any], profile_pointer: str, outcome: str
) -> bool:
    secondary = set(evidence["exact_locator"].get("secondary", []))
    return {
        f"observer_profile={profile_pointer}",
        f"outcome={outcome}",
    } <= secondary


def validate_rule_set(authority: dict[str, Any]) -> tuple[list[str], dict[str, dict[str, Any]]]:
    errors: list[str] = []
    rules_by_id, new = unique_index(authority["rules"], "id", "authority rule")
    errors.extend(new)
    by_pair: dict[tuple[str, str], dict[str, Any]] = {}
    for rule in authority["rules"]:
        applies = rule["applies_to"]
        pair = (applies["kind"], applies["authority_status"])
        if pair in by_pair:
            errors.append(f"duplicate authority kind/status rule: {pair}")
        by_pair[pair] = rule
        if set(rule["checks"]) != EXPECTED_RULE_CHECKS.get(pair, set()):
            errors.append(f"{rule['id']}: qualification checks differ from frozen V1 sufficiency")
        expected_scope = (
            "NORMATIVE_REQUIREMENT_FOR_MODELED_JUDGMENT"
            if pair[0] == "NORMATIVE_CANDIDATE_OBLIGATION"
            else "EMPIRICAL_BOUNDARY_FOR_PINNED_PROFILES"
        )
        if applies["authority_scope"] != expected_scope:
            errors.append(f"{rule['id']}: authority scope does not match kind")
    if set(by_pair) != set(EXPECTED_RULE_CHECKS):
        errors.append("authority rules do not cover exactly both kinds and all three statuses")
    return errors, rules_by_id


def validate_entry(
    wrapper: dict[str, Any],
    *,
    catalog_ids: set[str],
    identities: dict[str, dict[str, Any]],
    decision_ids: set[str],
    authority_rules: dict[str, dict[str, Any]],
    target: dict[str, Any],
    model: dict[str, Any],
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]],
) -> list[str]:
    errors: list[str] = []
    entry = wrapper["characterization"]
    entry_id = entry["id"]
    identity = identities.get(entry_id)
    if identity is None:
        errors.append(f"{entry_id}: catalog ID is absent from the frozen identity registry")
    else:
        expected_denotation = {
            "semantic_statement": identity["semantic_statement"],
            "applicability": identity["applicability"],
            "intended_kind": identity["intended_kind"],
        }
        if wrapper["identity_denotation"] != expected_denotation:
            errors.append(f"{entry_id}: structured identity denotation differs from the frozen registry")
        expected_identity_hash = hashlib.sha256(
            json.dumps(expected_denotation, sort_keys=True, separators=(",", ":")).encode("utf-8")
        ).hexdigest()
        if wrapper["identity_statement_sha256"] != identity["statement_sha256"]:
            errors.append(f"{entry_id}: identity statement hash is stale")
        if wrapper["identity_statement_sha256"] != expected_identity_hash:
            errors.append(f"{entry_id}: identity statement hash does not bind the structured denotation")
        intended = identity["intended_kind"]
        if intended is not None and entry["kind"] != intended:
            errors.append(f"{entry_id}: catalog kind changes the frozen identity denotation")
        if identity["identity_status"] in {"RESERVED_OUT_OF_SCOPE", "DEFERRED_KIND"}:
            errors.append(f"{entry_id}: reserved/deferred identity cannot be admitted as a catalog entry")
        if not set(identity["decision_ids"]) <= set(wrapper["decision_ids"]):
            errors.append(f"{entry_id}: catalog entry omits its frozen identity decision")

        if entry["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION":
            if entry["statement"]["target_premise"]["statement"] != identity["semantic_statement"]:
                errors.append(f"{entry_id}: normative target premise changes the stable semantic identity")
            applicability_statements = {
                item["statement"] for item in entry["statement"]["applicability"]
            }
            if identity["applicability"] not in applicability_statements:
                errors.append(f"{entry_id}: normative applicability does not include the frozen applicability")
            if entry["statement"]["expected_effect"]["violation_expectation"] == "ACCEPT":
                errors.append(f"{entry_id}: normative candidate cannot expect acceptance of its violation")
            if (
                entry["authority"]["status"] == "ESTABLISHED"
                and entry["statement"]["expected_effect"]["violation_expectation"] != "REJECT"
            ):
                errors.append(f"{entry_id}: established normative candidate must expect rejection")
        else:
            if entry["statement"]["subject_scope"] != identity["applicability"]:
                errors.append(f"{entry_id}: empirical subject scope changes the stable applicability")
            if entry["statement"]["stimulus"]["statement"] != identity["semantic_statement"]:
                errors.append(f"{entry_id}: empirical stimulus changes the stable semantic identity")

    for decision_id in wrapper["decision_ids"]:
        if decision_id not in decision_ids:
            errors.append(f"{entry_id}: unknown decision ID {decision_id}")

    targets = entry["lifecycle"]["target_ids"]
    for target_id in targets:
        if target_id == entry_id:
            errors.append(f"{entry_id}: lifecycle target cannot reference itself")
        elif target_id not in catalog_ids:
            errors.append(f"{entry_id}: lifecycle target is not a catalog entry: {target_id}")

    evidence_by_id, new = unique_index(entry["evidence"], "id", f"{entry_id} evidence ID")
    errors.extend(new)
    all_evidence_refs = set(entry["authority"]["basis"]["evidence_refs"])
    all_evidence_refs.update(entry["soundness_relevance"]["basis_evidence_refs"])
    for observation in wrapper["observer_vector"]:
        all_evidence_refs.update(observation["evidence_refs"])
    for mapping in wrapper["source_mappings"]:
        all_evidence_refs.update(mapping["evidence_refs"])
    unknown_refs = all_evidence_refs - set(evidence_by_id)
    if unknown_refs:
        errors.append(f"{entry_id}: unresolved evidence refs {sorted(unknown_refs)}")

    pointer_errors = False
    source_errors = False
    role_source_matrix = model["evidence_qualification"]["role_source_type_matrix"]
    for evidence in entry["evidence"]:
        if evidence["source_type"] not in role_source_matrix[evidence["role"]]:
            errors.append(
                f"{entry_id}/{evidence['id']}: evidence role/source-type combination is not qualified"
            )
        pointer = evidence["claim_supported"]["entry_json_pointer"]
        try:
            resolve_pointer(entry, pointer)
        except (KeyError, IndexError, ValueError):
            errors.append(f"{entry_id}/{evidence['id']}: claim JSON Pointer does not resolve")
            pointer_errors = True
        found = evidence_source_errors(evidence, target, source_lock, evidence_locks)
        if found:
            errors.extend(found)
            source_errors = True

    observer_by_pointer: dict[str, dict[str, Any]] = {}
    for observation in wrapper["observer_vector"]:
        pointer = observation["profile_pointer"]
        if pointer in observer_by_pointer:
            errors.append(f"{entry_id}: duplicate observer profile {pointer}")
        observer_by_pointer[pointer] = observation
        if observation["outcome"] in OBSERVED_OUTCOMES and not observation["evidence_refs"]:
            errors.append(f"{entry_id}/{pointer}: concrete observer outcome lacks evidence")
        if observation["outcome"] in OBSERVED_OUTCOMES:
            matching = [
                evidence_by_id[evidence_id]
                for evidence_id in observation["evidence_refs"]
                if evidence_id in evidence_by_id
                and evidence_matches_observation(
                    evidence_by_id[evidence_id], pointer, observation["outcome"]
                )
                and evidence_by_id[evidence_id]["source_type"] == "CHECKER_RESULT"
            ]
            if not matching:
                errors.append(
                    f"{entry_id}/{pointer}: concrete observer outcome lacks profile/outcome-bound checker evidence"
                )
    complete_vector = set(observer_by_pointer) == OBSERVER_POINTERS
    if not complete_vector:
        errors.append(f"{entry_id}: observer vector is incomplete")

    if entry["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION":
        pointer = entry["statement"]["judgment"]["target_profile_pointer"]
        try:
            resolve_pointer(target, pointer)
        except (KeyError, IndexError, ValueError):
            errors.append(f"{entry_id}: modeled-judgment target pointer does not resolve")
    else:
        for effect in entry["statement"]["profile_specific_effects"]:
            pointer = effect["observer_profile_pointer"]
            observation = observer_by_pointer.get(pointer)
            if observation is None:
                errors.append(f"{entry_id}: empirical effect has no observer-vector row: {pointer}")
            elif effect["outcome"] != observation["outcome"]:
                errors.append(f"{entry_id}: empirical effect disagrees with observer vector for {pointer}")

    source_rows = {row["id"]: row for row in source_lock["source_files"]}
    for mapping in wrapper["source_mappings"]:
        source = source_rows.get(mapping["source_file_id"])
        if source is None:
            errors.append(f"{entry_id}: unknown mapped source file {mapping['source_file_id']}")
            continue
        if source["repository_id"] not in IMPLEMENTATION_REPOSITORIES[mapping["implementation"]]:
            errors.append(
                f"{entry_id}: mapped source repository does not belong to {mapping['implementation']}"
            )
        matching_evidence = [
            evidence_by_id[evidence_id]
            for evidence_id in mapping["evidence_refs"]
            if evidence_id in evidence_by_id
            and evidence_by_id[evidence_id]["role"] == "IMPLEMENTATION_OBSERVATION"
            and evidence_by_id[evidence_id]["source_type"] == "IMPLEMENTATION_SOURCE"
            and evidence_by_id[evidence_id]["source_lock"]["lock_id"] == mapping["source_file_id"]
            and evidence_by_id[evidence_id]["exact_locator"]["value"] == mapping["symbol_or_range"]
        ]
        if not matching_evidence:
            errors.append(f"{entry_id}: source mapping lacks exact source-bound implementation evidence")

    basis = entry["authority"]["basis"]
    rule = authority_rules.get(basis["qualification_rule"])
    if rule is None:
        errors.append(f"{entry_id}: unknown authority qualification rule {basis['qualification_rule']}")
        return errors
    applies = rule["applies_to"]
    if (
        applies["kind"] != entry["kind"]
        or applies["authority_status"] != entry["authority"]["status"]
        or applies["authority_scope"] != entry["authority"]["scope"]
    ):
        errors.append(f"{entry_id}: qualification rule does not apply to entry kind/scope/status")

    evidence_values = list(evidence_by_id.values())
    authority_evidence = [evidence_by_id[item] for item in basis["evidence_refs"] if item in evidence_by_id]
    checks = set(rule["checks"])
    if "FORBID_LLM_AUTHORITY" in checks and any(
        item["source_type"] == "OTHER" for item in authority_evidence
    ):
        errors.append(f"{entry_id}: unqualified OTHER/LLM-like evidence cannot support authority")
    if "NO_UNMET_REQUIREMENTS" in checks and basis["unmet_requirements"]:
        errors.append(f"{entry_id}: established authority has unmet requirements")
    if "HAS_NAMED_UNMET_REQUIREMENT" in checks and not basis["unmet_requirements"]:
        errors.append(f"{entry_id}: non-established authority lacks a named unmet requirement")
    normative_support = [item for item in authority_evidence if item["role"] == "NORMATIVE_SUPPORT"]
    if "FORBID_CONSENSUS_ONLY_NORMATIVITY" in checks and authority_evidence and all(
        item["role"] == "IMPLEMENTATION_OBSERVATION" for item in authority_evidence
    ):
        errors.append(f"{entry_id}: implementation consensus alone cannot establish normativity")
    if "HAS_NORMATIVE_SUPPORT" in checks and not normative_support:
        errors.append(f"{entry_id}: established normative authority lacks NORMATIVE_SUPPORT")
    if "NORMATIVE_SUPPORT_SOURCE_TYPE_ALLOWED" in checks and any(
        item["source_type"] not in {
            "FORMAL_MECHANIZATION",
            "NORMATIVE_SPECIFICATION",
            "AUTHORITATIVE_DOCUMENTATION",
        }
        for item in normative_support
    ):
        errors.append(f"{entry_id}: normative support uses a non-normative source type")
    if "FORBID_SEMANTIC_TARGET_AS_NORMATIVE_SUPPORT" in checks and any(
        item["source_lock"]["registry"] == "SEMANTIC_TARGET_PROFILE"
        for item in normative_support
    ):
        errors.append(f"{entry_id}: semantic-target profile cannot serve as normative support")
    if "NORMATIVE_SUPPORT_SOURCE_LOCK_KIND_COMPATIBLE" in checks and any(
        evidence_source_errors(item, target, source_lock, evidence_locks)
        for item in normative_support
    ):
        errors.append(f"{entry_id}: normative support is not bound to a compatible normative source")
    if "NORMATIVE_SUPPORT_TARGETS_NORMATIVE_CLAIM" in checks and any(
        not item["claim_supported"]["entry_json_pointer"].startswith("/statement")
        for item in normative_support
    ):
        errors.append(f"{entry_id}: normative support does not target the modeled statement")
    if "HAS_IMPLEMENTATION_OBSERVATION" in checks and not any(
        item["role"] == "IMPLEMENTATION_OBSERVATION"
        and item["source_type"] == "CHECKER_RESULT"
        and any(
            evidence_matches_observation(item, observation["profile_pointer"], observation["outcome"])
            for observation in wrapper["observer_vector"]
            if observation["outcome"] in OBSERVED_OUTCOMES
        )
        for item in authority_evidence
    ):
        errors.append(f"{entry_id}: established empirical authority lacks an implementation observation")
    if "HAS_NON_PLACEHOLDER_OBSERVER_OUTCOME" in checks and not any(
        item["outcome"] in OBSERVED_OUTCOMES for item in wrapper["observer_vector"]
    ):
        errors.append(f"{entry_id}: established empirical authority has no concrete observer outcome")
    if "OBSERVER_VECTOR_COMPLETE" in checks and not complete_vector:
        errors.append(f"{entry_id}: authority rule requires a complete observer vector")
    if "OBSERVED_OUTCOMES_EVIDENCE_BACKED" in checks:
        for observation in wrapper["observer_vector"]:
            if observation["outcome"] in OBSERVED_OUTCOMES and not observation["evidence_refs"]:
                errors.append(f"{entry_id}: observed outcome is not evidence-backed")
    if "OBSERVED_OUTCOMES_ATTRIBUTION_BOUND" in checks:
        for observation in wrapper["observer_vector"]:
            if observation["outcome"] not in OBSERVED_OUTCOMES:
                continue
            if not any(
                evidence_matches_observation(
                    evidence_by_id[evidence_id],
                    observation["profile_pointer"],
                    observation["outcome"],
                )
                for evidence_id in observation["evidence_refs"]
                if evidence_id in evidence_by_id
            ):
                errors.append(f"{entry_id}: observed outcome attribution is not evidence-bound")
    active_authority_contradiction = any(
        item["role"] == "CONTRADICTION"
        and item["claim_supported"]["entry_json_pointer"].startswith("/authority")
        for item in evidence_values
    )
    active_statement_contradiction = any(
        item["role"] == "CONTRADICTION"
        and item["claim_supported"]["entry_json_pointer"].startswith("/statement")
        for item in evidence_values
    )
    if "NO_ACTIVE_AUTHORITY_CONTRADICTION" in checks and active_authority_contradiction:
        errors.append(f"{entry_id}: established authority has an active authority contradiction")
    if "NO_RELEVANT_STATEMENT_CONTRADICTION" in checks and active_statement_contradiction:
        errors.append(f"{entry_id}: established authority has an active statement contradiction")
    unresolved_normative_assumptions = {
        assumption["id"]
        for item in normative_support
        for assumption in item["assumptions"]
        if assumption["status"] == "UNRESOLVED"
    }
    active_normative_assumptions = {
        assumption["id"]
        for item in normative_support
        for assumption in item["assumptions"]
        if assumption["status"] == "ACTIVE"
    }
    if (
        "NO_UNRESOLVED_NORMATIVE_SUPPORT_ASSUMPTIONS" in checks
        and unresolved_normative_assumptions
    ):
        errors.append(f"{entry_id}: established normative support has unresolved assumptions")
    if "NO_ACTIVE_NORMATIVE_SUPPORT_ASSUMPTIONS" in checks and active_normative_assumptions:
        errors.append(f"{entry_id}: established normative support has active assumptions")
    if "HAS_BLOCKING_AUTHORITY_UNKNOWN_OR_CONTRADICTION" in checks:
        blocking_unknown = any(
            "AUTHORITY_ESTABLISHMENT" in item["blocking_for"] for item in entry["unknowns"]
        )
        unresolved_assumption = any(
            assumption["status"] == "UNRESOLVED"
            for item in authority_evidence
            for assumption in item["assumptions"]
        )
        if not (
            blocking_unknown
            or active_authority_contradiction
            or active_statement_contradiction
            or unresolved_assumption
        ):
            errors.append(f"{entry_id}: unresolved authority lacks a blocking unknown or contradiction")
    if "CLAIM_POINTERS_RESOLVE" in checks and pointer_errors:
        errors.append(f"{entry_id}: qualification rule has unresolved claim pointers")
    if "SOURCE_LOCK_REFS_RESOLVE" in checks and source_errors:
        errors.append(f"{entry_id}: qualification rule has unresolved source locks")
    if entry["soundness_relevance"]["status"] != "NOT_ASSESSED":
        errors.append(
            f"{entry_id}: soundness relevance must remain NOT_ASSESSED until a separate qualification rule is frozen"
        )
    return errors


def lifecycle_cycle_errors(entries: list[dict[str, Any]]) -> list[str]:
    graph = {
        row["characterization"]["id"]: row["characterization"]["lifecycle"]["target_ids"]
        for row in entries
    }
    errors: list[str] = []
    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(node: str) -> None:
        if node in visiting:
            errors.append(f"lifecycle target cycle contains {node}")
            return
        if node in visited:
            return
        visiting.add(node)
        for target in graph.get(node, []):
            visit(target)
        visiting.remove(node)
        visited.add(node)

    for node in graph:
        visit(node)
    return errors


def validate_decisions(
    decisions: dict[str, Any],
    catalog: dict[str, Any],
    identities: dict[str, dict[str, Any]],
    catalog_schema: dict[str, Any],
) -> tuple[list[str], set[str]]:
    errors: list[str] = []
    records_by_id, new = unique_index(decisions["records"], "id", "post-catalog decision")
    errors.extend(new)
    catalog_hash = document_sha256(catalog)
    entry_by_id = {
        row["characterization"]["id"]: row["characterization"] for row in catalog["entries"]
    }
    evidence_pairs = {
        (entry_id, evidence["id"])
        for entry_id, entry in entry_by_id.items()
        for evidence in entry["evidence"]
    }
    referenced = {
        decision_id
        for row in catalog["entries"]
        for decision_id in row["decision_ids"]
        if decision_id.startswith("DEC.CATALOG.")
    }
    referenced.update(
        decision_id
        for row in catalog["identity_dispositions"]
        for decision_id in row["decision_ids"]
        if decision_id.startswith("DEC.CATALOG.")
    )
    for record in decisions["records"]:
        if record["catalog_hash_after"] != catalog_hash:
            errors.append(f"{record['id']}: catalog_hash_after is not the supplied catalog")
        snapshot_binding = record["catalog_snapshot_before"]
        relative = snapshot_binding["path"]
        snapshot: dict[str, Any] | None = None
        if not safe_relative_path(relative) or not relative.startswith(
            "results/research/declaration-validation-catalog-snapshots/"
        ):
            errors.append(f"{record['id']}: before snapshot path is not canonical and safe")
        else:
            snapshot_path = ROOT / relative
            if not snapshot_path.is_file():
                errors.append(f"{record['id']}: before snapshot is missing")
            elif sha256_file(snapshot_path) != snapshot_binding["sha256"]:
                errors.append(f"{record['id']}: before snapshot binding is stale")
            elif record["catalog_hash_before"] != snapshot_binding["sha256"]:
                errors.append(f"{record['id']}: catalog_hash_before disagrees with snapshot binding")
            elif not is_tracked(relative):
                errors.append(f"{record['id']}: before snapshot is not tracked by Git")
            else:
                try:
                    snapshot = load_json(snapshot_path)
                except (OSError, json.JSONDecodeError):
                    errors.append(f"{record['id']}: before snapshot is unreadable JSON")
                else:
                    snapshot_errors = schema_errors(
                        snapshot,
                        catalog_schema,
                        f"{record['id']} before snapshot",
                    )
                    errors.extend(snapshot_errors)
                    if snapshot_errors:
                        snapshot = None
        before_by_id = {
            row["characterization"]["id"]: row["characterization"]
            for row in (snapshot or {}).get("entries", [])
        }
        for stable_id in set(record["inputs"] + record["result"]):
            if stable_id not in identities:
                errors.append(f"{record['id']}: unknown stable identity {stable_id}")
        for evidence in record["evidence"]:
            pair = (evidence["entry_id"], evidence["evidence_id"])
            if pair not in evidence_pairs:
                errors.append(f"{record['id']}: unresolved decision evidence {pair}")
        expected_before_ids = set(record["inputs"])
        expected_after_ids = set(record["inputs"] + record["result"])
        if set(record["statement_hashes_before"]) != expected_before_ids:
            errors.append(f"{record['id']}: statement_hashes_before does not exactly cover inputs")
        if set(record["statement_hashes_after"]) != expected_after_ids:
            errors.append(f"{record['id']}: statement_hashes_after does not cover the complete transition")
        for stable_id, digest in record["statement_hashes_before"].items():
            previous = before_by_id.get(stable_id)
            if previous is None:
                errors.append(f"{record['id']}: before statement names absent snapshot entry {stable_id}")
                continue
            payload = json.dumps(previous["statement"], sort_keys=True, separators=(",", ":")).encode()
            if hashlib.sha256(payload).hexdigest() != digest:
                errors.append(f"{record['id']}: statement_hashes_before is stale for {stable_id}")
        for stable_id, digest in record["statement_hashes_after"].items():
            current = entry_by_id.get(stable_id)
            if current is None:
                errors.append(f"{record['id']}: statement hash names absent catalog entry {stable_id}")
                continue
            payload = json.dumps(current["statement"], sort_keys=True, separators=(",", ":")).encode()
            if hashlib.sha256(payload).hexdigest() != digest:
                errors.append(f"{record['id']}: statement_hashes_after is stale for {stable_id}")
        if snapshot is not None:
            decision_type = record["decision_type"]
            inputs = record["inputs"]
            results = record["result"]
            if decision_type == "MERGE":
                if len(inputs) < 2 or len(results) != 1:
                    errors.append(f"{record['id']}: MERGE requires multiple inputs and one result")
                else:
                    survivor = results[0]
                    for stable_id in set(inputs) - {survivor}:
                        current = entry_by_id.get(stable_id)
                        if (
                            current is None
                            or current["lifecycle"]["status"] != "REDUNDANT"
                            or survivor not in current["lifecycle"]["target_ids"]
                        ):
                            errors.append(f"{record['id']}: MERGE does not retain redundant tombstone {stable_id}")
            elif decision_type == "SPLIT":
                if len(inputs) != 1 or len(results) < 2:
                    errors.append(f"{record['id']}: SPLIT requires one input and multiple results")
                else:
                    current = entry_by_id.get(inputs[0])
                    if (
                        current is None
                        or current["lifecycle"]["status"] != "SUPERSEDED"
                        or set(current["lifecycle"]["target_ids"]) != set(results)
                    ):
                        errors.append(f"{record['id']}: SPLIT does not retain the superseded input tombstone")
            elif decision_type == "EXCLUSION":
                if any(
                    entry_by_id.get(stable_id, {}).get("lifecycle", {}).get("status")
                    != "OUT_OF_SCOPE"
                    for stable_id in inputs
                ):
                    errors.append(f"{record['id']}: EXCLUSION inputs are not retained OUT_OF_SCOPE")
            elif decision_type in {"AUTHORITY_CHANGE", "LAYER_CHANGE", "LIFECYCLE_CHANGE"}:
                if len(inputs) != 1 or inputs != results:
                    errors.append(f"{record['id']}: {decision_type} requires one unchanged stable ID")
                else:
                    previous = before_by_id.get(inputs[0])
                    current = entry_by_id.get(inputs[0])
                    field = {
                        "AUTHORITY_CHANGE": "authority",
                        "LAYER_CHANGE": "layers",
                        "LIFECYCLE_CHANGE": "lifecycle",
                    }[decision_type]
                    if previous is None or current is None or previous[field] == current[field]:
                        errors.append(f"{record['id']}: {decision_type} does not change {field}")
            elif decision_type == "OTHER" and all(
                before_by_id.get(stable_id) == entry_by_id.get(stable_id)
                for stable_id in set(inputs + results)
            ):
                errors.append(f"{record['id']}: OTHER decision records no catalog change")
    orphaned = set(records_by_id) - referenced
    if orphaned:
        errors.append(f"post-catalog decisions are not referenced by catalog entries: {sorted(orphaned)}")
    return errors, set(records_by_id)


def validate_freeze(
    freeze: dict[str, Any],
    *,
    rendered_freeze: dict[str, Any] | None = None,
) -> list[str]:
    errors: list[str] = []
    for name, binding in freeze["artifacts"].items():
        path = ROOT / binding["path"]
        if not path.is_file():
            errors.append(f"freeze artifact {name} is missing")
        elif sha256_file(path) != binding["sha256"]:
            errors.append(f"freeze artifact {name} hash is stale")
        if path == FREEZE_PATH:
            errors.append("freeze manifest cannot content-bind itself")
    if rendered_freeze is None:
        rendered_freeze = load_module("declaration_m7_freeze_renderer", FREEZE_RENDERER_PATH).render()
    if freeze != rendered_freeze:
        errors.append("freeze manifest is not synchronized with its canonical inputs")

    order = freeze["attestation_order"]
    rank = {name: index for index, name in enumerate(order)}
    graph: dict[str, list[str]] = {name: [] for name in freeze["artifacts"]}
    for edge in freeze["dependency_edges"]:
        source = edge["from"]
        target = edge["to"]
        if source not in graph or target not in graph:
            errors.append(f"freeze dependency edge names unknown artifact: {source}->{target}")
            continue
        graph[source].append(target)
        source_tier = freeze["artifacts"][source]["tier"]
        target_tier = freeze["artifacts"][target]["tier"]
        if rank[target_tier] > rank[source_tier]:
            errors.append(f"freeze edge violates attestation order: {source}->{target}")
    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(node: str) -> None:
        if node in visiting:
            errors.append(f"freeze dependency graph contains a cycle at {node}")
            return
        if node in visited:
            return
        visiting.add(node)
        for target in graph[node]:
            visit(target)
        visiting.remove(node)
        visited.add(node)

    for node in graph:
        visit(node)
    return errors


def validate_identity_dispositions(
    catalog: dict[str, Any],
    identities: dict[str, dict[str, Any]],
    decision_ids: set[str],
) -> list[str]:
    errors: list[str] = []
    dispositions, new = unique_index(
        catalog["identity_dispositions"], "id", "identity disposition"
    )
    errors.extend(new)
    if catalog["status"] == "MILESTONE_7_INFRASTRUCTURE_ONLY":
        if dispositions:
            errors.append("Milestone 7 must not pre-adjudicate identity dispositions")
        return errors
    if catalog["status"] not in {
        "MILESTONE_8_CHARACTERIZATION_INVENTORY",
        "MILESTONE_9_PRE_REVIEW_FREEZE",
        "MILESTONE_9_REVIEWED_FREEZE",
    }:
        return errors
    if set(dispositions) != set(identities):
        errors.append(
            "Milestone 8 identity dispositions do not exactly cover the frozen discovery surface"
        )
    catalog_ids = {row["characterization"]["id"] for row in catalog["entries"]}
    expected_catalog_ids: set[str] = set()
    for stable_id, identity in identities.items():
        row = dispositions.get(stable_id)
        if row is None:
            continue
        if row["identity_statement_sha256"] != identity["statement_sha256"]:
            errors.append(f"{stable_id}: disposition identity hash is stale")
        if not set(identity["decision_ids"]) <= set(row["decision_ids"]):
            errors.append(f"{stable_id}: disposition omits its frozen identity decision")
        unknown = set(row["decision_ids"]) - decision_ids
        if unknown:
            errors.append(f"{stable_id}: disposition has unknown decisions {sorted(unknown)}")
        expected = {
            "ACTIVE_PROVISIONAL": "CATALOG_ENTRY",
            "DEFERRED_KIND": "DEFERRED_UNRESOLVED_KIND",
            "RESERVED_OUT_OF_SCOPE": "OUT_OF_SCOPE",
        }[identity["identity_status"]]
        if row["disposition"] != expected:
            errors.append(
                f"{stable_id}: disposition {row['disposition']} is incompatible with frozen identity status"
            )
        if expected == "CATALOG_ENTRY":
            expected_catalog_ids.add(stable_id)
    if catalog_ids != expected_catalog_ids:
        errors.append(
            "Milestone 8 catalog entries do not exactly match identities dispositioned as CATALOG_ENTRY"
        )
    return errors


def validate_artifacts(
    catalog: dict[str, Any],
    catalog_schema: dict[str, Any],
    entry_schema: dict[str, Any],
    authority: dict[str, Any],
    authority_schema: dict[str, Any],
    decisions: dict[str, Any],
    decisions_schema: dict[str, Any],
    freeze: dict[str, Any],
    freeze_schema: dict[str, Any],
    target: dict[str, Any],
    model: dict[str, Any],
    identities_document: dict[str, Any],
    source_lock: dict[str, Any],
    evidence_lock: dict[str, Any],
    evidence_lock_schema: dict[str, Any],
    prior_decisions: dict[str, Any],
    *,
    rendered_report: str | None = None,
    rendered_freeze: dict[str, Any] | None = None,
    check_generated: bool = True,
    enforce_milestone_boundary: bool = True,
) -> list[str]:
    resolved_catalog_schema = copy.deepcopy(catalog_schema)
    resolved_catalog_schema["$defs"]["catalogEntry"]["properties"]["characterization"] = entry_schema
    errors = schema_errors(catalog, resolved_catalog_schema, "catalog")
    errors.extend(schema_errors(authority, authority_schema, "authority rules"))
    errors.extend(schema_errors(decisions, decisions_schema, "catalog decisions"))
    errors.extend(schema_errors(freeze, freeze_schema, "freeze manifest"))
    if errors:
        return errors

    bindings = catalog["artifact_bindings"]
    if set(bindings) != set(EXPECTED_BINDINGS) | {"evidence_lock"}:
        errors.append("catalog binding names are not exact")
    else:
        errors.extend(
            binding_errors(
                {name: bindings[name] for name in EXPECTED_BINDINGS},
                EXPECTED_BINDINGS,
                "catalog",
            )
        )
        evidence_binding = bindings["evidence_lock"]
        if not safe_relative_path(evidence_binding["path"]) or not evidence_binding[
            "path"
        ].startswith("config/declaration-validation-evidence-locks/"):
            errors.append("catalog evidence-lock binding path is not canonical and safe")
        if evidence_binding["sha256"] != document_sha256(evidence_lock):
            errors.append("catalog evidence-lock binding hash disagrees with supplied successor lock")
        if check_generated:
            evidence_path = ROOT / evidence_binding["path"]
            if not evidence_path.is_file() or sha256_file(evidence_path) != evidence_binding["sha256"]:
                errors.append("catalog evidence-lock file binding is missing or stale")
    errors.extend(binding_errors(authority["bindings"], EXPECTED_AUTHORITY_BINDINGS, "authority"))
    evidence_errors, evidence_locks = validate_evidence_lock_chain(
        evidence_lock,
        evidence_lock_schema,
        source_lock,
        check_git_tracking=check_generated,
    )
    errors.extend(evidence_errors)
    expected_evidence_status = {
        "MILESTONE_7_INFRASTRUCTURE_ONLY": "MILESTONE_7_EMPTY_EVIDENCE_LOCK",
        "MILESTONE_8_CHARACTERIZATION_INVENTORY": "MILESTONE_8_EVIDENCE_SELECTION",
        "MILESTONE_9_PRE_REVIEW_FREEZE": "MILESTONE_9_PRE_REVIEW_EVIDENCE_FREEZE",
        "MILESTONE_9_REVIEWED_FREEZE": "MILESTONE_9_REVIEWED_EVIDENCE_FREEZE",
    }[catalog["status"]]
    if evidence_lock["status"] != expected_evidence_status:
        errors.append("catalog status and evidence-lock successor status disagree")
    if catalog["id_evolution_rules"] != identities_document["id_evolution_rules"]:
        errors.append("catalog stable-ID evolution rules differ from the frozen identity registry")
    if set(catalog["observer_order"]) != OBSERVER_POINTERS:
        errors.append("catalog observer order does not cover the exact pinned observer set")

    rule_errors, rules_by_id = validate_rule_set(authority)
    errors.extend(rule_errors)
    identities, new = unique_index(identities_document["identities"], "id", "stable identity")
    errors.extend(new)
    prior_ids = {row["id"] for row in prior_decisions["records"]}
    decision_errors, post_ids = validate_decisions(
        decisions, catalog, identities, resolved_catalog_schema
    )
    errors.extend(decision_errors)

    entry_rows = catalog["entries"]
    catalog_ids: set[str] = set()
    for row in entry_rows:
        entry_id = row["characterization"]["id"]
        if entry_id in catalog_ids:
            errors.append(f"duplicate catalog stable ID: {entry_id}")
        catalog_ids.add(entry_id)
    all_decision_ids = prior_ids | post_ids
    if enforce_milestone_boundary or catalog["status"] == "MILESTONE_7_INFRASTRUCTURE_ONLY":
        errors.extend(validate_identity_dispositions(catalog, identities, all_decision_ids))
    for row in entry_rows:
        errors.extend(
            validate_entry(
                row,
                catalog_ids=catalog_ids,
                identities=identities,
                decision_ids=all_decision_ids,
                authority_rules=rules_by_id,
                target=target,
                model=model,
                source_lock=source_lock,
                evidence_locks=evidence_locks,
            )
        )
        for decision_id in row["decision_ids"]:
            if not decision_id.startswith("DEC.CATALOG."):
                continue
            record = next(
                (item for item in decisions["records"] if item["id"] == decision_id),
                None,
            )
            entry_id = row["characterization"]["id"]
            if record is not None and entry_id not in set(record["inputs"] + record["result"]):
                errors.append(f"{entry_id}: post-catalog decision {decision_id} is unrelated")
    errors.extend(lifecycle_cycle_errors(entry_rows))

    if enforce_milestone_boundary and catalog["status"] == "MILESTONE_7_INFRASTRUCTURE_ONLY":
        boundary = catalog["completion_boundary"]
        if entry_rows or boundary["inventory_populated"] or boundary["authority_assignments_created"]:
            errors.append("Milestone 7 infrastructure catalog crossed into inventory adjudication")
        if boundary["next_milestone"] != "MILESTONE_8_BUILD_FIRST_CHARACTERIZATION_INVENTORY":
            errors.append("Milestone 7 catalog does not authorize exactly Milestone 8 next")
        if decisions["records"]:
            errors.append("Milestone 7 post-catalog decision log must remain empty")
        if evidence_lock["sequence"] != 1:
            errors.append("Milestone 7 must bind the sequence-1 empty evidence lock")

    if enforce_milestone_boundary and catalog["status"] == "MILESTONE_8_CHARACTERIZATION_INVENTORY":
        boundary = catalog["completion_boundary"]
        if not boundary["inventory_populated"] or not boundary["authority_assignments_created"]:
            errors.append("Milestone 8 completion flags do not assert the completed inventory")
        if boundary["next_milestone"] != "MILESTONE_9_ADVERSARIAL_REVIEW":
            errors.append("Milestone 8 catalog does not authorize exactly Milestone 9 next")
        if evidence_lock["sequence"] < 2:
            errors.append("Milestone 8 must bind a successor of the immutable Milestone 7 evidence lock")

    if enforce_milestone_boundary and catalog["status"] in {
        "MILESTONE_9_PRE_REVIEW_FREEZE",
        "MILESTONE_9_REVIEWED_FREEZE",
    }:
        boundary = catalog["completion_boundary"]
        if not boundary["inventory_populated"] or not boundary["authority_assignments_created"]:
            errors.append("Milestone 9 status cannot discard the completed Milestone 8 inventory")
        if evidence_lock["sequence"] < 3:
            errors.append("Milestone 9 must bind a successor of the Milestone 8 evidence lock")

    if check_generated:
        report_renderer = load_module("declaration_m7_report_renderer", REPORT_RENDERER_PATH)
        if rendered_report is None:
            rendered_report = report_renderer.render(catalog, source_lock, evidence_lock)
        if REPORT_PATH.read_text(encoding="utf-8") != rendered_report:
            errors.append("generated human report is not synchronized with the canonical catalog")
        catalog_hash = sha256_file(CATALOG_PATH)
        if f"Catalog SHA-256: `{catalog_hash}`" not in rendered_report:
            errors.append("generated human report does not include the canonical catalog hash")
        errors.extend(validate_freeze(freeze, rendered_freeze=rendered_freeze))
    return errors


def validate_completion_record(
    record: dict[str, Any] | None = None,
    *,
    rendered: dict[str, Any] | None = None,
    run_tests: bool = True,
) -> list[str]:
    if not COMPLETION_PATH.is_file():
        return [f"missing completion record: {COMPLETION_PATH.relative_to(ROOT)}"]
    if record is None:
        record = load_json(COMPLETION_PATH)
    errors: list[str] = []
    errors.extend(
        schema_errors(
            record,
            load_json(COMPLETION_SCHEMA_PATH),
            "Milestone 7 completion record",
        )
    )
    if errors:
        return errors
    if rendered is None:
        rendered = load_module(
            "declaration_m7_completion_renderer", COMPLETION_RENDERER_PATH
        ).render()
    if record != rendered:
        errors.append("Milestone 7 completion record is not synchronized with derived facts")
    for name, binding in record["artifacts"].items():
        path = ROOT / binding["path"]
        if not path.is_file():
            errors.append(f"completion record {name} artifact is missing")
        elif sha256_file(path) != binding["sha256"]:
            errors.append(f"completion record {name} hash is stale")
        if path == COMPLETION_PATH:
            errors.append("completion record cannot content-bind itself")
    catalog_hash = sha256_file(CATALOG_PATH)
    report = REPORT_PATH.read_text(encoding="utf-8")
    if record["canonical_architecture"]["catalog_hash_embedded_in_report"] != catalog_hash:
        errors.append("completion record catalog hash claim is stale")
    if f"Catalog SHA-256: `{catalog_hash}`" not in report:
        errors.append("completion record claims a report binding that is absent")
    if run_tests:
        result = subprocess.run(
            [
                sys.executable,
                "-m",
                "unittest",
                "discover",
                "-s",
                "tests",
                "-p",
                "test_declaration_validation_*.py",
            ],
            cwd=ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            errors.append("completion record full declaration-validation test gate failed")
    return errors


def validate_all(*, require_completion: bool = True) -> tuple[list[str], dict[str, Any]]:
    catalog = load_json(CATALOG_PATH)
    evidence_binding = catalog["artifact_bindings"]["evidence_lock"]
    evidence_lock = load_json(ROOT / evidence_binding["path"])
    source_validator = load_module("declaration_m6_source_validator", SOURCE_LOCK_VALIDATOR_PATH)
    source_errors, _ = source_validator.validate_all(require_completion=True, online=False)
    errors = [f"source-lock predecessor: {error}" for error in source_errors]
    errors.extend(
        validate_artifacts(
            catalog,
            load_json(CATALOG_SCHEMA_PATH),
            load_json(ENTRY_SCHEMA_PATH),
            load_json(AUTHORITY_PATH),
            load_json(AUTHORITY_SCHEMA_PATH),
            load_json(DECISIONS_PATH),
            load_json(DECISIONS_SCHEMA_PATH),
            load_json(FREEZE_PATH),
            load_json(FREEZE_SCHEMA_PATH),
            load_json(TARGET_PATH),
            load_json(MODEL_PATH),
            load_json(IDENTITY_PATH),
            load_json(SOURCE_LOCK_PATH),
            evidence_lock,
            load_json(EVIDENCE_LOCK_SCHEMA_PATH),
            load_json(PRIOR_DECISIONS_PATH),
        )
    )
    if require_completion:
        errors.extend(validate_completion_record())
    entries = catalog["entries"]
    summary = {
        "catalog_sha256": sha256_file(CATALOG_PATH),
        "entries": len(entries),
        "normative_candidates": sum(
            row["characterization"]["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION" for row in entries
        ),
        "empirical_scenarios": sum(
            row["characterization"]["kind"] == "EMPIRICAL_CONTRACT_SCENARIO" for row in entries
        ),
        "authority_rules": len(load_json(AUTHORITY_PATH)["rules"]),
        "observer_profiles": len(catalog["observer_order"]),
        "post_catalog_decisions": len(load_json(DECISIONS_PATH)["records"]),
        "identity_dispositions": len(catalog["identity_dispositions"]),
        "evidence_lock_sequence": evidence_lock["sequence"],
    }
    return errors, summary


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--artifacts-only", action="store_true", help="skip the completion record while constructing the milestone")
    args = parser.parse_args()
    errors, summary = validate_all(require_completion=not args.artifacts_only)
    if errors:
        for error in errors:
            print(f"ERROR: {error}")
        print(json.dumps(summary, sort_keys=True))
        return 1
    print("declaration-validation canonical catalog: PASS")
    print(json.dumps(summary, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
