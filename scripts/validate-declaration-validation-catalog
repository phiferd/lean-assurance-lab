def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def document_bytes(document: dict[str, Any]) -> bytes:
    return (json.dumps(document, indent=2, sort_keys=True) + "\n").encode("utf-8")


def document_sha256(document: dict[str, Any]) -> str:
    return hashlib.sha256(document_bytes(document)).hexdigest()


def empirical_observation_statement(identity: dict[str, Any]) -> str:
    return f"Observe each pinned observer's outcome for: {identity['semantic_statement']}"


def canonical_identity_denotation(identity: dict[str, Any]) -> dict[str, Any]:
    kind = identity["intended_kind"]
    base = {
        "semantic_statement": identity["semantic_statement"],
        "applicability": identity["applicability"],
        "intended_kind": kind,
    }
    if kind == "NORMATIVE_CANDIDATE_OBLIGATION":
        base["canonical_semantics"] = {
            "kind": kind,
            "modeled_judgment_target_profile_pointer": "/logical_target/modeled_judgment",
            "applicability": [identity["applicability"]],
            "premises": [],
            "target_premise": identity["semantic_statement"],
            "violation_expectation": "REJECT",
        }
    elif kind == "EMPIRICAL_CONTRACT_SCENARIO":
        base["canonical_semantics"] = {
            "kind": kind,
            "subject_scope": identity["applicability"],
            "precondition": [identity["applicability"]],
            "stimulus": identity["semantic_statement"],
            "observation_points": [empirical_observation_statement(identity)],
            "observer_population": sorted(OBSERVER_POINTERS),
            "profile_specific_effects_identity_relevance": "NON_IDENTITY_OBSERVATIONS",
        }
    else:
        raise ValueError(f"identity {identity['id']} has no catalog-admissible kind")
    return base


def load_module(name: str, path: Path) -> Any:
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"could not load {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def resolve_pointer(document: Any, pointer: str) -> Any:
    if pointer == "":
        return document
    if not pointer.startswith("/"):
        raise KeyError("not a JSON Pointer")
    current = document
    for raw in pointer[1:].split("/"):
        if re.search(r"~(?:[^01]|$)", raw):
            raise KeyError("invalid JSON Pointer escape")
        part = raw.replace("~1", "/").replace("~0", "~")
        if isinstance(current, list):
            if not re.fullmatch(r"0|[1-9][0-9]*", part):
                raise KeyError("invalid JSON Pointer array index")
            index = int(part)
            if index >= len(current):
                raise IndexError(index)
            current = current[index]
        elif isinstance(current, dict):
            current = current[part]
        else:
            raise KeyError(part)
    return current


def schema_errors(
    instance: dict[str, Any],
    schema: dict[str, Any],
    label: str,
) -> list[str]:
    validator = jsonschema.Draft202012Validator(
        schema,
        format_checker=jsonschema.FormatChecker(),
    )
    errors: list[str] = []
    for error in sorted(validator.iter_errors(instance), key=lambda item: list(item.absolute_path)):
        where = "/" + "/".join(str(part) for part in error.absolute_path)
        errors.append(f"{label} schema {where}: {error.message}")
    return errors


def unique_index(rows: list[dict[str, Any]], field: str, label: str) -> tuple[dict[str, dict[str, Any]], list[str]]:
    index: dict[str, dict[str, Any]] = {}
    errors: list[str] = []
    for row in rows:
        value = row[field]
        if value in index:
            errors.append(f"duplicate {label}: {value}")
        index[value] = row
    return index, errors


def binding_errors(bindings: dict[str, Any], expected: dict[str, Path], label: str) -> list[str]:
    errors: list[str] = []
    if set(bindings) != set(expected):
        errors.append(f"{label} binding names are not exact")
        return errors
    for name, path in expected.items():
        binding = bindings[name]
        if ROOT / binding["path"] != path:
            errors.append(f"{label} {name} path is not canonical")
        elif binding["sha256"] != sha256_file(path):
            errors.append(f"{label} {name} hash is stale")
    return errors


def source_lock_indices(
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]] | None = None,
) -> dict[str, tuple[str, dict[str, Any]]]:
    result: dict[str, tuple[str, dict[str, Any]]] = {}
    for section, kind in [
        ("repositories", "repository"),
        ("source_files", "source_file"),
        ("tracked_evidence", "tracked_evidence"),
        ("generated_witnesses", "generated_witness"),
        ("optional_local_observations", "optional_local_observation"),
    ]:
        for row in source_lock[section]:
            result[row["id"]] = (kind, row)
    for row in source_lock["observer_configurations"]:
        result[f"OBSERVER.{row['observer']}"] = ("observer_configuration", row)
    for section in ("normative_documentation", "mechanized_results"):
        for row in source_lock[section]["records"]:
            result[row["id"]] = (section, row)
    for evidence_lock in evidence_locks or []:
        for section, kind in (
            ("normative_documentation", "normative_documentation"),
            ("mechanized_results", "mechanized_results"),
            ("tracked_evidence", "tracked_evidence"),
            ("generated_witnesses", "generated_witness"),
        ):
            for row in evidence_lock[section]:
                result[row["id"]] = (kind, row)
    return result


def approved_authority_source_indices(
    registry: dict[str, Any],
) -> tuple[dict[str, tuple[str, dict[str, Any]]], list[str]]:
    result: dict[str, tuple[str, dict[str, Any]]] = {}
    errors: list[str] = []
    for section in ("normative_documentation", "mechanized_results"):
        for row in registry[section]:
            if row["id"] in result:
                errors.append(f"duplicate approved authority-source ID: {row['id']}")
            result[row["id"]] = (section, row)
    return result, errors


def parse_recorded_at(value: str, label: str, errors: list[str]) -> datetime | None:
    try:
        return datetime.fromisoformat(value)
    except ValueError:
        errors.append(f"{label}: recorded_at is not an ISO-8601 timestamp")
        return None


def registry_sequence(registry: dict[str, Any], path: Path) -> int:
    return 1 if path.resolve() in {
        APPROVED_AUTHORITY_SOURCES_PATH.resolve(),
        FROZEN_PRE_M8_AUTHORITY_SOURCES_SNAPSHOT_PATH.resolve(),
    } else registry["sequence"]


def registry_schema_path(path: Path) -> Path:
    if path.resolve() in {
        APPROVED_AUTHORITY_SOURCES_PATH.resolve(),
        FROZEN_PRE_M8_AUTHORITY_SOURCES_SNAPSHOT_PATH.resolve(),
    }:
        return APPROVED_AUTHORITY_SOURCES_SCHEMA_PATH
    return APPROVED_AUTHORITY_SOURCES_SUCCESSOR_SCHEMA_PATH


def safe_registry_path(path: Path) -> bool:
    try:
        relative = path.resolve().relative_to(ROOT.resolve())
    except ValueError:
        return False
    return (
        path.resolve() == APPROVED_AUTHORITY_SOURCES_PATH.resolve()
        or path.resolve() == FROZEN_PRE_M8_AUTHORITY_SOURCES_SNAPSHOT_PATH.resolve()
        or str(relative).startswith("config/declaration-validation-approved-authority-sources/")
    )


def validate_approved_authority_source_registry(
    registry: dict[str, Any],
    registry_schema: dict[str, Any],
    registry_path: Path,
    *,
    check_generated: bool,
    allow_test_registry: bool = False,
    seen_paths: set[Path] | None = None,
) -> list[str]:
    """Validate the immutable M7 root or a separately approved successor chain."""

    errors: list[str] = []
    resolved_path = registry_path.resolve()
    seen_paths = set() if seen_paths is None else seen_paths
    if resolved_path in seen_paths:
        return [f"authority-source registry predecessor cycle at {registry_path}"]
    seen_paths.add(resolved_path)
    if not safe_registry_path(registry_path):
        return ["authority-source registry path is not canonical and safe"]

    errors.extend(schema_errors(registry, registry_schema, "approved authority sources"))
    if errors:
        return errors
    if check_generated and not registry_path.is_file():
        errors.append("approved authority-source registry file is missing")

    if resolved_path in {
        APPROVED_AUTHORITY_SOURCES_PATH.resolve(),
        FROZEN_PRE_M8_AUTHORITY_SOURCES_SNAPSHOT_PATH.resolve(),
    }:
        if not allow_test_registry and document_sha256(registry) != FROZEN_APPROVED_AUTHORITY_SOURCES_DOCUMENT_SHA256:
            errors.append("frozen M7 approved authority-source registry bytes changed")
        if registry["registry_id"] != "ordinary-declaration-validation.approved-authority-sources.m7.v1":
            errors.append("frozen M7 approved authority-source registry identity changed")
        if not allow_test_registry and (registry["normative_documentation"] or registry["mechanized_results"]):
            errors.append("frozen M7 approved authority-source registry must remain empty")
        return errors

    predecessor = registry["predecessor"]
    predecessor_path = ROOT / predecessor["path"]
    if not safe_relative_path(predecessor["path"]) or not safe_registry_path(predecessor_path):
        return errors + ["authority-source registry predecessor path is not canonical and safe"]
    if not predecessor_path.is_file():
        return errors + ["authority-source registry predecessor is missing"]
    if sha256_file(predecessor_path) != predecessor["sha256"]:
        return errors + ["authority-source registry predecessor hash is stale"]
    predecessor_registry = load_json(predecessor_path)
    predecessor_schema_path = registry_schema_path(predecessor_path)
    predecessor_errors = validate_approved_authority_source_registry(
        predecessor_registry,
        load_json(predecessor_schema_path),
        predecessor_path,
        check_generated=check_generated,
        allow_test_registry=allow_test_registry,
        seen_paths=seen_paths,
    )
    errors.extend(f"authority-source registry predecessor: {error}" for error in predecessor_errors)
    if predecessor["registry_id"] != predecessor_registry["registry_id"]:
        errors.append("authority-source registry predecessor identity disagrees with predecessor bytes")
    expected_predecessor_sequence = registry_sequence(predecessor_registry, predecessor_path)
    if predecessor["sequence"] != expected_predecessor_sequence:
        errors.append("authority-source registry predecessor sequence disagrees with predecessor bytes")
    if registry["sequence"] != expected_predecessor_sequence + 1:
        errors.append("authority-source registry successor sequence is not contiguous")
    if registry["registry_id"] == predecessor_registry["registry_id"]:
        errors.append("authority-source registry successor reuses predecessor identity")

    registry_time = parse_recorded_at(registry["recorded_at"], "authority-source registry", errors)
    predecessor_time = parse_recorded_at(
        predecessor_registry["recorded_at"], "authority-source registry predecessor", errors
    )
    if registry_time and predecessor_time and registry_time <= predecessor_time:
        errors.append("authority-source registry successor must be recorded after predecessor")

    decision_rows: dict[str, dict[str, Any]] = {}
    for binding in registry["approval_decision_bindings"]:
        decision_path = ROOT / binding["path"]
        if not safe_relative_path(binding["path"]) or not binding["path"].startswith(
            "results/research/declaration-validation-authority-source-approvals/"
        ):
            errors.append(f"{binding['decision_id']}: authority-source approval decision path is not canonical")
            continue
        if not decision_path.is_file() or sha256_file(decision_path) != binding["sha256"]:
            errors.append(f"{binding['decision_id']}: authority-source approval decision binding is missing or stale")
            continue
        decision = load_json(decision_path)
        errors.extend(
            schema_errors(
                decision,
                load_json(AUTHORITY_SOURCE_APPROVAL_DECISION_SCHEMA_PATH),
                f"{binding['decision_id']} authority-source approval decision",
            )
        )
        if decision.get("decision_id") != binding["decision_id"]:
            errors.append(f"{binding['decision_id']}: authority-source approval decision identity disagrees with binding")
            continue
        if decision["predecessor_registry"] != predecessor:
            errors.append(f"{binding['decision_id']}: authority-source approval did not review this predecessor registry")
        decision_time = parse_recorded_at(decision["recorded_at"], binding["decision_id"], errors)
        if registry_time and decision_time and decision_time >= registry_time:
            errors.append(f"{binding['decision_id']}: authority-source approval must predate its registry successor")
        decision_rows[binding["decision_id"]] = decision

    predecessor_sources, predecessor_errors = approved_authority_source_indices(predecessor_registry)
    successor_sources, successor_errors = approved_authority_source_indices(registry)
    errors.extend(predecessor_errors)
    errors.extend(successor_errors)
    for source_id, (_, prior_row) in predecessor_sources.items():
        successor = successor_sources.get(source_id)
        if successor is None or successor[1] != prior_row:
            errors.append(f"{source_id}: authority-source successor does not preserve predecessor approval")
    for source_id, (_, source) in successor_sources.items():
        if source_id in predecessor_sources:
            continue
        decision = decision_rows.get(source["approval_decision"])
        if decision is None or source_id not in decision["approved_source_ids"]:
            errors.append(f"{source_id}: source lacks a separate predecessor-bound approval decision")
    return errors


def pointer_is_within(pointer: str, allowed: set[str]) -> bool:
    return any(
        pointer == root or pointer.startswith(root.rstrip("/") + "/")
        for root in allowed
    )


def document_contains_case_id(value: Any, case_id: str) -> bool:
    if isinstance(value, dict):
        if any(value.get(key) == case_id for key in ("id", "case_id", "name")):
            return True
        return any(document_contains_case_id(item, case_id) for item in value.values())
    if isinstance(value, list):
        return any(document_contains_case_id(item, case_id) for item in value)
    return False


def document_strings(value: Any) -> set[str]:
    if isinstance(value, dict):
        return {item for child in value.values() for item in document_strings(child)}
    if isinstance(value, list):
        return {item for child in value for item in document_strings(child)}
    return {value} if isinstance(value, str) else set()


def existing_evidence_identity_associations(
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]] | None = None,
    *,
    include_successors: bool = False,
) -> tuple[dict[str, set[str]], dict[str, str]]:
    """Derive identity associations from exact frozen witness paths and digests."""

    base_witnesses = source_lock["generated_witnesses"]
    associations: dict[str, set[str]] = {
        row["id"]: set(row["relevant_case_id"]) for row in base_witnesses
    }
    kinds = {row["id"]: "GENERATED_WITNESS" for row in base_witnesses}

    tracked_rows = [
        row
        for row in source_lock["tracked_evidence"]
        if row["source_role"] in {"EXISTING_LAB_EVIDENCE", "WITNESS_ORIGIN"}
    ]
    successor_witnesses: list[dict[str, Any]] = []
    if include_successors:
        for lock in evidence_locks or []:
            tracked_rows.extend(lock["tracked_evidence"])
            successor_witnesses.extend(lock["generated_witnesses"])
    witnesses = [*base_witnesses, *successor_witnesses]
    for witness in successor_witnesses:
        associations[witness["id"]] = set(witness["relevant_case_id"])
        kinds[witness["id"]] = "GENERATED_WITNESS"

    base_tracked = {row["id"]: row for row in source_lock["tracked_evidence"]}
    base_associated_signatures: dict[tuple[str, str], set[str]] = {}
    for row in tracked_rows:
        try:
            strings = document_strings(load_json(ROOT / row["path"]))
        except (OSError, json.JSONDecodeError, UnicodeDecodeError):
            continue
        related: set[str] = set()
        for witness in witnesses:
            if (
                witness["path"] in strings
                or witness["artifact_sha256"] in strings
                or witness["generator_or_origin"] == row["path"]
            ):
                related.update(witness["relevant_case_id"])
        if related:
            associations[row["id"]] = related
            kinds[row["id"]] = "TRACKED_EVIDENCE"
            if row["id"] in base_tracked:
                base_associated_signatures[(row["path"], row["file_sha256"])] = related

    if include_successors:
        for lock in evidence_locks or []:
            for row in lock["tracked_evidence"]:
                inherited = base_associated_signatures.get((row["path"], row["file_sha256"]))
                if inherited:
                    associations.setdefault(row["id"], set()).update(inherited)
                    kinds[row["id"]] = "TRACKED_EVIDENCE"
    return associations, kinds


def locked_records_related(
    first: tuple[str, dict[str, Any]], second: tuple[str, dict[str, Any]]
) -> bool:
    first_kind, first_row = first
    second_kind, second_row = second
    if first_row.get("id") == second_row.get("id"):
        return True
    if first_kind == second_kind == "tracked_evidence":
        return (
            first_row["path"] == second_row["path"]
            and first_row["file_sha256"] == second_row["file_sha256"]
        )
    if first_kind == second_kind == "generated_witness":
        return (
            first_row["path"] == second_row["path"]
            and first_row["artifact_sha256"] == second_row["artifact_sha256"]
        )
    if {first_kind, second_kind} != {"tracked_evidence", "generated_witness"}:
        return False
    witness = first_row if first_kind == "generated_witness" else second_row
    tracked = first_row if first_kind == "tracked_evidence" else second_row
    try:
        strings = document_strings(load_json(ROOT / tracked["path"]))
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return False
    return witness["path"] in strings or witness["artifact_sha256"] in strings


def safe_relative_path(value: str) -> bool:
    path = Path(value)
    return not path.is_absolute() and ".." not in path.parts and value not in {"", "."}


def is_tracked(relative: str) -> bool:
    return subprocess.run(
        ["git", "ls-files", "--error-unmatch", relative],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    ).returncode == 0


def validate_evidence_lock_chain(
    current: dict[str, Any],
    schema: dict[str, Any],
    source_lock: dict[str, Any],
    *,
    check_git_tracking: bool = True,
    historical_documents: dict[str, dict[str, Any]] | None = None,
    historical_document_sha256: dict[str, str] | None = None,
    source_lock_sha256: str | None = None,
    identities_document: dict[str, Any] | None = None,
) -> tuple[list[str], list[dict[str, Any]]]:
    """Validate a successor chain without mutating the frozen Milestone 6 lock."""
    errors: list[str] = []
    chain_reversed: list[dict[str, Any]] = []
    seen_hashes: set[str] = set()
    cursor = current
    while True:
        current_schema_errors = schema_errors(
            cursor, schema, f"evidence lock {cursor.get('lock_id', 'UNKNOWN')}"
        )
        errors.extend(current_schema_errors)
        if current_schema_errors:
            return errors, list(reversed(chain_reversed))
        digest = document_sha256(cursor)
        if digest in seen_hashes:
            errors.append("evidence-lock predecessor chain contains a cycle")
            break
        seen_hashes.add(digest)
        chain_reversed.append(cursor)
        predecessor = cursor.get("predecessor", {})
        if predecessor.get("kind") == "MILESTONE_6_SOURCE_LOCK":
            if ROOT / predecessor.get("path", "") != SOURCE_LOCK_PATH:
                errors.append("evidence-lock root does not name the canonical Milestone 6 source lock")
            elif predecessor.get("sha256") != (
                source_lock_sha256 if source_lock_sha256 is not None else sha256_file(SOURCE_LOCK_PATH)
            ):
                errors.append("evidence-lock root source-lock hash is stale")
            break
        if predecessor.get("kind") != "EVIDENCE_LOCK":
            errors.append("evidence-lock predecessor kind is invalid")
            break
        relative = predecessor.get("path", "")
        if not safe_relative_path(relative) or not relative.startswith(
            "config/declaration-validation-evidence-locks/"
        ):
            errors.append("evidence-lock predecessor path is not canonical and safe")
            break
        if historical_documents is not None and relative in historical_documents:
            cursor = historical_documents[relative]
            expected_predecessor_hash = (
                historical_document_sha256.get(relative, document_sha256(cursor))
                if historical_document_sha256 is not None
                else document_sha256(cursor)
            )
            if expected_predecessor_hash != predecessor.get("sha256"):
                errors.append(f"evidence-lock predecessor hash is stale: {relative}")
                break
        else:
            path = ROOT / relative
            if not path.is_file():
                errors.append(f"evidence-lock predecessor is missing: {relative}")
                break
            if sha256_file(path) != predecessor.get("sha256"):
                errors.append(f"evidence-lock predecessor hash is stale: {relative}")
                break
            try:
                cursor = load_json(path)
            except (OSError, json.JSONDecodeError):
                errors.append(f"evidence-lock predecessor is unreadable JSON: {relative}")
                break

    chain = list(reversed(chain_reversed))
    for index, lock in enumerate(chain, start=1):
        if lock.get("sequence") != index:
            errors.append(f"{lock.get('lock_id', 'UNKNOWN')}: evidence-lock sequence is not contiguous")
    if chain:
        root = chain[0]
        if root.get("status") != "MILESTONE_7_EMPTY_EVIDENCE_LOCK" or root.get("sequence") != 1:
            errors.append("evidence-lock chain does not start at the Milestone 7 empty root")
        if any(root.get(section) for section in (
            "normative_documentation",
            "mechanized_results",
            "tracked_evidence",
            "generated_witnesses",
        )):
            errors.append("Milestone 7 evidence-lock root is not empty")

    base_ids = set(source_lock_indices(source_lock))
    seen_ids = set(base_ids)
    tracked_paths = {row["path"] for row in source_lock["tracked_evidence"]}
    identity_source = identities_document if identities_document is not None else load_json(IDENTITY_PATH)
    identity_ids = {row["id"] for row in identity_source["identities"]}
    for lock in chain:
        for section in (
            "normative_documentation",
            "mechanized_results",
            "tracked_evidence",
            "generated_witnesses",
        ):
            for row in lock[section]:
                if row["id"] in seen_ids:
                    errors.append(f"duplicate source/evidence lock ID across successor chain: {row['id']}")
                seen_ids.add(row["id"])
        for row in lock["normative_documentation"]:
            relative = row["retrieved_path"]
            path = ROOT / relative
            if not safe_relative_path(relative) or not path.is_file():
                errors.append(f"{row['id']}: normative-document snapshot is missing or unsafe")
            elif sha256_file(path) != row["retrieved_content_sha256"]:
                errors.append(f"{row['id']}: normative-document snapshot hash is stale")
            elif check_git_tracking and not is_tracked(relative):
                errors.append(f"{row['id']}: normative-document snapshot is not tracked by Git")
        for row in lock["mechanized_results"]:
            relative = row["retrieved_path"]
            path = ROOT / relative
            if not safe_relative_path(relative) or not path.is_file():
                errors.append(f"{row['id']}: mechanized source snapshot is missing or unsafe")
            elif sha256_file(path) != row["retrieved_content_sha256"]:
                errors.append(f"{row['id']}: mechanized source snapshot hash is stale")
            elif check_git_tracking and not is_tracked(relative):
                errors.append(f"{row['id']}: mechanized source snapshot is not tracked by Git")
        for row in lock["tracked_evidence"]:
            relative = row["path"]
            path = ROOT / relative
            if not safe_relative_path(relative) or not path.is_file():
                errors.append(f"{row['id']}: successor tracked evidence is missing or unsafe")
                continue
            if sha256_file(path) != row["file_sha256"]:
                errors.append(f"{row['id']}: successor tracked-evidence hash is stale")
            if check_git_tracking and not is_tracked(relative):
                errors.append(f"{row['id']}: successor tracked evidence is not tracked by Git")
            tracked_paths.add(relative)
            try:
                document = load_json(path)
            except (OSError, json.JSONDecodeError, UnicodeDecodeError):
                errors.append(f"{row['id']}: successor tracked evidence is not JSON")
                continue
            for pointer in row["json_pointer_or_case_id"]:
                if pointer.startswith("/"):
                    try:
                        resolve_pointer(document, pointer)
                    except (KeyError, IndexError, ValueError):
                        errors.append(f"{row['id']}: successor JSON pointer does not resolve: {pointer}")
        for row in lock["generated_witnesses"]:
            relative = row["path"]
            path = ROOT / relative
            if not safe_relative_path(relative) or not path.is_file():
                errors.append(f"{row['id']}: successor witness is missing or unsafe")
            elif sha256_file(path) != row["artifact_sha256"]:
                errors.append(f"{row['id']}: successor witness hash is stale")
            elif check_git_tracking and not is_tracked(relative):
                errors.append(f"{row['id']}: successor witness is not tracked by Git")
            if row["generator_or_origin"] not in tracked_paths:
                errors.append(f"{row['id']}: successor witness origin is not content-bound tracked evidence")
            unknown = set(row["relevant_case_id"]) - identity_ids
            if unknown:
                errors.append(f"{row['id']}: successor witness names unknown identities {sorted(unknown)}")
    return errors, chain


def evidence_source_errors(
    evidence: dict[str, Any],
    target: dict[str, Any],
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]],
    approved_authority_sources: dict[str, Any],
) -> list[str]:
    errors: list[str] = []
    registry_name = evidence["source_lock"]["registry"]
    lock_id = evidence["source_lock"]["lock_id"]
    indices = source_lock_indices(source_lock, evidence_locks)
    locked: tuple[str, dict[str, Any]] | None = None
    if registry_name == "SEMANTIC_TARGET_PROFILE":
        allowed = {
            target["profile_id"],
            target["logical_target"]["target_id"],
            "/logical_target/modeled_judgment",
            *OBSERVER_POINTERS,
        }
        if lock_id not in allowed:
            errors.append(f"{evidence['id']}: unknown semantic-target lock id {lock_id}")
        if evidence["role"] != "DISCOVERY" or evidence["source_type"] != "OTHER":
            errors.append(
                f"{evidence['id']}: semantic-target profile is identity/applicability discovery only"
            )
    elif registry_name == "DECLARATION_VALIDATION_SOURCE_LOCK":
        locked = indices.get(lock_id)
        if locked is None:
            errors.append(f"{evidence['id']}: unknown source-lock id {lock_id}")
    else:
        locked = indices.get(lock_id)
        if locked is None or locked[0] not in {"tracked_evidence", "generated_witness"}:
            errors.append(f"{evidence['id']}: local-artifact lock id is not content-bound by the source lock")

    if locked is None:
        return errors
    kind, row = locked
    allowed_kinds = SOURCE_TYPE_LOCK_KINDS[evidence["source_type"]]
    if kind not in allowed_kinds:
        errors.append(
            f"{evidence['id']}: source type {evidence['source_type']} is incompatible "
            f"with locked record kind {kind}"
        )
    if (
        evidence["role"] == "ISOLATION"
        and row.get("source_role") == "EXISTING_LAB_EVIDENCE_ONLY"
    ):
        errors.append(
            f"{evidence['id']}: an EXISTING_LAB_EVIDENCE_ONLY artifact cannot by itself serve as ISOLATION"
        )
    if kind == "normative_documentation":
        expected_type = (
            "NORMATIVE_SPECIFICATION"
            if row["document_kind"] == "SPECIFICATION"
            else "AUTHORITATIVE_DOCUMENTATION"
        )
        if evidence["source_type"] != expected_type:
            errors.append(f"{evidence['id']}: normative document kind disagrees with source type")
        approved, _ = approved_authority_source_indices(approved_authority_sources)
        approval = approved.get(row["approved_source_id"])
        expected_identity = {
            "document_kind": row["document_kind"],
            "version_or_edition": row["version_or_edition"],
            "stable_url_or_doi": row["stable_url_or_doi"],
            "authenticated_content_sha256": row["retrieved_content_sha256"],
        }
        if approval is None or approval[0] != "normative_documentation":
            errors.append(
                f"{evidence['id']}: normative document is absent from the frozen approved authority-source registry"
            )
        elif any(approval[1][key] != value for key, value in expected_identity.items()):
            errors.append(
                f"{evidence['id']}: normative document identity disagrees with its approved authority source"
            )
    elif kind == "mechanized_results":
        approved, _ = approved_authority_source_indices(approved_authority_sources)
        approval = approved.get(row["approved_source_id"])
        expected_identity = {
            "repository_url": row["repository_url"],
            "revision": row["revision"],
            "path": row["path"],
            "blob_sha256": row["blob_sha256"],
            "theorem_or_definition": row["theorem_or_definition"],
        }
        if approval is None or approval[0] != "mechanized_results":
            errors.append(
                f"{evidence['id']}: mechanized result is absent from the frozen approved authority-source registry"
            )
        elif any(approval[1][key] != value for key, value in expected_identity.items()):
            errors.append(
                f"{evidence['id']}: mechanized source identity disagrees with its approved authority source"
            )
    locator = evidence["exact_locator"]
    value = locator["value"]
    locator_kind = locator["kind"]
    if kind == "tracked_evidence":
        allowed_locators = set(row["json_pointer_or_case_id"])
        if locator_kind == "JSON_POINTER":
            pointer = value
            if "#" in value:
                path, pointer = value.split("#", 1)
                if path != row["path"]:
                    errors.append(f"{evidence['id']}: JSON locator path disagrees with tracked evidence {lock_id}")
            if not pointer_is_within(pointer, allowed_locators):
                errors.append(f"{evidence['id']}: JSON locator is not bound by tracked evidence {lock_id}")
            else:
                try:
                    resolve_pointer(load_json(ROOT / row["path"]), pointer)
                except (OSError, json.JSONDecodeError, KeyError, IndexError, ValueError):
                    errors.append(f"{evidence['id']}: JSON locator does not resolve in tracked evidence {lock_id}")
        elif locator_kind == "CASE_ID":
            try:
                document = load_json(ROOT / row["path"])
            except (OSError, json.JSONDecodeError):
                errors.append(f"{evidence['id']}: case artifact is not readable JSON")
            else:
                if not document_contains_case_id(document, value):
                    errors.append(f"{evidence['id']}: case ID does not resolve in tracked evidence {lock_id}")
        elif locator_kind == "COMMAND" and value not in allowed_locators:
            errors.append(f"{evidence['id']}: command locator is not bound by tracked evidence {lock_id}")
    elif kind == "generated_witness":
        if locator_kind == "ARTIFACT_SHA256" and value != row["artifact_sha256"]:
            errors.append(f"{evidence['id']}: artifact digest locator disagrees with witness {lock_id}")
        elif locator_kind not in {"ARTIFACT_SHA256", "CASE_ID"}:
            errors.append(f"{evidence['id']}: incompatible witness locator kind {locator_kind}")
    elif kind == "source_file":
        if locator_kind not in {"SOURCE_SYMBOL", "SOURCE_RANGE"}:
            errors.append(f"{evidence['id']}: source file requires a source symbol or range locator")
        else:
            tokens = row["locator_verification"]["tokens"]
            mechanically_bound = value == row["symbol_or_range"] or any(
                value == token or value == token.split()[-1] for token in tokens
            )
            if not mechanically_bound:
                errors.append(
                    f"{evidence['id']}: source symbol/range is not bound by the source-lock locator"
                )
    elif kind == "normative_documentation":
        if locator_kind != "DOCUMENT_SECTION" or value != row["section_anchor_or_page"]:
            errors.append(f"{evidence['id']}: normative-document locator is not exact")
    elif kind == "mechanized_results":
        if locator_kind != "THEOREM_OR_DEFINITION" or value != row["theorem_or_definition"]:
            errors.append(f"{evidence['id']}: mechanized-result locator is not exact")
    return errors


def checker_observation_from_evidence(
    evidence: dict[str, Any],
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]],
) -> dict[str, str] | None:
    """Extract an observer fact from content-bound structured result bytes.

    Human-readable secondary locator strings are deliberately ignored. The
    JSON pointer must identify one validator row's normalized outcome, and the
    checker identity is read from the sibling field in the same row.
    """
    if evidence["source_type"] != "CHECKER_RESULT":
        return None
    locked = source_lock_indices(source_lock, evidence_locks).get(
        evidence["source_lock"]["lock_id"]
    )
    if locked is None or locked[0] != "tracked_evidence":
        return None
    locator = evidence["exact_locator"]
    if locator["kind"] != "JSON_POINTER":
        return None
    row = locked[1]
    value = locator["value"]
    pointer = value
    if "#" in value:
        path, pointer = value.split("#", 1)
        if path != row["path"]:
            return None
    match = re.fullmatch(r"/validators/(0|[1-9][0-9]*)/result/normalized_outcome", pointer)
    if match is None:
        return None
    try:
        document = load_json(ROOT / row["path"])
        index = int(match.group(1))
        validator = document["validators"][index]
        outcome = validator["result"]["normalized_outcome"]
        checker = validator["checker"]
    except (OSError, json.JSONDecodeError, KeyError, IndexError, TypeError):
        return None
    if not isinstance(outcome, str) or not isinstance(checker, str):
        return None
    profile_pointer = next(
        (pointer for pointer, checker_id in OBSERVER_CHECKER_IDS.items() if checker_id == checker),
        None,
    )
    if profile_pointer is None:
        return None
    compatibility = validator.get("compatibility", {})
    checker_identity = compatibility.get("checker_identity", {})
    if compatibility.get("status") != "COMPATIBLE":
        return None
    target_profile = load_json(TARGET_PATH)["observer_profiles"][profile_pointer.rsplit("/", 1)[-1]]
    if (
        checker_identity.get("arena_definition_sha256")
        != target_profile["arena_integration"]["definition_sha256"]
    ):
        return None
    if checker == "official":
        if (
            checker_identity.get("built_toolchain")
            != target_profile["configuration"]["built_toolchain"]
        ):
            return None
    elif (
        checker_identity.get("source_revision")
        != target_profile["implementation"]["revision"]
    ):
        return None
    return {
        "checker": checker,
        "outcome": outcome,
        "profile_pointer": profile_pointer,
        "case_id": str(document.get("case_id", "")),
        "artifact_path": row["path"],
        "json_pointer": pointer,
    }


def evidence_matches_observation(
    evidence: dict[str, Any],
    profile_pointer: str,
    outcome: str,
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]],
) -> bool:
    observed = checker_observation_from_evidence(
        evidence, source_lock, evidence_locks
    )
    return observed is not None and (
        observed["checker"] == OBSERVER_CHECKER_IDS[profile_pointer]
        and observed["outcome"] == outcome
    )


def validate_rule_set(authority: dict[str, Any]) -> tuple[list[str], dict[str, dict[str, Any]]]:
    errors: list[str] = []
    rules_by_id, new = unique_index(authority["rules"], "id", "authority rule")
    errors.extend(new)
    by_pair: dict[tuple[str, str], dict[str, Any]] = {}
    for rule in authority["rules"]:
        applies = rule["applies_to"]
        pair = (applies["kind"], applies["authority_status"])
        if pair in by_pair:
            errors.append(f"duplicate authority kind/status rule: {pair}")
        by_pair[pair] = rule
        if set(rule["checks"]) != EXPECTED_RULE_CHECKS.get(pair, set()):
            errors.append(f"{rule['id']}: qualification checks differ from frozen V1 sufficiency")
        expected_scope = (
            "NORMATIVE_REQUIREMENT_FOR_MODELED_JUDGMENT"
            if pair[0] == "NORMATIVE_CANDIDATE_OBLIGATION"
            else "EMPIRICAL_BOUNDARY_FOR_PINNED_PROFILES"
        )
        if applies["authority_scope"] != expected_scope:
            errors.append(f"{rule['id']}: authority scope does not match kind")
    if set(by_pair) != set(EXPECTED_RULE_CHECKS):
        errors.append("authority rules do not cover exactly both kinds and all three statuses")
    return errors, rules_by_id


def validate_entry(
    wrapper: dict[str, Any],
    *,
    catalog_ids: set[str],
    identities: dict[str, dict[str, Any]],
    decision_ids: set[str],
    authority_rules: dict[str, dict[str, Any]],
    target: dict[str, Any],
    model: dict[str, Any],
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]],
    approved_authority_sources: dict[str, Any],
) -> list[str]:
    errors: list[str] = []
    entry = wrapper["characterization"]
    entry_id = entry["id"]
    identity = identities.get(entry_id)
    if identity is None:
        errors.append(f"{entry_id}: catalog ID is absent from the frozen identity registry")
    else:
        expected_denotation = canonical_identity_denotation(identity)
        if wrapper["identity_denotation"] != expected_denotation:
            errors.append(f"{entry_id}: structured identity denotation differs from the frozen registry")
        legacy_denotation = {
            "semantic_statement": identity["semantic_statement"],
            "applicability": identity["applicability"],
            "intended_kind": identity["intended_kind"],
        }
        expected_identity_hash = hashlib.sha256(
            json.dumps(legacy_denotation, sort_keys=True, separators=(",", ":")).encode("utf-8")
        ).hexdigest()
        expected_semantic_hash = hashlib.sha256(
            json.dumps(expected_denotation, sort_keys=True, separators=(",", ":")).encode("utf-8")
        ).hexdigest()
        if wrapper["identity_statement_sha256"] != identity["statement_sha256"]:
            errors.append(f"{entry_id}: identity statement hash is stale")
        if wrapper["identity_statement_sha256"] != expected_identity_hash:
            errors.append(f"{entry_id}: identity statement hash does not bind the structured denotation")
        if wrapper["semantic_denotation_sha256"] != expected_semantic_hash:
            errors.append(f"{entry_id}: canonical semantic denotation hash is stale")
        intended = identity["intended_kind"]
        if intended is not None and entry["kind"] != intended:
            errors.append(f"{entry_id}: catalog kind changes the frozen identity denotation")
        if identity["identity_status"] in {"RESERVED_OUT_OF_SCOPE", "DEFERRED_KIND"}:
            errors.append(f"{entry_id}: reserved/deferred identity cannot be admitted as a catalog entry")
        if not set(identity["decision_ids"]) <= set(wrapper["decision_ids"]):
            errors.append(f"{entry_id}: catalog entry omits its frozen identity decision")

        if entry["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION":
            if (
                entry["statement"]["judgment"]["target_profile_pointer"]
                != "/logical_target/modeled_judgment"
            ):
                errors.append(f"{entry_id}: modeled-judgment identity changes the stable semantic denotation")
            if entry["statement"]["target_premise"]["statement"] != identity["semantic_statement"]:
                errors.append(f"{entry_id}: normative target premise changes the stable semantic identity")
            applicability_statements = [
                item["statement"] for item in entry["statement"]["applicability"]
            ]
            if applicability_statements != [identity["applicability"]]:
                errors.append(f"{entry_id}: normative applicability narrows or widens the stable semantic denotation")
            if entry["statement"]["premises"]:
                errors.append(f"{entry_id}: additional normative premises change the stable semantic denotation")
            if entry["statement"]["expected_effect"]["violation_expectation"] != "REJECT":
                errors.append(f"{entry_id}: normative violation semantics change the stable semantic denotation")
        else:
            if entry["statement"]["subject_scope"] != identity["applicability"]:
                errors.append(f"{entry_id}: empirical subject scope changes the stable applicability")
            if entry["statement"]["stimulus"]["statement"] != identity["semantic_statement"]:
                errors.append(f"{entry_id}: empirical stimulus changes the stable semantic identity")
            preconditions = [item["statement"] for item in entry["statement"]["precondition"]]
            if preconditions != [identity["applicability"]]:
                errors.append(f"{entry_id}: empirical precondition changes the stable semantic denotation")
            observation_points = [
                item["statement"] for item in entry["statement"]["observation_points"]
            ]
            if observation_points != [empirical_observation_statement(identity)]:
                errors.append(f"{entry_id}: empirical observation point changes the stable semantic denotation")

    for decision_id in wrapper["decision_ids"]:
        if decision_id not in decision_ids:
            errors.append(f"{entry_id}: unknown decision ID {decision_id}")

    targets = entry["lifecycle"]["target_ids"]
    for target_id in targets:
        if target_id == entry_id:
            errors.append(f"{entry_id}: lifecycle target cannot reference itself")
        elif target_id not in catalog_ids:
            errors.append(f"{entry_id}: lifecycle target is not a catalog entry: {target_id}")

    evidence_by_id, new = unique_index(entry["evidence"], "id", f"{entry_id} evidence ID")
    errors.extend(new)
    evidence_identity_associations, _ = existing_evidence_identity_associations(
        source_lock, evidence_locks, include_successors=True
    )
    all_evidence_refs = set(entry["authority"]["basis"]["evidence_refs"])
    all_evidence_refs.update(entry["soundness_relevance"]["basis_evidence_refs"])
    for observation in wrapper["observer_vector"]:
        all_evidence_refs.update(observation["evidence_refs"])
    for mapping in wrapper["source_mappings"]:
        all_evidence_refs.update(mapping["evidence_refs"])
    if "arena_disposition" in wrapper:
        all_evidence_refs.update(wrapper["arena_disposition"]["evidence_refs"])
    unknown_refs = all_evidence_refs - set(evidence_by_id)
    if unknown_refs:
        errors.append(f"{entry_id}: unresolved evidence refs {sorted(unknown_refs)}")

    pointer_errors = False
    source_errors = False
    role_source_matrix = model["evidence_qualification"]["role_source_type_matrix"]
    for evidence in entry["evidence"]:
        if evidence["source_type"] not in role_source_matrix[evidence["role"]]:
            errors.append(
                f"{entry_id}/{evidence['id']}: evidence role/source-type combination is not qualified"
            )
        if (
            evidence["role"] == "CONTRADICTION"
            and evidence["source_type"] not in NORMATIVE_CONTRADICTION_SOURCE_TYPES
        ):
            errors.append(
                f"{entry_id}/{evidence['id']}: CONTRADICTION requires a qualified normative interpretation source"
            )
        pointer = evidence["claim_supported"]["entry_json_pointer"]
        try:
            resolve_pointer(entry, pointer)
        except (KeyError, IndexError, ValueError):
            errors.append(f"{entry_id}/{evidence['id']}: claim JSON Pointer does not resolve")
            pointer_errors = True
        found = evidence_source_errors(
            evidence,
            target,
            source_lock,
            evidence_locks,
            approved_authority_sources,
        )
        if found:
            errors.extend(found)
            source_errors = True

    observer_by_pointer: dict[str, dict[str, Any]] = {}
    for observation in wrapper["observer_vector"]:
        pointer = observation["profile_pointer"]
        if pointer in observer_by_pointer:
            errors.append(f"{entry_id}: duplicate observer profile {pointer}")
        observer_by_pointer[pointer] = observation
        if observation["outcome"] in OBSERVED_OUTCOMES and not observation["evidence_refs"]:
            errors.append(f"{entry_id}/{pointer}: concrete observer outcome lacks evidence")
        if observation["outcome"] in OBSERVED_OUTCOMES:
            matching = [
                evidence_by_id[evidence_id]
                for evidence_id in observation["evidence_refs"]
                if evidence_id in evidence_by_id
                and evidence_matches_observation(
                    evidence_by_id[evidence_id],
                    pointer,
                    observation["outcome"],
                    source_lock,
                    evidence_locks,
                )
                and entry_id
                in evidence_identity_associations.get(
                    evidence_by_id[evidence_id]["source_lock"]["lock_id"], set()
                )
                and evidence_by_id[evidence_id]["source_type"] == "CHECKER_RESULT"
            ]
            if not matching:
                errors.append(
                    f"{entry_id}/{pointer}: concrete observer outcome lacks profile/outcome-bound checker evidence for this identity"
                )
    complete_vector = set(observer_by_pointer) == OBSERVER_POINTERS
    if not complete_vector:
        errors.append(f"{entry_id}: observer vector is incomplete")

    if entry["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION":
        pointer = entry["statement"]["judgment"]["target_profile_pointer"]
        try:
            resolve_pointer(target, pointer)
        except (KeyError, IndexError, ValueError):
            errors.append(f"{entry_id}: modeled-judgment target pointer does not resolve")
    else:
        for effect in entry["statement"]["profile_specific_effects"]:
            pointer = effect["observer_profile_pointer"]
            observation = observer_by_pointer.get(pointer)
            if observation is None:
                errors.append(f"{entry_id}: empirical effect has no observer-vector row: {pointer}")
            elif effect["outcome"] != observation["outcome"]:
                errors.append(f"{entry_id}: empirical effect disagrees with observer vector for {pointer}")

    source_rows = {row["id"]: row for row in source_lock["source_files"]}
    for mapping in wrapper["source_mappings"]:
        source = source_rows.get(mapping["source_file_id"])
        if source is None:
            errors.append(f"{entry_id}: unknown mapped source file {mapping['source_file_id']}")
            continue
        if source["repository_id"] not in IMPLEMENTATION_REPOSITORIES[mapping["implementation"]]:
            errors.append(
                f"{entry_id}: mapped source repository does not belong to {mapping['implementation']}"
            )
        matching_evidence = [
            evidence_by_id[evidence_id]
            for evidence_id in mapping["evidence_refs"]
            if evidence_id in evidence_by_id
            and evidence_by_id[evidence_id]["role"] == "IMPLEMENTATION_OBSERVATION"
            and evidence_by_id[evidence_id]["source_type"] == "IMPLEMENTATION_SOURCE"
            and evidence_by_id[evidence_id]["source_lock"]["lock_id"] == mapping["source_file_id"]
            and evidence_by_id[evidence_id]["exact_locator"]["value"] == mapping["symbol_or_range"]
        ]
        if not matching_evidence:
            errors.append(f"{entry_id}: source mapping lacks exact source-bound implementation evidence")

    arena_disposition = wrapper.get("arena_disposition")
    if arena_disposition and arena_disposition["disposition"] == "LINKED":
        arena_evidence = [
            evidence_by_id[evidence_id]
            for evidence_id in arena_disposition["evidence_refs"]
            if evidence_id in evidence_by_id
        ]
        if not any(item["source_type"] == "ARENA_TEST" for item in arena_evidence):
            errors.append(f"{entry_id}: linked Arena disposition lacks content-bound ARENA_TEST evidence")

    basis = entry["authority"]["basis"]
    rule = authority_rules.get(basis["qualification_rule"])
    if rule is None:
        errors.append(f"{entry_id}: unknown authority qualification rule {basis['qualification_rule']}")
        return errors
    applies = rule["applies_to"]
    if (
        applies["kind"] != entry["kind"]
        or applies["authority_status"] != entry["authority"]["status"]
        or applies["authority_scope"] != entry["authority"]["scope"]
    ):
        errors.append(f"{entry_id}: qualification rule does not apply to entry kind/scope/status")

    evidence_values = list(evidence_by_id.values())
    authority_evidence = [evidence_by_id[item] for item in basis["evidence_refs"] if item in evidence_by_id]
    checks = set(rule["checks"])
    if "FORBID_LLM_AUTHORITY" in checks and any(
        item["source_type"] == "OTHER" for item in authority_evidence
    ):
        errors.append(f"{entry_id}: unqualified OTHER/LLM-like evidence cannot support authority")
    if "NO_UNMET_REQUIREMENTS" in checks and basis["unmet_requirements"]:
        errors.append(f"{entry_id}: established authority has unmet requirements")
    if "HAS_NAMED_UNMET_REQUIREMENT" in checks and not basis["unmet_requirements"]:
        errors.append(f"{entry_id}: non-established authority lacks a named unmet requirement")
    normative_support = [item for item in authority_evidence if item["role"] == "NORMATIVE_SUPPORT"]
    if "FORBID_CONSENSUS_ONLY_NORMATIVITY" in checks and authority_evidence and all(
        item["role"] == "IMPLEMENTATION_OBSERVATION" for item in authority_evidence
    ):
        errors.append(f"{entry_id}: implementation consensus alone cannot establish normativity")
    if "HAS_NORMATIVE_SUPPORT" in checks and not normative_support:
        errors.append(f"{entry_id}: established normative authority lacks NORMATIVE_SUPPORT")
    if "NORMATIVE_SUPPORT_SOURCE_TYPE_ALLOWED" in checks and any(
        item["source_type"] not in {
            "FORMAL_MECHANIZATION",
            "NORMATIVE_SPECIFICATION",
            "AUTHORITATIVE_DOCUMENTATION",
        }
        for item in normative_support
    ):
        errors.append(f"{entry_id}: normative support uses a non-normative source type")
    if "FORBID_SEMANTIC_TARGET_AS_NORMATIVE_SUPPORT" in checks and any(
        item["source_lock"]["registry"] == "SEMANTIC_TARGET_PROFILE"
        for item in normative_support
    ):
        errors.append(f"{entry_id}: semantic-target profile cannot serve as normative support")
    if "NORMATIVE_SUPPORT_SOURCE_LOCK_KIND_COMPATIBLE" in checks and any(
        evidence_source_errors(
            item,
            target,
            source_lock,
            evidence_locks,
            approved_authority_sources,
        )
        for item in normative_support
    ):
        errors.append(f"{entry_id}: normative support is not bound to a compatible normative source")
    if "NORMATIVE_SUPPORT_SOURCE_IDENTITY_PREAPPROVED" in checks and any(
        any(
            "approved authority-source registry" in error
            or "approved authority source" in error
            for error in evidence_source_errors(
                item,
                target,
                source_lock,
                evidence_locks,
                approved_authority_sources,
            )
        )
        for item in normative_support
    ):
        errors.append(f"{entry_id}: normative support source identity was not preapproved")
    if "NORMATIVE_SUPPORT_TARGETS_NORMATIVE_CLAIM" in checks and any(
        not item["claim_supported"]["entry_json_pointer"].startswith("/statement")
        for item in normative_support
    ):
        errors.append(f"{entry_id}: normative support does not target the modeled statement")
    if "HAS_IMPLEMENTATION_OBSERVATION" in checks and not any(
        item["role"] == "IMPLEMENTATION_OBSERVATION"
        and item["source_type"] == "CHECKER_RESULT"
        and any(
            evidence_matches_observation(
                item,
                observation["profile_pointer"],
                observation["outcome"],
                source_lock,
                evidence_locks,
            )
            for observation in wrapper["observer_vector"]
            if observation["outcome"] in OBSERVED_OUTCOMES
        )
        for item in authority_evidence
    ):
        errors.append(f"{entry_id}: established empirical authority lacks an implementation observation")
    if "HAS_NON_PLACEHOLDER_OBSERVER_OUTCOME" in checks and not any(
        item["outcome"] in OBSERVED_OUTCOMES for item in wrapper["observer_vector"]
    ):
        errors.append(f"{entry_id}: established empirical authority has no concrete observer outcome")
    if "OBSERVER_VECTOR_COMPLETE" in checks and not complete_vector:
        errors.append(f"{entry_id}: authority rule requires a complete observer vector")
    if "OBSERVED_OUTCOMES_EVIDENCE_BACKED" in checks:
        for observation in wrapper["observer_vector"]:
            if observation["outcome"] in OBSERVED_OUTCOMES and not observation["evidence_refs"]:
                errors.append(f"{entry_id}: observed outcome is not evidence-backed")
    if (
        "OBSERVED_OUTCOMES_ATTRIBUTION_BOUND" in checks
        or "OBSERVED_OUTCOMES_EXTRACTED_FROM_RESULT_BYTES" in checks
    ):
        for observation in wrapper["observer_vector"]:
            if observation["outcome"] not in OBSERVED_OUTCOMES:
                continue
            if not any(
                evidence_matches_observation(
                    evidence_by_id[evidence_id],
                    observation["profile_pointer"],
                    observation["outcome"],
                    source_lock,
                    evidence_locks,
                )
                for evidence_id in observation["evidence_refs"]
                if evidence_id in evidence_by_id
            ):
                errors.append(f"{entry_id}: observed outcome attribution is not evidence-bound")
    active_authority_contradiction = any(
        item["role"] == "CONTRADICTION"
        and item["source_type"] in NORMATIVE_CONTRADICTION_SOURCE_TYPES
        and item["claim_supported"]["entry_json_pointer"].startswith("/authority")
        for item in evidence_values
    )
    active_statement_contradiction = any(
        item["role"] == "CONTRADICTION"
        and item["source_type"] in NORMATIVE_CONTRADICTION_SOURCE_TYPES
        and item["claim_supported"]["entry_json_pointer"].startswith("/statement")
        for item in evidence_values
    )
    if "NO_ACTIVE_AUTHORITY_CONTRADICTION" in checks and active_authority_contradiction:
        errors.append(f"{entry_id}: established authority has an active authority contradiction")
    if "NO_RELEVANT_STATEMENT_CONTRADICTION" in checks and active_statement_contradiction:
        errors.append(f"{entry_id}: established authority has an active statement contradiction")
    unresolved_normative_assumptions = {
        assumption["id"]
        for item in normative_support
        for assumption in item["assumptions"]
        if assumption["status"] == "UNRESOLVED"
    }
    active_normative_assumptions = {
        assumption["id"]
        for item in normative_support
        for assumption in item["assumptions"]
        if assumption["status"] == "ACTIVE"
    }
    if (
        "NO_UNRESOLVED_NORMATIVE_SUPPORT_ASSUMPTIONS" in checks
        and unresolved_normative_assumptions
    ):
        errors.append(f"{entry_id}: established normative support has unresolved assumptions")
    if "NO_ACTIVE_NORMATIVE_SUPPORT_ASSUMPTIONS" in checks and active_normative_assumptions:
        errors.append(f"{entry_id}: established normative support has active assumptions")
    if "HAS_BLOCKING_AUTHORITY_UNKNOWN_OR_CONTRADICTION" in checks:
        blocking_unknown = any(
            "AUTHORITY_ESTABLISHMENT" in item["blocking_for"] for item in entry["unknowns"]
        )
        unresolved_assumption = any(
            assumption["status"] == "UNRESOLVED"
            for item in authority_evidence
            for assumption in item["assumptions"]
        )
        if not (
            blocking_unknown
            or active_authority_contradiction
            or active_statement_contradiction
            or unresolved_assumption
        ):
            errors.append(f"{entry_id}: unresolved authority lacks a blocking unknown or contradiction")
    if "CLAIM_POINTERS_RESOLVE" in checks and pointer_errors:
        errors.append(f"{entry_id}: qualification rule has unresolved claim pointers")
    if "SOURCE_LOCK_REFS_RESOLVE" in checks and source_errors:
        errors.append(f"{entry_id}: qualification rule has unresolved source locks")
    if entry["soundness_relevance"]["status"] != "NOT_ASSESSED":
        errors.append(
            f"{entry_id}: soundness relevance must remain NOT_ASSESSED until a separate qualification rule is frozen"
        )
    return errors


def lifecycle_cycle_errors(entries: list[dict[str, Any]]) -> list[str]:
    graph = {
        row["characterization"]["id"]: row["characterization"]["lifecycle"]["target_ids"]
        for row in entries
    }
    errors: list[str] = []
    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(node: str) -> None:
        if node in visiting:
            errors.append(f"lifecycle target cycle contains {node}")
            return
        if node in visited:
            return
        visiting.add(node)
        for target in graph.get(node, []):
            visit(target)
        visiting.remove(node)
        visited.add(node)

    for node in graph:
        visit(node)
    return errors


def validate_existing_evidence_dispositions(
    dispositions: list[dict[str, Any]],
    *,
    source_lock: dict[str, Any],
    evidence_locks: list[dict[str, Any]],
    entries: list[dict[str, Any]],
) -> list[str]:
    """Require silence-free closure of frozen identity-associated Lab evidence."""

    errors: list[str] = []
    associations, kinds = existing_evidence_identity_associations(source_lock)
    entry_by_id = {row["characterization"]["id"]: row for row in entries}
    indices = source_lock_indices(source_lock, evidence_locks)

    for stable_id, entry in entry_by_id.items():
        for evidence in entry["characterization"]["evidence"]:
            if evidence["source_type"] != "ARENA_TEST":
                continue
            source_id = evidence["source_lock"]["lock_id"]
            associations.setdefault(source_id, set()).add(stable_id)
            kinds[source_id] = "ARENA_EVIDENCE"

    expected_pairs = {
        (stable_id, source_id)
        for source_id, stable_ids in associations.items()
        for stable_id in stable_ids
        if stable_id in entry_by_id
    }
    seen_pairs: set[tuple[str, str]] = set()
    for row in dispositions:
        stable_id = row["stable_identity_id"]
        source_id = row["source_lock_id"]
        pair = (stable_id, source_id)
        if pair in seen_pairs:
            errors.append(f"{stable_id}/{source_id}: duplicate existing-evidence disposition")
        seen_pairs.add(pair)
        if stable_id not in entry_by_id:
            errors.append(f"{stable_id}/{source_id}: existing evidence targets a non-active identity")
            continue
        if stable_id not in associations.get(source_id, set()):
            errors.append(
                f"{stable_id}/{source_id}: evidence is not frozen as relevant to this identity"
            )
        expected_kind = kinds.get(source_id)
        if expected_kind is None:
            errors.append(f"{stable_id}/{source_id}: unknown identity-associated evidence record")
            continue
        if row["source_record_kind"] != expected_kind:
            errors.append(f"{stable_id}/{source_id}: evidence record kind is incorrect")
        expected_layers = entry_by_id[stable_id]["characterization"]["layers"]
        if row["layer_relevance"] != expected_layers:
            errors.append(f"{stable_id}/{source_id}: layer relevance differs from the entry")

        evidence_by_id = {
            item["id"]: item
            for item in entry_by_id[stable_id]["characterization"]["evidence"]
        }
        unknown = set(row["linked_catalog_evidence_ids"]) - set(evidence_by_id)
        if unknown:
            errors.append(
                f"{stable_id}/{source_id}: linked catalog evidence IDs do not resolve in this identity {sorted(unknown)}"
            )
        if row["disposition"] != "LINKED":
            continue
        source_record = indices.get(source_id)
        if source_record is None:
            errors.append(f"{stable_id}/{source_id}: linked source-lock record does not resolve")
            continue
        related = False
        for evidence_id in row["linked_catalog_evidence_ids"]:
            evidence = evidence_by_id.get(evidence_id)
            if evidence is None:
                continue
            linked_record = indices.get(evidence["source_lock"]["lock_id"])
            if linked_record is not None and locked_records_related(source_record, linked_record):
                related = True
                break
        if not related:
            errors.append(
                f"{stable_id}/{source_id}: LINKED disposition lacks content-related catalog evidence"
            )

    if seen_pairs != expected_pairs:
        missing = sorted(expected_pairs - seen_pairs)
        unexpected = sorted(seen_pairs - expected_pairs)
        if missing:
            errors.append(
                f"M8 existing-evidence closure omits frozen identity/evidence pairs {missing}"
            )
        if unexpected:
            errors.append(
                f"M8 existing-evidence closure contains unrelated identity/evidence pairs {unexpected}"
            )
    return errors


def validate_reviewed_pilot_reuse(catalog: dict[str, Any]) -> list[str]:
    """Require the current inventory to reuse the five reviewed entries byte-for-byte."""

    pilot_validator = load_module(
        "declaration_catalog_reviewed_pilot_reuse", PILOT_VALIDATOR_PATH
    )
    context, context_errors = pilot_validator.reviewed_pilot_context()
    if context_errors or context is None:
        return [
            "reviewed-pilot reuse: " + error for error in context_errors
        ] or ["reviewed-pilot reuse context is unavailable"]
    pilot = context["pilot"]
    current_entries = {
        row["characterization"]["id"]: row for row in catalog["entries"]
    }
    errors: list[str] = []
    for reviewed in pilot["entries"]:
        stable_id = reviewed["characterization"]["id"]
        if current_entries.get(stable_id) != reviewed:
            errors.append(f"{stable_id}: current catalog changes immutable reviewed-pilot bytes")
    current_sites = {
        (row["stable_identity_id"], row["site_id"]): row
        for row in catalog["site_dispositions"]
    }
    for reviewed in pilot["site_dispositions"]:
        pair = (reviewed["stable_identity_id"], reviewed["site_id"])
        if current_sites.get(pair) != reviewed:
            errors.append(f"{pair[0]}/{pair[1]}: current catalog changes immutable reviewed-pilot site bytes")
    return errors


def expected_discovery_site_pairs(
    stable_ids: set[str],
    identities: dict[str, dict[str, Any]],
    discovery_closure: dict[str, Any],
) -> set[tuple[str, str]]:
    """Derive the frozen M4 site-to-M5 identity surface for a catalog scope."""

    pairs: set[tuple[str, str]] = set()
    for stable_id in stable_ids:
        identity = identities.get(stable_id)
        if identity is None:
            continue
        seed_keys = set(identity["source_seed_keys"])
        for site in discovery_closure["sites"]:
            if seed_keys.intersection(site["seed_keys"]):
                pairs.add((stable_id, site["id"]))
    return pairs


def validate_site_dispositions(
    site_dispositions: list[dict[str, Any]],
    *,
    stable_ids: set[str],
    identities: dict[str, dict[str, Any]],
    discovery_closure: dict[str, Any],
    entries: list[dict[str, Any]],
) -> list[str]:
    """Require every frozen relevant M4 site to survive as an explicit M8 finding."""

    errors: list[str] = []
    sites, site_errors = unique_index(discovery_closure["sites"], "id", "discovery site")
    errors.extend(site_errors)
    source_rows, source_errors = unique_index(discovery_closure["sources"], "id", "discovery source")
    errors.extend(source_errors)
    expected_pairs = expected_discovery_site_pairs(stable_ids, identities, discovery_closure)
    seen_pairs: set[tuple[str, str]] = set()
    evidence_ids_by_identity = {
        row["characterization"]["id"]: {
            evidence["id"] for evidence in row["characterization"]["evidence"]
        }
        for row in entries
    }
    source_mappings_by_identity = {
        row["characterization"]["id"]: row["source_mappings"] for row in entries
    }
    for row in site_dispositions:
        stable_id = row["stable_identity_id"]
        site_id = row["site_id"]
        pair = (stable_id, site_id)
        if pair in seen_pairs:
            errors.append(f"{stable_id}/{site_id}: duplicate M8 site disposition")
        seen_pairs.add(pair)
        if stable_id not in stable_ids:
            errors.append(f"{stable_id}/{site_id}: site disposition targets an identity outside this inventory")
        site = sites.get(site_id)
        if site is None:
            errors.append(f"{stable_id}/{site_id}: unknown frozen M4 discovery site")
            continue
        if row["source_file_id"] != site["source_id"]:
            errors.append(f"{stable_id}/{site_id}: source file identity differs from frozen M4 site")
        if row["symbol_or_range"] != site["symbol_or_range"]:
            errors.append(f"{stable_id}/{site_id}: exact source locator differs from frozen M4 site")
        source = source_rows.get(site["source_id"])
        if source is None:
            errors.append(f"{stable_id}/{site_id}: M4 site source is absent from the frozen source list")
        else:
            expected_implementation = DISCOVERY_OBSERVER_IMPLEMENTATIONS.get(source["observer"])
            if expected_implementation is None:
                errors.append(f"{stable_id}/{site_id}: M4 source observer has no M8 implementation mapping")
            elif row["implementation"] != expected_implementation:
                errors.append(f"{stable_id}/{site_id}: implementation differs from frozen M4 observer attribution")
        unknown_evidence = set(row["evidence_refs"]) - evidence_ids_by_identity.get(stable_id, set())
        if unknown_evidence:
            errors.append(f"{stable_id}/{site_id}: unresolved site-disposition evidence refs {sorted(unknown_evidence)}")
        if row["disposition"] == "OBSERVED_ABSENCE":
            evidence_text = " ".join([site["behavior"], site["rationale"]]).lower()
            if not any(token in evidence_text for token in {"absence", "does not", "has no", "no allowed"}):
                errors.append(f"{stable_id}/{site_id}: OBSERVED_ABSENCE is not supported by the frozen M4 inspection finding")
            if any(
                mapping["source_file_id"] == row["source_file_id"]
                and mapping["symbol_or_range"] == row["symbol_or_range"]
                and mapping["role"] == "ENFORCEMENT"
                for mapping in source_mappings_by_identity.get(stable_id, [])
            ):
                errors.append(f"{stable_id}/{site_id}: observed absence cannot be represented as enforcement")
    if seen_pairs != expected_pairs:
        missing = sorted(expected_pairs - seen_pairs)
        unexpected = sorted(seen_pairs - expected_pairs)
        if missing:
            errors.append(f"M8 site-disposition closure omits frozen M4 site pairs {missing}")
        if unexpected:
            errors.append(f"M8 site-disposition closure contains non-applicable site pairs {unexpected}")
    return errors


def validate_decisions(
    decisions: dict[str, Any],
    catalog: dict[str, Any],
    identities: dict[str, dict[str, Any]],
    catalog_schema: dict[str, Any],
) -> tuple[list[str], set[str]]:
    errors: list[str] = []
    records_by_id, new = unique_index(decisions["records"], "id", "post-catalog decision")
    errors.extend(new)
    catalog_hash = document_sha256(catalog)
    entry_by_id = {
        row["characterization"]["id"]: row["characterization"] for row in catalog["entries"]
    }
    evidence_pairs = {
        (entry_id, evidence["id"])
        for entry_id, entry in entry_by_id.items()
        for evidence in entry["evidence"]
    }
    referenced = {
        decision_id
        for row in catalog["entries"]
        for decision_id in row["decision_ids"]
        if decision_id.startswith("DEC.CATALOG.")
    }
    referenced.update(
        decision_id
        for row in catalog["identity_dispositions"]
        for decision_id in row["decision_ids"]
        if decision_id.startswith("DEC.CATALOG.")
    )
    for record in decisions["records"]:
        if record["catalog_hash_after"] != catalog_hash:
            errors.append(f"{record['id']}: catalog_hash_after is not the supplied catalog")
        snapshot_binding = record["catalog_snapshot_before"]
        relative = snapshot_binding["path"]
        snapshot: dict[str, Any] | None = None
        if not safe_relative_path(relative) or not relative.startswith(
            "results/research/declaration-validation-catalog-snapshots/"
        ):
            errors.append(f"{record['id']}: before snapshot path is not canonical and safe")
        else:
            snapshot_path = ROOT / relative
            if not snapshot_path.is_file():
                errors.append(f"{record['id']}: before snapshot is missing")
            elif sha256_file(snapshot_path) != snapshot_binding["sha256"]:
                errors.append(f"{record['id']}: before snapshot binding is stale")
            elif record["catalog_hash_before"] != snapshot_binding["sha256"]:
                errors.append(f"{record['id']}: catalog_hash_before disagrees with snapshot binding")
            elif not is_tracked(relative):
                errors.append(f"{record['id']}: before snapshot is not tracked by Git")
            else:
                try:
                    snapshot = load_json(snapshot_path)
                except (OSError, json.JSONDecodeError):
                    errors.append(f"{record['id']}: before snapshot is unreadable JSON")
                else:
                    snapshot_errors = schema_errors(
                        snapshot,
                        catalog_schema,
                        f"{record['id']} before snapshot",
                    )
                    errors.extend(snapshot_errors)
                    if snapshot_errors:
                        snapshot = None
        before_by_id = {
            row["characterization"]["id"]: row["characterization"]
            for row in (snapshot or {}).get("entries", [])
        }
        for stable_id in set(record["inputs"] + record["result"]):
            if stable_id not in identities:
                errors.append(f"{record['id']}: unknown stable identity {stable_id}")
        for evidence in record["evidence"]:
            pair = (evidence["entry_id"], evidence["evidence_id"])
            if pair not in evidence_pairs:
                errors.append(f"{record['id']}: unresolved decision evidence {pair}")
        expected_before_ids = set(record["inputs"])
        expected_after_ids = set(record["inputs"] + record["result"])
        if set(record["statement_hashes_before"]) != expected_before_ids:
            errors.append(f"{record['id']}: statement_hashes_before does not exactly cover inputs")
        if set(record["statement_hashes_after"]) != expected_after_ids:
            errors.append(f"{record['id']}: statement_hashes_after does not cover the complete transition")
        for stable_id, digest in record["statement_hashes_before"].items():
            previous = before_by_id.get(stable_id)
            if previous is None:
                errors.append(f"{record['id']}: before statement names absent snapshot entry {stable_id}")
                continue
            payload = json.dumps(previous["statement"], sort_keys=True, separators=(",", ":")).encode()
            if hashlib.sha256(payload).hexdigest() != digest:
                errors.append(f"{record['id']}: statement_hashes_before is stale for {stable_id}")
        for stable_id, digest in record["statement_hashes_after"].items():
            current = entry_by_id.get(stable_id)
            if current is None:
                errors.append(f"{record['id']}: statement hash names absent catalog entry {stable_id}")
                continue
            payload = json.dumps(current["statement"], sort_keys=True, separators=(",", ":")).encode()
            if hashlib.sha256(payload).hexdigest() != digest:
                errors.append(f"{record['id']}: statement_hashes_after is stale for {stable_id}")
        if snapshot is not None:
            decision_type = record["decision_type"]
            inputs = record["inputs"]
            results = record["result"]
            if decision_type == "MERGE":
                if len(inputs) < 2 or len(results) != 1:
                    errors.append(f"{record['id']}: MERGE requires multiple inputs and one result")
                else:
                    survivor = results[0]
                    for stable_id in set(inputs) - {survivor}:
                        current = entry_by_id.get(stable_id)
                        if (
                            current is None
                            or current["lifecycle"]["status"] != "REDUNDANT"
                            or survivor not in current["lifecycle"]["target_ids"]
                        ):
                            errors.append(f"{record['id']}: MERGE does not retain redundant tombstone {stable_id}")
            elif decision_type == "SPLIT":
                if len(inputs) != 1 or len(results) < 2:
                    errors.append(f"{record['id']}: SPLIT requires one input and multiple results")
                else:
                    current = entry_by_id.get(inputs[0])
                    if (
                        current is None
                        or current["lifecycle"]["status"] != "SUPERSEDED"
                        or set(current["lifecycle"]["target_ids"]) != set(results)
                    ):
                        errors.append(f"{record['id']}: SPLIT does not retain the superseded input tombstone")
            elif decision_type == "EXCLUSION":
                if any(
                    entry_by_id.get(stable_id, {}).get("lifecycle", {}).get("status")
                    != "OUT_OF_SCOPE"
                    for stable_id in inputs
                ):
                    errors.append(f"{record['id']}: EXCLUSION inputs are not retained OUT_OF_SCOPE")
            elif decision_type in {"AUTHORITY_CHANGE", "LAYER_CHANGE", "LIFECYCLE_CHANGE"}:
                if len(inputs) != 1 or inputs != results:
                    errors.append(f"{record['id']}: {decision_type} requires one unchanged stable ID")
                else:
                    previous = before_by_id.get(inputs[0])
                    current = entry_by_id.get(inputs[0])
                    field = {
                        "AUTHORITY_CHANGE": "authority",
                        "LAYER_CHANGE": "layers",
                        "LIFECYCLE_CHANGE": "lifecycle",
                    }[decision_type]
                    if previous is None or current is None or previous[field] == current[field]:
                        errors.append(f"{record['id']}: {decision_type} does not change {field}")
            elif decision_type == "OTHER" and all(
                before_by_id.get(stable_id) == entry_by_id.get(stable_id)
                for stable_id in set(inputs + results)
            ):
                errors.append(f"{record['id']}: OTHER decision records no catalog change")
    orphaned = set(records_by_id) - referenced
    if orphaned:
        errors.append(f"post-catalog decisions are not referenced by catalog entries: {sorted(orphaned)}")
    return errors, set(records_by_id)


def validate_identity_dispositions(
    catalog: dict[str, Any],
    identities: dict[str, dict[str, Any]],
    decision_ids: set[str],
) -> list[str]:
    errors: list[str] = []
    dispositions, new = unique_index(
        catalog["identity_dispositions"], "id", "identity disposition"
    )
    errors.extend(new)
    if catalog["status"] == "MILESTONE_7_INFRASTRUCTURE_ONLY":
        if dispositions:
            errors.append("Milestone 7 must not pre-adjudicate identity dispositions")
        return errors
    if catalog["status"] not in {
        "MILESTONE_8_CHARACTERIZATION_INVENTORY",
        "MILESTONE_9_PRE_REVIEW_FREEZE",
        "MILESTONE_9_REVIEWED_FREEZE",
    }:
        return errors
    if set(dispositions) != set(identities):
        errors.append(
            "Milestone 8 identity dispositions do not exactly cover the frozen discovery surface"
        )
    catalog_ids = {row["characterization"]["id"] for row in catalog["entries"]}
    expected_catalog_ids: set[str] = set()
    for stable_id, identity in identities.items():
        row = dispositions.get(stable_id)
        if row is None:
            continue
        if row["identity_statement_sha256"] != identity["statement_sha256"]:
            errors.append(f"{stable_id}: disposition identity hash is stale")
        if not set(identity["decision_ids"]) <= set(row["decision_ids"]):
            errors.append(f"{stable_id}: disposition omits its frozen identity decision")
        unknown = set(row["decision_ids"]) - decision_ids
        if unknown:
            errors.append(f"{stable_id}: disposition has unknown decisions {sorted(unknown)}")
        expected = {
            "ACTIVE_PROVISIONAL": "CATALOG_ENTRY",
            "DEFERRED_KIND": "DEFERRED_UNRESOLVED_KIND",
            "RESERVED_OUT_OF_SCOPE": "OUT_OF_SCOPE",
        }[identity["identity_status"]]
        if row["disposition"] != expected:
            errors.append(
                f"{stable_id}: disposition {row['disposition']} is incompatible with frozen identity status"
            )
        if expected == "CATALOG_ENTRY":
            expected_catalog_ids.add(stable_id)
    if catalog_ids != expected_catalog_ids:
        errors.append(
            "Milestone 8 catalog entries do not exactly match identities dispositioned as CATALOG_ENTRY"
        )
    return errors


def validate_artifacts(
    catalog: dict[str, Any],
    catalog_schema: dict[str, Any],
    entry_schema: dict[str, Any],
    authority: dict[str, Any],
    authority_schema: dict[str, Any],
    decisions: dict[str, Any],
    decisions_schema: dict[str, Any],
    target: dict[str, Any],
    model: dict[str, Any],
    identities_document: dict[str, Any],
    source_lock: dict[str, Any],
    evidence_lock: dict[str, Any],
    evidence_lock_schema: dict[str, Any],
    approved_authority_sources: dict[str, Any],
    approved_authority_sources_schema: dict[str, Any],
    prior_decisions: dict[str, Any],
    *,
    rendered_report: str | None = None,
    check_generated: bool = True,
    enforce_milestone_boundary: bool = True,
    allow_test_approved_sources: bool = False,
) -> list[str]:
    resolved_catalog_schema = copy.deepcopy(catalog_schema)
    resolved_catalog_schema["$defs"]["catalogEntry"]["properties"]["characterization"] = entry_schema
    errors = schema_errors(catalog, resolved_catalog_schema, "catalog")
    errors.extend(schema_errors(authority, authority_schema, "authority rules"))
    errors.extend(schema_errors(decisions, decisions_schema, "catalog decisions"))
    if errors:
        return errors

    bindings = catalog["artifact_bindings"]
    if set(bindings) != set(EXPECTED_BINDINGS) | {
        "evidence_lock",
        "approved_authority_sources",
        "approved_authority_sources_schema",
    }:
        errors.append("catalog binding names are not exact")
    else:
        errors.extend(
            binding_errors(
                {name: bindings[name] for name in EXPECTED_BINDINGS},
                EXPECTED_BINDINGS,
                "catalog",
            )
        )
        evidence_binding = bindings["evidence_lock"]
        if not safe_relative_path(evidence_binding["path"]) or not evidence_binding[
            "path"
        ].startswith("config/declaration-validation-evidence-locks/"):
            errors.append("catalog evidence-lock binding path is not canonical and safe")
        if evidence_binding["sha256"] != document_sha256(evidence_lock):
            errors.append("catalog evidence-lock binding hash disagrees with supplied successor lock")
        if check_generated:
            evidence_path = ROOT / evidence_binding["path"]
            if not evidence_path.is_file() or sha256_file(evidence_path) != evidence_binding["sha256"]:
                errors.append("catalog evidence-lock file binding is missing or stale")
        approved_binding = bindings["approved_authority_sources"]
        approved_path = ROOT / approved_binding["path"]
        if not safe_relative_path(approved_binding["path"]) or not safe_registry_path(approved_path):
            errors.append("catalog approved authority-source registry path is not canonical")
        expected_approved_hash = sha256_file(approved_path) if check_generated and approved_path.is_file() else document_sha256(approved_authority_sources)
        if approved_binding["sha256"] != expected_approved_hash:
            errors.append("catalog approved authority-source registry hash is stale")
        approved_schema_binding = bindings["approved_authority_sources_schema"]
        expected_schema_path = registry_schema_path(approved_path)
        if ROOT / approved_schema_binding["path"] != expected_schema_path:
            errors.append("catalog approved authority-source registry schema does not match its version")
        elif approved_schema_binding["sha256"] != sha256_file(expected_schema_path):
            errors.append("catalog approved authority-source registry schema hash is stale")
    errors.extend(binding_errors(authority["bindings"], EXPECTED_AUTHORITY_BINDINGS, "authority"))
    approved_path = ROOT / bindings["approved_authority_sources"]["path"]
    errors.extend(
        validate_approved_authority_source_registry(
            approved_authority_sources,
            approved_authority_sources_schema,
            approved_path,
            check_generated=check_generated,
            allow_test_registry=allow_test_approved_sources,
        )
    )
    approved_indices, approved_errors = approved_authority_source_indices(
        approved_authority_sources
    )
    errors.extend(approved_errors)
    if not allow_test_approved_sources and approved_path.resolve() == APPROVED_AUTHORITY_SOURCES_PATH.resolve() and document_sha256(approved_authority_sources) != FROZEN_APPROVED_AUTHORITY_SOURCES_DOCUMENT_SHA256:
        errors.append("catalog adjudication cannot extend the frozen pre-M8 approved authority-source registry")
    if catalog["status"] == "MILESTONE_7_INFRASTRUCTURE_ONLY" and approved_indices:
        errors.append("Milestone 7 approved authority-source registry must remain empty")
    if catalog["status"] != "MILESTONE_7_INFRASTRUCTURE_ONLY" and not allow_test_approved_sources:
        catalog_time = parse_recorded_at(catalog["recorded_at"], "catalog", errors)
        registry_time = parse_recorded_at(approved_authority_sources["recorded_at"], "authority-source registry", errors)
        if catalog_time and registry_time and registry_time >= catalog_time:
            errors.append("catalog adjudication must bind an authority-source registry recorded before the catalog")
    evidence_errors, evidence_locks = validate_evidence_lock_chain(
        evidence_lock,
        evidence_lock_schema,
        source_lock,
        check_git_tracking=check_generated,
    )
    errors.extend(evidence_errors)
    expected_evidence_status = {
        "MILESTONE_7_INFRASTRUCTURE_ONLY": "MILESTONE_7_EMPTY_EVIDENCE_LOCK",
        "MILESTONE_8_CHARACTERIZATION_INVENTORY": "MILESTONE_8_EVIDENCE_SELECTION",
        "MILESTONE_9_PRE_REVIEW_FREEZE": "MILESTONE_9_PRE_REVIEW_EVIDENCE_FREEZE",
        "MILESTONE_9_REVIEWED_FREEZE": "MILESTONE_9_REVIEWED_EVIDENCE_FREEZE",
    }[catalog["status"]]
    if evidence_lock["status"] != expected_evidence_status:
        errors.append("catalog status and evidence-lock successor status disagree")
    if catalog["id_evolution_rules"] != identities_document["id_evolution_rules"]:
        errors.append("catalog stable-ID evolution rules differ from the frozen identity registry")
    if catalog["identity_denotation_profile"] != IDENTITY_DENOTATION_PROFILE:
        errors.append("catalog semantic-denotation projection differs from the frozen M7 profile")
    if set(catalog["observer_order"]) != OBSERVER_POINTERS:
        errors.append("catalog observer order does not cover the exact pinned observer set")

    rule_errors, rules_by_id = validate_rule_set(authority)
    errors.extend(rule_errors)
    identities, new = unique_index(identities_document["identities"], "id", "stable identity")
    errors.extend(new)
    prior_ids = {row["id"] for row in prior_decisions["records"]}
    decision_errors, post_ids = validate_decisions(
        decisions, catalog, identities, resolved_catalog_schema
    )
    errors.extend(decision_errors)

    entry_rows = catalog["entries"]
    catalog_ids: set[str] = set()
    for row in entry_rows:
        entry_id = row["characterization"]["id"]
        if entry_id in catalog_ids:
            errors.append(f"duplicate catalog stable ID: {entry_id}")
        catalog_ids.add(entry_id)
    all_decision_ids = prior_ids | post_ids
    if enforce_milestone_boundary or catalog["status"] == "MILESTONE_7_INFRASTRUCTURE_ONLY":
        errors.extend(validate_identity_dispositions(catalog, identities, all_decision_ids))
    for row in entry_rows:
        errors.extend(
            validate_entry(
                row,
                catalog_ids=catalog_ids,
                identities=identities,
                decision_ids=all_decision_ids,
                authority_rules=rules_by_id,
                target=target,
                model=model,
                source_lock=source_lock,
                evidence_locks=evidence_locks,
                approved_authority_sources=approved_authority_sources,
            )
        )
        for decision_id in row["decision_ids"]:
            if not decision_id.startswith("DEC.CATALOG."):
                continue
            record = next(
                (item for item in decisions["records"] if item["id"] == decision_id),
                None,
            )
            entry_id = row["characterization"]["id"]
            if record is not None and entry_id not in set(record["inputs"] + record["result"]):
                errors.append(f"{entry_id}: post-catalog decision {decision_id} is unrelated")
    errors.extend(lifecycle_cycle_errors(entry_rows))
    if catalog["status"] == "MILESTONE_7_INFRASTRUCTURE_ONLY":
        if catalog["site_dispositions"]:
            errors.append("Milestone 7 infrastructure catalog must not disposition M4 implementation sites")
        if catalog["existing_evidence_dispositions"]:
            errors.append("Milestone 7 infrastructure catalog must not disposition M8 existing evidence")
    elif enforce_milestone_boundary:
        errors.extend(
            validate_existing_evidence_dispositions(
                catalog["existing_evidence_dispositions"],
                source_lock=source_lock,
                evidence_locks=evidence_locks,
                entries=entry_rows,
            )
        )
        errors.extend(
            validate_site_dispositions(
                catalog["site_dispositions"],
                stable_ids=catalog_ids,
                identities=identities,
                discovery_closure=load_json(CLOSURE_PATH),
                entries=entry_rows,
            )
        )

    if enforce_milestone_boundary and catalog["status"] == "MILESTONE_7_INFRASTRUCTURE_ONLY":
        boundary = catalog["completion_boundary"]
        if entry_rows or boundary["inventory_populated"] or boundary["authority_assignments_created"]:
            errors.append("Milestone 7 infrastructure catalog crossed into inventory adjudication")
        if boundary["next_milestone"] != "MILESTONE_8_BUILD_FIRST_CHARACTERIZATION_INVENTORY":
            errors.append("Milestone 7 catalog does not authorize exactly Milestone 8 next")
        if decisions["records"]:
            errors.append("Milestone 7 post-catalog decision log must remain empty")
        if evidence_lock["sequence"] != 1:
            errors.append("Milestone 7 must bind the sequence-1 empty evidence lock")

    if enforce_milestone_boundary and catalog["status"] in {
        "MILESTONE_8_CHARACTERIZATION_INVENTORY",
        "MILESTONE_9_PRE_REVIEW_FREEZE",
        "MILESTONE_9_REVIEWED_FREEZE",
    }:
        errors.extend(validate_reviewed_pilot_reuse(catalog))

    if enforce_milestone_boundary and catalog["status"] == "MILESTONE_8_CHARACTERIZATION_INVENTORY":
        boundary = catalog["completion_boundary"]
        if not boundary["inventory_populated"] or not boundary["authority_assignments_created"]:
            errors.append("Milestone 8 completion flags do not assert the completed inventory")
        if boundary["next_milestone"] != "MILESTONE_9_ADVERSARIAL_REVIEW":
            errors.append("Milestone 8 catalog does not authorize exactly Milestone 9 next")
        if evidence_lock["sequence"] < 2:
            errors.append("Milestone 8 must bind a successor of the immutable Milestone 7 evidence lock")

    if enforce_milestone_boundary and catalog["status"] in {
        "MILESTONE_9_PRE_REVIEW_FREEZE",
        "MILESTONE_9_REVIEWED_FREEZE",
    }:
        boundary = catalog["completion_boundary"]
        if not boundary["inventory_populated"] or not boundary["authority_assignments_created"]:
            errors.append("Milestone 9 status cannot discard the completed Milestone 8 inventory")
        if evidence_lock["sequence"] < 3:
            errors.append("Milestone 9 must bind a successor of the Milestone 8 evidence lock")
        expected_sequence = {
            "MILESTONE_9_PRE_REVIEW_FREEZE": 5,
            "MILESTONE_9_REVIEWED_FREEZE": 6,
        }[catalog["status"]]
        if evidence_lock["sequence"] != expected_sequence:
            errors.append(
                f"{catalog['status']} must bind exact evidence-lock sequence {expected_sequence}"
            )
        expected_next = {
            "MILESTONE_9_PRE_REVIEW_FREEZE": "MILESTONE_9_ADVERSARIAL_REVIEW",
            "MILESTONE_9_REVIEWED_FREEZE": "MILESTONE_10_DESIGN_FROZEN_INVENTORY_COVERAGE_STUDY",
        }[catalog["status"]]
        if boundary["next_milestone"] != expected_next:
            errors.append(
                f"{catalog['status']} does not authorize exactly {expected_next} next"
            )

    if check_generated:
        report_renderer = load_module("declaration_m7_report_renderer", REPORT_RENDERER_PATH)
        if rendered_report is None:
            rendered_report = report_renderer.render(catalog, source_lock, evidence_lock)
        if REPORT_PATH.read_text(encoding="utf-8") != rendered_report:
            errors.append("generated human report is not synchronized with the canonical catalog")
        catalog_hash = sha256_file(CATALOG_PATH)
        if f"Catalog SHA-256: `{catalog_hash}`" not in rendered_report:
            errors.append("generated human report does not include the canonical catalog hash")
    return errors


def validate_historical_m7_attestation() -> list[str]:
    """Validate M7 through its immutable Git-blob attestation, never live paths."""

    historical = load_module(
        "declaration_m7_historical_attestation_validator", HISTORICAL_VALIDATOR_PATH
    )
    return historical.validate_m7_attestation()


def validate_historical_m8_pilot() -> list[str]:
    """Require the reviewed pilot's Git-blob attestation alongside the M7 history."""

    historical = load_module(
        "declaration_m8_historical_pilot_attestation_validator", HISTORICAL_VALIDATOR_PATH
    )
    return historical.validate_reviewed_m8_pilot()


def validate_historical_m8_attestation() -> list[str]:
    """Require corrected M8 through its immutable two-phase Git-blob record."""

    historical = load_module(
        "declaration_m8_historical_attestation_validator", HISTORICAL_VALIDATOR_PATH
    )
    return historical.validate_m8_attestation()


def validate_bound_files(bindings: dict[str, Any], label: str) -> list[str]:
    errors: list[str] = []
    for name, binding in bindings.items():
        relative = binding["path"]
        if not safe_relative_path(relative):
            errors.append(f"{label} {name} path is not safe and relative")
            continue
        path = ROOT / relative
        if not path.is_file():
            errors.append(f"{label} {name} artifact is missing")
        elif sha256_file(path) != binding["sha256"]:
            errors.append(f"{label} {name} artifact hash is stale")
    return errors


def dependency_cycle_errors(edges: list[dict[str, str]]) -> list[str]:
    graph: dict[str, list[str]] = {}
    for edge in edges:
        graph.setdefault(edge["from"], []).append(edge["to"])
        graph.setdefault(edge["to"], [])
    visiting: set[str] = set()
    visited: set[str] = set()
    errors: list[str] = []

    def visit(node: str) -> None:
        if node in visiting:
            errors.append(f"Milestone 8 freeze dependency cycle contains {node}")
            return
        if node in visited:
            return
        visiting.add(node)
        for target in graph[node]:
            visit(target)
        visiting.remove(node)
        visited.add(node)

    for node in graph:
        visit(node)
    return errors


def validate_current_m8_completion(catalog: dict[str, Any]) -> list[str]:
    """Validate the derived M8 freeze and completion record without cycles."""

    errors: list[str] = []
    required = [
        M8_FREEZE_PATH,
        M8_FREEZE_SCHEMA_PATH,
        M8_FREEZE_RENDERER_PATH,
        M8_COMPLETION_PATH,
        M8_COMPLETION_SCHEMA_PATH,
        M8_COMPLETION_RENDERER_PATH,
    ]
    missing = [str(path.relative_to(ROOT)) for path in required if not path.is_file()]
    if missing:
        return [f"Milestone 8 completion artifact is missing: {relative}" for relative in missing]

    freeze = load_json(M8_FREEZE_PATH)
    completion = load_json(M8_COMPLETION_PATH)
    errors.extend(
        schema_errors(
            freeze,
            load_json(M8_FREEZE_SCHEMA_PATH),
            "Milestone 8 freeze manifest",
        )
    )
    errors.extend(
        schema_errors(
            completion,
            load_json(M8_COMPLETION_SCHEMA_PATH),
            "Milestone 8 completion record",
        )
    )
    if errors:
        return errors

    freeze_renderer = load_module("declaration_m8_freeze_renderer", M8_FREEZE_RENDERER_PATH)
    if M8_FREEZE_PATH.read_bytes() != document_bytes(freeze_renderer.render()):
        errors.append("Milestone 8 freeze manifest is not synchronized with its renderer")
    completion_renderer = load_module(
        "declaration_m8_completion_renderer", M8_COMPLETION_RENDERER_PATH
    )
    if M8_COMPLETION_PATH.read_bytes() != document_bytes(completion_renderer.render()):
        errors.append("Milestone 8 completion record is not synchronized with its renderer")

    errors.extend(validate_bound_files(freeze["predecessor_attestations"], "M8 predecessor"))
    errors.extend(validate_bound_files(freeze["artifacts"], "M8 freeze"))
    errors.extend(validate_bound_files(completion["artifacts"], "M8 completion"))
    errors.extend(dependency_cycle_errors(freeze["dependency_edges"]))

    if freeze["artifacts"]["catalog"]["sha256"] != sha256_file(CATALOG_PATH):
        errors.append("Milestone 8 freeze does not bind the current canonical catalog")
    if completion["artifacts"]["freeze_manifest"]["sha256"] != sha256_file(M8_FREEZE_PATH):
        errors.append("Milestone 8 completion does not bind the current freeze manifest")
    if freeze["inventory_summary"] != completion["inventory_summary"]:
        errors.append("Milestone 8 completion summary disagrees with the freeze manifest")
    summary = freeze["inventory_summary"]
    if (
        summary["existing_evidence_linked"]
        + summary["existing_evidence_explicit_negative"]
        != summary["existing_evidence_dispositions"]
    ):
        errors.append("Milestone 8 evidence-disposition summary does not partition the surface")
    if any(
        sum(outcomes.values()) != summary["catalog_entries"]
        for outcomes in summary["observer_outcomes_by_profile"].values()
    ):
        errors.append("Milestone 8 observer summary does not cover every entry/profile pair")
    if sum(summary["arena_dispositions"].values()) != summary["catalog_entries"]:
        errors.append("Milestone 8 Arena summary does not cover every active entry")
    if catalog["status"] != "MILESTONE_8_CHARACTERIZATION_INVENTORY":
        errors.append("Milestone 8 completion is bound to a non-M8 catalog status")
    return errors


def validate_all(*, require_completion: bool = True) -> tuple[list[str], dict[str, Any]]:
    catalog = load_json(CATALOG_PATH)
    evidence_binding = catalog["artifact_bindings"]["evidence_lock"]
    evidence_lock = load_json(ROOT / evidence_binding["path"])
    authority_registry_binding = catalog["artifact_bindings"]["approved_authority_sources"]
    authority_registry_path = ROOT / authority_registry_binding["path"]
    authority_registry = load_json(authority_registry_path)
    authority_registry_schema = load_json(registry_schema_path(authority_registry_path))
    source_validator = load_module("declaration_m6_source_validator", SOURCE_LOCK_VALIDATOR_PATH)
    source_errors, _ = source_validator.validate_all(require_completion=True, online=False)
    errors = [f"source-lock predecessor: {error}" for error in source_errors]
    errors.extend(
        validate_artifacts(
            catalog,
            load_json(CATALOG_SCHEMA_PATH),
            load_json(ENTRY_SCHEMA_PATH),
            load_json(AUTHORITY_PATH),
            load_json(AUTHORITY_SCHEMA_PATH),
            load_json(DECISIONS_PATH),
            load_json(DECISIONS_SCHEMA_PATH),
            load_json(TARGET_PATH),
            load_json(MODEL_PATH),
            load_json(IDENTITY_PATH),
            load_json(SOURCE_LOCK_PATH),
            evidence_lock,
            load_json(EVIDENCE_LOCK_SCHEMA_PATH),
            authority_registry,
            authority_registry_schema,
            load_json(PRIOR_DECISIONS_PATH),
        )
    )
    if require_completion:
        errors.extend(validate_historical_m7_attestation())
        errors.extend(validate_historical_m8_pilot())
        errors.extend(validate_historical_m8_attestation())
    entries = catalog["entries"]
    summary = {
        "catalog_sha256": sha256_file(CATALOG_PATH),
        "entries": len(entries),
        "normative_candidates": sum(
            row["characterization"]["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION" for row in entries
        ),
        "empirical_scenarios": sum(
            row["characterization"]["kind"] == "EMPIRICAL_CONTRACT_SCENARIO" for row in entries
        ),
        "authority_rules": len(load_json(AUTHORITY_PATH)["rules"]),
        "observer_profiles": len(catalog["observer_order"]),
        "post_catalog_decisions": len(load_json(DECISIONS_PATH)["records"]),
        "identity_dispositions": len(catalog["identity_dispositions"]),
        "existing_evidence_dispositions": len(
            catalog["existing_evidence_dispositions"]
        ),
        "evidence_lock_sequence": evidence_lock["sequence"],
        "approved_normative_sources": len(
            authority_registry["normative_documentation"]
        ),
        "approved_mechanized_sources": len(
            authority_registry["mechanized_results"]
        ),
    }
    return errors, summary


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--artifacts-only", action="store_true", help="skip the completion record while constructing the milestone")
    args = parser.parse_args()
    errors, summary = validate_all(require_completion=not args.artifacts_only)
    if errors:
        for error in errors:
            print(f"ERROR: {error}")
        print(json.dumps(summary, sort_keys=True))
        return 1
    print("declaration-validation canonical catalog: PASS")
    print(json.dumps(summary, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
