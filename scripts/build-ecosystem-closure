#!/usr/bin/env python3
"""Validate bounded successor evidence and generate current action/decision records."""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import sys
import subprocess
from pathlib import Path

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))
BASE='results/investigations/ecosystem-closure-2026-09-05'
PACKET=BASE+'/decision-packet.json'
REPORT='docs/research/ECOSYSTEM_CLOSURE_REPORT.md'
ACTIONS='results/action-recommendations/current.json'
_loader=importlib.machinery.SourceFileLoader('execute_ecosystem_cases',str(ROOT/'scripts/execute-ecosystem-cases'))
_spec=importlib.util.spec_from_loader(_loader.name,_loader)
_executor=importlib.util.module_from_spec(_spec)
_loader.exec_module(_executor)


def read(path): return json.loads((ROOT/path).read_text())
def bind(path):
    p=ROOT/path
    return {'path':path,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
def verify(row):
    actual=bind(row['path'])
    if actual['sha256']!=row['sha256']: raise ValueError('evidence changed: '+row['path'])
    if 'bytes' in row and (ROOT/row['path']).stat().st_size!=row['bytes']: raise ValueError('evidence size changed')
def no_action(ident,target,reason):
    return {'id':ident,'action':'NO_EXTERNAL_ACTION','target':target,'priority':'LOW','rationale':reason,
            'prerequisites':[],'external_action':False,'human_gate':{'required':False,'status':'NOT_REQUIRED'},'execution_status':'COMPLETED'}
def proposal(ident,action,target,reason,prerequisites):
    return {'id':ident,'action':action,'target':target,'priority':'MEDIUM','rationale':reason,'prerequisites':prerequisites,
            'external_action':True,'human_gate':{'required':True,'status':'REVIEW_REQUIRED'},'execution_status':'NOT_STARTED'}
def validate_observation(row):
    for key in ['binary','artifact','stdout','stderr']: verify(row[key])
    exit_code=row.get('exit_code')
    if exit_code is not None and (not isinstance(exit_code,int) or isinstance(exit_code,bool)):
        raise ValueError('observation exit code is invalid')
    stdout=(ROOT/row['stdout']['path']).read_bytes().decode(errors='replace')
    stderr=(ROOT/row['stderr']['path']).read_bytes().decode(errors='replace')
    derived=_executor.normalize(row['checker'],exit_code,stdout,stderr)
    if row.get('outcome')!=derived:
        raise ValueError('observation outcome does not match bound raw process evidence')
    if derived not in ['ACCEPT','REJECT']:
        raise ValueError('unattributed observation needs explicit unresolved successor')


def build():
    upstream=read(BASE+'/upstream/manifest.json')
    if upstream['status']!='COMPLETE' or len(upstream['repositories'])!=4: raise ValueError('upstream inventory incomplete')
    for repo in upstream['repositories']:
        if not repo['issues_closed']: raise ValueError('issue pagination incomplete')
        for row in repo['requests']: verify({**row,'path':BASE+'/upstream/'+row['path']})
    for name in ['details','policy']:
        for row in read(BASE+'/upstream/'+name+'/requests.json'): verify(row)
    for filename in ['imax-right-successor.yaml','proj-maybe-prop.yaml','proj-maybe-prop-past.yaml']:
        import base64
        raw=read(BASE+'/upstream/policy/'+filename+'.json')
        decoded=base64.b64decode(raw['content'])
        if (ROOT/BASE/'upstream/policy'/filename).read_bytes()!=decoded or b'outcome: either' not in decoded: raise ValueError('Arena policy binding changed')
    for pr in [176,171]:
        if not read(BASE+f'/upstream/details/arena-pr-{pr}.json')['merged']: raise ValueError('expected merge absent')
    proof=read(BASE+'/proof-parameter-current/result.json')
    if proof['budget']['launches']!=4 or proof['budget']['seconds']>120: raise ValueError('proof pair budget invalid')
    for row in proof['observations']: validate_observation(row)
    if [(r['checker'],r['outcome']) for r in proof['observations']]!=[('kiota','ACCEPT'),('kiota','ACCEPT'),('official','ACCEPT'),('official','REJECT')]: raise ValueError('proof pair changed; re-review action disposition')
    triage=read(BASE+'/triage/results.json')
    if triage['registry_promotions']!=0 or triage['external_actions']: raise ValueError('triage boundary changed')
    expected=['nanoda-gen-f19ffc8a2e9b','nanoda-gen-21ef4d1d32a1']
    if [r['mutant_id'] for r in triage['cases']]!=expected: raise ValueError('triage selection changed')
    for row in triage['cases']:
        verify(row['protocol']);verify(row['baseline_binary']);verify(row['mutant_binary']);verify(row['build']['log'])
        if row['build']['status']!='BUILT' or row['build']['seconds']>120: raise ValueError('triage build bound failed')
        observations=row['observations']
        if len(observations)!=2 or row['budget']['launches']!=6 or row['budget']['seconds']>120: raise ValueError('triage bounds failed')
        for pair in observations:
            for role in ['baseline','mutant']: validate_observation(pair[role])
        if [(p['baseline']['outcome'],p['mutant']['outcome']) for p in observations]!=[('ACCEPT','ACCEPT'),('REJECT','ACCEPT')]: raise ValueError('triage distinction changed')
        for key in ['official_control','official_candidate']: validate_observation(row[key])
        if (row['official_control']['outcome'],row['official_candidate']['outcome'])!=('ACCEPT','REJECT') or row['status']!='WITNESS_FOUND': raise ValueError('triage attribution changed')
    completed_times=[r['completed_at'] for r in upstream['repositories']]
    for name in ['kiota-build','triage','proof-pair']:
        manifest=read('config/authorized-runs/'+name+'.json')
        from lib.authorized_runs import canonical_hash
        state=read('results/authorized-runs/'+manifest['run_id']+'.json')
        completed_times.extend(a['completed_at'] for phase in state['phases'].values() for a in phase['attempts'])
        if state['manifest_sha256']!=canonical_hash(manifest) or state['status']!='COMPLETE' or state['attempt_count']!=1 or state['elapsed_seconds']>manifest['total_budget_seconds']: raise ValueError('authorized execution record invalid')
    materialization=read(BASE+'/materialization.json')
    if materialization['status']!='PASS' or not all(r['matches'] for r in materialization['declared_inputs']): raise ValueError('materialization demonstration failed')
    predecessor = subprocess.check_output(['git', 'show', '18bd47bf632ff9f4bdf99d6d1400646b4c0c931e:results/action-recommendations/current.json'], cwd=ROOT)
    if (ROOT/BASE/'predecessor-actions.json').read_bytes() != predecessor:
        raise ValueError('predecessor action record differs from bound Git content')
    previous=read(BASE+'/predecessor-actions.json')
    outputs={}
    drafts={
      'kiota-proof-parameter.md': """# Review constructor-result proof-parameter uniformity

Prepared locally; publication requires explicit approval for sankalpsthakur/kiota.

At Kiota main `2d2a9fa31cba31abdd49543c3bb667591207577e`, the default checker accepts both the unchanged control and the export swapping `(p q : P)` to `(q p)` in the constructor result. The original complete recursor is retained. The pinned official Lean observer accepts the control and rejects the candidate with `invalid return type for LALProofParameterSwap.mk`.

Exact artifacts: `corpus/generated/lal-ordinary-inductive-proof-parameter-{control,candidate}.ndjson`. Raw outputs, binary hashes, revision, build log and four-launch budget: `results/investigations/ecosystem-closure-2026-09-05/proof-parameter-current/result.json`. The completed run manifest is `config/authorized-runs/proof-pair.json`; its run ID must not be recycled. For an independently authorized reproduction, invoke the built Kiota binary on each named NDJSON file as its sole argument, with `KIOTA_*` variables unset. Exit 0 records acceptance; the paired raw evidence retains the exact official command inputs and rejection diagnostic.

The read-only issue inventory includes merged PR #8's broad hardening work; its description does not identify this exact proof-parameter swap. The disagreement persists after that merge. Proof irrelevance can make the swapped proofs definitionally equal. This is a request to clarify the intended inductive-formation contract and add a focused regression if that contract requires exact parameter order. It is not a demonstrated proof of False or an assertion that observer agreement is semantic authority.
""",
      'arena-proof-parameter.md': """# Consider a paired constructor-result proof-parameter fixture

Prepared locally; publication requires explicit approval for leanprover/lean-kernel-arena.

Propose the exact control/candidate pair in `corpus/generated/lal-ordinary-inductive-proof-parameter-{control,candidate}.ndjson`: swap the two proof parameters only in the constructor result, retaining the complete recursor. Current Kiota `2d2a9fa` accepts both; the pinned official observer accepts the control and rejects the candidate. Full binary/input/raw evidence is in the successor decision packet.

The current Arena `nested-nonuniform-param` test uses a Bool-valued constant in a nested occurrence, not two proof variables in an ordinary constructor result. Its `either` policy is relevant context, not authority for this different case. No exact duplicate was identified in the bounded issue/tree review. Before submission, package against the current Arena export toolchain and verify integration; agree the outcome with maintainers instead of silently assuming a universal reject contract. This proposal is deferred until that local integration and expected-semantics review is complete.
""",
      'arena-reducible-positivity.md': """# Consider a complete-recursor companion for reducible-hidden positivity

Prepared locally; publication requires explicit approval for leanprover/lean-kernel-arena.

The preserved prior investigation derives a complete-recursor variant of the existing `indNegReducible` fixture. The control field is `Unit -> I`; the candidate changes the shared domain to `LALConstType Unit I`, with `LALConstType A B := A`, across constructor and recursor metadata. The prior pinned four-observer evidence records candidate rejection and control acceptance; a controlled Nanoda positivity mutation accepts the candidate. Those are prior pinned results, not a fresh four-checker run.

Recommend a companion corpus test, not an implementation issue. Current Arena issue and path inventories did not identify this exact complete-recursor companion; this bounded search is not proof of corpus-wide novelty. Before submission, integrate and rerun using current Arena's toolchain (now beyond our frozen observer), inspect the current tutorial declaration and approve the expected-outcome contract. These unmet prerequisites make this a deferred proposal. Preserve the existing draft and full prior evidence through the predecessor action record.
"""}
    for name,body in drafts.items(): outputs[BASE+'/drafts/'+name]=body
    reasons=[
      'Arena PR #176 merged both imax corner cases with outcome either. Preserve the observed profile difference; withdraw the two old implementation-fault recommendations. Arena policy does not establish normative kernel semantics.',
      'Arena PRs #167/#171 explicitly explain and permit the conservative possibly-Prop projection profile with outcome either. Withdraw the two old over-rejection issue recommendations; do not relabel the raw observations or assurance disagreements.',
      'The existing proof-parameter disagreement still reproduces on current Kiota 2d2a9fa after PR #8. Recommend one contract-clarification issue with the exact pair; defer the Arena submission pending current integration and expected-outcome review.',
      'The complete-recursor positivity companion remains a useful corpus proposal supported by prior pinned evidence. Current-toolchain integration and expected-outcome review remain concrete prerequisites; no checker defect is alleged.'
    ]
    findings=[]
    for i,old in enumerate(previous['findings']):
        f={**old,'summary':reasons[i],'evidence':old['evidence']+[bind(BASE+'/upstream/manifest.json')]}
        if i==0:
            done=next(r for r in old['recommendations'] if r['id']=='imax-submit-arena-tests')
            done={**done,'external_reference':'https://github.com/leanprover/lean-kernel-arena/pull/176','rationale':'Previously authorized contribution is now merged; GET-only confirmation in this successor. No new external action executed.'}
            f.update(disposition='ACTION_TAKEN',recommendations=[no_action('imax-no-new-implementation-issues','Nanoda and Kiota',reasons[i]),done])
        elif i==1:
            f.update(disposition='NO_EXTERNAL_ACTION',recommendations=[no_action('projection-no-new-implementation-issues','Nanoda and Lean4Lean',reasons[i])])
        elif i==2:
            f['evidence'].append(bind(BASE+'/proof-parameter-current/result.json'))
            issue=proposal('proof-parameter-current-kiota-contract-issue','FILE_IMPLEMENTATION_ISSUE','https://github.com/sankalpsthakur/kiota',reasons[i],['Owner approval for this exact Kiota issue and attached pair.','Review draft '+BASE+'/drafts/kiota-proof-parameter.md; frame as contract clarification, not demonstrated unsoundness.'])
            arena=proposal('proof-parameter-arena-pair-successor','PROPOSE_CORPUS_TEST','https://github.com/leanprover/lean-kernel-arena',reasons[i],['Current Arena integration and expected-outcome review.','Owner approval for the exact Arena submission.','Draft: '+BASE+'/drafts/arena-proof-parameter.md'])
            arena['execution_status']='DEFERRED'
            f.update(disposition='ACTION_RECOMMENDED',recommendations=[issue,arena])
        else:
            arena=proposal('positivity-arena-companion-successor','PROPOSE_CORPUS_TEST','https://github.com/leanprover/lean-kernel-arena',reasons[i],['Current-toolchain integration and current tutorial-content duplicate comparison.','Expected-outcome review and owner approval for exact submission.','Draft: '+BASE+'/drafts/arena-reducible-positivity.md'])
            arena['execution_status']='DEFERRED'
            f.update(disposition='DEFERRED',recommendations=[arena,no_action('positivity-no-implementation-issue','All observed validators',reasons[i])])
        findings.append(f)
    steps=[
      'Human decision: review the single current Kiota proof-parameter contract-clarification draft. No issue or other external message may be submitted without approval for that target.',
      'Next bounded local frontier proposal: package the two Arena companion pairs against the current toolchain, compare current declaration content, and settle expected outcomes before requesting submission approval. No large new build was authorized in this completed run.',
      'Separate Ultra review recommended: what qualified contract, if any, makes proof-parameter exact order a cross-validator conformance obligation despite proof irrelevance? Review should also distinguish Arena either policy from normative authority. No new Ultra review completed in this run.',
      'Review the two new survivor witness candidates for controlled corpus admission and registry classification under the existing witness policy. Until admitted, preserve the canonical nine-survivor pending count and unchanged scores.',
      'Keep the held-out/prospective transfer study deferred while mature corpus integration and human action decisions remain outstanding. Use manifest-bound scripts for future authorized runs; preserve finite accounting and stop on exceptions.'
    ]
    excluded={PACKET,BASE+'/predecessor-actions.json'}
    inputs=[bind(str(p.relative_to(ROOT))) for p in sorted((ROOT/BASE).rglob('*')) if p.is_file() and str(p.relative_to(ROOT)) not in excluded and '/drafts/' not in str(p) and p.name!='closure-validation.json']
    inputs += [bind(BASE+'/predecessor-actions.json'),bind('scripts/build-ecosystem-closure'),bind('scripts/collect-upstream-review'),bind('config/ecosystem-survivor-triage.json'),bind('docs/research/ECOSYSTEM_CLOSURE_AND_AUTONOMY_PLAN.md')]
    inputs += [bind(str(p.relative_to(ROOT))) for directory in ['config/authorized-runs','results/authorized-runs'] for p in sorted((ROOT/directory).rglob('*')) if p.is_file() and p.suffix!='.lock']
    packet={'schema_version':1,'status':'BOUNDED_WORK_COMPLETE_WITH_EXPLICIT_DEFERRALS','external_actions':False,
            'predecessor_commit':'18bd47bf632ff9f4bdf99d6d1400646b4c0c931e','inputs':inputs,
            'upstream_revisions':[{k:r[k] for k in ['repository','branch','revision']} for r in upstream['repositories']],
            'findings':[{'id':f['id'],'disposition':f['disposition'],'reason':reasons[i]} for i,f in enumerate(findings)],
            'triage':[{'mutant_id':r['mutant_id'],'status':r['status'],'reason':r['reason'],'budget':r['budget'],'recommendation':r['recommendation']} for r in triage['cases']],
            'new_registry_promotions':0,'new_external_actions_executed':0,'prior_implementation_issue_recommendations_withdrawn':4,
            'waiting_update':'Nanoda #29 is closed with a maintainer explanation of retaining serialized numIndices; a future change is deferred pending Lean #14977. No contract adjudication or new external post is inferred.',
            'limits':['Pinned official observer is not current Lean; no latest-Lean claim.','Current-toolchain Arena integration is deferred within the no-large-toolchain-build bound.','Filesystem materialization assumes trusted local parent directories; manifest checks are not a sandbox against a malicious script.','General runner budgets govern phases; checker-count limits are enforced by this bound experiment driver.','Timing records measure local active/build execution, not model token savings or end-to-end economics.'],
            'next_steps':steps}
    outputs[PACKET]=json.dumps(packet,indent=2,sort_keys=True)+'\n'
    # Bind the generated packet by its future exact bytes; the packet does not depend on this successor output.
    packet_binding={'path':PACKET,'sha256':hashlib.sha256(outputs[PACKET].encode()).hexdigest()}
    for f in findings: f['evidence'].append(packet_binding)
    outputs[ACTIONS]=json.dumps({'schema_version':1,'generated_at':max(completed_times),'policy':'docs/INVESTIGATION_SOP.md','findings':findings},indent=2,sort_keys=True)+'\n'
    lines=['# Ecosystem closure and bounded autonomy', '', 'Generated by `scripts/build-ecosystem-closure --write`. Canonical input-bound decision packet: `'+PACKET+'`.', '', '**Result:** bounded work complete, with explicit corpus-integration and human-decision deferrals. No external action was executed.', '', '| Finding | Disposition | Reason |','|---|---|---|']
    lines += ['| '+r['id']+' | '+r['disposition']+' | '+r['reason']+' |' for r in packet['findings']]
    lines += ['', 'Both fixed survivors yielded a baseline/mutant distinction with accepted controls and independently recorded pinned official rejection of the candidates. Six checker launches per survivor; no registry promotion, score change, new mutant or broad campaign. Current Kiota still accepts the proof-parameter candidate: four additional launches. Three isolated offline builds succeeded within their bounds.', '', 'The runner requires exact inputs and finite budgets, persists attempts, refuses changed-input resumes, excludes concurrent supervisors, and terminates phase process groups. A fresh full-history clone materialized and validated the exact proof-pair inputs without checker reruns. This assumes a trusted local filesystem and reviewed bound scripts.', '', '## Next decisions', '']
    lines += [str(i+1)+'. '+step for i,step in enumerate(steps)]
    lines += ['', '## Limits', '']+['- '+x for x in packet['limits']]+['',packet['waiting_update'],'']
    outputs[REPORT]='\n'.join(lines)
    return outputs

if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--write',action='store_true')
    parser.add_argument('--check',action='store_true')
    args=parser.parse_args()
    outputs=build()
    if args.write:
        for path,body in outputs.items():
            p=ROOT/path;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(body)
    elif args.check:
        for path,body in outputs.items():
            if (ROOT/path).read_text()!=body: raise SystemExit('stale successor output: '+path)
    else: print(outputs[PACKET],end='')
    if args.write or args.check: print('PASS: bounded ecosystem evidence and successor outputs')
