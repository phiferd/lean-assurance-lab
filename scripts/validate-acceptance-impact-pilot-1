#!/usr/bin/env python3
"""Validate available ACCEPTANCE-IMPACT-PILOT-1 preparation and Stage-1 evidence."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import acceptance_impact_pilot as pilot  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--require-committed", action="store_true")
    args = parser.parse_args()
    try:
        result = pilot.validate_preparation(ROOT, require_commit=args.require_committed)
        print(json.dumps(result, sort_keys=True))
        return 0
    except (OSError, ValueError) as error:
        print("acceptance-impact validation failed: " + str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
