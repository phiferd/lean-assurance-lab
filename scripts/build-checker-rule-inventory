#!/usr/bin/env python3
"""Aggregate bounded checker contract matrices and rank uncovered rule families."""

from __future__ import annotations

import hashlib
import json
from collections import Counter
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
OUTPUT = ROOT / "results" / "investigations" / "checker-rule-inventory.json"
OUTPUT_MD = ROOT / "results" / "investigations" / "checker-rule-inventory.md"
MATRICES = (
    ("quotient_contract", ROOT / "results" / "investigations" / "nanoda-quotient-contract-matrix.json"),
    ("restored_nested_declarations", ROOT / "results" / "investigations" / "nanoda-restored-declaration-contract-matrix.json"),
    ("declaration_environment", ROOT / "results" / "investigations" / "nanoda-declaration-environment-contract-matrix.json"),
    ("core_declaration_typing", ROOT / "results" / "investigations" / "nanoda-core-declaration-contract-matrix.json"),
    ("universe_definitional_equality", ROOT / "results" / "investigations" / "nanoda-universe-definitional-equality-matrix.json"),
    ("projection_typing", ROOT / "results" / "investigations" / "nanoda-projection-typing-contract-matrix.json"),
    ("reduction_semantics", ROOT / "results" / "investigations" / "nanoda-reduction-semantics-matrix.json"),
    ("ordinary_inductive_well_formedness", ROOT / "results" / "investigations" / "nanoda-ordinary-inductive-contract-matrix.json"),
)
CHECKERS = ("nanoda_baseline", "official", "kiota", "lean4lean")


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> int:
    boundaries = []
    matrix_evidence = []
    for family, path in MATRICES:
        matrix = json.loads(path.read_text(encoding="utf-8"))
        if matrix.get("status") != "PASS":
            raise SystemExit(f"matrix is not passing: {path}")
        matrix_evidence.append({
            "family": family,
            "path": str(path.relative_to(ROOT)),
            "sha256": sha256_file(path),
            "boundary_count": len(matrix["cases"]),
        })
        for case in matrix["cases"]:
            boundaries.append({
                "family": family,
                "boundary": case["boundary"],
                "case_id": case["case_id"],
                "outcomes": case["candidate_outcomes"],
            })

    profiles = {}
    for checker in CHECKERS:
        counts = Counter(row["outcomes"][checker] for row in boundaries)
        profiles[checker] = {
            "accept": counts["ACCEPT"],
            "reject": counts["REJECT"],
            "total": len(boundaries),
        }

    pairwise = {}
    for i, left in enumerate(CHECKERS):
        for right in CHECKERS[i + 1:]:
            agree = sum(row["outcomes"][left] == row["outcomes"][right] for row in boundaries)
            pairwise[f"{left}__{right}"] = {
                "agree": agree,
                "disagree": len(boundaries) - agree,
                "total": len(boundaries),
            }

    checks = {
        "eight_source_matrices_are_present": len(matrix_evidence) == 8,
        "thirty_seven_boundaries_are_directly_executable": len(boundaries) == 37,
        "official_and_lean4lean_differ_on_two_boundaries": (
            pairwise["official__lean4lean"]["disagree"] == 2
        ),
        "nanoda_differs_from_official_on_eight_boundaries": (
            pairwise["nanoda_baseline__official"]["disagree"] == 8
        ),
        "kiota_differs_from_official_on_ten_boundaries": (
            pairwise["official__kiota"]["disagree"] == 10
        ),
    }
    report = {
        "schema_version": 1,
        "status": "PASS" if all(checks.values()) else "FAIL",
        "checks": checks,
        "matrix_evidence": matrix_evidence,
        "boundary_count": len(boundaries),
        "boundaries": boundaries,
        "checker_profiles": profiles,
        "pairwise_profiles": pairwise,
        "coverage_scope": {
            "covered_families": [family for family, _ in MATRICES],
            "classified_non_matrix_families": [
                "literal_extensions_and_parser_configuration",
            ],
            "unmodeled_surfaces": [
                "axiom policy and unsafe declaration handling",
            ],
        },
        "ranked_next_families": [
            {
                "rank": 1,
                "family": "axiom_policy_and_unsafe_declarations",
                "reason": (
                    "Ordinary inductive omission isolation is complete, and literal extension "
                    "assertion mutants are closed by public-entrypoint reachability proofs."
                ),
            },
        ],
        "scope": "Inventory of 37 exact boundaries only; pairwise agreement is descriptive and is not majority-vote semantics.",
    }
    OUTPUT.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    display_names = {
        "nanoda_baseline": "Nanoda baseline",
        "official": "Official Lean",
        "kiota": "Kiota",
        "lean4lean": "Lean4Lean",
    }
    lines = [
        "# Checker Rule Inventory",
        "",
        f"Eight bounded matrices now provide {len(boundaries)} exact, executable rule boundaries.",
        "",
        "| Checker | Accept | Reject | Total |",
        "| --- | ---: | ---: | ---: |",
    ]
    for checker in CHECKERS:
        profile = profiles[checker]
        lines.append(
            f"| {display_names[checker]} | {profile['accept']} | {profile['reject']} | {profile['total']} |"
        )
    lines.extend([
        "",
        "Official Lean and Lean4Lean differ only on the two possibly-Prop projection cases.",
        "Nanoda differs from official Lean on those two cases, four serialized quotient",
        "signatures, and two universe right-successor comparisons. Kiota differs from official",
        "Lean on seven declaration/prerequisite boundaries, two universe comparisons, and the",
        "proof-parameter constructor-result boundary.",
        "",
        "These counts are descriptive, not votes. Exact artifacts, controls, expected-outcome",
        "evidence, and checker outcomes remain linked in `checker-rule-inventory.json`.",
        "",
        "## Coverage Gaps",
        "",
        "- axiom policy and unsafe declarations.",
        "",
        "Literal extension and parser/configuration assertion mutants are classified at the",
        "public entrypoint without a separate cross-checker matrix.",
        "",
        "The next ranked family is axiom policy and unsafe declarations.",
        "",
    ])
    OUTPUT_MD.write_text("\n".join(lines), encoding="utf-8")
    print(json.dumps({"output": str(OUTPUT.relative_to(ROOT)), "status": report["status"], "checks": checks, "profiles": profiles}, indent=2, sort_keys=True))
    return 0 if report["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
