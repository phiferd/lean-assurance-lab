#!/usr/bin/env python3
"""Freeze, validate, or run the ACCEPTANCE-IMPACT-PILOT-1 Kiota build."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import acceptance_impact_pilot as pilot  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("freeze", "validate", "run"))
    args = parser.parse_args()
    try:
        if args.action == "freeze":
            result = pilot.freeze_build_manifest(ROOT)
        elif args.action == "validate":
            result = pilot.validate_build_manifest(ROOT, require_commit=True)
        else:
            result = pilot.build_target(ROOT)
        print(json.dumps(result, sort_keys=True))
        return 0
    except (OSError, ValueError) as error:
        print("acceptance-impact build refused: " + str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
