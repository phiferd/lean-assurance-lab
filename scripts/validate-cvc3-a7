#!/usr/bin/env python3
"""Audit the closed A7 baseline failure without Lean or checker launches."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.cvc3_a7_evidence import validate_closure, validate_run

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--require-full-payload', action='store_true')
parser.add_argument('--closure', action='store_true')
args = parser.parse_args()
validator = validate_closure if args.closure else validate_run
print(json.dumps(validator(ROOT, require_full_payload=args.require_full_payload), indent=2, sort_keys=True))
