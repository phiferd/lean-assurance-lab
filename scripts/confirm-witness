#!/usr/bin/env python3
"""Confirm a witness with an unmodified reference checker and positive control."""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
ARENA_ROOT = ROOT / "external" / "lean-kernel-arena"


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def run(binary: Path, artifact: Path) -> dict:
    started = time.time()
    proc = subprocess.run(
        [str(binary), str(artifact.resolve())],
        cwd=binary.parent,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return {
        "exit_code": proc.returncode,
        "normalized_outcome": "ACCEPT" if proc.returncode == 0 else "REJECT",
        "seconds": time.time() - started,
        "stdout": proc.stdout[-2000:],
        "stderr": proc.stderr[-2000:],
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("witness_id")
    parser.add_argument("--checker", default="official")
    parser.add_argument("--control", type=Path, required=True)
    args = parser.parse_args()

    metadata_path = ROOT / "results" / "witnesses" / args.witness_id / "metadata.json"
    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    witness = (ROOT / metadata["input"]).resolve()
    control = args.control.resolve()
    checker_yaml = ARENA_ROOT / "checkers" / f"{args.checker}.yaml"
    binary = ARENA_ROOT / "_build" / "checkers" / args.checker / "src" / ".lake" / "build" / "bin" / "kernel"
    if not binary.is_file():
        raise SystemExit(
            f"reference checker is not built: {binary}; run lka.py build-checker {args.checker}"
        )

    witness_result = run(binary, witness)
    control_result = run(binary, control)
    status = (
        "CONFIRMED_EXPECTED_REJECTION"
        if witness_result["normalized_outcome"] == "REJECT"
        and control_result["normalized_outcome"] == "ACCEPT"
        else "UNRESOLVED"
    )
    confirmation = {
        "schema_version": 1,
        "witness_id": args.witness_id,
        "status": status,
        "confirmed_at": datetime.now(timezone.utc).isoformat(),
        "reference_checker": {
            "name": args.checker,
            "definition_sha256": sha256_file(checker_yaml),
            "arena_revision": subprocess.run(
                ["git", "rev-parse", "HEAD"],
                cwd=ARENA_ROOT,
                check=True,
                text=True,
                stdout=subprocess.PIPE,
            ).stdout.strip(),
        },
        "witness": {
            "path": str(witness.relative_to(ROOT)),
            "sha256": sha256_file(witness),
            "result": witness_result,
        },
        "positive_control": {
            "path": str(control.relative_to(ROOT)),
            "sha256": sha256_file(control),
            "difference": "definition declares the universe parameter used by the constant",
            "result": control_result,
        },
        "mechanical_predicate": "reference(witness) == REJECT and reference(control) == ACCEPT",
    }
    output = metadata_path.parent / "confirmation.json"
    output.write_text(json.dumps(confirmation, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(confirmation, indent=2, sort_keys=True))
    return 0 if status == "CONFIRMED_EXPECTED_REJECTION" else 1


if __name__ == "__main__":
    raise SystemExit(main())
