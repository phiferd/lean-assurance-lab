#!/usr/bin/env python3
"""Select and order Arena tests that cover a registered mutant's source span."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
ARENA_ROOT = ROOT / "external" / "lean-kernel-arena"
MUTATIONS = ROOT / "mutations"
REGISTRY = ROOT / "results" / "mutants" / "registry.jsonl"


def read_jsonl(path: Path) -> list[dict]:
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def latest_registry_record(mutant_id: str) -> dict:
    merged = {}
    for row in read_jsonl(REGISTRY):
        if row.get("id") == mutant_id:
            merged.update(row)
    if not merged:
        raise SystemExit(f"mutant not registered: {mutant_id}")
    return merged


def span_lines(span: str) -> list[int]:
    lines = set()
    for part in span.split(","):
        part = part.strip()
        match = re.fullmatch(r"(\d+)(?:-(\d+))?", part)
        if not match:
            raise SystemExit(f"unsupported source span: {span!r}")
        start = int(match.group(1))
        end = int(match.group(2) or start)
        lines.update(range(start, end + 1))
    return sorted(lines)


def source_digest(checker_root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted((checker_root / "src").rglob("*.rs")):
        digest.update(str(path.relative_to(checker_root)).encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("mutant_id")
    parser.add_argument(
        "--coverage-dir", type=Path, default=ROOT / "results" / "coverage" / "nanoda"
    )
    parser.add_argument("--output", type=Path)
    parser.add_argument(
        "--allow-stale-coverage",
        action="store_true",
        help="schedule even when checker source differs from the coverage build",
    )
    args = parser.parse_args()

    registry = latest_registry_record(args.mutant_id)
    spec_path = MUTATIONS / f"{args.mutant_id}.json"
    spec = json.loads(spec_path.read_text(encoding="utf-8"))
    checker = spec["checker"]
    checker_root = ARENA_ROOT / "_build" / "checkers" / checker / "src"
    manifest = json.loads((args.coverage_dir / "manifest.json").read_text(encoding="utf-8"))
    current_digest = source_digest(checker_root)
    stale = current_digest != manifest["source_sha256"]
    if stale and not args.allow_stale_coverage:
        raise SystemExit(
            "coverage source digest does not match current checker source; "
            "recollect coverage or pass --allow-stale-coverage"
        )

    records = {row["test"]: row for row in read_jsonl(args.coverage_dir / "coverage.jsonl")}
    line_to_tests = json.loads(
        (args.coverage_dir / "line-to-tests.json").read_text(encoding="utf-8")
    )
    source_file = spec["source_file"]
    lines = span_lines(str(registry["source_span"]))
    locations = [f"{source_file}:{line}" for line in lines]
    selected = set()
    covered_locations = []
    for location in locations:
        names = line_to_tests.get(location, [])
        if names:
            covered_locations.append(location)
            selected.update(names)
    tests = sorted(
        selected,
        key=lambda name: (records[name]["wall_time"], name),
    )
    schedule = {
        "mutant_id": args.mutant_id,
        "checker": checker,
        "source_file": source_file,
        "source_span": registry["source_span"],
        "locations": locations,
        "covered_locations": covered_locations,
        "coverage_stale": stale,
        "coverage_test_count": manifest["test_count"],
        "selected_test_count": len(tests),
        "estimated_seconds": sum(records[name]["wall_time"] for name in tests),
        "tests": [
            {
                "test": name,
                "baseline_outcome": records[name]["outcome"],
                "coverage_wall_time": records[name]["wall_time"],
            }
            for name in tests
        ],
    }
    rendered = json.dumps(schedule, indent=2, sort_keys=True) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered, encoding="utf-8")
    else:
        print(rendered, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
