#!/usr/bin/env python3
"""Summarize mutation registry and comparison reports.

The report is intentionally conservative: only records explicitly classified as
MEANINGFUL_SEMANTIC enter the mutation-score denominator.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from artifact_graph import load_graph, require_current  # noqa: E402


EXCLUDED_CLASSIFICATIONS = {
    "EQUIVALENT", "UNREACHABLE", "PERFORMANCE_ONLY", "NON_SEMANTIC",
    "REFERENCE_ALIGNED",
}


def read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    records = []
    with path.open("r", encoding="utf-8") as handle:
        for line_no, line in enumerate(handle, 1):
            if not line.strip():
                continue
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError as exc:
                raise SystemExit(f"{path}:{line_no}: invalid JSON: {exc}") from exc
    return records


def latest_by_id(records: list[dict]) -> dict[str, dict]:
    latest: dict[str, dict] = {}
    for record in records:
        mutant_id = record.get("id")
        if mutant_id:
            merged = {**latest.get(mutant_id, {}), **record}
            latest[mutant_id] = merged
    return latest


def comparison_killed(
    results_root: Path, mutant_id: str, record: dict | None = None
) -> bool | None:
    if record and record.get("status") in {"KILLED", "SURVIVED"}:
        return record["status"] == "KILLED"
    paths = [
        results_root / "mutants" / mutant_id / "scheduled-comparison.json",
        results_root / "mutants" / mutant_id / "comparison.json",
    ]
    path = next((candidate for candidate in paths if candidate.exists()), None)
    if path is None:
        return None
    with path.open("r", encoding="utf-8") as handle:
        report = json.load(handle)
    if report.get("status") in {"KILLED", "SURVIVED"}:
        return report["status"] == "KILLED"
    return bool(report.get("killed"))


def stratified_metrics(
    mutants: dict[str, dict],
    results_root: Path,
    dimension: str,
    minimum_sample: int,
    operator_families: dict[str, str],
) -> dict[str, dict]:
    groups: dict[str, list[tuple[dict, bool | None]]] = {}
    for mutant_id, record in mutants.items():
        if (
            record.get("status") == "SUPERSEDED"
            or record.get("classification") in EXCLUDED_CLASSIFICATIONS
        ):
            continue
        if dimension == "operator_family":
            value = record.get(dimension) or operator_families.get(record.get("mutation_operator"))
        else:
            value = record.get(dimension)
        if not value:
            value = "unknown"
        groups.setdefault(value, []).append(
            (record, comparison_killed(results_root, mutant_id, record))
        )
    output = {}
    for value, entries in sorted(groups.items()):
        evaluated = [killed for _, killed in entries if killed is not None]
        killed = sum(result is True for result in evaluated)
        sample = len(evaluated)
        sufficient = sample >= minimum_sample
        output[value] = {
            "population": len(entries),
            "evaluated": sample,
            "killed": killed,
            "survived": sum(result is False for result in evaluated),
            "build_failed": sum(record.get("status") == "BUILD_FAILED" for record, _ in entries),
            "mutation_score": killed / sample if sufficient else None,
            "evidence": "MEASURED" if sufficient else "INSUFFICIENT_SAMPLE",
            "minimum_sample": minimum_sample,
        }
    return output


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--results-root", type=Path, default=Path("results"))
    parser.add_argument("--output", type=Path)
    parser.add_argument(
        "--allow-stale-artifacts",
        action="store_true",
        help="emit a diagnostic report without enforcing the artifact graph",
    )
    args = parser.parse_args()

    catalog = json.loads((ROOT / "mutation-model" / "catalog.json").read_text(encoding="utf-8"))
    minimum_sample = catalog["minimum_stratum_sample"]
    operator_families = {
        operator: family["id"]
        for family in catalog["operator_families"]
        for operator in family["operators"]
    }

    graph_path = ROOT / "results" / "artifacts" / "graph.json"
    if graph_path.exists() and not args.allow_stale_artifacts:
        graph = load_graph(graph_path)
        try:
            require_current(graph, ROOT, ["report:mutation-summary"], dependencies_only=True)
        except RuntimeError as error:
            raise SystemExit(str(error)) from error

    registry = read_jsonl(args.results_root / "mutants" / "registry.jsonl")
    mutants = latest_by_id(registry)
    manual_catalog = {row["id"]: row for row in catalog["manual_mutants"]}
    for mutant_id, metadata in manual_catalog.items():
        if mutant_id in mutants:
            mutants[mutant_id].update(
                mutation_operator=metadata["operator"],
                operator_family=metadata["family"],
                subsystem=metadata["subsystem"],
            )

    generated = len(mutants)
    killed = 0
    surviving = 0
    meaningful_tested = 0
    meaningful_killed = 0
    classified_equivalent = 0
    classified_unreachable = 0
    classified_performance_only = 0
    classified_non_semantic = 0
    classified_reference_aligned = 0
    meaningful_survivors = 0
    modeled_tested = 0
    modeled_killed = 0
    survived_without_witness = 0
    unknown_equivalence = 0
    build_failed = 0
    superseded = 0
    unevaluated = 0

    for mutant_id, record in mutants.items():
        classification = record.get("classification", "UNKNOWN_EQUIVALENCE")
        status = record.get("status")
        killed_state = comparison_killed(args.results_root, mutant_id, record)
        if killed_state is True:
            killed += 1
        elif killed_state is False:
            surviving += 1
        elif status == "BUILD_FAILED":
            build_failed += 1
        elif status == "SUPERSEDED":
            superseded += 1
        else:
            unevaluated += 1

        if classification == "EQUIVALENT":
            classified_equivalent += 1
        elif classification == "UNREACHABLE":
            classified_unreachable += 1
        elif classification == "PERFORMANCE_ONLY":
            classified_performance_only += 1
        elif classification == "NON_SEMANTIC":
            classified_non_semantic += 1
        elif classification == "REFERENCE_ALIGNED":
            classified_reference_aligned += 1
        elif classification == "MEANINGFUL_SEMANTIC":
            meaningful_tested += killed_state is not None
            meaningful_killed += killed_state is True
            meaningful_survivors += killed_state is False
        elif classification == "SURVIVED_WITHOUT_WITNESS":
            survived_without_witness += 1
        else:
            unknown_equivalence += 1

        if (
            killed_state is not None
            and status != "SUPERSEDED"
            and classification not in EXCLUDED_CLASSIFICATIONS
        ):
            modeled_tested += 1
            modeled_killed += killed_state is True

    score = None
    if meaningful_tested:
        score = meaningful_killed / meaningful_tested

    witness_found_ids: set[str] = set()
    confirmed_generated_kill_ids: set[str] = set()
    witness_searches_without_result = 0
    ambiguous_witness_semantics = 0
    witness_checker_disagreements = 0
    confirmed_witness_semantics = 0
    minimized_witness_ids: set[str] = set()
    if (args.results_root / "witnesses").exists():
        for path in (args.results_root / "witnesses").glob("*/metadata.json"):
            try:
                metadata = json.loads(path.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                continue
            mutant_id = metadata.get("mutant_id")
            if mutant_id and metadata.get("search_status") == "WITNESS_FOUND":
                witness_found_ids.add(mutant_id)
            if mutant_id and metadata.get("semantic_status") == "CONFIRMED_EXPECTED_OUTCOME":
                confirmed_generated_kill_ids.add(mutant_id)
            witness_searches_without_result += metadata.get("search_status") == "NO_WITNESS_FOUND"
            ambiguous_witness_semantics += metadata.get("semantic_status") == "AMBIGUOUS_SEMANTICS"
            witness_checker_disagreements += metadata.get("semantic_status") == "CHECKER_DISAGREEMENT"
            confirmed_witness_semantics += metadata.get("semantic_status") == "CONFIRMED_EXPECTED_OUTCOME"
            if metadata.get("minimization_status") == "MINIMIZED":
                minimized_witness_ids.add(metadata.get("witness_id") or path.parent.name)
    witnesses_found = len(witness_found_ids)
    generated_witness_kills = sum(
        mutant_id in mutants
        and mutants[mutant_id].get("classification") == "MEANINGFUL_SEMANTIC"
        and comparison_killed(args.results_root, mutant_id, mutants[mutant_id]) is False
        for mutant_id in confirmed_generated_kill_ids
    )
    arena_candidates = 0
    if (args.results_root / "witnesses").exists():
        for path in (args.results_root / "witnesses").glob("*/metadata.json"):
            try:
                metadata = json.loads(path.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                continue
            arena_candidates += metadata.get("status") in {
                "ARENA_CANDIDATE",
                "CONFIRMED_REGRESSION_CANDIDATE",
            }

    cross_validation_counts: dict[str, int] = {}
    cross_validator_ids = set()
    regression_candidates_with_disagreement = 0
    cross_validation_root = args.results_root / "cross-validation"
    if cross_validation_root.exists():
        for path in cross_validation_root.glob("*/results.json"):
            try:
                result = json.loads(path.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                continue
            classification = result.get("classification", "UNRESOLVED")
            cross_validation_counts[classification] = cross_validation_counts.get(classification, 0) + 1
            cross_validator_ids.update(row.get("checker") for row in result.get("validators", []))
            regression_candidates_with_disagreement += bool(
                result.get("regression_candidate") and classification == "CHECKER_DISAGREEMENT"
            )
    expected_outcomes_established = 0
    expected_root = args.results_root / "expected-outcomes"
    if expected_root.exists():
        for path in expected_root.glob("*.json"):
            try:
                expected_outcomes_established += json.loads(path.read_text(encoding="utf-8")).get("status") == "ESTABLISHED"
            except json.JSONDecodeError:
                continue
    transfer_classifications: dict[str, int] = {}
    transfer_root = args.results_root / "transfer"
    if transfer_root.exists():
        for path in transfer_root.glob("*/evaluation.json"):
            try:
                transfer = json.loads(path.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                continue
            classification = transfer.get("classification", "UNRESOLVED")
            transfer_classifications[classification] = transfer_classifications.get(classification, 0) + 1
    rotating_report = None
    rotating_path = args.results_root / "rotating-heldout" / "milestone-7" / "report.json"
    if rotating_path.exists():
        try:
            rotating_report = json.loads(rotating_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            rotating_report = None

    report = {
        "mutation_score": score,
        "mutation_score_scope": "explicit MEANINGFUL_SEMANTIC classifications only",
        "modeled_mutation_score": modeled_killed / modeled_tested if modeled_tested else None,
        "modeled_mutation_score_denominator": modeled_tested,
        "generated_mutants": generated,
        "killed_mutants": killed,
        "surviving_mutants": surviving,
        "evaluated_mutants": killed + surviving,
        "build_failed_mutants": build_failed,
        "superseded_mutants": superseded,
        "unevaluated_mutants": unevaluated,
        "classified_equivalent": classified_equivalent,
        "classified_unreachable": classified_unreachable,
        "classified_performance_only": classified_performance_only,
        "classified_non_semantic": classified_non_semantic,
        "classified_reference_aligned": classified_reference_aligned,
        "meaningful_survivors": meaningful_survivors,
        "survived_without_witness": survived_without_witness,
        "unknown_equivalence": unknown_equivalence,
        "witnesses_found": witnesses_found,
        "generated_witness_kills": generated_witness_kills,
        "witness_searches_without_result": witness_searches_without_result,
        "ambiguous_witness_semantics": ambiguous_witness_semantics,
        "witness_checker_disagreements": witness_checker_disagreements,
        "confirmed_witness_semantics": confirmed_witness_semantics,
        "minimized_witnesses": len(minimized_witness_ids),
        "arena_regression_candidates": arena_candidates,
        "cross_validators": len(cross_validator_ids),
        "cross_validation_cases": sum(cross_validation_counts.values()),
        "cross_validation_classifications": cross_validation_counts,
        "expected_outcomes_established": expected_outcomes_established,
        "regression_candidates_with_unresolved_disagreement": regression_candidates_with_disagreement,
        "transfer_experiments": sum(transfer_classifications.values()),
        "transfer_classifications": transfer_classifications,
        "rotating_held_out": {
            "classification": rotating_report.get("classification"),
            "fold_count": rotating_report.get("fold_count"),
            "aggregate_score": rotating_report.get("aggregate_score"),
            "classification_counts": rotating_report.get("classification_counts"),
            "costs": rotating_report.get("costs"),
        } if rotating_report else None,
        "stratified_metrics": {
            "minimum_sample": minimum_sample,
            "by_subsystem": stratified_metrics(
                mutants, args.results_root, "subsystem", minimum_sample, operator_families
            ),
            "by_operator": stratified_metrics(
                mutants, args.results_root, "mutation_operator", minimum_sample, operator_families
            ),
            "by_operator_family": stratified_metrics(
                mutants, args.results_root, "operator_family", minimum_sample, operator_families
            ),
        },
    }

    text = json.dumps(report, indent=2, sort_keys=True) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(text, encoding="utf-8")
    else:
        print(text, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
