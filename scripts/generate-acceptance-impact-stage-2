#!/usr/bin/env python3
"""Generate the frozen ACCEPTANCE-IMPACT-PILOT-1 Stage-2 artifact pair once."""
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import acceptance_impact_stage2_producer as producer  # noqa: E402


def main() -> int:
    if len(sys.argv) != 1:
        print("acceptance-impact Stage 2 producer refused: no arguments are accepted",
              file=sys.stderr)
        return 2
    try:
        result = producer.produce(ROOT)
    except (OSError, ValueError) as error:
        print("acceptance-impact Stage 2 producer refused: " + str(error), file=sys.stderr)
        return 2
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
