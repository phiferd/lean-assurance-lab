#!/usr/bin/env python3
"""Evaluate focused reduction candidates and controls against Nanoda mutants."""

from __future__ import annotations

import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from nanoda_differential import DifferentialSession, sha256_file  # noqa: E402


CASES = (
    (
        "quot-lift-dispatch",
        "nanoda-gen-96ca69e29c37",
        "quot-lift",
        "KILLED_BY_CANDIDATE",
    ),
    (
        "quot-ind-proof-irrelevance",
        "nanoda-gen-cb4949d04bbf",
        "quot-ind",
        "OBSERVATIONALLY_EQUIVALENT",
    ),
    (
        "nat-ble-dispatch-boundary",
        "nanoda-gen-4ee88282735f",
        "nat-ble",
        "OBSERVED_WITHOUT_ASSUMED_KILL",
    ),
    (
        "nat-land-collateral-dispatch",
        "nanoda-gen-4ee88282735f",
        "nat-land",
        "KILLED_BY_CANDIDATE",
    ),
)


def artifact(family: str, role: str) -> Path:
    return ROOT / "corpus" / "generated" / f"lal-reduction-semantics-{family}-{role}.ndjson"


def main() -> int:
    sessions: dict[str, DifferentialSession] = {}
    rows = []
    try:
        for case_id, mutant_id, family, expected_classification in CASES:
            session = sessions.get(mutant_id)
            if session is None:
                session = DifferentialSession(mutant_id, timeout=300.0)
                session.prepare()
                sessions[mutant_id] = session
            candidate_path = artifact(family, "candidate")
            control_path = artifact(family, "control")
            candidate = session.evaluate(candidate_path)
            control = session.evaluate(control_path)
            if candidate["baseline"]["normalized_outcome"] != "ACCEPT":
                raise RuntimeError(f"baseline rejected candidate for {case_id}")
            if control["baseline"]["normalized_outcome"] != "ACCEPT":
                raise RuntimeError(f"baseline rejected control for {case_id}")
            if control["mutant"]["normalized_outcome"] != "ACCEPT":
                raise RuntimeError(f"mutant rejected control for {case_id}")
            classification = (
                "KILLED_BY_CANDIDATE" if candidate["different"]
                else "OBSERVATIONALLY_EQUIVALENT" if family == "quot-ind"
                else "SURVIVED_EXACT_CANDIDATE"
            )
            if expected_classification == "KILLED_BY_CANDIDATE" and classification != expected_classification:
                raise RuntimeError(f"expected mutation kill for {case_id}, got {classification}")
            rows.append({
                "case_id": case_id,
                "family": family,
                "mutant_id": mutant_id,
                "classification": classification,
                "candidate": {"path": str(candidate_path.relative_to(ROOT)), **candidate},
                "control": {"path": str(control_path.relative_to(ROOT)), **control},
            })
    finally:
        for session in sessions.values():
            session.close()

    report = {
        "schema_version": 1,
        "status": "PASS",
        "cases": rows,
        "mutations": {
            mutant_id: {
                "spec": f"mutations/{mutant_id}.json",
                "spec_sha256": sha256_file(ROOT / "mutations" / f"{mutant_id}.json"),
                "preparation": sessions[mutant_id].preparation,
            }
            for mutant_id in sessions
        },
    }
    output = ROOT / "results" / "investigations" / "nanoda-reduction-semantics" / "mutation-sensitivity.json"
    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps({
        "cases": [{"case_id": row["case_id"], "classification": row["classification"]} for row in rows],
        "output": str(output.relative_to(ROOT)),
        "status": report["status"],
    }, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
