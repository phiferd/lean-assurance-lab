#!/usr/bin/env python3
"""Validate the community contribution catalog or one contribution manifest."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from contribution_validation import load, validate_catalog, validate_manifest  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("manifest", nargs="?", type=Path)
    parser.add_argument("--check-catalog", action="store_true")
    args = parser.parse_args()
    catalog = load(ROOT / "config" / "contribution-types.json")
    catalog_schema = load(ROOT / "schemas" / "contribution-types.schema.json")
    errors = validate_catalog(catalog, catalog_schema)
    if args.manifest:
        manifest = load(args.manifest)
        manifest_schema = load(ROOT / "schemas" / "contribution-manifest.schema.json")
        errors.extend(validate_manifest(ROOT, manifest, manifest_schema, catalog))
    elif not args.check_catalog:
        parser.error("provide a manifest or --check-catalog")
    result = {
        "status": "PASS" if not errors else "FAIL",
        "catalog": "config/contribution-types.json",
        "manifest": str(args.manifest) if args.manifest else None,
        "errors": sorted(errors),
    }
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if not errors else 1


if __name__ == "__main__":
    raise SystemExit(main())
