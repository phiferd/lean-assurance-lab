#!/usr/bin/env python3
"""Build a scoped constitutional/operational review from current local records.

No upstream status lookup, checker launch or research authorization occurs.
Proposed next steps are planning judgments, not assurance or normative facts.
"""
import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.research_queue_v3 import handoff_status, load_queue
OUTPUT = 'results/research/project-review.json'
REPORT = 'docs/PROJECT_REVIEW.md'
HISTORY = 'results/research/declaration-validation-publication-study-historical.json'
DECISION = 'results/research/declaration-validation-publication-study-closure.json'
RUN = 'results/research/publication-study-theorem-control-0001'
ACTION_PATHS = ['results/action-recommendations/current.json', RUN + '/action-recommendations.json']
SUCCESSOR_PLAN = 'docs/research/CORPUS_INTEGRATION_AND_WITNESS_ADMISSION_PLAN.md'
SUCCESSOR_PACKET = 'results/investigations/corpus-integration-2026-09-05/decision-packet.json'
PORTFOLIO = 'results/research/contribution-portfolio-review-2026-09-09/'
SOURCES = ['CONSTITUTION.md', 'README.md', 'CONTRIBUTING.md', 'docs/INVESTIGATION_SOP.md',
           'docs/RESEARCH_STATUS.md', 'results/assurance/current.json',
           HISTORY, 'results/research/declaration-validation-publication-study-content-manifest.json',
           DECISION, RUN + '/result.json', *ACTION_PATHS,
           SUCCESSOR_PLAN, 'scripts/run-campaign', 'lib/authorized_runs.py',
           'schemas/authorized-run.schema.json', 'scripts/materialize-run-inputs',
           'scripts/run-autonomous-campaigns',
           'scripts/github-cli-preflight',
           'scripts/refresh-current-state', 'scripts/run-unit-tests',
           'scripts/validate-publication-study-snapshot', 'scripts/publication_study_snapshot.py',
           'scripts/build-project-review']
SOURCES += ['config/research-queue.json', 'docs/RESEARCH_WORKFLOW.md',
            'lib/research_queue.py', 'scripts/validate-research-queue',
            'tests/test_research_queue.py', 'lib/research_queue_v2.py',
            'tests/test_research_queue_v2.py', 'lib/research_queue_v3.py',
            'tests/test_research_queue_v3.py']
SOURCES += ['docs/PROJECT_PLAN.md', 'docs/UPSTREAM_ISSUES.md',
            PORTFOLIO + 'arena-review.json', PORTFOLIO + 'upstream-pr32.json',
            PORTFOLIO + 'zero-thread-recommendation-successor.json',
            PORTFOLIO + 'historical-transition-repair.json',
            'lib/portfolio_historical_snapshot.py',
            'scripts/validate-contribution-portfolio-transition',
            'tests/test_portfolio_historical_snapshot.py',
            'tests/test_project_review_contribution_observations.py']


def load(path):
    return json.loads((ROOT / path).read_bytes())


def bound(path):
    data = (ROOT / path).read_bytes()
    return {'path': path, 'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data)}


def contribution_observations(arena, nanoda):
    """Dated metadata only; no inference of acceptance from a submitted PR."""
    rows = []
    for pr in arena['upstream_observations']['pull_requests']:
        rows.append({'url': pr['url'], 'state': pr['state'],
                     'merged': pr['merged'], 'merged_at': pr['merged_at'],
                     'head_sha': pr['head_sha'], 'observed_at': arena['reviewed_on']})
    pr = nanoda['observation']
    rows.append({'url': pr['url'], 'state': pr['state'], 'merged': pr['merged'],
                 'merged_at': pr['merged_at'], 'head_sha': pr['head_sha'],
                 'observed_at': nanoda['retrieved_at']})
    return rows


def build():
    queue = load_queue(ROOT)
    historical = load(HISTORY)  # Gate 12 must exist before this final review.
    frozen = {row['path']: row for row in historical['artifacts']}
    for path in [DECISION, RUN + '/result.json', RUN + '/action-recommendations.json']:
        current = bound(path)
        if any(current[key] != frozen[path][key] for key in ['sha256', 'bytes']):
            raise ValueError('frozen study input changed; use an explicit successor: ' + path)
    snapshot, decision, result = load('results/assurance/current.json'), load(DECISION), load(RUN + '/result.json')
    recommendations = []
    for path in ACTION_PATHS:
        for finding in load(path)['findings']:
            for rec in finding['recommendations']:
                recommendations.append({'finding_id': finding['id'], 'source': path, **rec})
    pending = [r for r in recommendations if r['external_action'] and r['human_gate']['status'] == 'REVIEW_REQUIRED' and r['execution_status'] != 'COMPLETED']
    packet = load(SUCCESSOR_PACKET) if (ROOT / SUCCESSOR_PACKET).exists() else None
    if packet is not None:
        required_packet = {'status', 'findings', 'triage', 'external_actions', 'next_steps'}
        if not isinstance(packet, dict) or not required_packet.issubset(packet):
            raise ValueError('successor decision packet lacks required summary fields')
    metrics = {
        'study_gates_complete': 12,
        'study_content_commit': historical['historical_commit'],
        'study_outcome': decision['outcome_class'], 'study_tier': decision['claim_tier'],
        'study_publication_decision': decision['publication_decision'],
        'study_existing_isolated': result['counts']['existing_isolated_covered'],
        'study_final_isolated': result['counts']['final_isolated_covered'],
        'study_denominator': result['counts']['primary_denominator'],
        'assurance_gate': snapshot['gate']['status'],
        'semantic_disagreement_artifacts': snapshot['cross_validator_disagreements']['semantic_unresolved_count'],
        'parse_disagreement_artifacts': snapshot['cross_validator_disagreements']['parse_behavior_count'],
        'pending_survivor_triage': snapshot['mutation_testing']['pending_survivor_triage']['count'],
        'modeled_semantic_mutants': snapshot['mutation_testing']['total_semantic_mutants'],
        'modeled_mutation_score': snapshot['mutation_testing']['modeled_mutation_score'],
        'schema_backed_findings_in_selected_registers': sum(len(load(p)['findings']) for p in ACTION_PATHS),
        'external_actions_pending_review': len(pending),
        'current_external_actions_pending_review': sum(r['source'] == ACTION_PATHS[0] for r in pending),
        'historical_study_external_actions_pending_review': sum(r['source'] == ACTION_PATHS[1] for r in pending),
        'authorized_runner': 'manifest-required finite phase and total budgets, input bindings, immutable attempt logs and resume checks',
        'input_materialization': 'exact-hash local donor materialization on the declared platform',
        'successor_packet_status': packet['status'] if packet is not None else 'NOT_YET_RECORDED',
    }
    next_steps = []
    for item in sorted(queue['items'], key=lambda row: row['priority']):
        if item['status'] == 'COMPLETE':
            continue
        budget = item['budget']
        next_steps.append({
            'priority': item['priority'], 'id': item['id'], 'title': item['title'],
            'status': item['status'], 'target': item['target'], 'action': item['action'],
            'completion': item['completion'], 'stop_condition': item['stop_condition'],
            'rank_rationale': item['rank_rationale'], 'entry_gate': item['entry_gate'],
            'mechanism': f"At most {budget['max_sessions']} sessions of {budget['session_minutes']} active minutes; {budget['checker_launches']} validator launches. Additional plan limits apply.",
            'authorization': item['status'] + ': ' + item['entry_gate'],
        })
    selected = next(row for row in queue['items'] if row['id'] == queue['selected_item'])
    paused = handoff_status(queue) == 'PAUSED'
    queue_sources = [queue['plan'], *[str(p.relative_to(ROOT)) for p in sorted((ROOT / 'results/research/queue-reviews').glob('*.json'))]]
    if queue['schema_version'] == 3:
        queue_sources.append(queue['strategic_review']['path'])
    for item in queue['items']:
        queue_sources.extend(item['evidence_refs'])
        if item['closure']:
            queue_sources.extend(item['closure']['evidence_refs'])
    if paused:
        queue_sources.extend(queue['handoff']['evidence_refs'])
    return {'schema_version': 1, 'review_scope': 'Current local canonical records and the dated 2026-09-09 contribution-portfolio successor; historical submission records remain intact. No completeness claim for all historical actions or live upstream status.',
            'inputs': [bound(p) for p in dict.fromkeys([*SOURCES, *queue_sources, *([SUCCESSOR_PACKET] if packet is not None else [])])], 'metrics': metrics,
            'dated_contribution_observations': contribution_observations(load(PORTFOLIO + 'arena-review.json'), load(PORTFOLIO + 'upstream-pr32.json')),
            'constitutional_assessment': 'Aligned in reproducibility, scoped claims and preserved uncertainty. The current authorized frontier is ' + queue['frontier_id'] + ', governed by ' + queue['plan'] + '. The ranked queue compares shared assurance value, information gain, feasibility and urgency at item stopping points. Planning records establish no new semantic result. Historical study claims and pending upstream follow-through remain separately recorded.',
            'work_queue': queue,
            'constitutional_alignment': [
                {'goal': 'Measured ecosystem trust', 'assessment': 'Aligned, with limited generalization',
                 'evidence': 'The current snapshot separates scoped mutation results, cross-validator observations and unresolved triage; the completed pilot does not establish general method strength.',
                 'next_improvement': 'Prefer additional shared regression value and independent transfer over a larger coverage percentage.'},
                {'goal': 'Durable reproducibility', 'assessment': 'Historical evidence remains bound; successor runner is manifest-governed',
                 'evidence': 'The authorized-run manifest binds inputs, platform, finite budgets and completion condition; materialization verifies exact local donor bytes.',
                 'next_improvement': 'Preserve dated disposition successors alongside original submission and scientific evidence bindings.'},
                {'goal': 'Scoped claims and preserved uncertainty', 'assessment': 'Aligned',
                 'evidence': 'The pilot retains its one-obligation denominator, provisional candidates and known-negative limitation. The broader FAIL state and unresolved survivors remain visible.',
                 'next_improvement': 'Continue to distinguish artifacts from distinct defects and bounded search exhaustion from equivalence.'},
                {'goal': 'Improve shared assets', 'assessment': 'Merged corpus contributions and an explicit three-path contribution portfolio',
                 'evidence': 'The dated successor verifies Arena #181/#182 merged and Nanoda #32 open. The current queue compares shared corpus precision, checker hardening and independent semantic clarification; Kiota submission remains deferred.',
                 'next_improvement': 'Prefer small non-duplicative contributions with isolating evidence and a named beneficiary; maintainer feedback supports concise source-level explanations.'},
                {'goal': 'Community visibility and participation', 'assessment': 'Useful entry points; status maintenance needs discipline',
                 'evidence': 'README, contribution rules, the investigation SOP and generated public status provide inspection paths. The hand-maintained metrics section had diverged from machine records.',
                 'next_improvement': 'Keep contribution packets focused. Read-only connector access is verified; select a working authorized channel and exact preflight for any approved external write.'},
                {'goal': 'Concrete recommendations with human control', 'assessment': 'Aligned',
                 'evidence': 'Schema-backed action records now preserve approval, deferral, separate PR URLs, exact branch commits, and the latest-upstream duplicate preflight.',
                 'next_improvement': 'Continue to mechanize preflight and evidence assembly while keeping external publication under exact owner control.'},
                {'goal': 'Highest-value bounded work and replaceable strategy', 'assessment': ('PAUSED: no executable item' if paused else 'Explicit ranked operational successor'),
                 'evidence': 'The queue retains several finite executable alternatives across all three contribution paths plus outcome-gated follow-ups. History mining has a bounded literature/reuse review and a fresh-yield pilot, not a superiority claim.',
                 'next_improvement': (queue['handoff']['required_decision'] if paused else 'Complete ' + selected['id'] + ': ' + selected['title'] + '; record the result and rerank before the next item.')},
            ],
            'operational_findings': [
                'The old human Current Metrics block had drifted from canonical assurance records. It is now explicitly a legacy snapshot, with current facts generated from machine artifacts.',
                'Frozen study tests and validators now run against their committed frontier through an explicit successor; current and future tests remain live, and both groups must pass.',
                'Exact historical evidence can validate without local checker payloads; fresh execution still needs reproducible materialization of the ignored corpus/coverage/observer inputs.',
                'run-campaign now requires an authorized manifest that binds the active frontier, governing plan, exact inputs, declared platform, finite phase and total budgets, and a completion predicate before launch or resume.',
                'materialize-run-inputs supports exact-hash local donor materialization for a clean clone; it refuses mismatched existing files and does not rebuild omitted payloads.',
                'run-autonomous-campaigns is retired: it refuses broad generation and directs callers to an exact authorized manifest.',
                'The successor admitted two fixed witnesses without new checker execution, reducing the pending mechanical survivor queue from nine to seven while preserving unresolved semantic status.',
                'A completed run-campaign phase can be resumed mechanically. Normative qualification, unexpected semantic interpretation and target-specific external submission retain deliberate judgment boundaries.',
                'The earlier CLI preflight failure remains historical. A dated successor verifies working read-only GitHub connector access; it does not prove CLI repair or authorize external writes.',
                'No per-task model-token or total end-to-end cost record is available here; claimed token savings should be measured, not inferred from short checker runtime.',
                'Queue integrity validation checks bounded selection and status agreement, including explicit PAUSED handoffs. Use validate-research-queue --require-ready to require an executable selection. Ranking remains an evidence-backed judgment. Existing corpus packet next_steps remain historical follow-through context and no longer drive the current priority order.',
            ],
            'improvements_completed': ['Gates 11 and 12 closed with a generated decision/report and historical validator.',
                                       'The corpus-integration successor completed two current-Arena package builds, an exact tutorial comparison, and a separate Ultra proof-parameter review.',
                                       f"Two fixed survivor witnesses are admitted through an explicit v2 corpus successor; {metrics['pending_survivor_triage']} mechanically executed survivors remain pending after the no-duplicate 9face association.",
                                       'Owner decisions are recorded: Arena PRs #181 and #182 were submitted separately after latest-upstream duplicate checks; the Kiota clarification is deferred.',
                                       'One fail-fast scripts/refresh-current-state command replaces repeated model-mediated assurance-refresh steps and retains logs.',
                                       'The operating guide records script-first work, focused-then-required validation, selective cheaper delegation, and exception-based model review.',
                                       'The active plan and ranked queue are current. Completed queue items: ' + ', '.join(row['id'] for row in queue['items'] if row['status'] == 'COMPLETE') + '. Selected next item: ' + selected['id'] + ' (' + selected['status'] + ').'],
            'successor_decision_packet': ({'binding': bound(SUCCESSOR_PACKET), 'status': packet['status'],
                                           'findings': [{'id': row.get('id'), 'disposition': row.get('disposition'), 'reason': row.get('reason')} for row in packet['findings']],
                                           'triage': [{'mutant_id': row.get('mutant_id'), 'status': row.get('status'), 'reason': row.get('reason')} for row in packet['triage']],
                                           'external_actions': packet['external_actions']} if packet is not None else None),
            'pending_external_actions': pending, 'proposed_next_steps': next_steps,
            'autonomy_policy': {'automatic': ['Hash and inventory checks', 'Already-authorized bounded execution and checkpointing', 'Deterministic normalization, report generation and validation', 'Read-only evidence assembly and preparation of concrete drafts'],
                                'model_review': ['Frontier design and novelty assessment', 'Unexplained checker differences and semantic ambiguity', 'Source-to-claim interpretation under frozen authority rules'],
                                'human_decision': ['New normative source approvals', 'Target-specific external publication/submission', 'Scope beyond standing local authorization or an unsatisfied milestone gate']},
            'cost_policy': ['No model calls inside checker/build/minimization loops.', 'Batch independent mechanical work; stop on budget/input/semantic exceptions.', 'Use Luna for routine edits and Terra for bounded implementation; reserve Ultra for a named difficult question.', 'Run focused tests during implementation and required full gates at closure; do not repeat broad suites without a relevant change.', 'Measure wall time, checker attempts, resumed work, model calls/tokens and accepted shared contributions per bounded investigation.'],
            'new_research_authorized_by_this_review': False}


def render(review):
    m = review['metrics']
    lines = ['# Project review and proposed next steps', '',
             'Generated by `scripts/build-project-review --write` from `results/research/project-review.json`. Planning judgments are proposals, not semantic authority or new experiment authorization.', '',
             review['constitutional_assessment'], '',
             f"The publication study is closed through Gate 12: {m['study_outcome']} / {m['study_tier']} / {m['study_publication_decision']}. Its isolated result is {m['study_existing_isolated']}/{m['study_denominator']} to {m['study_final_isolated']}/{m['study_denominator']}, completing a known negative’s missing control.", '',
             f"The broader assurance gate remains **{m['assurance_gate']}**, with {m['semantic_disagreement_artifacts']} unresolved semantic-disagreement artifacts and {m['parse_disagreement_artifacts']} parse-behavior artifact. These are not a count of distinct bugs. {m['pending_survivor_triage']} survivors remain in the canonical pending-admission set after two fixed profile witnesses were admitted; their semantic status remains unresolved. The current register contains {m['current_external_actions_pending_review']} exact external actions requiring review. One historical Gate-10 companion recommendation also remains deferred, for {m['external_actions_pending_review']} pending rows across both selected registers and {m['schema_backed_findings_in_selected_registers']} findings.", '',
             (f"The corpus-integration successor packet is **{m['successor_packet_status']}**. It is summarized with an exact input binding below." if review['successor_decision_packet'] is not None else "The corpus-integration successor packet is **NOT_YET_RECORDED**. The active successor frontier is still in progress; this review does not claim its objectives are complete."), '',
             '## Constitutional alignment', '', '| Goal | Assessment | Next improvement |', '|---|---|---|']
    lines += ['| ' + row['goal'] + ' | ' + row['assessment'] + ' | ' + row['next_improvement'] + ' |' for row in review['constitutional_alignment']]
    lines += ['', 'Evidence for each assessment is recorded in the canonical JSON alongside exact input bindings.', '', '## Recommended order', '']
    queue = review['work_queue']
    if handoff_status(queue) == 'PAUSED':
        lines += ['**Queue execution is PAUSED; no executable item is selected.**', '',
                  '**Blocker:** ' + queue['handoff']['reason'], '',
                  '**Required decision:** ' + queue['handoff']['required_decision'], '',
                  'Selected blocked decision: **' + queue['selected_item'] + '**. Resolve the recorded blocker and update the canonical queue before execution.', '']
    else:
        lines += ['Selected next item: **' + queue['selected_item'] + '**.', '']
    lines += ['Status, rank and bounds come from `config/research-queue.json`; PLANNED, WAITING and DEFERRED entries are not executable merely because they appear here.', '',
              '| Rank | Item | Status |', '|---|---|---|']
    lines += [f"| {s['priority']} | {s['id']}: {s['title']} | {s['status']} |" for s in review['proposed_next_steps']]
    lines.append('')
    for step in review['proposed_next_steps']:
        target = step['target'] if isinstance(step['target'], str) else f"A fixed subset of the {len(step['target'])} existing pending survivors; exact IDs are in the canonical JSON."
        lines += [f"### {step['priority']}. {step['id']}: {step['title']}", '', '**Target:** ' + target, '', step['action'], '', '**Why this rank:** ' + step['rank_rationale'], '', '**Completion:** ' + step['completion'], '', '**Stop:** ' + step['stop_condition'], '', '**Execution:** ' + step['mechanism'], '', '**Boundary:** ' + step['authorization'], '']
    lines += ['## Autonomous workflow', '', '| Work | Default mechanism |', '|---|---|']
    for category, values in review['autonomy_policy'].items():
        lines.append('| ' + category.replace('_', ' ').capitalize() + ' | ' + '; '.join(values) + ' |')
    lines += ['', 'Use `scripts/refresh-current-state` for routine assurance refresh and `scripts/build-project-review --check` to detect stale review inputs. Each research run should have one exact manifest, finite budgets and an executable completion condition. Scripts run through the authorized work; models handle exceptions. Prepare a concrete review packet before requesting any required owner decision.', '', '## Operational findings', '']
    lines += ['- ' + value for value in review['operational_findings']]
    lines += ['', '## Efficiency rules', ''] + ['- ' + value for value in review['cost_policy']]
    lines += ['', '## Changes completed in this task', ''] + ['- ' + value for value in review['improvements_completed']]
    lines += ['', 'This generated review does not launch a campaign. Upstream observations are bounded to dated, input-bound records, including the 2026-09-09 disposition successor; they are not a live status guarantee. Earlier action rows retain their historical scope. The full evidence bindings, exact targets and prerequisites are in the canonical JSON.', '']
    return '\n'.join(lines)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument('--write', action='store_true')
    group.add_argument('--check', action='store_true')
    args = parser.parse_args()
    subprocess.run([str(ROOT / 'scripts/close-declaration-validation-publication-study'),
                    'validate-historical'], cwd=ROOT, check=True, stdout=subprocess.PIPE)
    review = build()
    encoded = json.dumps(review, indent=2, sort_keys=True) + '\n'
    report = render(review)
    if args.write:
        (ROOT / OUTPUT).write_text(encoded)
        (ROOT / REPORT).write_text(report)
    elif args.check:
        if (ROOT / OUTPUT).read_text() != encoded or (ROOT / REPORT).read_text() != report:
            raise SystemExit('project review is stale; run scripts/build-project-review --write')
        print('PASS: project review matches its current local inputs')
    else:
        print(encoded, end='')
