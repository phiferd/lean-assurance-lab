#!/usr/bin/env python3
"""Stage a frozen selection or construct the fixed real-proof slices."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib.real_proof_slices import build, write_scientific_manifest  # noqa: E402

parser = argparse.ArgumentParser()
parser.add_argument("stage", choices=["inventory", "construct"])
args = parser.parse_args()
print(json.dumps(write_scientific_manifest() if args.stage == "inventory" else build(), sort_keys=True))
