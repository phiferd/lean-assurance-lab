#!/usr/bin/env python3
"""Populate the two M9 catalog states from the immutable corrected M8 catalog."""

from __future__ import annotations

import argparse
import copy
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
HISTORICAL_VALIDATOR_PATH = ROOT / "scripts" / "validate-declaration-validation-historical"
M8_EVIDENCE_LOCK_PATH = (
    ROOT / "config" / "declaration-validation-evidence-locks" / "milestone-8-inventory.json"
)
PRE_EVIDENCE_LOCK_PATH = (
    ROOT / "config" / "declaration-validation-evidence-locks" / "milestone-9-pre-review.json"
)
REVIEWED_EVIDENCE_LOCK_PATH = (
    ROOT / "config" / "declaration-validation-evidence-locks" / "milestone-9-reviewed.json"
)
PRE_CATALOG_PATH = (
    ROOT / "results" / "research" / "declaration-validation-milestone-9-pre-review-catalog.json"
)
CATALOG_PATH = ROOT / "config" / "declaration-validation-catalog.json"
REVIEWED_CATALOG_PATH = (
    ROOT / "results" / "research" / "declaration-validation-milestone-9-reviewed-catalog.json"
)
PRE_RECORDED_AT = "2026-09-01T00:15:00-04:00"
REVIEWED_AT = "2026-09-01T01:30:00-04:00"


def load_module(name: str, path: Path) -> Any:
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"could not load {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def document_bytes(document: dict[str, Any]) -> bytes:
    return (json.dumps(document, indent=2, sort_keys=True) + "\n").encode("utf-8")


def document_sha256(document: dict[str, Any]) -> str:
    return hashlib.sha256(document_bytes(document)).hexdigest()


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def immutable_m8_catalog() -> dict[str, Any]:
    history = load_module("declaration_m9_history", HISTORICAL_VALIDATOR_PATH)
    errors = history.validate_m8_attestation()
    if errors:
        raise RuntimeError("immutable M8 validation failed: " + "; ".join(errors))
    attestation = history.load_json(history.M8_ATTESTATION_PATH)
    catalog, binding_errors = history.historical_json(
        attestation["artifacts"]["catalog"],
        label="M9 predecessor catalog",
        expected_commit=history.M8_COMMIT,
    )
    if binding_errors or catalog is None:
        raise RuntimeError(
            "could not recover immutable M8 catalog: " + "; ".join(binding_errors)
        )
    return catalog


def render_pre_review_evidence_lock() -> dict[str, Any]:
    return {
        "schema_version": 1,
        "lock_id": "ordinary-declaration-validation.evidence-lock.milestone-9-pre-review.v1",
        "sequence": 5,
        "recorded_at": PRE_RECORDED_AT,
        "status": "MILESTONE_9_PRE_REVIEW_EVIDENCE_FREEZE",
        "predecessor": {
            "kind": "EVIDENCE_LOCK",
            "path": str(M8_EVIDENCE_LOCK_PATH.relative_to(ROOT)),
            "sha256": sha256_file(M8_EVIDENCE_LOCK_PATH),
        },
        "normative_documentation": [],
        "mechanized_results": [],
        "tracked_evidence": [],
        "generated_witnesses": [],
        "nonclaims": [
            "This successor freezes the evidence-selection boundary before M9 review; it adds no authority source or observation.",
            "The immutable corrected M8 attestation, not a mutable current path, defines the pre-review inventory.",
            "No implementation behavior, checker agreement, or review judgment establishes normativity.",
            "No soundness relevance or Arena coverage denominator is created by this lock.",
        ],
    }


def render_reviewed_evidence_lock(
    pre_review_lock: dict[str, Any] | None = None,
) -> dict[str, Any]:
    pre_review_lock = pre_review_lock or render_pre_review_evidence_lock()
    return {
        "schema_version": 1,
        "lock_id": "ordinary-declaration-validation.evidence-lock.milestone-9-reviewed.v1",
        "sequence": 6,
        "recorded_at": REVIEWED_AT,
        "status": "MILESTONE_9_REVIEWED_EVIDENCE_FREEZE",
        "predecessor": {
            "kind": "EVIDENCE_LOCK",
            "path": str(PRE_EVIDENCE_LOCK_PATH.relative_to(ROOT)),
            "sha256": document_sha256(pre_review_lock),
        },
        "normative_documentation": [],
        "mechanized_results": [],
        "tracked_evidence": [],
        "generated_witnesses": [],
        "nonclaims": [
            "M9 review selected no new normative document, mechanized result, checker result, or witness.",
            "The empty reviewed successor records a negative evidence-selection result rather than silently inheriting new authority.",
            "All catalog authority remains provisional and all soundness relevance remains not assessed.",
            "The adversarial-review record is a post-catalog audit artifact, not semantic authority.",
        ],
    }


def render_pre_review_catalog(
    pre_review_lock: dict[str, Any] | None = None,
) -> dict[str, Any]:
    pre_review_lock = pre_review_lock or render_pre_review_evidence_lock()
    catalog = copy.deepcopy(immutable_m8_catalog())
    catalog["recorded_at"] = PRE_RECORDED_AT
    catalog["status"] = "MILESTONE_9_PRE_REVIEW_FREEZE"
    catalog["artifact_bindings"]["evidence_lock"] = {
        "path": str(PRE_EVIDENCE_LOCK_PATH.relative_to(ROOT)),
        "sha256": document_sha256(pre_review_lock),
    }
    catalog["completion_boundary"] = {
        "canonical_data_authoritative": True,
        "generated_report_required": True,
        "inventory_populated": True,
        "authority_assignments_created": True,
        "next_milestone": "MILESTONE_9_ADVERSARIAL_REVIEW",
    }
    catalog["nonclaims"] = [
        "This pre-review snapshot preserves the immutable corrected M8 inventory without semantic, authority, lifecycle, layer, observation, or soundness changes.",
        "The snapshot starts M9 review; it is not the reviewed result and does not authorize Milestone 10.",
        "No implementation behavior, checker agreement, or LLM judgment becomes authority through the freeze.",
        "All 27 active entries remain PROVISIONAL and all soundness relevance remains NOT_ASSESSED.",
        "No Arena negative-coverage denominator is created by this snapshot.",
    ]
    return catalog


def render_reviewed_catalog(
    pre_review_catalog: dict[str, Any] | None = None,
    reviewed_lock: dict[str, Any] | None = None,
) -> dict[str, Any]:
    pre_review_catalog = pre_review_catalog or render_pre_review_catalog()
    reviewed_lock = reviewed_lock or render_reviewed_evidence_lock()
    catalog = copy.deepcopy(pre_review_catalog)
    catalog["recorded_at"] = REVIEWED_AT
    catalog["status"] = "MILESTONE_9_REVIEWED_FREEZE"
    catalog["artifact_bindings"]["evidence_lock"] = {
        "path": str(REVIEWED_EVIDENCE_LOCK_PATH.relative_to(ROOT)),
        "sha256": document_sha256(reviewed_lock),
    }
    catalog["completion_boundary"] = {
        "canonical_data_authoritative": True,
        "generated_report_required": True,
        "inventory_populated": True,
        "authority_assignments_created": True,
        "next_milestone": "MILESTONE_10_DESIGN_FROZEN_INVENTORY_COVERAGE_STUDY",
    }
    catalog["nonclaims"] = [
        "M9 challenged all twelve mandated review classes and found no semantic catalog correction justified by the frozen evidence.",
        "The review preserves incomplete independent observability, provisional authority, explicit cross-layer scenarios, exclusions, and unresolved boundaries rather than upgrading them.",
        "No implementation behavior, checker agreement, adversarial-review result, or LLM judgment establishes normativity.",
        "All 27 active entries remain PROVISIONAL and all soundness relevance remains NOT_ASSESSED.",
        "The reviewed inventory is a frozen input for Milestone 10 design; it is not yet a negative-coverage denominator and no broad coverage study has begun.",
    ]
    return catalog


def rendered_documents() -> dict[Path, dict[str, Any]]:
    pre_lock = render_pre_review_evidence_lock()
    reviewed_lock = render_reviewed_evidence_lock(pre_lock)
    pre_catalog = render_pre_review_catalog(pre_lock)
    reviewed_catalog = render_reviewed_catalog(pre_catalog, reviewed_lock)
    return {
        PRE_EVIDENCE_LOCK_PATH: pre_lock,
        REVIEWED_EVIDENCE_LOCK_PATH: reviewed_lock,
        PRE_CATALOG_PATH: pre_catalog,
        CATALOG_PATH: reviewed_catalog,
        REVIEWED_CATALOG_PATH: reviewed_catalog,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--check", action="store_true", help="verify tracked outputs instead of writing them"
    )
    args = parser.parse_args()
    stale: list[str] = []
    for path, document in rendered_documents().items():
        expected = document_bytes(document)
        if args.check:
            if not path.is_file() or path.read_bytes() != expected:
                stale.append(str(path.relative_to(ROOT)))
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(expected)
            print(path.relative_to(ROOT))
    if stale:
        for relative in stale:
            print(f"ERROR: generated M9 artifact is stale: {relative}")
        return 1
    if args.check:
        print("declaration-validation M9 catalog population: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
