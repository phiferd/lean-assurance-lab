#!/usr/bin/env python3
import argparse
import json
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib.cvc4_ownership_evidence import validate
p = argparse.ArgumentParser()
p.add_argument('--write', action='store_true')
p.add_argument('--without-runtime-payloads', action='store_true')
a = p.parse_args()
print(json.dumps(validate(Path(__file__).resolve().parents[1], write=a.write,
                          require_payloads=not a.without_runtime_payloads), indent=2))
