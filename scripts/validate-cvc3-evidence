#!/usr/bin/env python3
"""Read-only CVC-3 closure-evidence validation; never launches Lean."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.cvc3_evidence import validate_run
from lib.cvc3_evidence import validate_closure

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--require-payloads', action='store_true')
parser.add_argument('--run-only', action='store_true')
args = parser.parse_args()
validator = validate_run if args.run_only else validate_closure
print(json.dumps(validator(ROOT, require_payloads=args.require_payloads), indent=2, sort_keys=True))
