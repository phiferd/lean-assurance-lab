#!/usr/bin/env python3
"""Build or check the frozen ACCEPTANCE-IMPACT-PILOT-1 pair audit."""
import argparse
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import acceptance_impact_pair as pair_audit  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--write", action="store_true")
    mode.add_argument("--check", action="store_true")
    args = parser.parse_args()
    try:
        if args.write:
            result = pair_audit.write(ROOT)
            print(json.dumps(result, sort_keys=True))
        elif args.check:
            result = pair_audit.check(ROOT)
            print(json.dumps(result, sort_keys=True))
        else:
            sys.stdout.buffer.write(pair_audit.canonical_bytes(pair_audit.build(ROOT)))
    except (OSError, pair_audit.PairAuditError) as error:
        print("pair audit refused: " + str(error), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
