#!/usr/bin/env python3
"""Extract privacy-preserving response usage totals from explicit Codex JSONL files."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.model_usage_accounting import UsageError, extract


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root-turn-id", required=True)
    parser.add_argument("--project-root", type=Path, default=ROOT)
    parser.add_argument("--observed-at")
    parser.add_argument("--input", action="append", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    try:
        result = extract(args.input, root_turn_id=args.root_turn_id,
                         project_root=args.project_root, observed_at=args.observed_at)
        args.output.parent.mkdir(parents=True, exist_ok=True)
        with args.output.open("x", encoding="utf-8") as output:
            json.dump(result, output, indent=2)
            output.write("\n")
    except (OSError, UsageError) as error:
        print(error, file=sys.stderr)
        return 1
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
