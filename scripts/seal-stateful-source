#!/usr/bin/env python3
"""Bind exact retained source, runtime and process identities for the pilot."""
import hashlib
import json
from pathlib import Path
import sys
ROOT=Path(__file__).resolve().parents[1]
BASE=ROOT/'results/research/stateful-validation-pilot-1'
def bind(p):
    return dict(path=str(p.relative_to(ROOT)),bytes=p.stat().st_size,sha256=hashlib.sha256(p.read_bytes()).hexdigest())
paths=sorted((BASE/'sources').iterdir())
runtime=ROOT/'results/research/trust-assumption-pipeline-pilot-1/runtime-manifest.json'
manifest=json.loads(runtime.read_text())
installed=Path(manifest['root'])
for name in ['Environment.lean','AddDecl.lean']:
    assert (BASE/'sources'/name).read_bytes()==(installed/'src/lean/Lean'/name).read_bytes()
assert json.loads((BASE/'sources/tag.json').read_text())['object']['sha']=='d8b18978322de05a8f3dba51ef03cf5461676c17'
doc=dict(item_id='STATEFUL-VALIDATION-PILOT-1',revision='SOURCE_R1',source_commit='d8b18978322de05a8f3dba51ef03cf5461676c17',
 sources=[bind(p) for p in paths],runtime_inventory=bind(runtime),runtime_root=str(installed),
 scientific_contract=bind(BASE/'scientific-contract.json'),review=bind(BASE/'source-reuse-review.md'),
 source_match='Installed Lean public API source equals the exact official tag source byte-for-byte.',
 source_acquisition='Official raw GitHub URLs under exact v4.33.0 tag/commit; fetched 2026-09-27; tag receipt retained.',
 host_tools=[dict(path=p,sha256=hashlib.sha256(Path(p).read_bytes()).hexdigest()) for p in [sys.executable,'/bin/ps']])
dest=BASE/'source-manifest.json'
with dest.open('x') as f: json.dump(doc,f,indent=2); f.write('\n')
print(bind(dest))
