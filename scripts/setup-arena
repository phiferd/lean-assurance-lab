#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EXTERNAL_DIR="${ROOT}/external"
LKA_ROOT="${LKA_ROOT:-${EXTERNAL_DIR}/lean-kernel-arena}"
LKA_REPO="${LKA_REPO:-https://github.com/leanprover/lean-kernel-arena.git}"
REPRODUCIBLE=false

if [[ "${1:-}" == "--reproducible" ]]; then
  REPRODUCIBLE=true
  shift
fi
if [[ $# -ne 0 ]]; then
  echo "usage: scripts/setup-arena [--reproducible]" >&2
  exit 2
fi

mkdir -p "${EXTERNAL_DIR}" \
  "${ROOT}/results/baseline" \
  "${ROOT}/results/mutants" \
  "${ROOT}/results/survivors" \
  "${ROOT}/results/witnesses" \
  "${ROOT}/corpus/generated" \
  "${ROOT}/corpus/minimized"

echo "Dependency check:"
for tool in git python3 cargo rustc elan uv; do
  if command -v "${tool}" >/dev/null 2>&1; then
    printf '  %-8s %s\n' "${tool}" "$(command -v "${tool}")"
  else
    printf '  %-8s MISSING\n' "${tool}"
  fi
done
if [[ -x "${ROOT}/.venv-arena/bin/python" ]]; then
  printf '  %-8s %s\n' "arena-py" "${ROOT}/.venv-arena/bin/python"
fi

if [[ -d "${LKA_ROOT}/.git" ]]; then
  echo "Arena checkout already exists: ${LKA_ROOT}"
  git -C "${LKA_ROOT}" status --short
else
  echo "Cloning Lean Kernel Arena into ${LKA_ROOT}"
  git clone "${LKA_REPO}" "${LKA_ROOT}"
fi

if [[ "${REPRODUCIBLE}" == true ]]; then
  ARENA_REVISION="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["arena"]["revision"])' "${ROOT}/config/reproducibility.json")"
  CURRENT_REVISION="$(git -C "${LKA_ROOT}" rev-parse HEAD)"
  if [[ "${CURRENT_REVISION}" != "${ARENA_REVISION}" ]]; then
    if [[ -n "$(git -C "${LKA_ROOT}" status --porcelain)" ]]; then
      echo "reproducible setup refuses to change a dirty Arena checkout" >&2
      exit 1
    fi
    echo "Checking out pinned Arena revision ${ARENA_REVISION}"
    git -C "${LKA_ROOT}" checkout --detach "${ARENA_REVISION}"
  fi

  python3 "${ROOT}/scripts/verify-portable-coverage" --check-environment-only
fi

echo "Arena root: ${LKA_ROOT}"
