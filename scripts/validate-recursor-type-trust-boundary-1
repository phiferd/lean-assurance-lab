#!/usr/bin/env python3
"""Validate the recursor-type source adjudication and frozen regression contract."""
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import recursor_type_trust_boundary as boundary  # noqa: E402


try:
    print(json.dumps(boundary.validate(ROOT), sort_keys=True))
except (OSError, ValueError) as error:
    print("recursor-type trust-boundary validation failed: " + str(error), file=sys.stderr)
    raise SystemExit(2)
