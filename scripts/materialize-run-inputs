#!/usr/bin/env python3
"""Copy one declared authorized input set from a local same-platform donor."""
from __future__ import annotations
import argparse, json, os, shutil, sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]; sys.path.insert(0,str(ROOT))
from lib.authorized_runs import checked_path, relative_path, sha256_file, validate_manifest
def main():
 p=argparse.ArgumentParser(); p.add_argument("--authorization",required=True,type=Path); p.add_argument("--source-root",required=True,type=Path); a=p.parse_args()
 try:
  manifest=json.loads(a.authorization.read_text()); validate_manifest(manifest,ROOT,a.authorization.resolve(),check_inputs=False)
  donor=a.source_root.resolve()
  if not donor.is_dir(): raise ValueError("source root is not a directory")
  # Verify every source before writing even one destination.
  sources=[]
  for row in manifest["inputs"]:
   dest=checked_path(ROOT,row["path"],exists=False); src=relative_path(donor,row["path"])
   if not src.is_file() or src.is_symlink() or src.stat().st_size!=row["bytes"] or sha256_file(src)!=row["sha256"]: raise ValueError("donor input missing or mismatched: "+row["path"])
   if dest.exists() and (dest.is_symlink() or not dest.is_file() or dest.stat().st_size!=row["bytes"] or sha256_file(dest)!=row["sha256"]): raise ValueError("destination exists with different bytes: "+row["path"])
   sources.append((src,dest,row))
  for src,dest,row in sources:
   if dest.exists(): continue
   dest.parent.mkdir(parents=True,exist_ok=True); temp=dest.with_name("."+dest.name+".materializing")
   if temp.exists(): raise ValueError("temporary materialization path exists")
   with src.open("rb") as i, temp.open("xb") as o: shutil.copyfileobj(i,o)
   if temp.stat().st_size != row["bytes"] or sha256_file(temp) != row["sha256"]:
    temp.unlink(); raise ValueError("donor changed during materialization")
   os.chmod(temp,src.stat().st_mode & 0o777)
   try: os.link(temp,dest)
   except FileExistsError: temp.unlink(); raise ValueError("destination appeared during materialization: "+row["path"])
   temp.unlink()
  validate_manifest(manifest,ROOT,a.authorization.resolve()); return 0
 except (ValueError,OSError,json.JSONDecodeError) as e: print("materialization refused: "+str(e),file=sys.stderr); return 2
if __name__=="__main__": raise SystemExit(main())
