#!/usr/bin/env python3
"""Create a witness-search plan for a meaningful surviving mutant.

This script intentionally does not claim to synthesize witnesses yet. It writes
the durable search metadata needed for the first semi-automatic experiment.
"""

from __future__ import annotations

import argparse
import json
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mutant-id", required=True)
    parser.add_argument("--subsystem", default="unknown")
    parser.add_argument("--strategy", default="structure-aware-ndjson-mutation")
    parser.add_argument("--seed-artifact", action="append", default=[])
    parser.add_argument("--output-dir", type=Path, default=Path("results/witnesses"))
    args = parser.parse_args()

    witness_id = f"{args.mutant_id}-witness-plan"
    out_dir = args.output_dir / witness_id
    out_dir.mkdir(parents=True, exist_ok=True)

    metadata = {
        "witness_id": witness_id,
        "mutant_id": args.mutant_id,
        "subsystem": args.subsystem,
        "strategy": args.strategy,
        "seed_artifacts": args.seed_artifact,
        "status": "PLANNED",
        "success_predicate": "baseline(input) != mutant(input)",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "next_steps": [
            "select positive and negative Arena artifacts near the mutated subsystem",
            "apply structure-aware NDJSON mutations",
            "run baseline and mutant after each candidate",
            "retain candidates with different normalized outcomes",
        ],
    }
    (out_dir / "metadata.json").write_text(
        json.dumps(metadata, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    print(out_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
