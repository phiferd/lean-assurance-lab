#!/usr/bin/env python3
"""Compare normalized checker outcome JSONL files.

Input records should contain at least:
  {"test": "...", "outcome": "ACCEPT"}
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path

ALLOWED_OUTCOMES = {
    "ACCEPT",
    "REJECT",
    "DECLINE",
    "CRASH",
    "TIMEOUT",
    "PARSE_ERROR",
    "UNKNOWN",
}


def load(path: Path) -> dict[str, dict]:
    records: dict[str, dict] = {}
    with path.open("r", encoding="utf-8") as handle:
        for line_no, line in enumerate(handle, 1):
            if not line.strip():
                continue
            record = json.loads(line)
            test = record.get("test")
            if not test:
                raise SystemExit(f"{path}:{line_no}: missing 'test'")
            outcome = record.get("outcome", "UNKNOWN")
            if outcome not in ALLOWED_OUTCOMES:
                allowed = ", ".join(sorted(ALLOWED_OUTCOMES))
                raise SystemExit(
                    f"{path}:{line_no}: invalid outcome {outcome!r}; expected one of {allowed}"
                )
            records[test] = record
    return records


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("baseline", type=Path)
    parser.add_argument("candidate", type=Path)
    parser.add_argument("--mutant-id")
    parser.add_argument("--baseline-id", default="baseline")
    parser.add_argument("--candidate-id", default="candidate")
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()

    baseline = load(args.baseline)
    candidate = load(args.candidate)
    tests = sorted(set(baseline) | set(candidate))
    differences = []

    for test in tests:
        left = baseline.get(test, {"outcome": "UNKNOWN"})
        right = candidate.get(test, {"outcome": "UNKNOWN"})
        baseline_outcome = left.get("outcome", "UNKNOWN")
        candidate_outcome = right.get("outcome", "UNKNOWN")
        if baseline_outcome != candidate_outcome:
            differences.append(
                {
                    "test": test,
                    "baseline": baseline_outcome,
                    "candidate": candidate_outcome,
                    "direction": f"{baseline_outcome}_TO_{candidate_outcome}",
                }
            )

    report = {
        "baseline_id": args.baseline_id,
        "candidate_id": args.candidate_id,
        "mutant_id": args.mutant_id,
        "total_tests": len(tests),
        "baseline_only_tests": sorted(set(baseline) - set(candidate)),
        "candidate_only_tests": sorted(set(candidate) - set(baseline)),
        "difference_count": len(differences),
        "differences": differences,
        "killed": bool(differences),
    }

    text = json.dumps(report, indent=2, sort_keys=True) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(text, encoding="utf-8")
    else:
        print(text, end="")

    return 0 if differences else 1


if __name__ == "__main__":
    raise SystemExit(main())
