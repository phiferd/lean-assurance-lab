#!/usr/bin/env python3
"""Record baseline Nanoda outcomes for one candidate and matched control."""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
CHECKER_ROOT = ROOT / "external" / "lean-kernel-arena" / "_build" / "checkers" / "nanoda" / "src"


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def run(binary: Path, config: Path, artifact: Path, timeout: float) -> dict:
    started = time.time()
    with artifact.open("rb") as handle:
        try:
            proc = subprocess.run(
                [str(binary), str(config)],
                cwd=CHECKER_ROOT,
                stdin=handle,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout,
            )
            outcome = "ACCEPT" if proc.returncode == 0 else "REJECT"
            exit_code = proc.returncode
            stdout = proc.stdout
            stderr = proc.stderr
        except subprocess.TimeoutExpired as exc:
            outcome = "TIMEOUT"
            exit_code = None
            stdout = exc.stdout or b""
            stderr = exc.stderr or b""
    return {
        "normalized_outcome": outcome,
        "exit_code": exit_code,
        "seconds": time.time() - started,
        "stdout_sha256": hashlib.sha256(stdout).hexdigest(),
        "stderr_sha256": hashlib.sha256(stderr).hexdigest(),
        "stderr_tail": stderr.decode(errors="replace")[-2000:],
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("case_id")
    parser.add_argument("candidate", type=Path)
    parser.add_argument("--control", type=Path, required=True)
    parser.add_argument("--config", type=Path, default=CHECKER_ROOT / "config.json")
    parser.add_argument("--timeout", type=float, default=300.0)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    binary = CHECKER_ROOT / "target" / "release" / "nanoda_bin"
    candidate = args.candidate.resolve()
    control = args.control.resolve()
    config = args.config.resolve()
    result = {
        "schema_version": 1,
        "case_id": args.case_id,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "checker": {
            "id": "nanoda",
            "binary": str(binary.relative_to(ROOT)),
            "binary_sha256": sha256_file(binary),
            "config": str(config.relative_to(ROOT)),
            "config_sha256": sha256_file(config),
        },
        "candidate": {
            "path": str(candidate.relative_to(ROOT)),
            "sha256": sha256_file(candidate),
            "result": run(binary, config, candidate, args.timeout),
        },
        "control": {
            "path": str(control.relative_to(ROOT)),
            "sha256": sha256_file(control),
            "result": run(binary, config, control, args.timeout),
        },
        "timeout_seconds": args.timeout,
    }
    result["status"] = (
        "PASS"
        if result["candidate"]["result"]["normalized_outcome"] in {"ACCEPT", "REJECT"}
        and result["control"]["result"]["normalized_outcome"] == "ACCEPT"
        else "FAIL"
    )
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps({
        "output": str(args.output),
        "status": result["status"],
        "candidate": result["candidate"]["result"]["normalized_outcome"],
        "control": result["control"]["result"]["normalized_outcome"],
    }, indent=2, sort_keys=True))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
