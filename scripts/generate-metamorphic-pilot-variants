#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.metamorphic_ndjson_audit import AuditError, audit_files  # noqa: E402
from lib.metamorphic_ndjson_transform import TransformError, transform_file  # noqa: E402


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def binding(path: Path) -> dict[str, object]:
    return {"path": str(path.relative_to(ROOT)), "sha256": sha256(path), "bytes": path.stat().st_size}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--scientific-manifest", type=Path, required=True)
    parser.add_argument("--scientific-sha256", required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--summary", type=Path, required=True)
    args = parser.parse_args()
    try:
        science_path = args.scientific_manifest.resolve()
        if not science_path.is_relative_to(ROOT):
            raise ValueError("scientific manifest must be inside the repository")
        if sha256(science_path) != args.scientific_sha256:
            raise ValueError("scientific manifest hash differs from the bound hash")
        science = json.loads(science_path.read_text())
        if science.get("freeze_id") != "metamorphic-representation-pilot-1.science.v1":
            raise ValueError("unexpected scientific freeze")
        if science.get("generation_bounds") != {
            "originals": 2,
            "transformation_kinds": 2,
            "variants": 4,
            "max_records_per_input": 32,
            "max_bytes_per_input": 4096,
            "max_dependency_edges_per_input": 256,
            "max_ready_set_scans_per_variant": 1024,
            "randomness": False,
            "adaptive_expansion": False,
        }:
            raise ValueError("generation bounds differ from the expected freeze")
        originals = science.get("originals")
        transformations = science.get("transformations")
        if not isinstance(originals, list) or len(originals) != 2:
            raise ValueError("expected exactly two frozen originals")
        if not isinstance(transformations, list) or [row.get("id") for row in transformations] != [
            "reverse-ready-v1", "kind-round-robin-v1"
        ]:
            raise ValueError("expected exactly the two ordered frozen transformations")
        output_dir = args.output_dir.resolve()
        summary_path = args.summary.resolve()
        if not output_dir.is_relative_to(ROOT) or not summary_path.is_relative_to(ROOT):
            raise ValueError("outputs must remain inside the repository")
        if output_dir.exists() or summary_path.exists():
            raise ValueError("generation outputs already exist")
        for original in originals:
            path = ROOT / original["path"]
            if sha256(path) != original["sha256"]:
                raise ValueError(f"stale original binding: {original['id']}")
        output_dir.mkdir(parents=True)
        rows = []
        for original in originals:
            original_path = ROOT / original["path"]
            for transformation in transformations:
                algorithm = transformation["id"]
                stem = f"{original['id']}--{algorithm}"
                variant_path = output_dir / f"{stem}.ndjson"
                transform_path = output_dir / f"{stem}.transform.json"
                audit_path = output_dir / f"{stem}.audit.json"
                transform = transform_file(original_path, variant_path, algorithm)
                transform_path.write_text(json.dumps(transform, indent=2, sort_keys=True) + "\n")
                audit = audit_files(original_path, variant_path, require_nonidentity=True)
                audit_path.write_text(json.dumps(audit, indent=2, sort_keys=True) + "\n")
                if not audit["equivalent"]:
                    raise AuditError(f"preservation audit failed for {stem}")
                rows.append({
                    "original": original["id"],
                    "transformation": algorithm,
                    "variant": binding(variant_path),
                    "transform_report": binding(transform_path),
                    "audit": binding(audit_path),
                    "eligible": audit["eligible"],
                    "nonidentity": audit["nonidentity"],
                    "position_changes": audit["position_changes"],
                    "identifier_changes": audit["identifier_changes"],
                })
        summary = {
            "schema_version": 1,
            "item_id": "METAMORPHIC-REPRESENTATION-PILOT-1",
            "scientific_manifest": binding(science_path),
            "variant_count": len(rows),
            "variants": rows,
        }
        summary_path.parent.mkdir(parents=True, exist_ok=True)
        summary_path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")
        print(json.dumps({"summary": binding(summary_path), "eligible": sum(row["eligible"] for row in rows)}, sort_keys=True))
        return 0
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError, TransformError, AuditError) as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
