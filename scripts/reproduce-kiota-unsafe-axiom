#!/usr/bin/env python3
"""Reproduce current Kiota behavior for a safe declaration using an unsafe axiom."""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import time
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
CANDIDATE = ROOT / "corpus" / "generated" / "axiom-unsafe-candidate.ndjson"
CONTROL = ROOT / "corpus" / "generated" / "axiom-unsafe-control.ndjson"
OFFICIAL = ROOT / "external" / "lean-kernel-arena" / "_build" / "checkers" / "official" / "src" / ".lake" / "build" / "bin" / "kernel"
EXPECTED = ROOT / "results" / "expected-outcomes" / "axiom-unsafe-flag.json"
OUTPUT = ROOT / "results" / "investigations" / "nanoda-axiom-unsafe" / "kiota-upstream-main.json"


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def relative(path: Path) -> str:
    try:
        return str(path.resolve().relative_to(ROOT))
    except ValueError:
        return str(path.resolve())


def git(checkout: Path, *args: str) -> str:
    return subprocess.run(
        ["git", *args], cwd=checkout, check=True, text=True, stdout=subprocess.PIPE,
    ).stdout.strip()


def run(binary: Path, artifact: Path, decline_code: int | None = None) -> dict:
    started = time.monotonic()
    proc = subprocess.run([str(binary), str(artifact)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if proc.returncode == 0:
        outcome = "ACCEPT"
    elif decline_code is not None and proc.returncode == decline_code:
        outcome = "DECLINE"
    elif proc.returncode == 1:
        outcome = "REJECT"
    elif proc.returncode < 0:
        outcome = "CRASH"
    else:
        outcome = "UNKNOWN"
    return {
        "exit_code": proc.returncode,
        "normalized_outcome": outcome,
        "seconds": time.monotonic() - started,
        "stdout_sha256": hashlib.sha256(proc.stdout).hexdigest(),
        "stderr_sha256": hashlib.sha256(proc.stderr).hexdigest(),
        "stdout_tail": proc.stdout.decode(errors="replace")[-1000:],
        "stderr_tail": proc.stderr.decode(errors="replace")[-1000:],
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--kiota-checkout", type=Path, required=True)
    parser.add_argument("--expected-kiota-revision", required=True)
    args = parser.parse_args()
    checkout = args.kiota_checkout.resolve()
    revision = git(checkout, "rev-parse", "HEAD")
    if revision != args.expected_kiota_revision:
        raise SystemExit(f"Kiota revision {revision} != expected {args.expected_kiota_revision}")
    if git(checkout, "status", "--porcelain"):
        raise SystemExit("Kiota checkout must be clean")
    kiota = checkout / "target" / "release" / "kiota"
    parser_source = checkout / "src" / "parser.rs"
    for path in (CANDIDATE, CONTROL, OFFICIAL, EXPECTED, kiota, parser_source):
        if not path.is_file():
            raise SystemExit(f"missing required file: {path}")
    official_candidate = run(OFFICIAL, CANDIDATE)
    official_control = run(OFFICIAL, CONTROL)
    kiota_candidate = run(kiota, CANDIDATE, decline_code=2)
    kiota_control = run(kiota, CONTROL, decline_code=2)
    satisfied = all((
        official_candidate["normalized_outcome"] == "REJECT",
        official_control["normalized_outcome"] == "ACCEPT",
        kiota_candidate["normalized_outcome"] == "REJECT",
        kiota_control["normalized_outcome"] == "ACCEPT",
    ))
    result = {
        "schema_version": 1,
        "case_id": "kiota-unsafe-axiom-safe-dependent",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "status": "CONFIRMED" if satisfied else "NOT_REPRODUCED",
        "classification": "CURRENT_UPSTREAM_ALIGNED" if satisfied else "CURRENT_UPSTREAM_DISAGREEMENT",
        "candidate": {"path": relative(CANDIDATE), "sha256": digest(CANDIDATE)},
        "control": {"path": relative(CONTROL), "sha256": digest(CONTROL)},
        "expected_evidence": {"path": relative(EXPECTED), "sha256": digest(EXPECTED), "expected_outcome": "REJECT"},
        "validators": [
            {"id": "official", "candidate_result": official_candidate, "control_result": official_control},
            {
                "id": "kiota-upstream-main",
                "revision": revision,
                "remote": git(checkout, "remote", "get-url", "origin"),
                "source_clean": True,
                "parser_source_sha256": digest(parser_source),
                "binary_sha256": digest(kiota),
                "candidate_result": kiota_candidate,
                "control_result": kiota_control,
            },
        ],
        "mechanical_predicate": {
            "expression": "official(candidate)=REJECT and official(control)=ACCEPT and current-kiota(candidate)=REJECT and current-kiota(control)=ACCEPT",
            "satisfied": satisfied,
        },
        "scope": "Current-upstream alignment means no Kiota implementation issue is recommended; the Arena-pinned revision remains separately characterized.",
        "producer": {"path": relative(Path(__file__)), "sha256": digest(Path(__file__))},
    }
    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
    OUTPUT.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps({"output": relative(OUTPUT), "status": result["status"]}, indent=2))
    return 0 if satisfied else 2


if __name__ == "__main__":
    raise SystemExit(main())
