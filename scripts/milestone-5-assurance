#!/usr/bin/env python3
"""Produce and gate the Milestone 5 cross-validator assurance snapshot."""

from __future__ import annotations

import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

import jsonschema

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from artifact_graph import load_graph, require_current  # noqa: E402
from cross_validation import OUTCOMES, sha256_file  # noqa: E402

CASES = ("nanoda-0003-original", "nanoda-0003-minimized")
RESULT_FIELDS = {
    "normalized_outcome", "parse_behavior", "exit_code", "signal", "seconds",
    "stdout_sha256", "stderr_sha256", "stdout_tail", "stderr_tail", "command",
}


def load(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def validators_by_id(result: dict) -> dict[str, dict]:
    return {row["checker"]: row for row in result["validators"]}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--output", type=Path,
        default=ROOT / "results" / "assurance" / "milestone-5.json",
    )
    parser.add_argument("--allow-stale-artifacts", action="store_true")
    args = parser.parse_args()
    graph_path = ROOT / "results" / "artifacts" / "graph.json"
    if graph_path.exists() and not args.allow_stale_artifacts:
        try:
            require_current(
                load_graph(graph_path), ROOT, ["report:milestone5-assurance"],
                dependencies_only=True,
            )
        except RuntimeError as error:
            raise SystemExit(str(error)) from error

    catalog = load(ROOT / "config" / "validators.json")
    inventory = load(ROOT / "results" / "cross-validation" / "validator-inventory.json")
    evidence = {
        case: load(ROOT / "results" / "expected-outcomes" / f"{case}.json") for case in CASES
    }
    results = {
        case: load(ROOT / "results" / "cross-validation" / case / "results.json") for case in CASES
    }
    probe = load(ROOT / "results" / "cross-validation" / "malformed-object-probe" / "results.json")
    regression_manifest_path = ROOT / "corpus" / "regression-candidates" / "milestone-5.json"
    regression_manifest = load(regression_manifest_path)
    m4 = load(ROOT / "results" / "assurance" / "milestone-4.json")
    catalog_schema = load(ROOT / "schemas" / "validator-catalog.schema.json")
    evidence_schema = load(ROOT / "schemas" / "expected-outcome.schema.json")
    result_schema = load(ROOT / "schemas" / "cross-validation.schema.json")
    regression_schema = load(ROOT / "schemas" / "regression-candidates.schema.json")
    catalog_validator = jsonschema.Draft202012Validator(catalog_schema)
    evidence_validator = jsonschema.Draft202012Validator(evidence_schema)
    result_validator = jsonschema.Draft202012Validator(result_schema)
    regression_validator = jsonschema.Draft202012Validator(regression_schema)

    identities = {row["id"]: row for row in inventory["validators"]}
    original = results["nanoda-0003-original"]
    minimized = results["nanoda-0003-minimized"]
    original_validators = validators_by_id(original)
    minimized_validators = validators_by_id(minimized)
    probe_validators = validators_by_id(probe)
    expected_states = {
        "CONFIRMED", "CHECKER_DISAGREEMENT", "DECLINED", "INCOMPATIBLE", "CRASHED",
        "TIMED_OUT", "PARSE_ERROR", "UNRESOLVED",
    }
    schema_text = json.dumps(result_schema, sort_keys=True)

    checks = {
        "schemas_validate_all_m5_artifacts": catalog_validator.is_valid(catalog)
        and all(evidence_validator.is_valid(row) for row in evidence.values())
        and all(result_validator.is_valid(row) for row in [*results.values(), probe]),
        "validator_inventory_is_ready_and_content_bound": inventory["status"] == "READY"
        and inventory["catalog_sha256"] == sha256_file(ROOT / inventory["catalog"])
        and inventory["library_sha256"] == sha256_file(ROOT / "lib" / "cross_validation.py"),
        "unmodified_checker_identities_are_verified": identities["official"]["built_source_matches_template"]
        and identities["official"]["built_toolchain"] == identities["official"]["expected_built_toolchain"]
        and identities["kiota"]["source_clean"]
        and identities["kiota"]["source_revision"] == identities["kiota"]["expected_source_revision"],
        "independent_implementation_families_are_present": len({row["implementation_family"] for row in inventory["validators"]}) == 2
        and all(row["independent_from_nanoda"] for row in inventory["validators"]),
        "direct_results_retain_raw_behavior": all(
            RESULT_FIELDS <= set(validator["result"])
            for result in [original, minimized, probe]
            for validator in result["validators"]
            if validator["result"] is not None
        ),
        "witnesses_are_compatible_and_controls_accept": all(
            validator["compatibility"]["status"] == "COMPATIBLE"
            and validator["positive_control"]["result"]["normalized_outcome"] == "ACCEPT"
            for result in results.values()
            for validator in result["validators"]
        ),
        "expected_rejections_are_mechanically_established": all(
            row["status"] == "ESTABLISHED"
            and row["expected_outcome"] == "REJECT"
            and row["positive_control"]["result"]["normalized_outcome"] == "ACCEPT"
            and row["artifact"]["sha256"] == results[case]["artifact"]["sha256"]
            for case, row in evidence.items()
        ),
        "original_semantic_disagreement_is_durable": original["classification"] == "CHECKER_DISAGREEMENT"
        and original["semantic_status"] == "UNRESOLVED" and original["exceptional_unresolved"]
        and original_validators["official"]["result"]["normalized_outcome"] == "REJECT"
        and original_validators["kiota"]["result"]["normalized_outcome"] == "ACCEPT",
        "minimized_semantic_disagreement_is_durable": minimized["classification"] == "CHECKER_DISAGREEMENT"
        and minimized["semantic_status"] == "UNRESOLVED" and minimized["exceptional_unresolved"]
        and minimized_validators["official"]["result"]["normalized_outcome"] == "REJECT"
        and minimized_validators["kiota"]["result"]["normalized_outcome"] == "ACCEPT",
        "parse_behavior_disagreement_is_durable": probe["classification"] == "CHECKER_DISAGREEMENT"
        and probe["disagreement_kind"] == "PARSE_BEHAVIOR"
        and probe_validators["official"]["result"]["normalized_outcome"] == "ACCEPT"
        and probe_validators["official"]["result"]["parse_behavior"] == "PARSED_OR_IGNORED"
        and probe_validators["kiota"]["result"]["normalized_outcome"] == "PARSE_ERROR",
        "all_required_outcomes_and_classifications_are_modeled": OUTCOMES
        == {"ACCEPT", "REJECT", "DECLINE", "CRASH", "TIMEOUT", "PARSE_ERROR", "UNKNOWN"}
        and all(state in schema_text for state in expected_states),
        "majority_vote_is_never_used": catalog["policy"]["majority_vote"] is False
        and all(row["majority_vote_used"] is False for row in [*results.values(), probe])
        and all(row["policy"]["majority_vote_used"] is False for row in evidence.values()),
        "regression_candidates_bind_expected_outcome_evidence": all(
            row["regression_candidate"]
            and row["regression_status"] == "EXPECTED_OUTCOME_ESTABLISHED_WITH_UNRESOLVED_DISAGREEMENT"
            and row["expected_evidence"]["sha256"]
            == sha256_file(ROOT / row["expected_evidence"]["path"])
            for row in results.values()
        ),
        "regression_candidate_manifest_is_mechanically_gated": regression_validator.is_valid(regression_manifest)
        and regression_manifest["status"] == "READY"
        and len(regression_manifest["candidates"]) == len(CASES)
        and all(
            candidate["expected_outcome"] == "REJECT"
            and candidate["status"] == "EXPECTED_OUTCOME_ESTABLISHED_WITH_UNRESOLVED_DISAGREEMENT"
            and candidate["expected_evidence"]["sha256"]
            == sha256_file(ROOT / candidate["expected_evidence"]["path"])
            and candidate["cross_validation"]["sha256"]
            == sha256_file(ROOT / candidate["cross_validation"]["path"])
            for candidate in regression_manifest["candidates"]
        ),
        "milestone4_remains_valid_after_metadata_preserving_minimization": m4["status"] == "PASS"
        and all(m4["checks"].values())
        and inspect_export_metadata_present(minimized["artifact"]["metadata"]),
    }
    existing = load(args.output) if args.output.exists() else {}
    snapshot = {
        "schema_version": 1,
        "snapshot": "milestone-5",
        "created_at": existing.get("created_at", datetime.now(timezone.utc).isoformat()),
        "status": "PASS" if all(checks.values()) else "FAIL",
        "checks": checks,
        "cases": {case: f"results/cross-validation/{case}/results.json" for case in CASES},
        "parse_probe": "results/cross-validation/malformed-object-probe/results.json",
        "validator_inventory": "results/cross-validation/validator-inventory.json",
        "regression_candidates": str(regression_manifest_path.relative_to(ROOT)),
        "measurements": {
            "validators": len(inventory["validators"]),
            "implementation_families": len({row["implementation_family"] for row in inventory["validators"]}),
            "semantic_cases": len(results),
            "semantic_disagreements": sum(row["classification"] == "CHECKER_DISAGREEMENT" for row in results.values()),
            "parse_behavior_disagreements": probe["classification"] == "CHECKER_DISAGREEMENT",
            "expected_outcomes_established": sum(row["status"] == "ESTABLISHED" for row in evidence.values()),
            "regression_candidates_with_unresolved_disagreement": sum(row["regression_candidate"] for row in results.values()),
        },
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(snapshot, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(snapshot, indent=2, sort_keys=True))
    return 0 if snapshot["status"] == "PASS" else 1


def inspect_export_metadata_present(metadata: dict) -> bool:
    return (
        metadata.get("format_version") == "3.1.0"
        and metadata.get("exporter_version") == "3.1.0"
        and metadata.get("lean_version") == "4.29.1"
    )


if __name__ == "__main__":
    raise SystemExit(main())
