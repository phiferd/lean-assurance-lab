#!/usr/bin/env python3
"""Validate available Stage-2 tooling, artifacts, manifests, and evidence."""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import acceptance_impact_stage2 as stage2  # noqa: E402

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--require-committed", action="store_true")
args = parser.parse_args()
try:
    print(json.dumps(stage2.validate_available(
        ROOT, require_commit=args.require_committed), sort_keys=True))
except (OSError, ValueError) as error:
    print("Stage-2 validation failed: " + str(error), file=sys.stderr)
    raise SystemExit(2)
