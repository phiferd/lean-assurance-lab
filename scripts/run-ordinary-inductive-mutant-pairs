#!/usr/bin/env python3
"""Evaluate ordinary-inductive candidate/control pairs against omission mutants."""

from __future__ import annotations

import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from nanoda_differential import DifferentialSession, sha256_file  # noqa: E402


CASES = (
    ("classic-negative", "nanoda-0005"),
    ("reducible-hidden-negative", "nanoda-0005"),
    ("constructor-result-params", "nanoda-0006"),
)


def artifact(case_id: str, role: str) -> Path:
    return ROOT / "corpus" / "generated" / f"ordinary-inductive-{case_id}-{role}.ndjson"


def main() -> int:
    sessions: dict[str, DifferentialSession] = {}
    rows = []
    try:
        for case_id, mutant_id in CASES:
            session = sessions.get(mutant_id)
            if session is None:
                session = DifferentialSession(mutant_id, timeout=300.0)
                session.prepare()
                sessions[mutant_id] = session
            candidate_path = artifact(case_id, "candidate")
            control_path = artifact(case_id, "control")
            candidate = session.evaluate(candidate_path)
            control = session.evaluate(control_path)
            if candidate["baseline"]["normalized_outcome"] != "REJECT":
                raise RuntimeError(f"baseline did not reject {case_id}")
            if {control["baseline"]["normalized_outcome"], control["mutant"]["normalized_outcome"]} != {"ACCEPT"}:
                raise RuntimeError(f"control failed for {case_id}")
            classification = (
                "KILLED_BY_CANDIDATE" if candidate["different"]
                else "SURVIVED_EXACT_CANDIDATE"
            )
            rows.append({
                "case_id": case_id,
                "mutant_id": mutant_id,
                "classification": classification,
                "candidate": {"path": str(candidate_path.relative_to(ROOT)), **candidate},
                "control": {"path": str(control_path.relative_to(ROOT)), **control},
            })
    finally:
        for session in sessions.values():
            session.close()

    report = {
        "schema_version": 1,
        "status": "PASS",
        "cases": rows,
        "mutations": {
            mutant_id: {
                "spec": f"mutations/{mutant_id}.json",
                "spec_sha256": sha256_file(ROOT / "mutations" / f"{mutant_id}.json"),
                "preparation": sessions[mutant_id].preparation,
            }
            for mutant_id in sessions
        },
    }
    output = ROOT / "results" / "investigations" / "nanoda-ordinary-inductive" / "mutation-sensitivity.json"
    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps({
        "cases": [{"case_id": row["case_id"], "classification": row["classification"]} for row in rows],
        "output": str(output.relative_to(ROOT)),
        "status": report["status"],
    }, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
