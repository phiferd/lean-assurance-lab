#!/usr/bin/env python3
"""Normalize Lean Kernel Arena result JSON files to project JSONL outcomes."""

from __future__ import annotations

import argparse
import json
from pathlib import Path

STATUS_TO_OUTCOME = {
    "accepted": "ACCEPT",
    "rejected": "REJECT",
    "declined": "DECLINE",
    "error": "CRASH",
}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--arena-root", type=Path, default=Path("external/lean-kernel-arena"))
    parser.add_argument("--checker", required=True)
    parser.add_argument("--results-dir", type=Path)
    parser.add_argument(
        "--expected-tests-dir",
        type=Path,
        help="require result test names to exactly match built *.stats.json names",
    )
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    results_dir = args.results_dir or args.arena_root / "_results"
    if not results_dir.exists():
        raise SystemExit(f"results directory not found: {results_dir}")

    records = []
    seen_tests: dict[str, Path] = {}
    for path in sorted(results_dir.glob(f"{args.checker}_*.json")):
        data = json.loads(path.read_text(encoding="utf-8"))
        if data.get("checker") != args.checker:
            continue
        status = data.get("status", "error")
        if status not in STATUS_TO_OUTCOME:
            raise SystemExit(f"{path}: unknown Arena status {status!r}")
        outcome = STATUS_TO_OUTCOME[status]
        test = data.get("test")
        if not test:
            raise SystemExit(f"{path}: missing non-empty test name")
        if test in seen_tests:
            raise SystemExit(
                f"duplicate result for test {test!r}: {seen_tests[test]} and {path}"
            )
        seen_tests[test] = path
        records.append(
            {
                "test": test,
                "outcome": outcome,
                "checker": data.get("checker"),
                "status": status,
                "correctness": data.get("correctness"),
                "exit_code": data.get("exit_code"),
                "wall_time": data.get("wall_time"),
                "source_result": str(path),
            }
        )

    if args.expected_tests_dir:
        expected_tests = set()
        for path in args.expected_tests_dir.rglob("*.stats.json"):
            data = json.loads(path.read_text(encoding="utf-8"))
            test = data.get("name")
            if not test:
                raise SystemExit(f"{path}: missing non-empty built test name")
            if test in expected_tests:
                raise SystemExit(f"duplicate built test name: {test!r}")
            expected_tests.add(test)

        actual_tests = set(seen_tests)
        missing = sorted(expected_tests - actual_tests)
        unexpected = sorted(actual_tests - expected_tests)
        if missing or unexpected:
            raise SystemExit(
                "result inventory does not match built corpus: "
                f"expected={len(expected_tests)} actual={len(actual_tests)} "
                f"missing={missing} unexpected={unexpected}"
            )

    args.output.parent.mkdir(parents=True, exist_ok=True)
    with args.output.open("w", encoding="utf-8") as handle:
        for record in records:
            handle.write(json.dumps(record, sort_keys=True) + "\n")

    inventory = ""
    if args.expected_tests_dir:
        inventory = f"; matched {len(expected_tests)} built tests"
    print(f"Wrote {len(records)} unique records to {args.output}{inventory}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
