#!/usr/bin/env python3
"""Render the acyclic Milestone 7 declaration-validation freeze manifest."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
CATALOG_PATH = ROOT / "config" / "declaration-validation-catalog.json"
DEFAULT_OUTPUT = ROOT / "results" / "research" / "declaration-validation-milestone-7-freeze.json"

ARTIFACTS = {
    "source_lock": (
        "config/declaration-validation-source-lock.json",
        "SOURCE_AND_EVIDENCE_LOCKS",
    ),
    "evidence_lock": (
        "config/declaration-validation-evidence-locks/milestone-7.json",
        "SOURCE_AND_EVIDENCE_LOCKS",
    ),
    "evidence_lock_schema": (
        "schemas/declaration-validation-evidence-lock.schema.json",
        "SOURCE_AND_EVIDENCE_LOCKS",
    ),
    "authority_rules": (
        "config/declaration-validation-authority-rules.json",
        "AUTHORITY_QUALIFICATION_RULES",
    ),
    "catalog": (
        "config/declaration-validation-catalog.json",
        "CANONICAL_CATALOG",
    ),
    "generated_report": (
        "docs/research/DECLARATION_VALIDATION_OBLIGATIONS.md",
        "GENERATED_HUMAN_REPORT",
    ),
    "prior_identity_decisions": (
        "results/research/declaration-validation-milestone-5-decisions.json",
        "SOURCE_AND_EVIDENCE_LOCKS",
    ),
    "post_catalog_decisions": (
        "results/research/declaration-validation-catalog-decisions.json",
        "DECISION_RECORDS",
    ),
}

ATTESTATION_ORDER = [
    "SOURCE_AND_EVIDENCE_LOCKS",
    "AUTHORITY_QUALIFICATION_RULES",
    "CANONICAL_CATALOG",
    "GENERATED_HUMAN_REPORT",
    "DECISION_RECORDS",
]

DEPENDENCY_EDGES = [
    {"from": "authority_rules", "to": "source_lock"},
    {"from": "catalog", "to": "source_lock"},
    {"from": "catalog", "to": "evidence_lock"},
    {"from": "catalog", "to": "evidence_lock_schema"},
    {"from": "catalog", "to": "authority_rules"},
    {"from": "catalog", "to": "prior_identity_decisions"},
    {"from": "generated_report", "to": "catalog"},
    {"from": "generated_report", "to": "source_lock"},
    {"from": "generated_report", "to": "evidence_lock"},
    {"from": "post_catalog_decisions", "to": "catalog"},
]


def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def render() -> dict[str, Any]:
    catalog = load_json(CATALOG_PATH)
    artifacts: dict[str, dict[str, str]] = {}
    for name, (relative, tier) in ARTIFACTS.items():
        path = ROOT / relative
        artifacts[name] = {
            "path": relative,
            "sha256": sha256_file(path),
            "tier": tier,
        }
    return {
        "schema_version": 1,
        "manifest_id": "ordinary-declaration-validation.milestone-7-freeze.v1",
        "generated_at": catalog["recorded_at"],
        "status": "FROZEN_MILESTONE_7_INFRASTRUCTURE",
        "artifacts": artifacts,
        "attestation_order": ATTESTATION_ORDER,
        "dependency_edges": DEPENDENCY_EDGES,
        "acyclic": True,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(render(), indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
