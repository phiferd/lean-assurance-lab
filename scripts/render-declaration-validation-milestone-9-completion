#!/usr/bin/env python3
"""Render the declaration-validation Milestone 9 completion record."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
REVIEW_PATH = ROOT / "results" / "research" / "declaration-validation-milestone-9-adversarial-review.json"
FREEZE_PATH = ROOT / "results" / "research" / "declaration-validation-milestone-9-freeze.json"
DEFAULT_OUTPUT = ROOT / "results" / "research" / "declaration-validation-milestone-9.json"
TESTS_RUN = 153

ARTIFACTS = {
    "canonical_catalog": "config/declaration-validation-catalog.json",
    "pre_review_catalog": "results/research/declaration-validation-milestone-9-pre-review-catalog.json",
    "reviewed_catalog": "results/research/declaration-validation-milestone-9-reviewed-catalog.json",
    "adversarial_review": "results/research/declaration-validation-milestone-9-adversarial-review.json",
    "generated_catalog_report": "docs/research/DECLARATION_VALIDATION_OBLIGATIONS.md",
    "generated_review_report": "docs/research/DECLARATION_VALIDATION_MILESTONE_9_ADVERSARIAL_REVIEW.md",
    "pre_review_evidence_lock": "config/declaration-validation-evidence-locks/milestone-9-pre-review.json",
    "reviewed_evidence_lock": "config/declaration-validation-evidence-locks/milestone-9-reviewed.json",
    "m8_historical_attestation": "results/research/declaration-validation-milestone-8-historical.json",
    "review_schema": "schemas/declaration-validation-milestone-9-review.schema.json",
    "freeze_manifest": "results/research/declaration-validation-milestone-9-freeze.json",
    "freeze_schema": "schemas/declaration-validation-milestone-9-freeze.schema.json",
    "completion_schema": "schemas/declaration-validation-milestone-9.schema.json",
    "catalog_populator": "scripts/populate-declaration-validation-milestone-9",
    "review_renderer": "scripts/render-declaration-validation-milestone-9-review",
    "freeze_renderer": "scripts/render-declaration-validation-milestone-9-freeze",
    "completion_renderer": "scripts/render-declaration-validation-milestone-9-completion",
    "catalog_validator": "scripts/validate-declaration-validation-catalog",
    "historical_validator": "scripts/validate-declaration-validation-historical",
    "milestone_9_validator": "scripts/validate-declaration-validation-milestone-9",
    "historical_transition_tests": "tests/test_declaration_validation_historical_transition.py",
    "milestone_9_tests": "tests/test_declaration_validation_milestone_9.py",
    "research_plan": "docs/research/DECLARATION_VALIDATION_CONTRACT_SLICE_PLAN.md",
    "research_status": "docs/RESEARCH_STATUS.md",
}


def load(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def render() -> dict[str, Any]:
    review = load(REVIEW_PATH)
    freeze = load(FREEZE_PATH)
    return {
        "schema_version": 1,
        "milestone": "declaration-validation-contract-slice-9",
        "recorded_at": review["recorded_at"],
        "status": "PASS",
        "repository_state": {
            "head_at_milestone_start": "15c76f236b82077ba1fdb65e6b6165d5c7bdf5f1",
            "branch": "main",
            "tree_clean_at_milestone_start": True,
            "prior_milestone_attestation": "results/research/declaration-validation-milestone-8-historical.json",
        },
        "artifacts": {
            name: {"path": relative, "sha256": sha256_file(ROOT / relative)}
            for name, relative in ARTIFACTS.items()
        },
        "review_summary": freeze["review_summary"],
        "qualification_boundary": {
            "approved_normative_sources": 0,
            "approved_mechanized_sources": 0,
            "established_authority_entries": 0,
            "provisional_authority_entries": 27,
            "soundness_relevance": "NOT_ASSESSED_ONLY",
            "catalog_corrections": 0,
            "checker_consensus_establishes_normativity": False,
            "llm_judgment_is_evidence": False,
        },
        "validation": {
            "source_lock_command": "scripts/validate-declaration-validation-source-lock",
            "historical_command": "scripts/validate-declaration-validation-historical",
            "catalog_command": "scripts/validate-declaration-validation-catalog",
            "milestone_9_command": "scripts/validate-declaration-validation-milestone-9",
            "test_command": "python3 -m unittest discover -s tests -p 'test_declaration_validation_*.py'",
            "recorded_results": {
                "source_lock": "PASS",
                "historical_m7_reviewed_pilot_and_corrected_m8": "PASS",
                "canonical_reviewed_catalog": "PASS",
                "milestone_9_adversarial_review": "PASS",
                "declaration_validation_tests": {
                    "tests_run": TESTS_RUN,
                    "failures": 0,
                    "errors": 0,
                    "result": "PASS",
                },
            },
        },
        "requirements_audit": {
            "pre_review_freeze": "M8_GIT_BLOB_PREDECESSOR_PLUS_SEQUENCE_5_EVIDENCE_AND_PRE_REVIEW_CATALOG",
            "implementation_restatement": "ALL_19_NORMATIVE_CANDIDATES_REVIEWED_WITHOUT_AUTHORITY_PROMOTION",
            "kernel_export_boundary": "NORMATIVE_KERNEL_LAYER_SEPARATED_FROM_EMPIRICAL_EXPORT_AND_RECONSTRUCTION",
            "multi_layer_scenarios": "EVERY_MULTI_LAYER_SCENARIO_EXPLICIT",
            "consensus_authority": "ZERO_CONSENSUS_BASED_AUTHORITY_ASSIGNMENTS",
            "lineage": "OFFICIAL_AND_LEAN4LEAN_SHARED_LINEAGE_EXPLICIT",
            "independent_observability": "INCOMPLETE_OBSERVATION_PRESERVED_AS_NEGATIVE_RESULT",
            "duplicates": "ZERO_DUPLICATE_FROZEN_DENOTATION_HASH_GROUPS",
            "established_support": "ZERO_ESTABLISHED_ENTRIES_TO_DOWNGRADE",
            "discovery_omissions": "FROZEN_22_SOURCE_59_SITE_149_PAIR_SURFACE_EXACTLY_CLOSED",
            "exclusions": "ALL_DECLARED_EXCLUSIONS_AND_NON_ENTRY_IDENTITIES_EXPLICITLY_JUSTIFIED",
            "soundness": "ALL_27_ENTRIES_REMAIN_NOT_ASSESSED",
            "reconstruction": "M8_AND_M9_CATALOG_BYTES_REPRODUCIBLE_WITHOUT_LLM_AUTHORITY",
            "freeze_manifest": "ACYCLIC_PRE_REVIEW_REVIEWED_CATALOG_REVIEW_AND_REPORT_BINDING",
        },
        "completion_boundary": {
            "completed": "Milestone 9 adversarial review as a reproducible artifact",
            "next_authorized_milestone": "Milestone 10 — Design the next phase against the frozen inventory",
            "deferred": [
                "approval or selection of any normative authority source",
                "soundness-relevance qualification",
                "construction of the primary Arena negative-coverage denominator",
                "execution of any broad Arena coverage study",
            ],
            "nonclaims": review["nonclaims"],
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(render(), indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
