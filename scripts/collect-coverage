#!/usr/bin/env python3
"""Collect deterministic per-test Rust line coverage for nanoda."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from portable_coverage import (  # noqa: E402
    PortableCoverageError,
    VIRTUAL_CHECKER_ROOT,
    build_checker,
    build_identity,
    canonical_coverage,
    expected_source_ids,
    sha256_file,
    source_digest,
    validate_sentinel,
)


ARENA_ROOT = ROOT / "external" / "lean-kernel-arena"
CHECKER_ROOT = ARENA_ROOT / "_build" / "checkers" / "nanoda" / "src"
TEST_ROOT = ARENA_ROOT / "_build" / "tests"
BASELINE = ROOT / "results" / "baseline" / "outcomes" / "nanoda-full.jsonl"
DEFAULT_SENTINEL_TEST = "proj-of-prop"
DEFAULT_SENTINEL_LOCATION = "src/tc.rs:869"


def find_llvm_tool(name: str) -> str:
    candidates = [
        shutil.which(name),
        f"/opt/homebrew/opt/llvm@22/bin/{name}",
        f"/opt/homebrew/Cellar/llvm@22/22.1.8/bin/{name}",
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            return candidate
    raise SystemExit(f"matching LLVM tool not found: {name}")


def run(command: list[str], text: bool = False) -> subprocess.CompletedProcess:
    proc = subprocess.run(command, text=text, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if proc.returncode:
        stdout = proc.stdout or ("" if text else b"")
        stderr = proc.stderr or ("" if text else b"")
        if not text:
            stdout = stdout.decode(errors="replace")
            stderr = stderr.decode(errors="replace")
        raise SystemExit(f"command failed ({proc.returncode}): {' '.join(command)}\n{stdout}{stderr}")
    return proc


def read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line]


def load_tests(pattern: str | None) -> list[dict]:
    import fnmatch

    tests = []
    for stats_path in sorted(TEST_ROOT.rglob("*.stats.json")):
        data = json.loads(stats_path.read_text(encoding="utf-8"))
        if pattern and not fnmatch.fnmatch(data["name"], pattern):
            continue
        ndjson = stats_path.with_name(stats_path.name.replace(".stats.json", ".ndjson"))
        if not ndjson.is_file():
            raise SystemExit(f"built test has no NDJSON input: {data['name']} ({ndjson})")
        data["file"] = str(ndjson)
        tests.append(data)
    return tests


def normalize_exit(exit_code: int) -> str:
    if exit_code == 0:
        return "ACCEPT"
    if exit_code == 2:
        return "DECLINE"
    return "REJECT"


def git_output(cwd: Path, *args: str) -> str:
    return subprocess.run(
        ["git", *args], cwd=cwd, check=True, text=True, stdout=subprocess.PIPE
    ).stdout.strip()


def llvm_identity(tool: str) -> dict[str, str]:
    return {
        "name": Path(tool).name,
        "version": subprocess.check_output([tool, "--version"], text=True).strip(),
    }


def canonical_record(record: dict) -> dict:
    return {
        "test": record["test"],
        "outcome": record["outcome"],
        "exit_code": record["exit_code"],
        "covered": sorted(set(record["covered"])),
    }


def write_json(path: Path, value: object) -> None:
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--checker", default="nanoda", choices=["nanoda"])
    parser.add_argument("--test", help="optional Arena test glob")
    parser.add_argument("--reuse-build", action="store_true")
    parser.add_argument("--resume", action="store_true")
    parser.add_argument("--timeout", type=float, default=1800.0)
    parser.add_argument("--checker-threads", type=int, default=8)
    parser.add_argument("--sentinel-test", default=DEFAULT_SENTINEL_TEST)
    parser.add_argument("--sentinel-location", default=DEFAULT_SENTINEL_LOCATION)
    parser.add_argument(
        "--skip-sentinel",
        action="store_true",
        help="explicitly permit a scoped collection that omits the standard sentinel",
    )
    parser.add_argument(
        "--output-dir", type=Path, default=ROOT / "results" / "coverage" / "nanoda"
    )
    args = parser.parse_args()

    output_dir = args.output_dir.resolve()
    output_dir.mkdir(parents=True, exist_ok=True)
    records_path = output_dir / "coverage.jsonl"
    metrics_path = output_dir / "collection-metrics.json"
    state_path = output_dir / "collection-state.json"
    build_manifest_path = output_dir / "build-manifest.json"
    target_dir = CHECKER_ROOT / "target-coverage"
    binary = target_dir / "release" / "nanoda_bin"

    tests = load_tests(args.test)
    if not tests:
        raise SystemExit("no built tests selected")
    test_names = [test["name"] for test in tests]
    if not args.skip_sentinel and args.sentinel_test not in test_names:
        raise SystemExit(
            f"selected corpus omits sentinel test {args.sentinel_test!r}; "
            "include it or pass --skip-sentinel explicitly"
        )

    baseline = {row["test"]: row["outcome"] for row in read_jsonl(BASELINE)}
    missing_baseline = sorted(name for name in test_names if name not in baseline)
    if missing_baseline:
        raise SystemExit(f"tests missing from baseline outcomes: {missing_baseline}")

    base_config = json.loads((CHECKER_ROOT / "config.json").read_text(encoding="utf-8"))
    base_config["num_threads"] = args.checker_threads
    config = output_dir / "config.json"
    write_json(config, base_config)
    source_ids = expected_source_ids(CHECKER_ROOT)
    static_build_identity = build_identity(CHECKER_ROOT)
    collection_state = {
        "schema_version": 2,
        "checker": args.checker,
        "checker_threads": args.checker_threads,
        "source_sha256": source_digest(CHECKER_ROOT),
        "test_pattern": args.test,
        "build_identity": static_build_identity,
        "sentinel": None
        if args.skip_sentinel
        else {"test": args.sentinel_test, "location": args.sentinel_location},
    }
    if args.resume and state_path.exists():
        saved_state = json.loads(state_path.read_text(encoding="utf-8"))
        if saved_state != collection_state:
            raise SystemExit(
                f"resume state mismatch: saved={saved_state} current={collection_state}"
            )
    else:
        write_json(state_path, collection_state)

    llvm_profdata = find_llvm_tool("llvm-profdata")
    llvm_cov = find_llvm_tool("llvm-cov")
    build_seconds = 0.0
    if not args.reuse_build or not binary.is_file():
        started = time.monotonic()
        binary, portable_build, build_log = build_checker(CHECKER_ROOT, target_dir)
        build_seconds = time.monotonic() - started
        (output_dir / "build.log").write_text(build_log, encoding="utf-8")
        write_json(build_manifest_path, portable_build)
    else:
        if not build_manifest_path.is_file():
            raise SystemExit("--reuse-build requires build-manifest.json from a portable build")
        portable_build = json.loads(build_manifest_path.read_text(encoding="utf-8"))
        saved_static = {key: value for key, value in portable_build.items() if key != "binary"}
        if saved_static != static_build_identity:
            raise SystemExit("portable coverage build manifest does not match current inputs")
        if portable_build["binary"]["sha256"] != sha256_file(binary):
            raise SystemExit("portable coverage binary hash does not match build manifest")

    existing = (
        {row["test"]: canonical_record(row) for row in read_jsonl(records_path)}
        if args.resume
        else {}
    )
    if records_path.exists() and not args.resume:
        records_path.unlink()
    completed = dict(existing)
    metrics: dict[str, object] = {
        "schema_version": 1,
        "collected_at": datetime.now(timezone.utc).isoformat(),
        "build_seconds": build_seconds,
        "binary_logical_path": portable_build["binary"]["logical_path"],
        "llvm_cov": Path(llvm_cov).name,
        "llvm_profdata": Path(llvm_profdata).name,
        "tests": {},
    }

    with tempfile.TemporaryDirectory(prefix="nanoda-coverage-") as temp_name:
        temp = Path(temp_name)
        for index, test in enumerate(tests, 1):
            name = test["name"]
            if name in completed:
                print(f"[{index}/{len(tests)}] reuse {name}", flush=True)
                continue
            safe_name = re.sub(r"[^A-Za-z0-9_.-]+", "_", name)
            profile_pattern = temp / f"{safe_name}-%p.profraw"
            env = os.environ.copy()
            env["LLVM_PROFILE_FILE"] = str(profile_pattern)
            started = time.monotonic()
            with Path(test["file"]).open("rb") as input_handle:
                try:
                    proc = subprocess.run(
                        [str(binary), str(config)],
                        cwd=CHECKER_ROOT,
                        env=env,
                        stdin=input_handle,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE,
                        timeout=args.timeout,
                    )
                except subprocess.TimeoutExpired as exc:
                    raise SystemExit(f"coverage run timed out for {name}: {exc}") from exc
            elapsed = time.monotonic() - started
            outcome = normalize_exit(proc.returncode)
            if outcome != baseline[name]:
                raise SystemExit(
                    f"instrumented outcome mismatch for {name}: "
                    f"baseline={baseline[name]} instrumented={outcome} exit={proc.returncode}"
                )

            raw_profiles = sorted(temp.glob(f"{safe_name}-*.profraw"))
            if not raw_profiles:
                raise SystemExit(f"instrumented checker emitted no profile for {name}")
            profdata = temp / f"{safe_name}.profdata"
            run([llvm_profdata, "merge", "-sparse", *map(str, raw_profiles), "-o", str(profdata)])
            exported = run(
                [llvm_cov, "export", str(binary), f"--instr-profile={profdata}"]
            )
            try:
                export = json.loads(exported.stdout)
                embedded_root, covered = canonical_coverage(export, source_ids)
            except (json.JSONDecodeError, PortableCoverageError) as exc:
                raise SystemExit(f"coverage extraction failed for {name}: {exc}") from exc
            if embedded_root != VIRTUAL_CHECKER_ROOT:
                raise SystemExit(
                    f"coverage binary is not path-remapped: embedded root={embedded_root!r}"
                )
            record = {
                "test": name,
                "outcome": outcome,
                "exit_code": proc.returncode,
                "covered": covered,
            }
            with records_path.open("a", encoding="utf-8") as handle:
                handle.write(json.dumps(record, sort_keys=True) + "\n")
            completed[name] = record
            metrics["tests"][name] = {"wall_seconds": elapsed}
            for path in [*raw_profiles, profdata]:
                path.unlink(missing_ok=True)
            print(f"[{index}/{len(tests)}] {name}: {len(covered)} lines", flush=True)

    ordered = [canonical_record(completed[test["name"]]) for test in tests]
    records_path.write_text(
        "".join(json.dumps(record, sort_keys=True) + "\n" for record in ordered),
        encoding="utf-8",
    )
    if not args.skip_sentinel:
        try:
            validate_sentinel(ordered, args.sentinel_test, args.sentinel_location)
        except PortableCoverageError as exc:
            raise SystemExit(str(exc)) from exc

    test_to_lines = {record["test"]: record["covered"] for record in ordered}
    line_to_tests: dict[str, list[str]] = {}
    for test_name, locations in test_to_lines.items():
        for location in locations:
            line_to_tests.setdefault(location, []).append(test_name)
    for names in line_to_tests.values():
        names.sort()
    write_json(output_dir / "test-to-lines.json", test_to_lines)
    write_json(output_dir / "line-to-tests.json", line_to_tests)

    manifest = {
        "schema_version": 2,
        "checker": args.checker,
        "checker_threads": args.checker_threads,
        "test_pattern": args.test,
        "test_count": len(ordered),
        "source_file_count": len(source_ids),
        "covered_location_count": len(line_to_tests),
        "source_sha256": source_digest(CHECKER_ROOT),
        "arena_revision": git_output(ARENA_ROOT, "rev-parse", "HEAD"),
        "checker_revision": git_output(CHECKER_ROOT, "rev-parse", "HEAD"),
        "binary": portable_build["binary"],
        "build_manifest": {
            "logical_path": "build-manifest.json",
            "sha256": sha256_file(build_manifest_path),
        },
        "llvm": {
            "cov": llvm_identity(llvm_cov),
            "profdata": llvm_identity(llvm_profdata),
        },
        "source_identity": {
            "embedded_root": VIRTUAL_CHECKER_ROOT,
            "locations": "repository-relative",
        },
        "sentinel": None
        if args.skip_sentinel
        else {"test": args.sentinel_test, "location": args.sentinel_location, "passed": True},
        "operational_metrics": {
            "logical_path": "collection-metrics.json",
            "excluded_from_content_identity": True,
        },
    }
    write_json(output_dir / "manifest.json", manifest)
    metrics["run_seconds"] = sum(
        item["wall_seconds"] for item in metrics["tests"].values()
    )
    write_json(metrics_path, metrics)
    print(json.dumps(manifest, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
