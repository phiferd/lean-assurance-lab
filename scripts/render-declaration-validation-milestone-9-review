#!/usr/bin/env python3
"""Render the authored M9 adversarial-review decisions as Markdown.

The canonical JSON record is research input. This renderer never creates or
changes semantic dispositions, rationales, correction flags, or conclusions.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
RENDERER_ROLE = "PRESENTATION_ONLY"
DEFAULT_REVIEW = (
    ROOT
    / "results"
    / "research"
    / "declaration-validation-milestone-9-adversarial-review.json"
)
DEFAULT_REPORT = (
    ROOT
    / "docs"
    / "research"
    / "DECLARATION_VALIDATION_MILESTONE_9_ADVERSARIAL_REVIEW.md"
)

QUESTIONS = [
    "Which normative entries merely restate implementation checks?",
    "Which entries confuse kernel validity with export behavior?",
    "Which scenarios cross multiple layers?",
    "Which authority claims rely on implementation consensus?",
    "Which supposedly independent sources share lineage?",
    "Which entries cannot be observed independently?",
    "Which entries are duplicates?",
    "Which established entries lack sufficient normative support?",
    "Which checks in the declared discovery surface were missed?",
    "Which exclusions are poorly justified?",
    "Which soundness_relevance claims overreach the evidence?",
    "Could another researcher reconstruct the catalog without trusting the LLM?",
]


def load_review(path: Path = DEFAULT_REVIEW) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def render_markdown(review: dict[str, Any]) -> str:
    summary = review["summary"]
    baseline = review["baseline"]
    lines = [
        "# Declaration-Validation Milestone 9 Adversarial Review",
        "",
        "This report is rendered from canonical, explicitly authored review decisions. "
        "The renderer supplies no semantic disposition or rationale.",
        "",
        f"- Review status: `{review['status']}`",
        f"- Baseline commit: `{baseline['repository_head']}`",
        f"- Baseline declaration-validation tests: {baseline['tests']['tests_run']}",
        f"- Challenges completed: {summary['challenges_completed']} of "
        f"{summary['required_challenges']}",
        f"- Catalog corrections: {summary['catalog_corrections']}",
        f"- Remaining provisional entries: {summary['remaining_provisional_entries']}",
        f"- Remaining soundness states `NOT_ASSESSED`: "
        f"{summary['remaining_not_assessed_soundness']}",
        "",
        "## Review Method",
        "",
        f"- Predecessor boundary: `{review['method']['predecessor_boundary']}`",
        f"- Semantic decision origin: `{review['authorship']['semantic_decision_origin']}`",
        f"- Renderer role: `{review['authorship']['renderer_role']}`",
        f"- Semantic authority claimed by review: "
        f"`{str(review['authorship']['semantic_authority_claimed']).lower()}`",
        "",
    ]
    for index, row in enumerate(review["challenges"], start=1):
        target_count = len(row["target"]["catalog_ids"])
        surface_count = len(row["target"]["surface_ids"])
        lines.extend(
            [
                f"## {index}. {row['challenge']}",
                "",
                f"- Decision ID: `{row['id']}`",
                f"- Attack performed: {row['attack']}",
                f"- Disposition: `{row['disposition']}`",
                f"- Rationale: {row['rationale']}",
                f"- Catalog targets: {target_count}",
                f"- Surface targets: {surface_count}",
                f"- Statement hash before: `{row['statement_hash_before']}`",
                f"- Statement hash after: `{row['statement_hash_after']}`",
                f"- Correction required: `{str(row['correction_required']).lower()}`",
                "",
            ]
        )
        for item in row["evidence"]:
            lines.append(f"- Evidence `{item['artifact']}`: {item['finding']}")
        for limitation in row["limitations"]:
            lines.append(f"- Challenge limitation: {limitation}")
        lines.extend(["", "### Item-level adjudications", ""])
        for item in row["assessments"]:
            targets = ", ".join(f"`{target}`" for target in item["target_ids"])
            lines.extend(
                [
                    f"- {targets} — `{item['disposition']}`",
                    f"  - Attack: {item['attack']}",
                    f"  - Rationale: {item['rationale']}",
                ]
            )
            for limitation in item["limitations"]:
                lines.append(f"  - Limitation: {limitation}")
        lines.append("")
    lines.extend(["## Preserved Nonclaims", ""])
    lines.extend(f"- {item}" for item in review["nonclaims"])
    lines.extend(
        [
            "",
            f"Next milestone: `{review['conclusion']['next_authorized_milestone']}`",
            "",
        ]
    )
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--review", type=Path, default=DEFAULT_REVIEW)
    parser.add_argument("--report", type=Path, default=DEFAULT_REPORT)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    expected = render_markdown(load_review(args.review))
    if args.check:
        if not args.report.is_file() or args.report.read_text(encoding="utf-8") != expected:
            print("ERROR: M9 authored-review report is stale")
            return 1
        print("declaration-validation M9 authored-review report: PASS")
        return 0
    args.report.parent.mkdir(parents=True, exist_ok=True)
    args.report.write_text(expected, encoding="utf-8")
    print(args.report)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
