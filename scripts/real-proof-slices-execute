#!/usr/bin/env python3
"""Freeze and run the real-proof-slice observer matrix."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib.real_proof_slices_execute import freeze_control, freeze_execution, rss_preflight, execute  # noqa: E402

parser=argparse.ArgumentParser()
parser.add_argument("stage",choices=["freeze-control","freeze-execution","preflight","run"])
args=parser.parse_args()
actions={"freeze-control":freeze_control,"freeze-execution":freeze_execution,"preflight":rss_preflight,"run":execute}
print(json.dumps(actions[args.stage](),sort_keys=True))
