#!/usr/bin/env python3
"""Minimize an NDJSON witness while directly preserving checker distinction."""

from __future__ import annotations

import argparse
import json
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from nanoda_differential import DifferentialSession, sha256_file  # noqa: E402
from witness_search import canonical_ndjson, minimize_witness, read_ndjson  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("artifact", type=Path)
    parser.add_argument("--mutant-id", required=True)
    parser.add_argument("--witness-id", required=True)
    parser.add_argument("--max-checks", type=int, default=200)
    parser.add_argument("--timeout", type=float, default=60.0)
    parser.add_argument("--output-dir", type=Path, default=ROOT / "corpus" / "minimized")
    parser.add_argument("--metadata-dir", type=Path, default=ROOT / "results" / "witnesses")
    args = parser.parse_args()
    if not args.artifact.exists():
        parser.error(f"artifact not found: {args.artifact}")

    records = read_ndjson(args.artifact)
    args.output_dir.mkdir(parents=True, exist_ok=True)
    output = args.output_dir / f"{args.witness_id}-min.ndjson"
    with tempfile.TemporaryDirectory(prefix=f"{args.witness_id}-", dir=ROOT / "results") as temp:
        scratch = Path(temp) / "candidate.ndjson"
        with DifferentialSession(args.mutant_id, args.timeout) as session:
            original = session.evaluate(args.artifact)
            if not original["different"]:
                raise SystemExit("distinction predicate does not hold for the original artifact")
            minimized, stats = minimize_witness(records, scratch, session, args.max_checks)
            output.write_bytes(canonical_ndjson(minimized))
            final = session.evaluate(output)
            if not final["different"]:
                raise RuntimeError("final distinction predicate check failed")
            metadata = {
                "schema_version": 1,
                "witness_id": args.witness_id,
                "mutant_id": args.mutant_id,
                "status": "MINIMIZED",
                "predicate": "baseline(input) != mutant(input)",
                "input_artifact": str(args.artifact),
                "input_sha256": sha256_file(args.artifact),
                "output_artifact": str(output.relative_to(ROOT)),
                "output_sha256": sha256_file(output),
                "original_records": len(records),
                "minimized_records": len(minimized),
                "minimization": stats,
                "final_predicate_check": final,
                "checker_runs": session.checker_runs,
                "checker_seconds": session.checker_seconds,
                "created_at": datetime.now(timezone.utc).isoformat(),
            }
    metadata_path = args.metadata_dir / args.witness_id / "minimization.json"
    metadata_path.parent.mkdir(parents=True, exist_ok=True)
    metadata_path.write_text(json.dumps(metadata, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
