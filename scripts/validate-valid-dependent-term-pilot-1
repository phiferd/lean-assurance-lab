#!/usr/bin/env python3
"""Offline validation for the dependent-term preparation/execution gate."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib.valid_dependent_term_pilot import validate_execution, validate_preparation  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--preparation", action="store_true",
                        help="validate pre-construction inputs when no generated manifests exist")
    args = parser.parse_args()
    result = validate_preparation() if args.preparation else validate_execution()
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

