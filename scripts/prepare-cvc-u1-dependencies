#!/usr/bin/env python3
"""Inspect, preflight or execute the exact, bounded CVC-U1 dependency preparation."""
import argparse
import json
from pathlib import Path
import sys
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.cvc_prep import execute, preflight, validate_manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['inspect', 'preflight', 'run'])
    parser.add_argument('--manifest', required=True, type=Path)
    parser.add_argument('--resume', action='store_true')
    args = parser.parse_args()
    try:
        if args.mode == 'run':
            return execute(ROOT, args.manifest, args.resume)
        if args.resume:
            raise ValueError('--resume applies only to run')
        if args.mode == 'preflight':
            print(json.dumps(preflight(ROOT, args.manifest), sort_keys=True))
        else:
            manifest, order, _ = validate_manifest(ROOT, args.manifest)
            print(json.dumps({'item_id': manifest['item_id'], 'module_count': len(order)}))
        return 0
    except (ValueError, OSError, KeyError, json.JSONDecodeError) as error:
        print('CVC preparation refused: ' + str(error), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
