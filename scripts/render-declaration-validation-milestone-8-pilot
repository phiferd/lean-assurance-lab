#!/usr/bin/env python3
"""Render the review-only declaration-validation Milestone 8 pilot."""

from __future__ import annotations

import hashlib
import json
import subprocess
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
PILOT_PATH = ROOT / "config" / "declaration-validation-milestone-8-pilot.json"
REVIEWED_PILOT_ATTESTATION_PATH = (
    ROOT / "results" / "research" / "declaration-validation-milestone-8-pilot-reviewed-historical.json"
)
FROZEN_REVIEWED_PILOT_ATTESTATION_SHA256 = "9962738f09db162efb1c41e115e2f87415c560584fe1ba34481f18e5a5f523c4"
REPORT_PATH = ROOT / "docs" / "research" / "DECLARATION_VALIDATION_MILESTONE_8_PILOT.md"


def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def reviewed_pilot() -> tuple[dict[str, Any], dict[str, Any]]:
    """Render the exact reviewed pilot, never a mutable convenience copy."""

    if sha256_file(REVIEWED_PILOT_ATTESTATION_PATH) != FROZEN_REVIEWED_PILOT_ATTESTATION_SHA256:
        raise RuntimeError("reviewed-pilot historical attestation bytes changed")
    attestation = load_json(REVIEWED_PILOT_ATTESTATION_PATH)
    binding = attestation["pilot"]
    result = subprocess.run(
        ["git", "show", f"{binding['git_commit']}:{binding['path']}"],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        raise RuntimeError("reviewed pilot Git blob is unavailable")
    if hashlib.sha256(result.stdout).hexdigest() != binding["sha256"]:
        raise RuntimeError("reviewed pilot Git blob SHA-256 is stale")
    return json.loads(result.stdout), attestation


def row_for(entry: dict[str, Any]) -> tuple[str, str, str, str]:
    characterization = entry["characterization"]
    observations = ", ".join(
        f"{item['profile_pointer'].rsplit('/', 1)[-1]}={item['outcome']}"
        for item in entry["observer_vector"]
    )
    return (
        characterization["id"],
        characterization["kind"],
        characterization["authority"]["status"],
        observations,
    )


def render(pilot: dict[str, Any] | None = None) -> str:
    attestation: dict[str, Any] | None = None
    if pilot is None:
        pilot, attestation = reviewed_pilot()
    pilot_hash = (
        attestation["pilot"]["sha256"] if attestation is not None else sha256_file(PILOT_PATH)
    )
    lines = [
        "# Declaration Validation Milestone 8 Pilot",
        "",
        "> Generated from the immutable reviewed-pilot attestation; do not edit this report.",
        "",
        f"- Pilot ID: `{pilot['pilot_id']}`",
        f"- Status: `{pilot['status']}`",
        f"- Pilot SHA-256: `{pilot_hash}`",
        f"- Candidate entries: {len(pilot['entries'])}",
        f"- Bound authority registry: `{pilot['artifact_bindings']['approved_authority_sources']['registry_id']}`",
        f"- M4 site dispositions: {len(pilot['site_dispositions'])}",
        "",
        "This is the reviewed, historical five-entry candidate batch preserved before the complete Milestone 8 inventory. It does not change the canonical catalog status or disposition the remaining frozen identities.",
        "",
        "## Selection",
        "",
        pilot["selection"]["method"],
        "",
    ]
    for item in pilot["selection"]["coverage"]:
        lines.append(f"- {item}")
    lines.extend(["", "## Candidate Summary", "", "| Stable ID | Kind | Authority | Observer vector |", "| --- | --- | --- | --- |"])
    for entry in pilot["entries"]:
        stable_id, kind, authority, observations = row_for(entry)
        lines.append(f"| `{stable_id}` | `{kind}` | `{authority}` | `{observations}` |")

    lines.extend(["", "## Per-Entry Review Material", ""])
    for entry in pilot["entries"]:
        characterization = entry["characterization"]
        lines.extend([
            f"### `{characterization['id']}` — {characterization['name']}",
            "",
            f"- Layers: {', '.join(f'`{item}`' for item in characterization['layers'])}",
            f"- Authority: `{characterization['authority']['status']}` — {characterization['authority']['basis']['summary']}",
            f"- Lifecycle: `{characterization['lifecycle']['status']}`",
            f"- Soundness relevance: `{characterization['soundness_relevance']['status']}`",
            "- Source mappings: " + (
                ", ".join(
                    f"`{item['implementation']}` at `{item['source_file_id']}`"
                    for item in entry["source_mappings"]
                ) or "none"
            ),
            f"- Arena disposition: `{entry['arena_disposition']['disposition']}`" + (
                f" — `{entry['arena_disposition']['case_id']}` at `{entry['arena_disposition']['case_path']}`"
                if entry["arena_disposition"]["disposition"] == "LINKED"
                else f" — {entry['arena_disposition']['notes']}"
            ),
            "- Open questions: " + (
                "; ".join(item["question"] for item in characterization["unknowns"])
                or "none"
            ),
            "",
        ])

    lines.extend([
        "## M4 Implementation-Site Closure",
        "",
        "Every frozen M4 site relevant to one of these five frozen M5 identities has an explicit M8 characterization disposition. This is provenance and completeness of implementation characterization; it is not normative support.",
        "",
        "| Stable ID | M4 site | Implementation | M8 disposition |",
        "| --- | --- | --- | --- |",
    ])
    for item in pilot["site_dispositions"]:
        lines.append(
            f"| `{item['stable_identity_id']}` | `{item['site_id']}` | `{item['implementation']}` | `{item['disposition']}` |"
        )
    lines.extend([
        "",
        "The two Kiota universe-ownership sites are retained as `OBSERVED_ABSENCE`: the frozen checking path has no current-declaration ownership context/check. This is neither an enforcement mapping nor an unsoundness claim.",
        "",
        "## Authority Provenance",
        "",
        f"The repaired pilot content-binds the empty historical registry snapshot at `{pilot['artifact_bindings']['approved_authority_sources']['path']}` (SHA-256 `{pilot['artifact_bindings']['approved_authority_sources']['sha256']}`). It also preserves the pre-hardening pilot provenance record at `{pilot['predecessor_pilot']['path']}`.",
        "",
        "A future registry successor must be separately approved against its predecessor before a later catalog can bind it; this pilot neither approves a source nor selects one.",
        "",
        "## Historical Boundary",
        "",
        f"The pilot predecessor is the immutable M7 historical attestation at `{pilot['predecessor_catalog']['attestation_path']}` (SHA-256 `{pilot['predecessor_catalog']['attestation_sha256']}`), specifically its `{pilot['predecessor_catalog']['artifact']}` artifact. It does not read the mutable current catalog path.",
        "",
        f"The reviewed pilot itself is frozen through `{REVIEWED_PILOT_ATTESTATION_PATH.relative_to(ROOT)}`: its exact bytes are resolved from Git commit `{attestation['historical_commit'] if attestation is not None else 'the reviewed-pilot attestation'}` and SHA-256 `{pilot_hash}` rather than the mutable pilot path. The pre-hardening provenance record, repaired evidence-lock chain, and every other pilot input are likewise content-bound. Future M8 catalog, schema, validator, or report evolution therefore cannot re-interpret this reviewed pilot.",
        "",
    ])

    lines.extend(["## Required Review", ""])
    for item in pilot["review_requirements"]:
        lines.append(f"- {item}")
    lines.extend(["", "## Stop Boundary", "", pilot["stop_condition"], "", "## Nonclaims", ""])
    for item in pilot["nonclaims"]:
        lines.append(f"- {item}")
    lines.append("")
    return "\n".join(lines)


def main() -> int:
    REPORT_PATH.write_text(render(), encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
