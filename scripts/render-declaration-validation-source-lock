"""Render the Milestone 6 declaration-validation provenance source lock."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
TARGET_PATH = ROOT / "config" / "declaration-validation-target.json"
MODEL_PATH = ROOT / "config" / "declaration-validation-characterization-model.json"
