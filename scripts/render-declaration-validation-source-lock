def render() -> dict[str, Any]:
    target = load(TARGET_PATH)
    closure = load(CLOSURE_PATH)
    registry = load(REGISTRY_PATH)
    repository_by_key = {
        (row["repository_url"], row["revision"]): row["id"] for row in REPOSITORIES
    }
    source_files = []
    for source in closure["sources"]:
        repository_id = repository_by_key[(source["repository_url"], source["revision"])]
        tokens = LOCATOR_TOKENS.get(source["id"], [])
        source_files.append({
            "id": source["id"],
            "repository_id": repository_id,
            "path": source["path"],
            "symbol_or_range": source["inspection"]["locator"],
            "blob_sha256": source["blob_sha256"],
            "source_role": "DISCOVERY_SOURCE",
            "locator_verification": {
                "mode": "TOKENS" if tokens else "HASH_ONLY_DESCRIPTIVE_LOCATOR",
                "tokens": tokens,
            },
        })
    for file_id, repository_id, path, file_hash, role, locator, tokens in SUPPLEMENTAL_SOURCE_FILES:
        source_files.append({
            "id": file_id,
            "repository_id": repository_id,
            "path": path,
            "symbol_or_range": locator,
            "blob_sha256": file_hash,
            "source_role": role,
            "locator_verification": {
                "mode": "TOKENS" if tokens else "HASH_ONLY_DESCRIPTIVE_LOCATOR",
                "tokens": tokens,
            },
        })

    tracked_evidence = []
    for evidence_id, relative_path, pointers, role in TRACKED_EVIDENCE:
        path = ROOT / relative_path
        tracked_evidence.append({
            "id": evidence_id,
            "path": relative_path,
            "file_sha256": sha256(path),
            "json_pointer_or_case_id": pointers,
            "source_role": role,
        })

    optional_local = []
    for evidence in target["evidence_lock"]:
        if evidence["availability"] != "OPTIONAL_LOCAL_OBSERVATION":
            continue
        path = Path(evidence["path"])
        if path.is_absolute():
            continue
        optional_local.append({
            "id": evidence["id"],
            "path_hint": evidence["path"],
            "file_sha256": evidence["sha256"],
            "availability": "OPTIONAL_LOCAL_OBSERVATION",
            "source_role": evidence["role"],
            "claim_supported": evidence["claim_supported"],
        })

    witnesses = []
    identity_ids = {row["id"] for row in registry["identities"]}
    for witness_id, relative_path, origin, relevant_ids in WITNESSES:
        if not set(relevant_ids).issubset(identity_ids):
            raise ValueError(f"{witness_id}: unknown relevant identity")
        witnesses.append({
            "id": witness_id,
            "path": relative_path,
            "artifact_sha256": sha256(ROOT / relative_path),
            "generator_or_origin": origin,
            "relevant_case_id": relevant_ids,
            "source_role": "EXISTING_LAB_EVIDENCE_ONLY",
        })

    observers = []
    for profile_key, binding in OBSERVER_BINDINGS.items():
        profile = target["observer_profiles"][profile_key]
        observers.append({
            "observer": binding["observer"],
            "observer_id": profile["observer_id"],
            "lineage_group": profile["lineage_group"],
            "entrypoint_source_file_id": binding["entrypoint_source_file_id"],
            "configuration": profile["configuration"],
            "configuration_sha256": digest_json(profile["configuration"]),
            "configuration_source_file_ids": binding["configuration_source_file_ids"],
            "binary_observation_id": binding["binary_observation_id"],
        })

    return {
        "schema_version": 1,
        "lock_id": "ordinary-declaration-validation.source-lock.v1",
        "recorded_at": "2026-08-30T13:20:00-04:00",
        "status": "FROZEN_CONTENT_ADDRESSED_SOURCE_LOCK",
        "hash_semantics": {
            "blob_sha256": "SHA-256 digest of raw file content, not a Git object ID or Git blob hash.",
            "file_sha256": "SHA-256 digest of the complete local tracked file bytes.",
            "artifact_sha256": "SHA-256 digest of the complete generated witness bytes.",
            "configuration_sha256": "SHA-256 of canonical compact JSON with sorted object keys.",
        },
        "predecessors": {
            "semantic_target": {"path": str(TARGET_PATH.relative_to(ROOT)), "sha256": sha256(TARGET_PATH)},
            "characterization_model": {"path": str(MODEL_PATH.relative_to(ROOT)), "sha256": sha256(MODEL_PATH)},
            "discovery_closure": {"path": str(CLOSURE_PATH.relative_to(ROOT)), "sha256": sha256(CLOSURE_PATH)},
            "identity_registry": {"path": str(REGISTRY_PATH.relative_to(ROOT)), "sha256": sha256(REGISTRY_PATH)},
            "decision_log": {"path": str(DECISIONS_PATH.relative_to(ROOT)), "sha256": sha256(DECISIONS_PATH)},
        },
        "repositories": REPOSITORIES,
        "source_files": source_files,
        "tracked_evidence": tracked_evidence,
        "generated_witnesses": witnesses,
        "optional_local_observations": optional_local,
        "observer_configurations": observers,
        "normative_documentation": {
            "selection_status": "NONE_SELECTED_BEFORE_CATALOG_AUTHORITY_REVIEW",
            "records": [],
            "reason": "Milestone 6 provides the durable representation. No document is promoted as normative support before per-identity authority review in Milestone 8.",
        },
        "mechanized_results": {
            "selection_status": "NONE_SELECTED_BEFORE_CATALOG_AUTHORITY_REVIEW",
            "records": [],
            "reason": "No Lean4Lean or other mechanized theorem is claimed to establish the pinned declaration judgment at this milestone.",
        },
        "validation_modes": {
            "offline": {
                "command": "scripts/validate-declaration-validation-source-lock",
                "guarantees": [
                    "schema and internal-reference conformance",
                    "predecessor and tracked-evidence content hashes",
                    "generated-witness hashes and identity references",
                    "exact Milestone 4 source coverage",
                    "observer configuration digests",
                    "generated lock synchronization",
                ],
                "ignored_external_checkout_required": False,
            },
            "online": {
                "command": "scripts/validate-declaration-validation-source-lock --online",
                "guarantees": [
                    "every repository revision is fetchable as the exact pinned commit",
                    "every pinned source path has the expected raw-content SHA-256",
                    "declared locator tokens occur where token verification is enabled",
                ],
                "uses_isolated_temporary_git_repositories": True,
            },
        },
        "completion_boundary": {
            "source_lock_created": True,
            "offline_validation_supported": True,
            "online_verification_supported": True,
            "catalog_entries_created": False,
            "authority_assigned": False,
            "next_milestone": "MILESTONE_7_CANONICAL_DATA_FIRST",
        },
        "nonclaims": [
            "A source lock proves identity and content, not semantic authority or correctness.",
            "Optional local binaries are observations and are not required for fresh-process offline validation.",
            "Existing Lab witnesses are discovery inputs and do not establish isolation or negative coverage.",
            "No normative documentation or mechanized theorem is silently promoted by this lock.",
            "No ignored external checkout is an implicit dependency of offline validation.",
        ],
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(render(), indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
