#!/usr/bin/env python3
from __future__ import annotations

import argparse
import importlib.util
import subprocess
import sys
import unittest
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--generate-frozen", action="store_true")
    args = parser.parse_args()
    test_path = ROOT / "tests" / "test_metamorphic_representation.py"
    name = "test_metamorphic_representation"
    spec = importlib.util.spec_from_file_location(name, test_path)
    if spec is None or spec.loader is None:
        print(f"FAIL: cannot load {test_path}", file=sys.stderr)
        return 1
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    spec.loader.exec_module(module)
    suite = unittest.defaultTestLoader.loadTestsFromModule(module)
    count = suite.countTestCases()
    if count != 14:
        print(f"FAIL: expected exactly 14 frozen tooling cases, found {count}", file=sys.stderr)
        return 1
    result = unittest.TextTestRunner(verbosity=1).run(suite)
    if not result.wasSuccessful():
        return 1
    if args.generate_frozen:
        command = [
            str(ROOT / "scripts" / "generate-metamorphic-pilot-variants"),
            "--scientific-manifest", str(ROOT / "results" / "research" / "metamorphic-representation-pilot-1" / "scientific-manifest.json"),
            "--scientific-sha256", "0b862c93495bc0ca3bf16c836d0123ee9ebe4c13ac0aa93bbe9350e709d6e5ab",
            "--output-dir", str(ROOT / "results" / "research" / "metamorphic-representation-pilot-1" / "generated"),
            "--summary", str(ROOT / "results" / "research" / "metamorphic-representation-pilot-1" / "generation-summary.json"),
        ]
        return subprocess.run(command, cwd=ROOT, check=False).returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
