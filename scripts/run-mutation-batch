#!/usr/bin/env python3
"""Run a generated mutation batch through coverage-guided execution."""

from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def save(path: Path, manifest: dict) -> None:
    path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("batch_id")
    parser.add_argument("--resume", action="store_true")
    args = parser.parse_args()
    manifest_path = ROOT / "results" / "mutation-batches" / f"{args.batch_id}.json"
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    build_status = {
        row["mutant_id"]: row["status"]
        for row in manifest.get("build_validation", {}).get("results", [])
    }
    if not build_status:
        raise SystemExit("batch has no build validation; run scripts/validate-mutation-batch first")
    execution = manifest.setdefault(
        "execution",
        {
            "started_at": datetime.now(timezone.utc).isoformat(),
            "results": [],
        },
    )
    completed = {row["mutant_id"] for row in execution["results"]} if args.resume else set()
    if execution["results"] and not args.resume:
        raise SystemExit("batch already has execution results; use --resume")
    save(manifest_path, manifest)

    for entry in manifest["mutants"]:
        mutant_id = entry["id"]
        if build_status.get(mutant_id) != "BUILT":
            if mutant_id not in completed:
                execution["results"].append(
                    {
                        "mutant_id": mutant_id,
                        "status": "SKIPPED_BUILD_FAILURE",
                        "completed_at": datetime.now(timezone.utc).isoformat(),
                    }
                )
                save(manifest_path, manifest)
            continue
        if mutant_id in completed:
            continue
        comparison_path = ROOT / "results" / "mutants" / mutant_id / "scheduled-comparison.json"
        comparison_path.unlink(missing_ok=True)
        proc = subprocess.Popen(
            [str(ROOT / "scripts" / "run-mutant-scheduled"), mutant_id],
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        try:
            output, _ = proc.communicate()
        except KeyboardInterrupt:
            os.killpg(proc.pid, signal.SIGINT)
            proc.communicate()
            raise
        result = {
            "mutant_id": mutant_id,
            "runner_returncode": proc.returncode,
            "completed_at": datetime.now(timezone.utc).isoformat(),
        }
        if comparison_path.exists():
            result["comparison"] = json.loads(comparison_path.read_text(encoding="utf-8"))
        else:
            result["status"] = "RUNNER_FAILED"
            result["output"] = output[-4000:]
        execution["results"].append(result)
        save(manifest_path, manifest)
        print(
            json.dumps(
                {
                    "mutant_id": mutant_id,
                    "returncode": proc.returncode,
                    "status": result.get("comparison", {}).get("status", result.get("status")),
                },
                sort_keys=True,
            ),
            flush=True,
        )
        if proc.returncode != 0:
            return proc.returncode

    execution["completed_at"] = datetime.now(timezone.utc).isoformat()
    execution["status"] = "COMPLETE"
    save(manifest_path, manifest)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
