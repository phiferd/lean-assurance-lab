#!/usr/bin/env python3
"""Validate Milestone 9 adversarial review and its acyclic completion artifacts."""

from __future__ import annotations

import argparse
import copy
import hashlib
import importlib.machinery
import importlib.util
import json
import re
from collections import Counter
from pathlib import Path
from typing import Any

import jsonschema


ROOT = Path(__file__).resolve().parents[1]
CATALOG_VALIDATOR_PATH = ROOT / "scripts" / "validate-declaration-validation-catalog"
HISTORICAL_VALIDATOR_PATH = ROOT / "scripts" / "validate-declaration-validation-historical"
POPULATOR_PATH = ROOT / "scripts" / "populate-declaration-validation-milestone-9"
REVIEW_RENDERER_PATH = ROOT / "scripts" / "render-declaration-validation-milestone-9-review"
FREEZE_RENDERER_PATH = ROOT / "scripts" / "render-declaration-validation-milestone-9-freeze"
COMPLETION_RENDERER_PATH = ROOT / "scripts" / "render-declaration-validation-milestone-9-completion"
PRE_CATALOG_PATH = ROOT / "results" / "research" / "declaration-validation-milestone-9-pre-review-catalog.json"
REVIEWED_CATALOG_PATH = ROOT / "results" / "research" / "declaration-validation-milestone-9-reviewed-catalog.json"
CATALOG_PATH = ROOT / "config" / "declaration-validation-catalog.json"
REVIEW_PATH = ROOT / "results" / "research" / "declaration-validation-milestone-9-adversarial-review.json"
REVIEW_REPORT_PATH = ROOT / "docs" / "research" / "DECLARATION_VALIDATION_MILESTONE_9_ADVERSARIAL_REVIEW.md"
REVIEW_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-milestone-9-review.schema.json"
FREEZE_PATH = ROOT / "results" / "research" / "declaration-validation-milestone-9-freeze.json"
FREEZE_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-milestone-9-freeze.schema.json"
COMPLETION_PATH = ROOT / "results" / "research" / "declaration-validation-milestone-9.json"
COMPLETION_SCHEMA_PATH = ROOT / "schemas" / "declaration-validation-milestone-9.schema.json"


def load_module(name: str, path: Path) -> Any:
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"could not load {path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def document_bytes(document: dict[str, Any]) -> bytes:
    return (json.dumps(document, indent=2, sort_keys=True) + "\n").encode("utf-8")


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def schema_errors(instance: Any, schema: dict[str, Any], label: str) -> list[str]:
    validator = jsonschema.Draft202012Validator(schema, format_checker=jsonschema.FormatChecker())
    return [
        f"{label} schema error at /{'/'.join(str(part) for part in error.absolute_path)}: {error.message}"
        for error in sorted(validator.iter_errors(instance), key=lambda item: list(item.absolute_path))
    ]


def safe_relative_path(value: str) -> bool:
    path = Path(value)
    return not path.is_absolute() and ".." not in path.parts and ":" not in value


def bound_file_errors(bindings: dict[str, Any], label: str) -> list[str]:
    errors: list[str] = []
    for name, binding in bindings.items():
        relative = binding["path"]
        if not safe_relative_path(relative):
            errors.append(f"{label} {name} path is not safe and relative")
            continue
        path = ROOT / relative
        if not path.is_file():
            errors.append(f"{label} {name} artifact is missing")
        elif sha256_file(path) != binding["sha256"]:
            errors.append(f"{label} {name} artifact hash is stale")
    return errors


def cycle_errors(edges: list[dict[str, str]]) -> list[str]:
    graph: dict[str, list[str]] = {}
    for edge in edges:
        graph.setdefault(edge["from"], []).append(edge["to"])
        graph.setdefault(edge["to"], [])
    active: set[str] = set()
    done: set[str] = set()
    errors: list[str] = []

    def visit(node: str) -> None:
        if node in active:
            errors.append(f"Milestone 9 dependency graph contains a cycle at {node}")
            return
        if node in done:
            return
        active.add(node)
        for target in graph[node]:
            visit(target)
        active.remove(node)
        done.add(node)

    for node in graph:
        visit(node)
    return errors


def immutable_m8_catalog(history: Any) -> tuple[dict[str, Any] | None, list[str]]:
    attestation = history.load_json(history.M8_ATTESTATION_PATH)
    return history.historical_json(
        attestation["artifacts"]["catalog"],
        label="M9 immutable M8 catalog",
        expected_commit=history.M8_COMMIT,
    )


def inventory_projection(catalog: dict[str, Any]) -> dict[str, Any]:
    bindings = copy.deepcopy(catalog["artifact_bindings"])
    bindings.pop("evidence_lock", None)
    return {
        "artifact_bindings_except_evidence_lock": bindings,
        "id_evolution_rules": catalog["id_evolution_rules"],
        "identity_denotation_profile": catalog["identity_denotation_profile"],
        "observer_order": catalog["observer_order"],
        "entries": catalog["entries"],
        "site_dispositions": catalog["site_dispositions"],
        "existing_evidence_dispositions": catalog["existing_evidence_dispositions"],
        "identity_dispositions": catalog["identity_dispositions"],
    }


def target_hash(
    catalog: dict[str, Any], catalog_ids: list[str], surface_ids: list[str]
) -> str:
    entries = {
        row["characterization"]["id"]: hashlib.sha256(
            json.dumps(row, sort_keys=True, separators=(",", ":")).encode()
        ).hexdigest()
        for row in catalog["entries"]
    }
    dispositions = {
        row["id"]: hashlib.sha256(
            json.dumps(row, sort_keys=True, separators=(",", ":")).encode()
        ).hexdigest()
        for row in catalog["identity_dispositions"]
    }
    projection = {
        "catalog": {
            stable_id: entries.get(stable_id, dispositions.get(stable_id, "MISSING"))
            for stable_id in sorted(catalog_ids)
        },
        "surface_ids": sorted(surface_ids),
    }
    encoded = json.dumps(projection, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def projection_sha256(catalog: dict[str, Any]) -> str:
    return hashlib.sha256(document_bytes(inventory_projection(catalog))).hexdigest()


def resolve_pointer(document: Any, pointer: str) -> Any:
    node = document
    if pointer == "":
        return node
    for part in pointer.removeprefix("/").split("/"):
        part = part.replace("~1", "/").replace("~0", "~")
        node = node[int(part)] if isinstance(node, list) else node[part]
    return node


def recursive_strings(value: Any) -> set[str]:
    if isinstance(value, str):
        return {value}
    if isinstance(value, list):
        return set().union(*(recursive_strings(item) for item in value), set())
    if isinstance(value, dict):
        return set().union(*(recursive_strings(item) for item in value.values()), set())
    return set()


def catalog_artifact_errors(
    catalog_validator: Any,
    catalog: dict[str, Any],
    evidence_lock: dict[str, Any],
) -> list[str]:
    supplied_catalog = copy.deepcopy(catalog)
    approved_path = ROOT / catalog["artifact_bindings"]["approved_authority_sources"]["path"]
    supplied_catalog["artifact_bindings"]["approved_authority_sources"]["sha256"] = (
        catalog_validator.document_sha256(load_json(approved_path))
    )
    return catalog_validator.validate_artifacts(
        supplied_catalog,
        load_json(catalog_validator.CATALOG_SCHEMA_PATH),
        load_json(catalog_validator.ENTRY_SCHEMA_PATH),
        load_json(catalog_validator.AUTHORITY_PATH),
        load_json(catalog_validator.AUTHORITY_SCHEMA_PATH),
        load_json(catalog_validator.DECISIONS_PATH),
        load_json(catalog_validator.DECISIONS_SCHEMA_PATH),
        load_json(catalog_validator.TARGET_PATH),
        load_json(catalog_validator.MODEL_PATH),
        load_json(catalog_validator.IDENTITY_PATH),
        load_json(catalog_validator.SOURCE_LOCK_PATH),
        evidence_lock,
        load_json(catalog_validator.EVIDENCE_LOCK_SCHEMA_PATH),
        load_json(approved_path),
        load_json(catalog_validator.registry_schema_path(approved_path)),
        load_json(catalog_validator.PRIOR_DECISIONS_PATH),
        check_generated=False,
        enforce_milestone_boundary=True,
    )


EXPECTED_CHALLENGES = [
    ("CHALLENGE.M9.01.IMPLEMENTATION_RESTATEMENT", "Which normative entries merely restate implementation checks?"),
    ("CHALLENGE.M9.02.KERNEL_EXPORT_BOUNDARY", "Which entries confuse kernel validity with export behavior?"),
    ("CHALLENGE.M9.03.MULTI_LAYER_SCENARIOS", "Which scenarios cross multiple layers?"),
    ("CHALLENGE.M9.04.CONSENSUS_AUTHORITY", "Which authority claims rely on implementation consensus?"),
    ("CHALLENGE.M9.05.SHARED_LINEAGE", "Which supposedly independent sources share lineage?"),
    ("CHALLENGE.M9.06.INDEPENDENT_OBSERVABILITY", "Which entries cannot be observed independently?"),
    ("CHALLENGE.M9.07.DUPLICATE_IDENTITIES", "Which entries are duplicates?"),
    ("CHALLENGE.M9.08.ESTABLISHED_SUPPORT", "Which established entries lack sufficient normative support?"),
    ("CHALLENGE.M9.09.DISCOVERY_SURFACE_OMISSIONS", "Which checks in the declared discovery surface were missed?"),
    ("CHALLENGE.M9.10.EXCLUSION_JUSTIFICATION", "Which exclusions are poorly justified?"),
    ("CHALLENGE.M9.11.SOUNDNESS_OVERREACH", "Which soundness_relevance claims overreach the evidence?"),
    ("CHALLENGE.M9.12.LLM_INDEPENDENT_RECONSTRUCTION", "Could another researcher reconstruct the catalog without trusting the LLM?"),
]


def correction_errors(
    pre: dict[str, Any], reviewed: dict[str, Any], review: dict[str, Any]
) -> list[str]:
    errors: list[str] = []
    corrections = {row["decision_id"]: row for row in review["corrections"]}
    if len(corrections) != len(review["corrections"]):
        errors.append("M9 correction decision IDs are not unique")
    linked: set[str] = set()
    challenge_ids = {row["id"] for row in review["challenges"]}
    for challenge in review["challenges"]:
        decision_ids = challenge["correction_decision_ids"]
        if challenge["correction_required"] != bool(decision_ids):
            errors.append(f"{challenge['id']}: correction flag and decision links disagree")
        for decision_id in decision_ids:
            linked.add(decision_id)
            decision = corrections.get(decision_id)
            if decision is None or challenge["id"] not in decision["challenge_ids"]:
                errors.append(f"{challenge['id']}: correction decision link is unresolved")
    if linked != set(corrections):
        errors.append("M9 correction decisions are not linked exactly from challenges")

    before_projection = inventory_projection(pre)
    after_projection = inventory_projection(reviewed)
    changed = before_projection != after_projection
    if changed != bool(corrections):
        errors.append("M9 reviewed catalog change and correction trail disagree")
    if review["summary"]["catalog_corrections"] != len(corrections):
        errors.append("M9 correction summary count is stale")
    expected_before = projection_sha256(pre)
    expected_after = projection_sha256(reviewed)
    for decision in corrections.values():
        if any(challenge_id not in challenge_ids for challenge_id in decision["challenge_ids"]):
            errors.append(f"{decision['decision_id']}: unknown challenge link")
        if decision["catalog_hash_before"] != expected_before or decision["catalog_hash_after"] != expected_after:
            errors.append(f"{decision['decision_id']}: catalog before/after hash is stale")
        before = target_hash(pre, decision["target_ids"], [])
        after = target_hash(reviewed, decision["target_ids"], [])
        if decision["statement_hash_before"] != before or decision["statement_hash_after"] != after:
            errors.append(f"{decision['decision_id']}: statement before/after hash is stale")
        if before == after:
            errors.append(f"{decision['decision_id']}: correction does not change its targeted statement")
        for pointer in decision["effect_paths"]:
            try:
                old_value = resolve_pointer(pre, pointer)
                new_value = resolve_pointer(reviewed, pointer)
            except (KeyError, IndexError, TypeError, ValueError):
                errors.append(f"{decision['decision_id']}: effect path does not resolve: {pointer}")
                continue
            if old_value == new_value:
                errors.append(f"{decision['decision_id']}: effect path records no change: {pointer}")
        if any(item["artifact"] not in review["artifact_bindings"] for item in decision["evidence"]):
            errors.append(f"{decision['decision_id']}: correction evidence is unbound")
    return errors


def review_fact_errors(
    pre: dict[str, Any], reviewed: dict[str, Any], review: dict[str, Any]
) -> list[str]:
    errors: list[str] = []
    if [(row.get("id"), row.get("challenge")) for row in review["challenges"]] != EXPECTED_CHALLENGES:
        errors.append("M9 challenge IDs, order, or questions differ from the active plan")
        return errors
    active = {
        row["characterization"]["id"]: row["characterization"] for row in pre["entries"]
    }
    normative = {item_id for item_id, row in active.items() if row["kind"] == "NORMATIVE_CANDIDATE_OBLIGATION"}
    empirical = set(active) - normative
    closure = load_json(ROOT / "config" / "declaration-validation-discovery-closure.json")
    discovery_surface = {
        row["id"]
        for group in ("sources", "sites", "topics", "dependencies")
        for row in closure[group]
    }
    required_targets = {1: normative, 3: empirical, 6: set(active), 9: discovery_surface}
    for number, row in enumerate(review["challenges"], start=1):
        before = target_hash(pre, row["target"]["catalog_ids"], row["target"]["surface_ids"])
        after = target_hash(reviewed, row["target"]["catalog_ids"], row["target"]["surface_ids"])
        if row["statement_hash_before"] != before or row["statement_hash_after"] != after:
            errors.append(f"{row['id']}: statement hash does not match the targeted catalog projection")
        if not row["attack"].strip() or not row["rationale"].strip() or not row["assessments"]:
            errors.append(f"{row['id']}: authored attack, rationale, or assessments are missing")
        if any(item["artifact"] not in review["artifact_bindings"] for item in row["evidence"]):
            errors.append(f"{row['id']}: evidence references an unbound artifact")
        if number in required_targets:
            target_field = "surface_ids" if number == 9 else "catalog_ids"
            if set(row["target"][target_field]) != required_targets[number]:
                errors.append(f"{row['id']}: required complete target coverage is stale")
            assessed = {target for item in row["assessments"] for target in item["target_ids"]}
            if not required_targets[number].issubset(assessed):
                errors.append(f"{row['id']}: item-level assessment coverage is incomplete")
        if number in {2, 4, 7, 8, 10, 11}:
            required = set(row["target"]["catalog_ids"]) | set(row["target"]["surface_ids"])
            assessed = {target for item in row["assessments"] for target in item["target_ids"]}
            if not required.issubset(assessed):
                errors.append(f"{row['id']}: item-level assessment coverage is incomplete")
    lineage_targets = {
        target for item in review["challenges"][4]["assessments"] for target in item["target_ids"]
    }
    if lineage_targets != {"observer:official", "observer:lean4lean", "observer:nanoda", "observer:kiota"}:
        errors.append("M9 observer-lineage review does not cover the four frozen profiles")
    entries = [row["characterization"] for row in reviewed["entries"]]
    if any(row["authority"]["status"] != "PROVISIONAL" for row in entries):
        errors.append("M9 review found or created a non-provisional authority state")
    if any(row["soundness_relevance"]["status"] != "NOT_ASSESSED" for row in entries):
        errors.append("M9 review found or created a soundness assessment")
    errors.extend(correction_errors(pre, reviewed, review))
    return errors


def renderer_separation_errors() -> list[str]:
    source = REVIEW_RENDERER_PATH.read_text(encoding="utf-8")
    errors: list[str] = []
    for forbidden in (
        "def render(",
        "DEFAULT_OUTPUT",
        '"correction_required":',
        '"correction_decision_ids":',
        '"disposition":',
        '"rationale":',
    ):
        if forbidden in source:
            errors.append(f"M9 renderer contains semantic-decision construction token: {forbidden}")
    if "PRESENTATION_ONLY" not in source or "render_markdown" not in source:
        errors.append("M9 renderer does not declare its presentation-only role")
    populator_source = POPULATOR_PATH.read_text(encoding="utf-8")
    for forbidden in ("render_reviewed_catalog", "REVIEWED_CATALOG_PATH", "render_reviewed_evidence_lock"):
        if forbidden in populator_source:
            errors.append(f"M9 pre-review reconstructor can manufacture reviewed state: {forbidden}")
    return errors


def plan_challenge_errors() -> list[str]:
    plan = (ROOT / "docs" / "research" / "DECLARATION_VALIDATION_CONTRACT_SLICE_PLAN.md").read_text(
        encoding="utf-8"
    )
    try:
        block = plan.split("Challenge at minimum:", 1)[1].split("Each challenge receives:", 1)[0]
    except IndexError:
        return ["M9 challenge block is missing from the active plan"]
    questions = re.findall(r"^[0-9]+\. (.+)$", block, flags=re.MULTILINE)
    if questions != [question for _, question in EXPECTED_CHALLENGES]:
        return ["M9 validator challenge questions differ from the active plan"]
    return []


def review_evidence_locator_errors(
    review: dict[str, Any], catalog_validator: Any
) -> list[str]:
    errors: list[str] = []
    parsed: dict[str, Any] = {}
    known_refs = set(review["artifact_bindings"])
    for artifact, binding in review["artifact_bindings"].items():
        path = ROOT / binding["path"]
        try:
            document = parsed.setdefault(artifact, load_json(path))
        except json.JSONDecodeError:
            continue
        known_refs.update(recursive_strings(document))
    for row in review["challenges"]:
        for assessment in row["assessments"]:
            for evidence_ref in assessment["evidence_refs"]:
                if evidence_ref not in known_refs:
                    errors.append(f"{row['id']}: assessment evidence reference is unresolved: {evidence_ref}")
        for evidence in row["evidence"]:
            artifact = evidence["artifact"]
            binding = review["artifact_bindings"].get(artifact)
            if binding is None:
                continue
            path = ROOT / binding["path"]
            for locator in evidence["locators"]:
                if locator.startswith("COMMAND:"):
                    command = locator.removeprefix("COMMAND:")
                    if not command.startswith(binding["path"]):
                        errors.append(
                            f"{row['id']}: command locator is not implemented by bound artifact {artifact}"
                        )
                    continue
                if not locator.startswith("/"):
                    errors.append(f"{row['id']}: unsupported review evidence locator {locator}")
                    continue
                try:
                    document = parsed.setdefault(artifact, load_json(path))
                    catalog_validator.resolve_pointer(document, locator)
                except (json.JSONDecodeError, KeyError, TypeError, IndexError):
                    errors.append(
                        f"{row['id']}: evidence locator {locator} does not resolve in {artifact}"
                    )
    return errors


def validate_document(
    review: dict[str, Any] | None = None,
    *,
    check_generated: bool = True,
    require_completion: bool = True,
) -> list[str]:
    errors: list[str] = []
    catalog_validator = load_module("declaration_m9_catalog_validator", CATALOG_VALIDATOR_PATH)
    history = load_module("declaration_m9_historical_validator", HISTORICAL_VALIDATOR_PATH)
    populator = load_module("declaration_m9_populator", POPULATOR_PATH)
    renderer = load_module("declaration_m9_review_renderer", REVIEW_RENDERER_PATH)
    errors.extend(history.validate_m7_attestation())
    errors.extend(history.validate_reviewed_m8_pilot())
    errors.extend(history.validate_m8_attestation())
    errors.extend(history.validate_m8_attestation_predecessor_commit())
    if errors:
        return errors
    if history.M9_COMMIT is not None:
        return history.validate_m9_attestation()

    pre = load_json(PRE_CATALOG_PATH)
    reviewed = load_json(REVIEWED_CATALOG_PATH)
    current = load_json(CATALOG_PATH)
    pre_lock = load_json(populator.PRE_EVIDENCE_LOCK_PATH)
    reviewed_lock = load_json(
        ROOT / "config" / "declaration-validation-evidence-locks" / "milestone-9-reviewed.json"
    )
    review = load_json(REVIEW_PATH) if review is None else review
    errors.extend(schema_errors(review, load_json(REVIEW_SCHEMA_PATH), "Milestone 9 review"))
    if errors:
        return errors

    m8_catalog, historical_errors = immutable_m8_catalog(history)
    errors.extend(historical_errors)
    if m8_catalog is None:
        return errors
    if inventory_projection(pre) != inventory_projection(m8_catalog):
        errors.append("M9 pre-review inventory differs from immutable corrected M8 content")
    if current != reviewed:
        errors.append("current canonical catalog differs from the frozen reviewed catalog")

    chain_errors, _ = catalog_validator.validate_evidence_lock_chain(
        reviewed_lock,
        load_json(catalog_validator.EVIDENCE_LOCK_SCHEMA_PATH),
        load_json(catalog_validator.SOURCE_LOCK_PATH),
        check_git_tracking=check_generated,
    )
    errors.extend(chain_errors)
    if pre_lock["sequence"] != 5 or reviewed_lock["sequence"] != 6:
        errors.append("M9 evidence-lock sequence is not exactly 5 then 6")
    errors.extend(catalog_artifact_errors(catalog_validator, pre, pre_lock))
    errors.extend(catalog_artifact_errors(catalog_validator, reviewed, reviewed_lock))
    errors.extend(review_fact_errors(pre, reviewed, review))
    errors.extend(review_evidence_locator_errors(review, catalog_validator))
    errors.extend(renderer_separation_errors())
    errors.extend(plan_challenge_errors())

    authority_sources = load_json(ROOT / "config" / "declaration-validation-approved-authority-sources.json")
    if authority_sources["normative_documentation"] or authority_sources["mechanized_results"]:
        errors.append("M9 review changed the frozen empty authority-source boundary")
    closure = load_json(ROOT / "config" / "declaration-validation-discovery-closure.json")
    if not all(closure["completion"].get(key) for key in [
        "declared_sources_exhausted", "all_sites_disposed", "all_topics_closed", "all_dependencies_disposed"
    ]):
        errors.append("M9 missed-check review is not based on a closed discovery predecessor")
    exclusion_rows = (
        closure["exclusions"]
        + closure["scope"]["excluded_declaration_kinds"]
        + closure["scope"]["excluded_phases"]
        + [row for row in closure["dependencies"] if row["treatment"] == "EXCLUDED"]
    )
    if any(not row.get("reason") for row in exclusion_rows):
        errors.append("M9 exclusion review found an exclusion without a reason")

    if check_generated:
        expected_documents = populator.rendered_documents()
        for path, document in expected_documents.items():
            if not path.is_file() or path.read_bytes() != document_bytes(document):
                errors.append(f"M9 generated catalog artifact is stale: {path.relative_to(ROOT)}")
        if REVIEW_REPORT_PATH.read_text(encoding="utf-8") != renderer.render_markdown(review):
            errors.append("M9 adversarial-review report is not synchronized with its renderer")
        errors.extend(bound_file_errors(review["artifact_bindings"], "M9 review"))

    if require_completion:
        if not FREEZE_PATH.is_file() or not COMPLETION_PATH.is_file():
            return errors + ["Milestone 9 freeze or completion artifact is missing"]
        freeze = load_json(FREEZE_PATH)
        completion = load_json(COMPLETION_PATH)
        errors.extend(schema_errors(freeze, load_json(FREEZE_SCHEMA_PATH), "Milestone 9 freeze"))
        errors.extend(schema_errors(completion, load_json(COMPLETION_SCHEMA_PATH), "Milestone 9 completion"))
        if errors:
            return errors
        freeze_renderer = load_module("declaration_m9_freeze_renderer", FREEZE_RENDERER_PATH)
        completion_renderer = load_module("declaration_m9_completion_renderer", COMPLETION_RENDERER_PATH)
        if check_generated and FREEZE_PATH.read_bytes() != document_bytes(freeze_renderer.render()):
            errors.append("Milestone 9 freeze manifest is not synchronized with its renderer")
        if check_generated and COMPLETION_PATH.read_bytes() != document_bytes(completion_renderer.render()):
            errors.append("Milestone 9 completion record is not synchronized with its renderer")
        if check_generated:
            errors.extend(bound_file_errors(freeze["predecessor_attestations"], "M9 predecessor"))
            errors.extend(bound_file_errors(freeze["artifacts"], "M9 freeze"))
            errors.extend(bound_file_errors(completion["artifacts"], "M9 completion"))
        errors.extend(cycle_errors(freeze["dependency_edges"]))
        if freeze["review_summary"] != review["summary"] or completion["review_summary"] != review["summary"]:
            errors.append("M9 freeze/completion review summaries disagree")
        if freeze["reviewed_catalog_sha256"] != sha256_file(REVIEWED_CATALOG_PATH):
            errors.append("M9 freeze does not bind the reviewed catalog")
        if completion["artifacts"]["freeze_manifest"]["sha256"] != sha256_file(FREEZE_PATH):
            errors.append("M9 completion does not bind the final content manifest")
        if completion["repository_state"]["head_at_milestone_start"] != history.M8_ATTESTATION_COMMIT:
            errors.append("M9 completion milestone-start commit does not bind immutable M8 attestation")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--artifacts-only", action="store_true")
    args = parser.parse_args()
    errors = validate_document(require_completion=not args.artifacts_only)
    if errors:
        for error in errors:
            print(f"ERROR: {error}")
        return 1
    print("declaration-validation Milestone 9 adversarial review: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
