#!/usr/bin/env python3
"""Staged local controls for RESOURCE-ENVELOPE-PILOT-1."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from lib.resource_envelope_construct import construct  # noqa: E402
from lib.resource_envelope_control import freeze_execution, freeze_science  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("stage", choices=("freeze-science", "freeze-execution", "construct"))
    args = parser.parse_args()
    if args.stage == "freeze-science":
        output = freeze_science()
    elif args.stage == "freeze-execution":
        output = freeze_execution()
    else:
        output = construct()
    print(json.dumps(output, sort_keys=True, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
