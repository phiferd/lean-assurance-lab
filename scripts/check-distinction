#!/usr/bin/env python3
"""Exit successfully exactly when baseline and mutant normalized outcomes differ."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from nanoda_differential import DifferentialSession  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("mutant_id")
    parser.add_argument("artifact", type=Path)
    parser.add_argument("--timeout", type=float, default=60.0)
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    with DifferentialSession(args.mutant_id, args.timeout) as session:
        result = session.evaluate(args.artifact)
        result["mutant_id"] = args.mutant_id
        result["predicate"] = "baseline(input) != mutant(input)"
        result["preparation"] = session.preparation
    text = json.dumps(result, indent=2, sort_keys=True) + "\n"
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(text, encoding="utf-8")
    else:
        print(text, end="")
    return 0 if result["different"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
