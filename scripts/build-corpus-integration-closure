#!/usr/bin/env python3
"""Validate and render the bounded corpus-integration closure successor.

This consumes recorded evidence only.  It has no process, network, checker, or
external-action capability.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
BASE = "results/investigations/corpus-integration-2026-09-05"
PACKET = BASE + "/decision-packet.json"
PREDECESSOR = BASE + "/predecessor-actions.json"
ACTIONS = "results/action-recommendations/current.json"
REPORT = "docs/research/CORPUS_INTEGRATION_AND_WITNESS_ADMISSION_REPORT.md"
DRAFT = BASE + "/drafts/arena-reducible-positivity.md"
FOLLOWTHROUGH = BASE + "/external-actions.json"
PREDECESSOR_ACTIONS_SHA256 = "e284a5e336189e04c56944f2bb305681ebbee0d643aa29520c305233970837d9"
WITNESSES = ("nanoda-gen-f19ffc8a2e9b", "nanoda-gen-21ef4d1d32a1")


def read(path: str) -> dict:
    return json.loads((ROOT / path).read_text(encoding="utf-8"))


def bind(path: str) -> dict:
    payload = (ROOT / path).read_bytes()
    return {"path": path, "sha256": hashlib.sha256(payload).hexdigest(), "bytes": len(payload)}


def verify(row: dict) -> None:
    actual = bind(row["path"])
    if actual["sha256"] != row.get("sha256") or ("bytes" in row and actual["bytes"] != row["bytes"]):
        raise ValueError("bound input changed: " + row["path"])


def predecessor_actions() -> tuple[dict, str]:
    archive = ROOT / PREDECESSOR
    if archive.exists():
        text = archive.read_text(encoding="utf-8")
    else:
        text = (ROOT / ACTIONS).read_text(encoding="utf-8")
    if hashlib.sha256(text.encode()).hexdigest() != PREDECESSOR_ACTIONS_SHA256:
        raise ValueError("action register is not the bound predecessor")
    return json.loads(text), text


def validate_integration() -> dict:
    result = read(BASE + "/result.json")
    if (result.get("status"), result.get("build_test_invocations"), result.get("checker_launches"), result.get("toolchain_downloads"), result.get("checkout_clean_after"), result.get("external_actions")) != ("PASS", 2, 0, 0, True, False):
        raise ValueError("Arena integration bounds changed")
    if result.get("active_seconds", 121) > 120 or result["arena"].get("revision") != "abc55357aee17c59dfdbf39c8a2e19739e23dd10":
        raise ValueError("Arena integration identity changed")
    verify(result["governing_plan"])
    for item in ("harness", "official_profile", "test_schema"):
        verify(result["arena"][item])
    expected = {"proof-parameter-uniformity": ("accept", "either"), "reducible-hidden-positivity": ("accept", "reject")}
    if [pair["pair_id"] for pair in result.get("pairs", [])] != list(expected):
        raise ValueError("Arena package selection changed")
    for pair in result["pairs"]:
        if pair["status"] != "PASS" or pair["returncode"] != 0 or pair["checker_launches"] != 0 or pair["active_seconds"] > pair["maximum_seconds"] or pair["maximum_seconds"] > 120:
            raise ValueError("Arena package build result is not bounded")
        verify(pair["log"])
        for built in pair["built"]:
            # Built paths are relative to the isolated checkout and retain a
            # hash in the recorded result; package bytes provide the portable binding.
            if len(built.get("sha256", "")) != 64:
                raise ValueError("Arena built artifact binding malformed")
        package = pair["package"]
        if [(row["role"], row["expected_outcome"]) for row in package] != [("control", expected[pair["pair_id"]][0]), ("candidate", expected[pair["pair_id"]][1])]:
            raise ValueError("Arena package outcome contract changed")
        for row in package:
            for key in ("artifact", "definition", "source"):
                verify(row[key])
            if row["artifact"]["sha256"] != row["source"]["sha256"]:
                raise ValueError("Arena package is not an exact source copy")
    return result


def validate_tutorial() -> dict:
    request = read("results/research/evidence/corpus-integration-arena-tutorial/request.json")
    if request.get("status") != "COMPLETE" or request.get("method") != "GET" or request.get("external_mutations") != 0:
        raise ValueError("current Arena tutorial retrieval is not a completed GET-only record")
    verify(request["response"]); verify(request["source"])
    tutorial = read(request["response"]["path"])
    if "abc55357aee17c59dfdbf39c8a2e19739e23dd10" not in tutorial.get("_links", {}).get("self", ""):
        raise ValueError("tutorial evidence revision changed")
    source_bytes = (ROOT / request["source"]["path"]).read_bytes()
    if base64.b64decode(tutorial["content"]) != source_bytes:
        raise ValueError("tutorial response no longer matches saved source bytes")
    source = source_bytes.decode("utf-8")
    if "let n := `indNegReducible" not in source or "dummyRecInfo n" not in source:
        raise ValueError("current related positivity tutorial content is missing")
    companion_tokens = ["lal-proof-parameter-uniformity", "lal-reducible-hidden-positivity", "LALConstType"]
    matches = [token for token in companion_tokens if token in source]
    if matches:
        raise ValueError("current Arena tutorial already contains exact companion content: " + ", ".join(matches))
    request = dict(request)
    request["duplicate_comparison"] = {
        "scope": "exact companion names and helper against the pinned current Tutorial.lean",
        "related_existing_case": "indNegReducible uses dummyRecInfo and omits the submitted pair's complete serialized recursor fixture",
        "exact_companion_matches": 0,
        "searched_tokens": companion_tokens,
    }
    return request


def validate_review() -> dict:
    review = read("results/research/proof-parameter-contract-review.json")
    if review.get("status") != "COMPLETE" or review.get("review_class") != "SEPARATE_ULTRA_SCIENTIFIC_REVIEW":
        raise ValueError("proof-parameter review is incomplete")
    if review["authority"].get("status") != "UNRESOLVED_FOR_UNIVERSAL_CONFORMANCE" or review["arena_recommendation"] != {"candidate": "either", "control": "accept", "external_action": False, "human_gate": "REVIEW_REQUIRED_BEFORE_SUBMISSION", "integration_status": "PASS", "purpose": "empirical characterization excluded from completeness and soundness scoring"}:
        raise ValueError("proof-parameter authority or Arena posture changed")
    for item in review["inputs"]:
        verify(item)
    return review


def validate_witnesses() -> list[dict]:
    manifest = read("corpus/augmented/manifest-v2.json")
    if manifest.get("corpus_id") != "nanoda-augmented-v2" or len(manifest.get("tests", [])) != 3:
        raise ValueError("v2 manifest is not the required successor")
    verify(manifest["predecessor"])
    rows = []
    for mutant_id in WITNESSES:
        witness = mutant_id + "-witness"
        confirmation_path = f"results/witnesses/{witness}/confirmation.json"
        confirmation = read(confirmation_path)
        if confirmation.get("mutant_id") != mutant_id or confirmation.get("status") != "CONFIRMED_OFFICIAL_PROFILE_REJECTION" or confirmation.get("classification") != "MEANINGFUL_SEMANTIC":
            raise ValueError("witness confirmation classification changed")
        if confirmation.get("budget", {}).get("launches") != 6 or confirmation["budget"].get("seconds", 121) > 120:
            raise ValueError("witness confirmation bound changed")
        if confirmation["candidate"]["path"] not in [test.get("file") for test in manifest["tests"]] or confirmation["control"]["path"] not in [test.get("control") for test in manifest["tests"]]:
            raise ValueError("witness is not admitted by manifest v2")
        for key in ("candidate", "control", "mutation_spec", "governing_plan", "authorized_triage_run"):
            verify(confirmation[key])
        if confirmation["mechanical_predicate"] != "baseline(control)==mutant(control)==ACCEPT and baseline(candidate)==REJECT and mutant(candidate)==ACCEPT and official(control)==ACCEPT and official(candidate)==REJECT":
            raise ValueError("witness predicate changed")
        rows.append({"id": mutant_id, "confirmation": bind(confirmation_path), "candidate": confirmation["candidate"], "control": confirmation["control"]})
    return rows


def validate_followthrough() -> dict:
    record = read(FOLLOWTHROUGH)
    if record.get("schema_version") != 1 or record.get("status") != "COMPLETE":
        raise ValueError("external-action follow-through is incomplete")
    if record.get("repository") != "https://github.com/leanprover/lean-kernel-arena":
        raise ValueError("external-action target changed")
    preflight = record.get("duplicate_preflight", {})
    if (preflight.get("baseline_revision"), preflight.get("latest_revision"), preflight.get("exact_pair_matches"), preflight.get("result")) != (
        "abc55357aee17c59dfdbf39c8a2e19739e23dd10", "8ae1d84e335d2381b2bfcc0dbde7fc3da8e96062", 0, "NEITHER_PAIR_ADDRESSED"
    ):
        raise ValueError("Arena duplicate preflight changed")
    if preflight.get("recent_commit", {}).get("changed_paths") != ["checkers/sokonanoda.yaml"]:
        raise ValueError("Arena recent-commit scope changed")
    decisions = record.get("decisions", {})
    expected = {
        "proof_parameter_arena_pair": (182, "codex/proof-parameter-order", "1d1e808c73f9b650a6b2f4a40ee08c7da268267e"),
        "reducible_positivity_arena_pair": (181, "codex/reducible-hidden-positivity", "1027fae9817509081cdfb9a7455eac424d0b1e4b"),
    }
    for key, (number, branch, commit) in expected.items():
        row = decisions.get(key, {})
        if (row.get("decision"), row.get("external_action"), row.get("pull_request"), row.get("branch"), row.get("commit")) != ("SUBMITTED", True, number, branch, commit):
            raise ValueError("Arena submission record changed: " + key)
        if row.get("url") != f"https://github.com/leanprover/lean-kernel-arena/pull/{number}":
            raise ValueError("Arena pull-request URL changed: " + key)
        if row.get("validation", {}).get("succeeded") != 2 or row["validation"].get("failed") != 0:
            raise ValueError("Arena submission validation changed: " + key)
    kiota = decisions.get("kiota_contract_clarification", {})
    if (kiota.get("decision"), kiota.get("external_action")) != ("DEFERRED", False):
        raise ValueError("Kiota deferral decision changed")
    return record


def no_external_action(identifier: str, target: str, rationale: str) -> dict:
    return {"id": identifier, "action": "NO_EXTERNAL_ACTION", "target": target, "priority": "LOW", "rationale": rationale, "prerequisites": [], "external_action": False, "human_gate": {"required": False, "status": "NOT_REQUIRED"}, "execution_status": "COMPLETED"}


def build() -> dict[str, str]:
    predecessor, predecessor_text = predecessor_actions()
    review = validate_review()
    integration = validate_integration()
    tutorial = validate_tutorial()
    witnesses = validate_witnesses()
    followthrough = validate_followthrough()
    findings = [
        {"id": "imax-right-successor-checker-disagreement", "disposition": "ACTION_TAKEN", "reason": "Earlier Arena corpus contribution remains recorded; this closure executes no new external action."},
        {"id": "possibly-prop-projection-overrejection", "disposition": "NO_EXTERNAL_ACTION", "reason": "Existing profile evidence and Arena policy remain non-normative; no new checker allegation follows."},
        {"id": "proof-parameter-uniformity-disagreement", "disposition": "ACTION_TAKEN", "reason": "Arena PR #182 carries the either characterization pair; the separate Kiota clarification is owner-deferred pending Arena feedback."},
        {"id": "reducible-hidden-positivity-corpus-gap", "disposition": "ACTION_TAKEN", "reason": "Arena PR #181 carries the complete-recursor positivity companion as a separate contribution."},
    ]
    triage = [{"mutant_id": row["id"], "semantic_status": "UNRESOLVED", "profile_status": "CONFIRMED_OFFICIAL_PROFILE_REJECTION", "classification": "MEANINGFUL_SEMANTIC"} for row in witnesses]
    next_steps = [
        "Monitor Arena PR #181 and PR #182; record their final upstream dispositions without treating corpus policy as semantic authority.",
        "Keep the Kiota contract clarification deferred unless Arena feedback supplies a concrete reason to reconsider it; obtain human approval before any issue is created.",
        "Do not activate a new research frontier from these submissions; use the project review to select and authorize any successor work.",
    ]
    packet = {"schema_version": 1, "status": "CORPUS_INTEGRATION_EXTERNAL_DECISIONS_RECORDED", "external_actions": True,
              "predecessor_action_register": {"path": PREDECESSOR, "sha256": PREDECESSOR_ACTIONS_SHA256, "bytes": len(predecessor_text.encode())},
              "proof_parameter_review": bind("results/research/proof-parameter-contract-review.json"),
              "arena_integration": bind(BASE + "/result.json"), "arena_tutorial_evidence": bind("results/research/evidence/corpus-integration-arena-tutorial/request.json"),
              "external_action_record": bind(FOLLOWTHROUGH),
              "arena_tutorial_comparison": tutorial["duplicate_comparison"],
              "witness_admissions": witnesses,
              "findings": findings, "triage": triage, "next_steps": next_steps,
              "limits": ["Arena outcomes are package-policy contracts, not normative semantic authority.", "The proof-parameter candidate remains an implementation-profile characterization with outcome either.", "The positivity candidate's reject outcome remains a corpus contract supported by bound evidence, not a universal semantic claim.", "This renderer consumes the recorded submissions but has no checker, network, download, or external-action capability."],
              "recorded_at": followthrough["recorded_at"]}
    packet_text = json.dumps(packet, indent=2, sort_keys=True) + "\n"
    actions = json.loads(json.dumps(predecessor))
    actions["generated_at"] = followthrough["recorded_at"]
    proof, positivity = actions["findings"][2], actions["findings"][3]
    closure_evidence = {"path": PACKET, "sha256": hashlib.sha256(packet_text.encode()).hexdigest()}
    action_evidence = lambda path: {key: value for key, value in bind(path).items() if key != "bytes"}
    proof["evidence"].extend([closure_evidence, action_evidence("results/research/proof-parameter-contract-review.json"), action_evidence(BASE + "/result.json"), action_evidence(FOLLOWTHROUGH)])
    proof["disposition"] = "ACTION_TAKEN"
    proof["summary"] = "Arena PR #182 submits the control-accept / candidate-either characterization. The separate Kiota clarification is owner-deferred pending Arena feedback; no universal rejection obligation is asserted."
    proof["recommendations"][0].update(execution_status="DEFERRED", prerequisites=["Owner deferred this issue pending Arena feedback; new approval is required before filing."], human_gate={"required": True, "status": "DECLINED"})
    proof["recommendations"][0]["rationale"] = "The owner deferred a separate Kiota clarification to avoid premature or duplicative maintainer traffic."
    proof["recommendations"][1].update(execution_status="COMPLETED", prerequisites=["completed: exact duplicate and recent-commit preflight", "completed: owner approval", "completed: Arena build-test 2 succeeded, 0 failed"], human_gate={"required": True, "status": "APPROVED"}, external_reference="https://github.com/leanprover/lean-kernel-arena/pull/182")
    proof["recommendations"][1]["rationale"] = "Submitted separately as an either characterization after the latest-upstream duplicate check found no exact match."
    positivity["disposition"] = "ACTION_TAKEN"
    positivity["evidence"].extend([closure_evidence, action_evidence(BASE + "/result.json"), action_evidence("results/research/evidence/corpus-integration-arena-tutorial/request.json"), action_evidence(FOLLOWTHROUGH)])
    positivity["summary"] = "Arena PR #181 submits the complete-recursor positivity pair separately. The candidate reject outcome remains a corpus contract supported by bound evidence, not a universal semantic claim."
    positivity["recommendations"][0].update(execution_status="COMPLETED", prerequisites=["completed: expected-outcome review", "completed: exact duplicate and recent-commit preflight", "completed: owner approval", "completed: Arena build-test 2 succeeded, 0 failed"], human_gate={"required": True, "status": "APPROVED"}, external_reference="https://github.com/leanprover/lean-kernel-arena/pull/181")
    positivity["recommendations"][0]["rationale"] = "Submitted separately after current tutorial and recent-commit checks found no exact complete serialized recursor fixture."
    if not any(item.get("id") == "positivity-no-implementation-issue" for item in positivity["recommendations"]):
        positivity["recommendations"].append(no_external_action("positivity-integration-no-checker-allegation", "All observed validators", "Static package materialization does not establish a checker defect or normative semantics."))
    for item in positivity["recommendations"]:
        if item.get("id") == "positivity-no-implementation-issue":
            item["rationale"] = "The focused Arena contribution records a corpus case without alleging a checker defect or universal semantic rule."
    draft = """# Arena PR #181 maintainer follow-up

## Replacement PR description

This adds two static exports for Lean's strict-positivity check. The rejected
case has the following shape:

```lean
def Ignore (A B : Type) : Type := A

inductive T : Type where
  | mk (f : Ignore Unit T -> T) : T
```

`Ignore Unit T` reduces to `Unit`, but the recursive type `T` still occurs as
an argument to `Ignore`. Lean therefore rejects the declaration as non-positive.
The accepted control replaces `Ignore Unit T` with `Unit`, giving the field
type `(Unit -> T) -> T`.

Both files contain the full exported inductive declaration, including valid
constructor and recursor data. This matters because Arena's related tutorial
example has placeholder recursor data and can be rejected for that independent
reason. These tests isolate the positivity check: the control has outcome
`accept`, and the version with the hidden occurrence has outcome `reject`.

Validation:

```text
python lka.py build-test 'lal-reducible-hidden-positivity-*'
Results: 2 succeeded, 0 failed
```

## Proposed maintainer reply after replacing the PR description

Yes — the original description was AI-assisted, and I should have rewritten it
in plain language before submitting it. Sorry. I replaced it with a direct
explanation of the two declarations and why the second one is rejected.
"""
    report = """# Corpus integration and witness admission closure

The two fixed Nanoda survivor witnesses are now admitted through `nanoda-augmented-v2`. Each preserves its exact candidate and control bytes, raw six-launch evidence, baseline/mutant distinction, and pinned official-profile rejection. Their classifications measure meaningful source-mutant distinctions; they do not establish universal Lean semantics.

Arena static integration at `abc55357aee17c59dfdbf39c8a2e19739e23dd10` completed two bounded `build-test` invocations with zero checker launches and zero downloads. The proof-parameter control is `accept` and candidate `either`; the complete-recursor positivity control is `accept` and candidate remains proposed `reject` subject to human expected-outcome review.

The separate proof-parameter review preserves unresolved universal authority and corrects the pair description: edited expressions are shared into the recursor. Arena PR #182 carries that pair as an `either` characterization, while Arena PR #181 separately carries the complete-recursor positivity companion. The owner deferred the Kiota clarification pending Arena feedback.
"""
    return {PREDECESSOR: predecessor_text, PACKET: packet_text, ACTIONS: json.dumps(actions, indent=2, sort_keys=True) + "\n", DRAFT: draft, REPORT: report}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--write", action="store_true")
    mode.add_argument("--check", action="store_true")
    args = parser.parse_args()
    outputs = build()
    for path, text in outputs.items():
        target = ROOT / path
        if args.write:
            target.parent.mkdir(parents=True, exist_ok=True); target.write_text(text, encoding="utf-8")
        elif not target.is_file() or target.read_text(encoding="utf-8") != text:
            raise SystemExit("stale corpus-integration closure output: " + path)
    print("PASS: corpus integration closure matches bound evidence")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
