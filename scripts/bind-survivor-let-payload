#!/usr/bin/env python3
"""Prepare or verify inert local build inputs for SURVIVOR-LET-REUSE-1."""
from __future__ import annotations
import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import survivor_let_payload as payload

parser = argparse.ArgumentParser(description=__doc__)
group = parser.add_mutually_exclusive_group(required=True)
group.add_argument("--prepare", action="store_true")
group.add_argument("--verify", action="store_true")
parser.add_argument("--require-commit", action="store_true")
args = parser.parse_args()
try:
    if args.prepare:
        payload.materialize(ROOT)
    recipe = payload.verify(ROOT, require_commit=args.require_commit)
    print(json.dumps(recipe["build"], indent=2, sort_keys=True))
except (OSError, ValueError, json.JSONDecodeError, subprocess.CalledProcessError) as error:
    print("payload binding refused: " + str(error), file=sys.stderr)
    raise SystemExit(2)
