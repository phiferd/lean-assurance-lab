#!/usr/bin/env python3
"""Build the bounded cross-checker reduction-semantics matrix."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
INVESTIGATION = ROOT / "results" / "investigations" / "nanoda-reduction-semantics"
OUTPUT = ROOT / "results" / "investigations" / "nanoda-reduction-semantics-matrix.json"
OUTPUT_MD = ROOT / "results" / "investigations" / "nanoda-reduction-semantics-matrix.md"
FAMILIES = (
    ("beta_reduction", "beta"),
    ("zeta_reduction", "zeta"),
    ("constructor_projection_reduction", "projection"),
    ("recursor_iota_reduction", "recursor"),
    ("quot_lift_reduction", "quot-lift"),
    ("quot_ind_proof_reduction", "quot-ind"),
    ("native_nat_ble_reduction", "nat-ble"),
    ("native_nat_land_reduction", "nat-land"),
)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> int:
    mutation_path = INVESTIGATION / "mutation-sensitivity.json"
    mutation = json.loads(mutation_path.read_text(encoding="utf-8"))
    sensitivity = {row["family"]: row for row in mutation["cases"]}
    rows = []
    for boundary, family in FAMILIES:
        case_id = f"reduction-semantics-{family}"
        nanoda_path = INVESTIGATION / f"{family}-nanoda.json"
        cross_path = ROOT / "results" / "cross-validation" / case_id / "results.json"
        expected_path = ROOT / "results" / "expected-outcomes" / f"{case_id}.json"
        nanoda = json.loads(nanoda_path.read_text(encoding="utf-8"))
        cross = json.loads(cross_path.read_text(encoding="utf-8"))
        validators = {
            row["checker"]: row["result"]["normalized_outcome"]
            for row in cross["validators"]
        }
        controls = {
            row["checker"]: row["positive_control"]["result"]["normalized_outcome"]
            for row in cross["validators"]
        }
        rows.append({
            "boundary": boundary,
            "case_id": case_id,
            "artifact": cross["artifact"],
            "expected_outcome": cross["expected_outcome"],
            "candidate_outcomes": {
                "nanoda_baseline": nanoda["candidate"]["result"]["normalized_outcome"],
                **validators,
            },
            "control_outcomes": {
                "nanoda_baseline": nanoda["control"]["result"]["normalized_outcome"],
                **controls,
            },
            "mutation_sensitivity": (
                {
                    "mutant_id": sensitivity[family]["mutant_id"],
                    "classification": sensitivity[family]["classification"],
                }
                if family in sensitivity else None
            ),
            "evidence": {
                "expected_outcome": str(expected_path.relative_to(ROOT)),
                "expected_outcome_sha256": digest(expected_path),
                "cross_validation": str(cross_path.relative_to(ROOT)),
                "cross_validation_sha256": digest(cross_path),
                "nanoda_pair": str(nanoda_path.relative_to(ROOT)),
                "nanoda_pair_sha256": digest(nanoda_path),
            },
        })

    by_boundary = {row["boundary"]: row for row in rows}
    checks = {
        "eight_exact_reduction_boundaries": len(rows) == 8,
        "all_candidates_are_accepted_by_all_checkers": all(
            set(row["candidate_outcomes"].values()) == {"ACCEPT"} for row in rows
        ),
        "all_controls_are_accepted_by_all_checkers": all(
            set(row["control_outcomes"].values()) == {"ACCEPT"} for row in rows
        ),
        "quot_lift_candidate_kills_dispatch_mutant": (
            by_boundary["quot_lift_reduction"]["mutation_sensitivity"]["classification"]
            == "KILLED_BY_CANDIDATE"
        ),
        "quot_ind_candidate_is_observationally_equivalent": (
            by_boundary["quot_ind_proof_reduction"]["mutation_sensitivity"]["classification"]
            == "OBSERVATIONALLY_EQUIVALENT"
        ),
        "nat_ble_candidate_survives_exact_dispatch_mutant": (
            by_boundary["native_nat_ble_reduction"]["mutation_sensitivity"]["classification"]
            == "SURVIVED_EXACT_CANDIDATE"
        ),
        "nat_land_candidate_kills_collateral_dispatch_mutant": (
            by_boundary["native_nat_land_reduction"]["mutation_sensitivity"]["classification"]
            == "KILLED_BY_CANDIDATE"
        ),
    }
    report = {
        "schema_version": 1,
        "status": "PASS" if all(checks.values()) else "FAIL",
        "checks": checks,
        "cases": rows,
        "mutation_evidence": {
            "path": str(mutation_path.relative_to(ROOT)),
            "sha256": digest(mutation_path),
        },
        "observed_rules": {
            "cross_checker": (
                "All four checkers accept the eight exact beta, zeta, projection, recursor, "
                "quotient, and native-natural reduction boundaries and their controls."
            ),
            "quot_ind_limit": (
                "The exact Quot.ind equality cannot distinguish suppression of proof-valued "
                "iota reduction because proof irrelevance identifies the two sides."
            ),
            "native_dispatch": (
                "The Nat.ble equality does not kill the mutated dispatch comparison, but a "
                "later Nat.land operation does because the mutant misclassifies it as Nat.ble."
            ),
        },
        "scope": (
            "Eight exact accept boundaries only. Agreement establishes a bounded profile, not "
            "completeness of reduction or definitional equality. Mutation sensitivity is shown "
            "only for the four explicitly linked candidate/mutant pairs."
        ),
        "recommended_action": {
            "action": "CONTINUE_INVESTIGATION",
            "target": "ordinary inductive positivity and parameter uniformity",
            "rationale": (
                "This matrix found no checker disagreement or unreported implementation defect. "
                "The next ranked source-derived family has higher semantic impact."
            ),
            "external_action": False,
        },
    }
    OUTPUT.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    lines = [
        "# Reduction Semantics Matrix",
        "",
        "| Boundary | Nanoda | Official | Kiota | Lean4Lean | Mutation sensitivity |",
        "| --- | --- | --- | --- | --- | --- |",
    ]
    for row in rows:
        outcomes = row["candidate_outcomes"]
        sensitivity_text = (
            row["mutation_sensitivity"]["classification"]
            if row["mutation_sensitivity"] else "NOT_TESTED"
        )
        lines.append(
            f"| `{row['boundary']}` | {outcomes['nanoda_baseline']} | {outcomes['official']} | "
            f"{outcomes['kiota']} | {outcomes['lean4lean']} | {sensitivity_text} |"
        )
    lines.extend([
        "",
        "All controls are accepted by all four checkers. `Quot.ind` acceptance is not a",
        "mutation kill: proof irrelevance makes suppression of its proof-valued reduction",
        "observationally indistinguishable in this checker. The native dispatch mutant is",
        "exposed by `Nat.land`, not by the exact `Nat.ble` case whose comparison it mutates.",
        "",
        "No external issue is recommended from this passing bounded matrix. The next",
        "investigation is ordinary inductive positivity and parameter uniformity.",
        "",
    ])
    OUTPUT_MD.write_text("\n".join(lines), encoding="utf-8")
    print(json.dumps({"checks": checks, "output": str(OUTPUT.relative_to(ROOT)), "status": report["status"]}, indent=2, sort_keys=True))
    return 0 if report["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
