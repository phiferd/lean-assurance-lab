            "approved_authority_source_registry_is_frozen_before_m8": True,
            "secondary_locator_metadata_establishes_checker_outcome": False,
        },
        "residual_attack_results": [
            {
                "attack_id": "FORGED_NORMATIVE_DOCUMENT_AUTHORITY",
                "baseline_at_commit": "0bee1b71fe8d49ebe6a8adb5e4193c507ea2e43a",
                "baseline_result": "VALIDATED_WITH_ZERO_ERRORS",
                "final_result": "REJECTED_UNLESS_SOURCE_IDENTITY_IS_PREAPPROVED",
                "regression_tests": [
                    "test_locally_forged_normative_document_cannot_establish_authority",
                    "test_catalog_adjudication_cannot_extend_frozen_approved_source_registry",
                    "test_locally_forged_authoritative_document_cannot_establish_authority",
                    "test_locally_forged_formal_mechanization_cannot_establish_authority"
                ]
            },
            {
                "attack_id": "FORGED_CHECKER_RESULT_ATTRIBUTION",
                "baseline_at_commit": "0bee1b71fe8d49ebe6a8adb5e4193c507ea2e43a",
                "baseline_result": "VALIDATED_WITH_ZERO_ERRORS",
                "final_result": "REJECTED_BY_STRUCTURED_RESULT_EXTRACTION",
                "regression_tests": [
                    "test_checker_outcome_cannot_be_forged_by_secondary_metadata",
                    "test_checker_outcome_cannot_be_forged_through_case_id_locator"
                ]
            },
            {
                "attack_id": "STABLE_ID_SEMANTIC_DENOTATION_DRIFT",
                "baseline_at_commit": "0bee1b71fe8d49ebe6a8adb5e4193c507ea2e43a",
                "baseline_result": "VALIDATED_WITH_ZERO_ERRORS",
                "final_result": "REJECTED_BY_CANONICAL_STRUCTURED_DENOTATION",
                "regression_tests": [
                    "test_stable_identity_rejects_applicability_or_premise_drift",
