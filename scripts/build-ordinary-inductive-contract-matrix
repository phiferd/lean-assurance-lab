#!/usr/bin/env python3
"""Build the bounded ordinary-inductive well-formedness matrix."""

from __future__ import annotations

import hashlib
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
INVESTIGATION = ROOT / "results" / "investigations" / "nanoda-ordinary-inductive"
OUTPUT = ROOT / "results" / "investigations" / "nanoda-ordinary-inductive-contract-matrix.json"
OUTPUT_MD = ROOT / "results" / "investigations" / "nanoda-ordinary-inductive-contract-matrix.md"
BOUNDARIES = (
    ("classic_strict_positivity", "classic-negative"),
    ("reducible_hidden_strict_positivity", "reducible-hidden-negative"),
    ("constructor_parameter_domain", "constructor-param-domain"),
    ("constructor_result_parameter_uniformity", "constructor-result-params"),
    ("constructor_result_universe_uniformity", "constructor-result-levels"),
    ("recursive_occurrence_excluded_from_indices", "recursive-index-occurrence"),
)
PROOF_CASE_ID = "ordinary-inductive-proof-parameter-uniformity"


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> int:
    mutation_path = INVESTIGATION / "mutation-sensitivity.json"
    mutation = json.loads(mutation_path.read_text(encoding="utf-8"))
    sensitivity = {row["case_id"]: row for row in mutation["cases"]}
    rows = []
    for boundary, family in BOUNDARIES:
        case_id = f"ordinary-inductive-{family}"
        nanoda_path = INVESTIGATION / f"{family}-nanoda.json"
        cross_path = ROOT / "results" / "cross-validation" / case_id / "results.json"
        expected_path = ROOT / "results" / "expected-outcomes" / f"{case_id}.json"
        nanoda = json.loads(nanoda_path.read_text(encoding="utf-8"))
        cross = json.loads(cross_path.read_text(encoding="utf-8"))
        validators = {
            row["checker"]: row["result"]["normalized_outcome"]
            for row in cross["validators"]
        }
        controls = {
            row["checker"]: row["positive_control"]["result"]["normalized_outcome"]
            for row in cross["validators"]
        }
        probe = sensitivity.get(family)
        rows.append({
            "boundary": boundary,
            "case_id": case_id,
            "artifact": cross["artifact"],
            "expected_outcome": cross["expected_outcome"],
            "candidate_outcomes": {
                "nanoda_baseline": nanoda["candidate"]["result"]["normalized_outcome"],
                **validators,
            },
            "control_outcomes": {
                "nanoda_baseline": nanoda["control"]["result"]["normalized_outcome"],
                **controls,
            },
            "mutation_sensitivity": (
                {
                    "mutant_id": probe["mutant_id"],
                    "classification": probe["classification"],
                }
                if probe else None
            ),
            "evidence": {
                "expected_outcome": str(expected_path.relative_to(ROOT)),
                "expected_outcome_sha256": digest(expected_path),
                "cross_validation": str(cross_path.relative_to(ROOT)),
                "cross_validation_sha256": digest(cross_path),
                "nanoda_pair": str(nanoda_path.relative_to(ROOT)),
                "nanoda_pair_sha256": digest(nanoda_path),
            },
        })

    proof_cross_path = ROOT / "results" / "cross-validation" / PROOF_CASE_ID / "results.json"
    proof_expected_path = ROOT / "results" / "expected-outcomes" / f"{PROOF_CASE_ID}.json"
    proof_diff_path = INVESTIGATION / "proof-parameter-differential.json"
    proof_control_path = INVESTIGATION / "proof-parameter-control-differential.json"
    proof_cross = json.loads(proof_cross_path.read_text(encoding="utf-8"))
    proof_diff = json.loads(proof_diff_path.read_text(encoding="utf-8"))
    proof_control = json.loads(proof_control_path.read_text(encoding="utf-8"))
    rows.append({
        "boundary": "constructor_result_proof_parameter_uniformity",
        "case_id": PROOF_CASE_ID,
        "artifact": proof_cross["artifact"],
        "expected_outcome": proof_cross["expected_outcome"],
        "candidate_outcomes": {
            "nanoda_baseline": proof_diff["baseline"]["normalized_outcome"],
            **{
                row["checker"]: row["result"]["normalized_outcome"]
                for row in proof_cross["validators"]
            },
        },
        "control_outcomes": {
            "nanoda_baseline": proof_control["baseline"]["normalized_outcome"],
            **{
                row["checker"]: row["positive_control"]["result"]["normalized_outcome"]
                for row in proof_cross["validators"]
            },
        },
        "mutation_sensitivity": {
            "mutant_id": "nanoda-0006",
            "classification": "KILLED_BY_CANDIDATE",
        },
        "evidence": {
            "expected_outcome": str(proof_expected_path.relative_to(ROOT)),
            "expected_outcome_sha256": digest(proof_expected_path),
            "cross_validation": str(proof_cross_path.relative_to(ROOT)),
            "cross_validation_sha256": digest(proof_cross_path),
            "nanoda_pair": str(proof_diff_path.relative_to(ROOT)),
            "nanoda_pair_sha256": digest(proof_diff_path),
            "nanoda_control_pair": str(proof_control_path.relative_to(ROOT)),
            "nanoda_control_pair_sha256": digest(proof_control_path),
        },
    })

    checks = {
        "seven_exact_ordinary_inductive_boundaries": len(rows) == 7,
        "nanoda_official_and_lean4lean_reject_all_candidates": all(
            row["candidate_outcomes"][checker] == "REJECT"
            for row in rows for checker in ("nanoda_baseline", "official", "lean4lean")
        ),
        "kiota_accepts_only_the_proof_parameter_candidate": (
            [row["case_id"] for row in rows if row["candidate_outcomes"]["kiota"] == "ACCEPT"]
            == [PROOF_CASE_ID]
        ),
        "all_controls_are_accepted_by_all_checkers": all(
            set(row["control_outcomes"].values()) == {"ACCEPT"} for row in rows
        ),
        "all_focused_omission_probes_survive_canonical_candidates": all(
            row["classification"] == "SURVIVED_EXACT_CANDIDATE"
            for row in sensitivity.values()
        ),
        "all_mutated_sources_are_restored": all(
            row["preparation"]["source_restored"] for row in mutation["mutations"].values()
        ) and proof_diff["restore_after"] == "changed" and proof_control["restore_after"] == "changed",
        "proof_parameter_candidate_kills_uniformity_mutant": proof_diff["status"] == "KILLED",
    }
    report = {
        "schema_version": 1,
        "status": "PASS" if all(checks.values()) else "FAIL",
        "checks": checks,
        "cases": rows,
        "mutation_evidence": {
            "path": str(mutation_path.relative_to(ROOT)),
            "sha256": digest(mutation_path),
        },
        "observed_rules": {
            "cross_checker": (
                "All four checkers reject the six canonical malformed declarations. Nanoda, "
                "official Lean, and Lean4Lean also reject the proof-parameter witness, while "
                "Kiota accepts it. Every matched control is accepted."
            ),
            "isolation_limit": (
                "The canonical Arena negatives do not isolate Nanoda's positivity or exact "
                "constructor-result parameter checks: independent isRec and reconstructed-"
                "recursor consistency checks reject the same artifacts."
            ),
            "mutation_interpretation": (
                "Survival of these omission probes is defense-in-depth evidence only; it does "
                "not establish positivity equivalence. The proof-parameter witness kills the "
                "parameter-uniformity omission at whole-checker scope."
            ),
        },
        "scope": (
            "Six canonical reject boundaries plus one source-derived proof-parameter boundary. "
            "The profile is bounded and is not a complete inductive-declaration specification."
        ),
        "recommended_action": {
            "action": "CONTINUE_INVESTIGATION",
            "target": "source-derived internally consistent positivity witness and human review of the proof-parameter external actions",
            "rationale": (
                "Parameter-uniformity isolation is complete and exposes a current Kiota "
                "disagreement; positivity remains unisolated."
            ),
            "external_action": True,
            "human_gate": "REVIEW_REQUIRED",
        },
    }
    OUTPUT.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    lines = [
        "# Ordinary Inductive Contract Matrix",
        "",
        "| Boundary | Nanoda | Official | Kiota | Lean4Lean | Mutation sensitivity |",
        "| --- | --- | --- | --- | --- | --- |",
    ]
    for row in rows:
        outcomes = row["candidate_outcomes"]
        sensitivity_text = (
            row["mutation_sensitivity"]["classification"]
            if row["mutation_sensitivity"] else "NOT_TESTED"
        )
        lines.append(
            f"| `{row['boundary']}` | {outcomes['nanoda_baseline']} | {outcomes['official']} | "
            f"{outcomes['kiota']} | {outcomes['lean4lean']} | {sensitivity_text} |"
        )
    lines.extend([
        "",
        "All controls are accepted by all four checkers. The three canonical omission",
        "probes survive their exact canonical candidates because independent `isRec` or",
        "reconstructed-recursor checks reject first or later. This is defense in depth,",
        "not evidence that positivity is equivalent. The source-derived proof-parameter",
        "candidate kills the exact parameter-uniformity omission; Kiota alone accepts it.",
        "",
        "Continue locally with an internally consistent positivity witness. A Kiota issue",
        "and Arena reject-test proposal are recommended but require human approval.",
        "",
    ])
    OUTPUT_MD.write_text("\n".join(lines), encoding="utf-8")
    print(json.dumps({"checks": checks, "output": str(OUTPUT.relative_to(ROOT)), "status": report["status"]}, indent=2, sort_keys=True))
    return 0 if report["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
