#!/usr/bin/env python3
"""Build or check the no-duplicate 9face association successor."""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib import survivor_let_association as association  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--write", action="store_true")
    group.add_argument("--check", action="store_true")
    parser.add_argument("--require-full-payload", action="store_true")
    args = parser.parse_args()
    try:
        if args.write or args.check:
            result = association.check(
                ROOT,
                write=args.write,
                require_full_payload=args.require_full_payload,
            )
            print(json.dumps(result, sort_keys=True))
        else:
            print(
                association.render(ROOT, args.require_full_payload)[association.ASSOCIATION],
                end="",
            )
    except (ValueError, OSError, json.JSONDecodeError) as error:
        print("association refused: " + str(error), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
