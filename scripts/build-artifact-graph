def attest(nodes: list[dict]) -> list[dict]:
    expected: dict[str, str | None] = {}
    pending = {draft["id"]: draft for draft in nodes}
    output = []
    while pending:
        progressed = False
        for node_id, draft in list(pending.items()):
            dependency_ids = draft["dependencies"]
            if any(dependency_id not in expected for dependency_id in dependency_ids):
                continue
            dependencies = [
                {"id": dependency_id, "expected_sha256": expected[dependency_id]}
                for dependency_id in dependency_ids
            ]
            if "locator" in draft:
                digest, _ = locator_digest(ROOT, draft["locator"])
            else:
                digest = composite_digest(dependencies, expected)
            if digest is None:
                raise SystemExit(f"cannot attest missing artifact: {node_id}")
            final = {**draft, "dependencies": dependencies, "expected_sha256": digest}
            output.append(final)
            expected[node_id] = digest
            del pending[node_id]
            progressed = True
        if not progressed:
            raise SystemExit(f"artifact dependency cycle: {sorted(pending)}")
    return output


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--output",
        type=Path,
        default=ROOT / "results" / "artifacts" / "graph.json",
    )
    args = parser.parse_args()
    nodes = attest(catalog())
    by_id = {item["id"]: item for item in nodes}
    coverage_manifest = json.loads(
        (ROOT / "results" / "coverage" / "nanoda" / "manifest.json").read_text(encoding="utf-8")
    )
    if coverage_manifest.get("schema_version", 1) >= 2:
        coverage_build_manifest = json.loads(
            (ROOT / "results" / "coverage" / "nanoda" / "build-manifest.json").read_text(
                encoding="utf-8"
            )
        )
        coverage_rustc = coverage_build_manifest["tools"]["rustc"].splitlines()[0]
    else:
        coverage_rustc = coverage_manifest["rustc"]
    graph = {
        "schema_version": 1,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "provenance": {
            "repository_revision": git_revision(ROOT),
            "arena_revision": git_revision(ROOT / "external" / "lean-kernel-arena"),
            "validator_source_sha256": by_id["validator:nanoda"]["expected_sha256"],
            "lean_versions": {
                "witness": "4.29.1",
                "official_reference": "4.33.0",
                "lean4export": "3.1.0",
                "rustc": coverage_rustc,
            },
            "mutation_specs_sha256": by_id["mutation-spec:catalog"]["expected_sha256"],
            "corpus_inventory_sha256": by_id["corpus:arena-materialized"]["expected_sha256"],
            "scripts_sha256": by_id["script:mutation-execution"]["expected_sha256"],
            "configurations_sha256": by_id["configuration:nanoda"]["expected_sha256"],
        },
        "nodes": nodes,
    }
    validate_graph(graph)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(graph, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
