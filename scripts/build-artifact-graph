#!/usr/bin/env python3
"""Attest the current LeanVerifier artifact dependency graph."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from artifact_graph import composite_digest, locator_digest, validate_graph  # noqa: E402


def node(
    node_id: str,
    artifact_type: str,
    *,
    locator: dict | None = None,
    dependencies: list[str] | None = None,
    lifecycle: str = "current",
    required: bool = False,
    notes: str = "",
    compatibility: dict | None = None,
) -> dict:
    result = {
        "id": node_id,
        "artifact_type": artifact_type,
        "lifecycle": lifecycle,
        "required_for_current_claims": required,
        "dependencies": dependencies or [],
        "notes": notes,
    }
    if locator:
        result["locator"] = locator
    if compatibility:
        result["compatibility"] = compatibility
    return result


def file(path: str) -> dict:
    return {"kind": "file", "path": path}


def files(root: str, *patterns: str) -> dict:
    return {"kind": "file_set", "root": root, "include": list(patterns), "exclude": []}


def revision(path: str) -> dict:
    return {"kind": "git_revision", "path": path}


def git_revision(path: Path) -> str:
    return subprocess.run(
        ["git", "rev-parse", "HEAD"],
        cwd=path,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    ).stdout.strip()


