        (ROOT / "results" / "mutation-batches" / "nanoda-semantic-0003.json").read_text(encoding="utf-8")
    )
    depth_batch = json.loads(
        (ROOT / "results" / "mutation-batches" / "nanoda-semantic-depth-0001.json").read_text(encoding="utf-8")
    )
    parallel_batch = json.loads(
        (ROOT / "results" / "mutation-batches" / "nanoda-semantic-parallel-0001.json").read_text(encoding="utf-8")
    )
