#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.metamorphic_pilot_runner import RunnerError, execute_manifest  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--manifest", type=Path, required=True)
    args = parser.parse_args()
    try:
        result = execute_manifest(args.manifest.resolve())
    except RunnerError as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 1
    print(json.dumps({"status": result["status"], "checker_attempts": result["checker_attempts"],
                      "process_seconds": result["process_seconds"]}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
