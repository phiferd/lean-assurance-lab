From f0375647ebac180c27898b5df7b8116ec7c7ca5d Mon Sep 17 00:00:00 2001
From: Dan Phifer <dan.phifer@gmail.com>
Date: Fri, 2 Oct 2026 20:53:12 +0000
Subject: [PATCH] test: classify malformed recursor as rejection

---
 tests/cli_verdicts.rs | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/tests/cli_verdicts.rs b/tests/cli_verdicts.rs
index 7cccb68..19afae0 100644
--- a/tests/cli_verdicts.rs
+++ b/tests/cli_verdicts.rs
@@ -47,6 +47,22 @@ fn invalid_proof_still_rejects() {
     assert!(String::from_utf8_lossy(&output.stderr).contains("REJECT:"));
 }
 
+#[test]
+fn malformed_recursor_type_is_a_proof_rejection() {
+    let output = run(
+        include_bytes!("fixtures/recursor-type-reconstruction.reject.ndjson"),
+        None,
+    );
+    assert_eq!(output.status.code(), Some(1), "{:?}", output);
+    assert!(
+        String::from_utf8_lossy(&output.stderr).contains(
+            "REJECT: recursor `LALNest.rec_1` type does not match reconstructed type"
+        ),
+        "{:?}",
+        output
+    );
+}
+
 #[test]
 fn diagnostic_cutoff_is_not_an_accept_or_reject() {
     let output = run(include_bytes!("fixtures/067_eqRec.accept.ndjson"), Some("0"));
