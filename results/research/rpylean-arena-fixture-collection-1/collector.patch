+def test_collect_arena_paths(tmpdir):
+    arena = tmpdir.ensure("tests", dir=True)
+    arena.join("flat.yaml").write("outcome: accept\n")
+    flat = arena.ensure("flat.ndjson")
+    shared = arena.ensure("corner-cases", dir=True)
+    alt = arena.ensure("other", dir=True)
+    shared.join("same.yaml").write("file: tests/corner-cases/data.ndjson\noutcome: accept\n")
+    shipped = shared.ensure("data.ndjson")
+    alt.join("same.yaml").write("leanfile: tests/other/sample.lean\noutcome: either\n")
+    built = tmpdir.ensure("_build", "tests", "other", "same.ndjson")
+    tmpdir.ensure("_build", "tests", "same.ndjson")  # Wrong basename-only match.
+    arena.join("mathlib.yaml").write("outcome: accept\n")
+    arena.ensure("mathlib.ndjson")
+    nested = ("corner-cases/same", "other/same")
+    assert _arena_cases(arena, nested) == [
+        ("flat", flat, "accept"),
+        (nested[0], shipped, "accept"),
+        (nested[1], built, "either"),
+    ]
+
