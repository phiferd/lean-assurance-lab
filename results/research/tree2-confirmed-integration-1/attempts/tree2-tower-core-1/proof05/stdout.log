theorem Tree2TowerCore.tower_core_certificate : ∀ (n d fuel : Nat),
  2 ≤ d →
    n + 3 ≤ fuel →
      inferTypeCore CheckMode.verified E fuel d (tower n) = Except.ok S ∧
        whnf CheckMode.verified E fuel d (tower n) = Except.ok (tower n) ∧
          (tower n).fvarB ≤ d ∧ Expr.looseBVarsBounded 0 (tower n) = true :=
fun n d fuel hd hf =>
  ⟨inferTypeCore_mono hf (infer_tower_at_bound n d hd),
    ⟨whnf_mono (Decidable.byContradiction fun a => tower_core_certificate._proof_1_1 n d fuel hf a)
        (whnf_tower_at_bound n d),
      ⟨Eq.mpr (id (congrArg (fun _a => _a ≤ d) (Expr.fvarB_eq (tower n))))
          (Eq.mpr (id (congrArg (fun _a => _a ≤ d) (tower_range n))) hd),
        tower_closed n⟩⟩⟩
theorem Tree2TowerCore.infer_tower_at_bound : ∀ (n d : Nat),
  2 ≤ d → inferTypeCore CheckMode.verified E (n + 3) d (tower n) = Except.ok S :=
fun n d hd =>
  Nat.recAux
    (inferTypeCore_mono (Decidable.byContradiction fun a => infer_tower_at_bound._proof_1_1 d a) (infer_X d hd))
    (fun n ih =>
      infer_list_step (tower n) d (n + 3) (Decidable.byContradiction fun a => infer_tower_at_bound._proof_1_2 d n a) ih)
    n
theorem Tree2TowerCore.whnf_tower_at_bound : ∀ (n d : Nat),
  whnf CheckMode.verified E 3 d (tower n) = Except.ok (tower n) :=
fun n d =>
  Nat.casesAuxOn (motive := fun a => n = a → whnf CheckMode.verified E 3 d (tower n) = Except.ok (tower n)) n
    (fun h => Eq.symm h ▸ whnf_mono (Decidable.byContradiction fun a => whnf_tower_at_bound._proof_1_1 a) (whnf_X d))
    (fun n_1 h => Eq.symm h ▸ whnf_list (tower n_1) d) (Eq.refl n)
theorem Tree2TowerCore.node_crest_certificate : ∀ (n d fuel : Nat),
  2 ≤ d →
    n + 4 ≤ fuel →
      inferTypeCore CheckMode.verified E fuel d (arr (tower n) X) =
        Except.ok (Expr.sort (Level.zero.succ.imax Level.zero.succ)) :=
fun n d fuel hd hf => inferTypeCore_mono hf (infer_node_crest_at_bound n d hd)
theorem Tree2TowerCore.cons_crest_certificate : ∀ (n d fuel : Nat),
  3 ≤ d →
    n + 5 ≤ fuel →
      inferTypeCore CheckMode.verified E fuel d (arr (tower n) (arr Y Y)) =
        Except.ok (Expr.sort (Level.zero.succ.imax (Level.zero.succ.imax Level.zero.succ))) :=
fun n d fuel hd hf => inferTypeCore_mono hf (infer_cons_crest_at_bound n d hd)
