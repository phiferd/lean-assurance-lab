Tree2TowerCorrespondence.representation_package (N F : Nat) (hf : N + 5 ≤ F) :
  Official.elimNested (context N) (declaration N) (N + 2) = Except.ok (target N) ∧
    PosDR (checker F) (En N) (Cn N) (N + 1) (PosJR.ctors [] [] 2 [] [A] [Tn] [X] (roots N)) ∧
      (∃ r, nestedBlockPositivity (checker F) (En N) (Cn N) [roots N] = Except.ok r) ∧
        officialRows N = List.map (List.map some) (signature N) ∧
          nativeRows N = List.map (List.map some) (signature N) ∧
            ∀ (i : Nat),
              i < N →
                (target N).types[i + 1]? = some (Tree2TowerOfficial.row N (N - i)) ∧
                  officialSlot N (auxExpr (i + 1)) = nativeSlot (some (holeAt (N - i - 1))) Y
Tree2TowerCorrespondence.allocation_frame (N i : Nat) (hi : i < N) :
  (target N).aux[i]? = some (pow (N - i) tr, freshName (i + 1)) ∧
    (target N).types[i + 1]? = some (Tree2TowerOfficial.row N (N - i)) ∧
      (holeAt (N - i - 1)).key = { cname := Ln, lvls := [Level.zero], ds := [tower (N - i - 1)] } ∧
        (holeAt (N - i - 1)).base = 2 ∧
          officialSlot N (auxExpr (i + 1)) = some (Slot.row (N - i)) ∧
            nativeSlot (some (holeAt (N - i - 1))) Y = some (Slot.row (N - i))
