Tree2TowerOfficial.official_lowering_family (N : Nat) :
  Official.elimNested (context N) (declaration N) (N + 2) = Except.ok (target N)
Tree2TowerOfficial.allocation_depth (N i : Nat) (hi : i < N) :
  (target N).aux[i]? = some (pow (N - i) tr, freshName (i + 1)) ∧
    (target N).types[i + 1]? = some (row N (N - i)) ∧
      (row N (N - i)).name = freshName (i + 1) ∧ R N (N - i) = auxExpr (i + 1)
Tree2TowerOfficial.lowering_and_native_run (N F : Nat) (hf : N + 5 ≤ F) :
  Official.elimNested (context N) (declaration N) (N + 2) = Except.ok (target N) ∧
    ∃ r, nestedBlockPositivity (checker F) (En N) (Cn N) [roots N] = Except.ok r
