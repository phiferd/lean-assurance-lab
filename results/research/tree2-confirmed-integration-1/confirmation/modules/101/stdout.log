theorem Tree2Bridge.tree2_bridge : Official.elimNested O decl 4 = Except.ok lowered ∧
  PosDR ops E C 3 (PosJR.ctors [] [] 2 [] [A] [Tn] [X] rootCs) ∧
    List.map (fun ty => List.map (row officialSlot) ty.ctors) lowered.types.toList =
        List.map (List.map some) signature ∧
      nativeRows = List.map (List.map some) signature :=
⟨official_lowering, ⟨root_derivation, row_correspondence⟩⟩
'Tree2Bridge.official_lowering' depends on axioms: [propext, Classical.choice, Quot.sound]
