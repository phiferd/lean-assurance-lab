Tree2TowerWalk.automatic_run (N F : Nat) (hf : N + 5 ≤ F) :
  ∃ r, nestedBlockPositivity (checker F) (En N) (Cn N) [roots N] = Except.ok r
Tree2TowerWalk.automatic_run_at_bound (N : Nat) :
  ∃ r, nestedBlockPositivity (checker (N + 5)) (En N) (Cn N) [roots N] = Except.ok r
