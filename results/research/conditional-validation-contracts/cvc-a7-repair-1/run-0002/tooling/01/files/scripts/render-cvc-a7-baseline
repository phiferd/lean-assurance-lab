#!/usr/bin/env python3
"""Generate or check the uncompiled A7 baseline from its reviewed declarations."""
import argparse
import json
from pathlib import Path
import sys
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from lib.cvc_a7_audit import baseline_source
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--check', action='store_true')
a = p.parse_args()
expected = ROOT / 'results/research/conditional-validation-contracts/cvc-conditional-1/baseline-expectations.json'
target = ROOT / 'research/conditional-validation-contracts/cvc-a7/Baseline.lean'
payload = baseline_source(json.loads(expected.read_text()))
if a.check:
    if target.read_bytes() != payload:
        raise SystemExit('FAIL: generated baseline drift')
else:
    target.write_bytes(payload)
print('PASS: baseline matches source-reviewed expected declarations; no Lean launch')
