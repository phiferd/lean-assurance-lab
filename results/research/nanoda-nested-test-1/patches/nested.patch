+fn punit_name<'p>(export: &ExportFile<'p>) -> NamePtr<'p> {
+    export
+        .declars
+        .iter()
+        .find_map(|(name, declar)| {
+            if matches!(declar, Declar::Inductive(_))
+                && export.with_ctx(|ctx| format!("{:?}", ctx.debug_print(*name)) == "PUnit")
+            {
+                Some(*name)
+            } else {
+                None
+            }
+        })
+        .expect("existing fixture must contain PUnit")
+}
+
+// Follow the parser's interning rules in the permanent DAG: a pointer allocated
+// in with_ctx's temporary DAG cannot be carried into check_declar's new context.
+fn reserved_const<'p>(export: &mut ExportFile<'p>) -> ExprPtr<'p> {
+    let mut name = export.dag.anonymous();
+    for component in ["_nested", "Probe"] {
+        let s = StringPtr::from(DagMarker::ExportFile, export.dag.strings.insert_full(Cow::Borrowed(component)).0);
+        let hash = crate::hash64!(crate::name::STR_HASH, name, s);
+        name = NamePtr::from(DagMarker::ExportFile, export.dag.names.insert_full(Name::Str(name, s, hash)).0);
+    }
+    let empty: Arc<[LevelPtr<'p>]> = Arc::from([]);
+    let levels = LevelsPtr::from(DagMarker::ExportFile, export.dag.uparams.insert_full(empty).0);
+    let hash = crate::hash64!(crate::expr::CONST_HASH, name, levels);
+    let expr = ExprPtr::from(DagMarker::ExportFile, export.dag.exprs.insert_full(Expr::Const { name, levels, hash }).0);
+    assert_eq!(expr.dag_marker(), DagMarker::ExportFile);
+    export.with_ctx(|ctx| {
+        assert!(matches!(ctx.read_expr(expr), Expr::Const { name: n, .. } if n == name));
+        assert!(ctx.read_levels(levels).is_empty());
+        assert_eq!(format!("{:?}", ctx.debug_print(name)), "_nested.Probe");
+        let prefix = ctx.str1("_nested");
+        assert!(ctx.has_nested_pfx(expr, prefix));
+    });
+    expr
+}
+
+fn assert_reserved_guard<'p>(export: &ExportFile<'p>, declar: &Declar<'p>, expected: &str) {
+    // Parsing and fixture construction have already succeeded outside this catch.
+    // A missing-declaration/type error after a deleted guard must fail this test.
+    let panic = catch_unwind(AssertUnwindSafe(|| export.check_declar(declar)))
+        .expect_err("reserved type must reach the namespace guard");
+    let message = panic
+        .downcast_ref::<String>()
+        .map(String::as_str)
+        .or_else(|| panic.downcast_ref::<&str>().copied())
+        .expect("string panic payload");
+    assert_eq!(message, expected);
+}
