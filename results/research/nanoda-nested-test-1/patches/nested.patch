+#[test]
+fn nested_prefix_binder_names_and_shared_dag() -> Result<(), Box<dyn Error>> {
+    test_ctx(None, |ctx| {
+        let reserved = ctx.str1("_nested");
+        let zero = ctx.zero();
+        let sort = ctx.mk_sort(zero);
+        let ignored_names = [
+            ctx.mk_pi(reserved, BinderStyle::Default, sort, sort),
+            ctx.mk_lambda(reserved, BinderStyle::Default, sort, sort),
+            ctx.mk_let(reserved, sort, sort, sort, false),
+            ctx.mk_unique(reserved, BinderStyle::Default, sort),
+            ctx.mk_var(0),
+            sort,
+        ];
+        for expr in ignored_names {
+            assert!(!ctx.has_nested_pfx(expr, reserved));
+        }
+        let name = ctx.str2("_nested", "Probe");
+        let levels = ctx.alloc_levels_slice(&[]);
+        let c = ctx.mk_const(name, levels);
+        assert_eq!(c, ctx.mk_const(name, levels));
+        let negative = ctx.mk_app(sort, sort);
+        let positive = ctx.mk_app(sort, c);
+        assert!(!ctx.has_nested_pfx(negative, reserved));
+        assert!(ctx.has_nested_pfx(positive, reserved));
+        assert!(!ctx.has_nested_pfx(negative, reserved));
+        // The positive occurrence short-circuits; it does not claim a positive
+        // memo hit. The repeated negative child above exercises shared traversal.
+        let repeated = ctx.mk_app(c, c);
+        assert!(ctx.has_nested_pfx(repeated, reserved));
+    })
+}
