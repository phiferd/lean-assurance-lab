+#[test]
+fn nested_prefix_traversal() -> Result<(), Box<dyn Error>> {
+    test_ctx(None, |ctx| {
+        let reserved = ctx.str1("_nested");
+        let binder = ctx.str1("x");
+        let ordinary = ctx.str1("Ordinary");
+        let zero = ctx.zero();
+        let sort = ctx.mk_sort(zero);
+        let levels = ctx.alloc_levels_slice(&[]);
+        // Each positive has exactly one name-bearing position to detect. The
+        // same shapes under a similar, unreserved root guard against overreach.
+        for (root, expected) in [("_nested", true), ("_nestedX", false)] {
+            let name = ctx.str2(root, "Probe");
+            let c = ctx.mk_const(name, levels);
+            let cells = [
+                ("const_root", c),
+                ("projection_name", ctx.mk_proj(name, 0, sort)),
+                ("app_fun", ctx.mk_app(c, sort)),
+                ("app_arg", ctx.mk_app(sort, c)),
+                ("pi_domain", ctx.mk_pi(binder, BinderStyle::Default, c, sort)),
+                ("pi_body", ctx.mk_pi(binder, BinderStyle::Default, sort, c)),
+                ("lambda_domain", ctx.mk_lambda(binder, BinderStyle::Default, c, sort)),
+                ("lambda_body", ctx.mk_lambda(binder, BinderStyle::Default, sort, c)),
+                ("let_annotation", ctx.mk_let(binder, c, sort, sort, false)),
+                ("let_value", ctx.mk_let(binder, sort, c, sort, false)),
+                ("let_body", ctx.mk_let(binder, sort, sort, c, false)),
+                ("local_type", ctx.mk_unique(binder, BinderStyle::Default, c)),
+                ("projection_structure", ctx.mk_proj(ordinary, 0, c)),
+            ];
+            for (position, expr) in cells {
+                assert_eq!(ctx.has_nested_pfx(expr, reserved), expected, "{root}: {position}");
+            }
+        }
+    })
+}
