+#[test]
+fn nested_punit_ctor_rejected() -> Result<(), Box<dyn Error>> {
+    let (mut export, _) = test_get_export_file(Some(Path::new("test_resources/ProjFromProp/config.json")))?;
+    let name = punit_name(&export);
+    let ctor_name = match export.declars.get(&name).unwrap() {
+        Declar::Inductive(ind) => {
+            assert!(!ind.is_recursive);
+            assert_eq!(ind.all_ctor_names.len(), 1);
+            ind.all_ctor_names[0]
+        }
+        _ => unreachable!(),
+    };
+    let reserved = reserved_const(&mut export);
+    match export.declars.get_mut(&ctor_name).unwrap() {
+        Declar::Constructor(ctor) => {
+            assert_eq!(ctor.inductive_name, name);
+            assert_eq!(ctor.num_fields, 0);
+            ctor.info.ty = reserved;
+        }
+        _ => unreachable!(),
+    }
+    let declar = export.declars.get(&name).unwrap().clone();
+    assert_reserved_guard(&export, &declar, "assertion failed: !ctx.has_nested_pfx(ctor_data.info.ty, nested_pfx)");
+    Ok(())
+}
