+#[test]
+fn nested_punit_type_rejected() -> Result<(), Box<dyn Error>> {
+    let (mut export, _) = test_get_export_file(Some(Path::new("test_resources/ProjFromProp/config.json")))?;
+    let name = punit_name(&export);
+    let reserved = reserved_const(&mut export);
+    match export.declars.get_mut(&name).unwrap() {
+        Declar::Inductive(ind) => {
+            assert!(!ind.is_recursive);
+            ind.info.ty = reserved;
+        }
+        _ => unreachable!(),
+    }
+    let declar = export.declars.get(&name).unwrap().clone();
+    assert_reserved_guard(&export, &declar, "assertion failed: !ctx.has_nested_pfx(ind.info.ty, nested_pfx)");
+    Ok(())
+}
