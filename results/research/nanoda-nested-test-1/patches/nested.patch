+#[test]
+fn nested_punit_control_returns() -> Result<(), Box<dyn Error>> {
+    let (export, _) = test_get_export_file(Some(Path::new("test_resources/ProjFromProp/config.json")))?;
+    let name = punit_name(&export);
+    // The complete fixture intentionally fails later at explosion_helper.
+    export.check_declar(export.declars.get(&name).unwrap());
+    Ok(())
+}
