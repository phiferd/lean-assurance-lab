+#[test]
+fn nested_prefix_names() -> Result<(), Box<dyn Error>> {
+    test_ctx(None, |ctx| {
+        let reserved = ctx.str1("_nested");
+        let descendant = ctx.str2("_nested", "Probe");
+        let numbered = ctx.num(descendant, 7);
+        let similar = ctx.str2("_nestedX", "Probe");
+        let user_nested = ctx.str2("user", "_nested");
+        let probe = ctx.alloc_string(Cow::Borrowed("Probe"));
+        let user_probe = ctx.str(user_nested, probe);
+        let anon = ctx.anonymous();
+        let numeric = ctx.num(anon, 7);
+        let nested = ctx.alloc_string(Cow::Borrowed("_nested"));
+        let numeric_nested = ctx.str(numeric, nested);
+        let levels = ctx.alloc_levels_slice(&[]);
+        for (name, expected) in [
+            (reserved, true),
+            (descendant, true),
+            (numbered, true),
+            (similar, false),
+            (user_probe, false),
+            (anon, false),
+            (numeric_nested, false),
+        ] {
+            let expr = ctx.mk_const(name, levels);
+            assert_eq!(ctx.has_nested_pfx(expr, reserved), expected, "{:?}", ctx.debug_print(name));
+        }
+    })
+}
