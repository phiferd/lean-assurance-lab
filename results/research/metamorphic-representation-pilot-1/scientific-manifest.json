  "transformations": [
    {
      "id": "reverse-ready-v1",
      "algorithm": "Repeatedly choose the ready primitive with the greatest original line ordinal; a primitive is ready only when every typed dependency is implicit, outside the block and already emitted, or already emitted in the block. Assign new contiguous indices independently per primitive space and rewrite every typed reference in primitives and declarations.",
      "deterministic_seed": "sha256:25b199ec5840f9973e71569a74fdf5b9d156af2ecf9e0b0bcd89652107b736cf",
      "nonidentity_requirement": "At least two primitive line ordinals change and at least one explicit back-reference identifier or primitive-space identifier changes; otherwise record INAPPLICABLE."
    },
    {
      "id": "kind-round-robin-v1",
      "algorithm": "Cycle Name, Level, Expr starting at Name; emit the lowest-old-index ready primitive of the requested space, advancing to the next nonempty ready space when necessary. Assign and rewrite indices exactly as reverse-ready-v1.",
